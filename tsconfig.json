{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"],
            "@images/*": ["./src/assets/images/*"],
            "@styles/*": ["./src/styles/*"],
            "@tests/*": ["./tests/*"]
        },
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "target": "ESNext",
        "module": "preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "scripts/**/*",
        "workers/**/*",
        "src/env.d.ts",
        "playwright*.config.ts"
    ],
    "exclude": ["dist", "workers/**/worker-configuration.d.ts"]
}
