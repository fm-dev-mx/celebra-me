#!/bin/sh

set -e

# Branch protection check
current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" = "HEAD" ]; then
  echo "❌ Error: Committing on a detached HEAD is not allowed."
  echo "💡 Please create or switch to a task branch explicitly from develop first:"
  echo "   git switch -c <task-branch> develop"
  exit 1
fi

if [ "$current_branch" = "main" ]; then
  if [ "$SKIP_BRANCH_PROTECTION" = "true" ]; then
    echo "⚠️  Bypassing branch protection for 'main'..."
  else
    echo "❌ Error: Committing directly to 'main' is not allowed."
    echo "💡 Please create a feature branch or use 'SKIP_BRANCH_PROTECTION=true git commit' if absolutely necessary."
    exit 1
  fi
fi

echo "🛡️ Running pre-commit checks..."
cmd.exe /c "pnpm lint-staged"
cmd.exe /c "pnpm test:changed"
