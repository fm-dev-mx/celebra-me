{
    "baseUrl": "http://localhost:4321",
    "outputDir": "screenshots",
    "defaultMode": "audit",
    "defaultViewportProfile": "site",
    "defaultAnimationHandling": "disable",
    "defaultOutputFormat": "png",
    "defaultOutputFolderStyle": "default",
    "pages": [
        {
            "name": "Boda Jewelry Box Wedding",
            "pageType": "invitation",
            "route": "/boda/demo-boda-jewelry-box-wedding",
            "profile": "invitation",
            "target": "critical-qa",
            "revealHandling": "auto",
            "animationHandling": "disable",
            "sectionExtent": "full",
            "outputFormat": "png"
        },
        {
            "name": "XV Demo Jewelry Box",
            "pageType": "invitation",
            "route": "/xv/demo-xv-jewelry-box",
            "profile": "full",
            "target": "critical-qa",
            "revealHandling": "force-open",
            "animationHandling": "disable",
            "sectionExtent": "full"
        },
        {
            "name": "Landing Page",
            "pageType": "landing",
            "route": "/",
            "mode": "audit",
            "profile": "site",
            "target": "critical-qa",
            "sectionExtent": "full",
            "criticalSelectors": [
                { "selector": "main", "required": true, "capture": true },
                {
                    "selector": "[data-screenshot=\"landing-hero\"], #inicio",
                    "required": true,
                    "capture": true,
                    "label": "hero"
                },
                {
                    "selector": "[data-screenshot=\"landing-pricing\"], #pricing",
                    "required": true,
                    "capture": true,
                    "label": "pricing"
                },
                {
                    "selector": "[data-screenshot=\"landing-faq\"], #faq-section",
                    "required": true,
                    "capture": true,
                    "label": "faq"
                },
                {
                    "selector": "[data-screenshot=\"landing-contact\"], #contacto",
                    "required": true,
                    "capture": true,
                    "label": "contact"
                },
                {
                    "selector": "[data-screenshot=\"landing-event-types\"], #tipo-evento",
                    "required": false
                },
                {
                    "selector": "[data-screenshot=\"landing-includes\"], #servicios",
                    "required": false
                },
                {
                    "selector": "[data-screenshot=\"landing-guest-experience\"], #experiencia-invitados",
                    "required": false
                },
                {
                    "selector": "[data-screenshot=\"landing-testimonials\"], #testimonios",
                    "required": false,
                    "capture": true,
                    "label": "testimonials"
                },
                {
                    "selector": "[data-screenshot=\"landing-process\"], #como-funciona",
                    "required": false
                },
                { "selector": "[data-screenshot=\"landing-footer\"], footer", "required": false }
            ]
        },
        {
            "name": "Dashboard",
            "pageType": "dashboard",
            "route": "/dashboard",
            "profile": "site",
            "target": "full-page",
            "authMethod": "storage-state"
        }
    ]
}
