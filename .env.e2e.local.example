# ==============================================================================
# Celebra-me hosted test runner template (copy to .env.e2e.local)
# ==============================================================================
# Names only. Put real values in the ignored .env.e2e.local and never commit them.
# Read by the Preview Playwright configs (scripts/playwright/preview-environment.ts);
# operational scripts take it explicitly, e.g. `node --env-file=.env.e2e.local ...`.
# The Local Playwright config never loads this file. Every name needs a comment;
# `pnpm env:audit` checks it. See docs/env-workflow.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# Target deployment
# ------------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=
# Required only when PLAYWRIGHT_BASE_URL is an immutable deployment URL rather than an approved alias.
PLAYWRIGHT_APPROVED_PREVIEW_DEPLOYMENT_HOST=
# Exact dedicated Preview Supabase HTTPS URL; Production refs are rejected.
PLAYWRIGHT_PREVIEW_SUPABASE_URL=https://iwipdvisoyerfdytuhwi.supabase.co

# ------------------------------------------------------------------------------
# Test host account and fixture
# ------------------------------------------------------------------------------
# Dedicated Preview host account (preview@preview.com) used by authenticated runs.
PLAYWRIGHT_HOST_LOGIN=
PLAYWRIGHT_HOST_PASSWORD=
# UUID of the canonical fixture invitation (printed by `pnpm invitation:preview-fixture --apply`).
PLAYWRIGHT_PREVIEW_INVITATION_ID=

# ------------------------------------------------------------------------------
# Explicit guards (non-secret)
# ------------------------------------------------------------------------------
# Must be exactly false for read-only runs; true only for the matching authorized command
# (`test:e2e:preview:publish` or `test:e2e:preview:provision`). Debug artifacts fail closed.
PLAYWRIGHT_ALLOW_PREVIEW_PUBLICATION=false
PLAYWRIGHT_ALLOW_PREVIEW_FIXTURE_PROVISIONING=false
PLAYWRIGHT_PREVIEW_DEBUG_ARTIFACTS=false

# ------------------------------------------------------------------------------
# Cloudflare Access (sent only to the matching deployment origin)
# ------------------------------------------------------------------------------
# Cloudflare Access service token for the Preview Worker (smoke, release status).
# Also stored as the GitHub Actions secrets of the same names.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
