{
    "name": "celebra-memories-sign",
    "main": "src/index.ts",
    "compatibility_date": "2026-08-24",
    "workers_dev": false,
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "head_sampling_rate": 0.05
    },
    "routes": [
        {
            "pattern": "memories.celebra-me.com",
            "custom_domain": true
        }
    ],
    "ratelimits": [
        {
            "name": "SIGN_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 6,
                "period": 60
            }
        }
    ]
}
