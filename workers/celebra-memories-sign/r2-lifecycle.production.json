{
    "rules": [
        {
            "id": "expire-event-memories",
            "enabled": true,
            "conditions": {
                "prefix": "events/"
            },
            "deleteObjectsTransition": {
                "condition": {
                    "maxAge": 12960000,
                    "type": "Age"
                }
            },
            "abortMultipartUploadsTransition": {
                "condition": {
                    "maxAge": 86400,
                    "type": "Age"
                }
            }
        }
    ]
}
