---
// Test-only visual harness — injected exclusively during local Playwright execution.
// Resides in tests/e2e/harness/ so src/ remains strictly free of test imports and routes.

import Hero from '@/components/invitation/Hero.astro';
import EnvelopeReveal from '@/components/invitation/EnvelopeReveal.astro';
import EventHeader from '@/components/invitation/EventHeader.astro';
import globalCssUrl from '@/styles/global.scss?url';
import invitationCssUrl from '@/styles/invitation.scss?url';
import InvitationSections from '@/components/invitation/InvitationSections.astro';
import { canonicalEventContentSchema } from '@/lib/schemas/content/base-event.schema';
import { adaptEvent } from '@/lib/adapters/event';
import { prepareInvitationPageContext } from '@/lib/invitation/page-data';
import { resolvePresetCssUrl } from '@/lib/invitation/preset-css-resolver';
import { resolveInvitationCssLoadPlan } from '@/lib/invitation/section-css-resolver';
import { buildInvitationCssResolverInput } from '@/lib/invitation/invitation-css-input';
import { buildInvitationStylesheetHeadLinks } from '@/lib/invitation/invitation-css-head-links';
import { buildSyntheticVariantEvent } from '../../fixtures/structural-variants/synthetic-variant-fixtures';
import { getRoutableEventEntry } from '@/lib/content/events';
import { listInvitationDefinitions } from '../../../scripts/provision/invitations/registry';
import { getInvitationAssetSourceDir } from '../../../scripts/provision/invitations/invitation-definition';
import { existsSync, readFileSync } from 'node:fs';
import { extname, join } from 'node:path';
import type { CanonicalVariantSection } from '@/lib/invitation/section-variants';
import type { EventContentEntry } from '@/lib/content/events';
import type { InvitationPageContext } from '@/lib/invitation/page-data';
import type { InvitationStylesheetHeadLink } from '@/lib/invitation/invitation-css-head-links';

const section = Astro.url.searchParams.get('section') as CanonicalVariantSection | null;
const variant = Astro.url.searchParams.get('variant') ?? 'standard';
const preset = Astro.url.searchParams.get('preset') ?? 'jewelry-box';
const fullPage = Astro.url.searchParams.get('full') === '1';
const showEnvelope = fullPage && Astro.url.searchParams.get('envelope') === '1';
const fullPresentation = fullPage && (showEnvelope || Astro.url.searchParams.get('presentation') === '1');
let fullPageContext: InvitationPageContext | undefined;
let fullPageHeadLinks: InvitationStylesheetHeadLink[] | undefined;
let page: InvitationPageContext;
let headLinks: InvitationStylesheetHeadLink[] = [];

if (fullPage) {
	const slug = Astro.url.searchParams.get('slug')?.trim();
	const eventType = Astro.url.searchParams.get('eventType')?.trim();
	if (!slug) return new Response('Missing slug parameter', { status: 400 });

	const definition = listInvitationDefinitions().find(
		(candidate) => candidate.slug === slug && (!eventType || candidate.eventType === eventType),
	);
	let eventEntry: EventContentEntry | null;
	if (definition) {
		const assetRoot = join(process.cwd(), getInvitationAssetSourceDir(definition));
		const syntheticAssets = Object.fromEntries(
			definition.assets.map((asset) => {
				const absoluteAssetPath = join(assetRoot, asset.relativePath);
				if (!existsSync(absoluteAssetPath)) {
					throw new Error(`VISUAL_ASSET_MISSING: ${definition.slug}/${asset.relativePath}`);
				}
				const extension = extname(asset.relativePath).toLowerCase();
				const mime = extension === '.png' ? 'image/png' : extension === '.jpg' || extension === '.jpeg' ? 'image/jpeg' : 'image/webp';
				return [
					asset.key,
					{
						type: 'uploaded' as const,
						assetId: `__INVITATION_ASSET_KEY__:${asset.key}`,
						src: `data:${mime};base64,${readFileSync(absoluteAssetPath).toString('base64')}`,
						delivery: asset.delivery,
					},
				];
			}),
		);
		const data = canonicalEventContentSchema.parse(
			definition.buildPublishedContent(syntheticAssets),
		);
		eventEntry = {
			id: slug,
			collection: 'event-templates',
			data,
		} as unknown as EventContentEntry;
	} else {
		eventEntry = await getRoutableEventEntry(slug, eventType ?? undefined);
	}
	if (!eventEntry) return new Response(`Unknown visual parity source: ${slug}`, { status: 404 });

	const viewModel = adaptEvent(eventEntry);
	const builtPage = prepareInvitationPageContext({ eventEntry, slug });
	const activePresetUrl = resolvePresetCssUrl(builtPage.viewModel.theme.preset);
	const activeSectionCssPlan = resolveInvitationCssLoadPlan(
		buildInvitationCssResolverInput({ page: builtPage, viewModel, slug }),
	);
	fullPageHeadLinks = buildInvitationStylesheetHeadLinks({
		presetUrl: activePresetUrl,
		plan: activeSectionCssPlan,
		forceBlocking: true,
	});
	page = builtPage;
	fullPageContext = builtPage;
} else {

	if (!section) {
	return new Response('Missing section parameter', { status: 400 });
}

const rawEvent = buildSyntheticVariantEvent({ section, variant, themePreset: preset,
	...(Astro.url.searchParams.get('imageDelivery') === 'optimized' ? { imageDelivery: {mode: 'optimized' as const, width: 640, height: 800, quality: 77, format: 'webp' as const} } : {}),
});
const validated = canonicalEventContentSchema.parse(rawEvent.data);
const eventEntry = {
	id: rawEvent.id,
	collection: 'event-demos',
	data: validated,
} as unknown as EventContentEntry;
const viewModel = adaptEvent(eventEntry);
	page = prepareInvitationPageContext({
	eventEntry,
	slug: 'test-synthetic-variant',
});

const activePresetUrl = resolvePresetCssUrl(preset);
const activeSectionCssPlan = resolveInvitationCssLoadPlan(
	buildInvitationCssResolverInput({ page, viewModel, slug: 'test-synthetic-variant' }),
);

	headLinks = buildInvitationStylesheetHeadLinks({
	presetUrl: activePresetUrl,
	plan: activeSectionCssPlan,
	forceBlocking: true,
});
}
---
<!DOCTYPE html>
<html lang="es" data-screenshot={showEnvelope ? undefined : 'audit'}>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{fullPageContext?.layout.title ?? `${section}.${variant} (${preset})`}</title>
	{fullPresentation && <><link rel="stylesheet" href={globalCssUrl} /><link rel="stylesheet" href={invitationCssUrl} /></>}
	{(fullPageHeadLinks ?? headLinks).map((link) => (
		<link rel="stylesheet" href={link.href} data-canonical-css-owner={link.canonicalPath} />
	))}
	<style is:inline lang="scss" set:html={(fullPageContext ?? page).wrapper.scopedStyles} />
	<style>
		*, *::before, *::after { box-sizing: border-box; }
		html, body {
			margin: 0;
			padding: 0;
			overflow-x: hidden;
		}
		.invitation-section-wrapper {
			opacity: 1 !important;
			transform: none !important;
			visibility: visible !important;
		}
	</style>
</head>
	<body class={(fullPageContext ?? page).wrapper.className} data-reveal-state={showEnvelope ? undefined : 'revealed'}>
	<div class={(fullPageContext ?? page).wrapper.className} {...showEnvelope ? page.wrapper.dataAttributes : {}} data-reveal-state={showEnvelope ? 'closed' : 'revealed'} data-screenshot="invitation-root" id="test-invitation-root">
		{fullPageContext ? (
			<>
				{showEnvelope && page.envelope && <EnvelopeReveal {...page.envelope} />}
				{showEnvelope && <EventHeader links={page.viewModel.navigation ?? []} variant="standard" initials={page.viewModel.envelope?.data?.sealInitials} eventName={page.viewModel.hero.name} eventSubtitle={page.viewModel.hero.label} isDemo={false} />}
				<Hero {...fullPageContext.viewModel.hero} venueName={fullPageContext.heroVenueName} time={fullPageContext.heroTime} highPriority={true} />
				<InvitationSections pageContext={fullPageContext} />
			</>
		) : section === 'hero' ? (
			<Hero {...page.viewModel.hero} venueName={page.heroVenueName} time={page.heroTime} highPriority={true} />
		) : (
			<InvitationSections pageContext={page} />
		)}
	</div>
</body>
</html>
