---
// Test-only visual harness — injected exclusively during local Playwright execution.
// Resides in tests/e2e/harness/ so src/ remains strictly free of test imports and routes.

import Hero from '@/components/invitation/Hero.astro';
import InvitationSections from '@/components/invitation/InvitationSections.astro';
import { canonicalEventContentSchema } from '@/lib/schemas/content/base-event.schema';
import { adaptEvent } from '@/lib/adapters/event';
import { prepareInvitationPageContext } from '@/lib/invitation/page-data';
import { resolvePresetCssUrl } from '@/lib/invitation/preset-css-resolver';
import { resolveInvitationCssLoadPlan } from '@/lib/invitation/section-css-resolver';
import { buildInvitationCssResolverInput } from '@/lib/invitation/invitation-css-input';
import { buildInvitationStylesheetHeadLinks } from '@/lib/invitation/invitation-css-head-links';
import { buildSyntheticVariantEvent } from '../../fixtures/structural-variants/synthetic-variant-fixtures';
import type { CanonicalVariantSection } from '@/lib/invitation/section-variants';
import type { EventContentEntry } from '@/lib/content/events';

const section = Astro.url.searchParams.get('section') as CanonicalVariantSection | null;
const variant = Astro.url.searchParams.get('variant') ?? 'standard';
const preset = Astro.url.searchParams.get('preset') ?? 'jewelry-box';

if (!section) {
	return new Response('Missing section parameter', { status: 400 });
}

const rawEvent = buildSyntheticVariantEvent({ section, variant, themePreset: preset });
const validated = canonicalEventContentSchema.parse(rawEvent.data);
const eventEntry = {
	id: rawEvent.id,
	collection: 'event-demos',
	data: validated,
} as unknown as EventContentEntry;
const viewModel = adaptEvent(eventEntry);
const page = prepareInvitationPageContext({
	eventEntry,
	slug: 'test-synthetic-variant',
});

const activePresetUrl = resolvePresetCssUrl(preset);
const activeSectionCssPlan = resolveInvitationCssLoadPlan(
	buildInvitationCssResolverInput({ page, viewModel, slug: 'test-synthetic-variant' }),
);

const headLinks = buildInvitationStylesheetHeadLinks({
	presetUrl: activePresetUrl,
	plan: activeSectionCssPlan,
	profileIdentity: {
		visualProfileId: undefined,
		slug: 'test-synthetic-variant',
	},
	forceBlocking: true,
});
---
<!DOCTYPE html>
<html lang="es" data-screenshot="audit">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{section}.{variant} ({preset})</title>
	{headLinks.map((link) => (
		<link rel="stylesheet" href={link.href} />
	))}
	<style is:inline lang="scss" set:html={page.wrapper.scopedStyles} />
	<style>
		*, *::before, *::after { box-sizing: border-box; }
		html, body {
			margin: 0;
			padding: 0;
			overflow-x: hidden;
		}
		.invitation-section-wrapper {
			opacity: 1 !important;
			transform: none !important;
			visibility: visible !important;
		}
	</style>
</head>
<body class={page.wrapper.className} data-reveal-state="revealed">
	<div class={page.wrapper.className} data-reveal-state="revealed" data-screenshot="invitation-root" id="test-invitation-root">
		{section === 'hero' ? (
			<Hero
				{...page.viewModel.hero}
				venueName={page.heroVenueName}
				time={page.heroTime}
				highPriority={true}
			/>
		) : (
			<InvitationSections pageContext={page} />
		)}
	</div>
</body>
</html>
