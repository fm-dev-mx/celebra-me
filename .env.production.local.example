# ==============================================================================
# Celebra-me Production operations template (copy to .env.production.local)
# ==============================================================================
# Names only. Put real values in the ignored .env.production.local and never commit them.
# Read only by operator workflows: critical backups, guarded refreshes and the
# interactive `prod:apply` / `db:migrate` owner gate (scripts/db/db-target-config.ts).
# The application never reads this file; hosted Production values live in the host.
# Do not keep parallel copies under .secrets/ or .tmp/secrets/. See docs/env-workflow.md.
# ==============================================================================

# Postgres connection string for Production DB workflows (session pooler).
PROD_DB_URL=
# Independently verified API and Storage inputs for the complete critical backup.
PROD_SUPABASE_URL=
PROD_SUPABASE_SERVICE_ROLE_KEY=

# Off-site copy of the daily critical backup (Cloudflare R2, age-encrypted).
# Leave all empty to skip; a partial set fails the daily job. See docs/database-workflow.md.
PROD_OFFSITE_R2_ACCOUNT_ID=
PROD_OFFSITE_R2_BUCKET=
PROD_OFFSITE_R2_ACCESS_KEY_ID=
PROD_OFFSITE_R2_SECRET_ACCESS_KEY=
# age public key (age1...); the private key never lives on this machine.
PROD_OFFSITE_AGE_RECIPIENT=

# Nightly copy of Production media originals into a separate R2 backup bucket.
# Leave all empty to skip; a partial set fails closed. See docs/database-workflow.md.
PROD_MEDIA_COPY_R2_ACCOUNT_ID=
# Backup bucket name; never a Production bucket.
PROD_MEDIA_COPY_R2_BUCKET=
# Read-only token on the source buckets.
PROD_MEDIA_COPY_SOURCE_ACCESS_KEY_ID=
PROD_MEDIA_COPY_SOURCE_SECRET_ACCESS_KEY=
# Read & write token on the backup bucket only.
PROD_MEDIA_COPY_TARGET_ACCESS_KEY_ID=
PROD_MEDIA_COPY_TARGET_SECRET_ACCESS_KEY=
