# ==============================================================================
# Production operational secrets template (gitignored copy: .env.production.local)
# ==============================================================================
# Copy to .env.production.local and fill real Production values only.
# Never put Preview secrets, PREVIEW_DB_URL, or Preview project refs here.
#
# Canonical Production Supabase project ref: ineitkdkyrxqyressllp
# SSOT for URL / DB URL / service_role: Supabase Dashboard of that project.
# See docs/env-workflow.md and docs/database-workflow.md.
#
# Notes:
# - Prefer PROD_* names below for local scripts (invitation:update, db production ops).
# - `vercel env pull --environment=production` may write SUPABASE_* aliases and can
#   redact Sensitive values as [SENSITIVE]. Replace those placeholders with the
#   real Production service_role from Supabase before running local apply/upload.
# - Do not commit .env.production.local (.env.*.local is gitignored).
# ==============================================================================

# ------------------------------------------------------------------------------
# Preferred Production operational inputs (scripts/db + invitation:update)
# ------------------------------------------------------------------------------
# Paste the Production Database URL from Supabase (must contain project ref ineitkdkyrxqyressllp).
PROD_DB_URL=postgresql://postgres.ineitkdkyrxqyressllp:REPLACE_WITH_PROD_DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres
PROD_SUPABASE_URL=https://ineitkdkyrxqyressllp.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=production-service-role-key-placeholder

# ------------------------------------------------------------------------------
# Optional aliases (accepted by some loaders / Vercel Production pulls)
# ------------------------------------------------------------------------------
# Keep these on the same Production project as PROD_* above.
# SUPABASE_URL=https://ineitkdkyrxqyressllp.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=production-service-role-key-placeholder
# PUBLIC_SUPABASE_URL=https://ineitkdkyrxqyressllp.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=production-anon-key-placeholder
# SUPABASE_ANON_KEY=production-anon-key-placeholder
