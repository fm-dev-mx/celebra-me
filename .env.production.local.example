# ==============================================================================
# Celebra-me Production operations template (copy to .env.production.local)
# ==============================================================================
# Names only. Put real values in the ignored .env.production.local and never commit them.
# Read only by operator workflows: critical backups, guarded refreshes and the
# interactive `prod:apply` / `db:migrate` owner gate (scripts/db/db-target-config.ts).
# The application never reads this file; hosted Production values live in the host.
# Do not keep parallel copies under .secrets/ or .tmp/secrets/. See docs/env-workflow.md.
# ==============================================================================

# Postgres connection string for Production DB workflows (session pooler).
PROD_DB_URL=
# Independently verified API and Storage inputs for the complete critical backup.
PROD_SUPABASE_URL=
PROD_SUPABASE_SERVICE_ROLE_KEY=
