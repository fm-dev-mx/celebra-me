{
    "version": 1,
    "allow": [
        "git status",
        "git diff",
        "git log",
        "git show",
        "git rev-parse",
        "git branch --show-current",
        "git fetch",
        "git add",
        "git commit",
        "git switch",
        "git merge origin/develop",
        "git push origin",
        "git push -u origin",
        "gh pr view",
        "gh pr diff",
        "gh pr checks",
        "gh pr create",
        "gh pr edit",
        "gh pr comment",
        "gh pr review",
        "gh run view",
        "gh run watch",
        "pnpm board",
        "pnpm board:verify",
        "pnpm agent:git-safety:start",
        "pnpm agent:git-safety:check",
        "pnpm agent:git-safety:finish",
        "pnpm test",
        "pnpm type-check",
        "pnpm validate:changed",
        "pnpm validate:structure",
        "pnpm lint",
        "pnpm build",
        "pnpm exec prettier",
        "node scripts/board/board.mjs"
    ],
    "ask": ["gh pr merge", "gh * pr merge*"],
    "deny": [
        "git push --force",
        "git push --force-with-lease",
        "git push -f",
        "git push --mirror",
        "git push origin --force",
        "git push origin --force-with-lease",
        "git push origin -f",
        "git push -u origin --force",
        "git push -u origin --force-with-lease",
        "git push -u origin -f",
        "git push origin main",
        "git push origin HEAD:main",
        "git push origin refs/heads/main",
        "git push origin HEAD:refs/heads/main",
        "git push -u origin main",
        "git push -u origin HEAD:main",
        "git push -u origin refs/heads/main",
        "git push -u origin HEAD:refs/heads/main",
        "git push *--force*",
        "git push *-f*",
        "git push *--mirror*",
        "git push *+*",
        "git push *main*",
        "supabase db reset",
        "supabase db push",
        "supabase migration up",
        "psql",
        "pnpm prod:apply",
        "pnpm run prod:apply",
        "pnpm prod:apply *--apply*",
        "pnpm run prod:apply *--apply*",
        "pnpm ops:cloudflare:production:secrets",
        "wrangler deploy",
        "wrangler versions deploy",
        "wrangler secret",
        "vercel --prod",
        "vercel deploy *--prod*",
        "* .env*",
        "*/.env*",
        "* .secrets/*",
        "*/.secrets/*",
        "* .vercel/*",
        "*/.vercel/*",
        "* .backups/*",
        "*/.backups/*"
    ],
    "denyRead": ["**/.env*", "**/.secrets/**", "**/.vercel/**", "**/.backups/**"]
}
