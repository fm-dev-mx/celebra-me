# ==============================================================================
# Celebra-me Secret-Free Environment Inventory and Local Template
# ==============================================================================
# Template for .env.local (Local development against Local Supabase).
# Keep variable names and non-sensitive placeholders here; never add real credentials.
# Do not put production secrets, production URLs, or PROD_DB_URL in this file.
# Sibling templates: .env.preview.local.example, .env.production.local.example,
# .env.e2e.local.example. See docs/env-workflow.md for the canonical environment workflow.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
BASE_URL=http://localhost:4321
# Local-process runtime target. Lane defaults set this automatically; override only when intentional.
# Values: local | preview. Never forges Vercel identity. Not a mutation authorization token.
CELEBRA_RUNTIME_TARGET=local
# Optional override for the durable canonical-status cache. Default: .cache/canonical-status.json
CELEBRA_STATUS_CACHE_PATH=

# ------------------------------------------------------------------------------
# Supabase local development
# ------------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-placeholder

# Browser-safe Supabase values. Never expose SUPABASE_SERVICE_ROLE_KEY with PUBLIC_.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=local-anon-key-placeholder

# Server-only event memories control plane (guest photo/video QR). Owner-managed in Vercel.
# Use two independent PKCS#8 P-256 PEM private keys; never expose them with PUBLIC_.
MEMORIES_UPLOAD_REQUEST_SIGNING_PRIVATE_KEY=
MEMORIES_RETRIEVAL_REQUEST_SIGNING_PRIVATE_KEY=
# Non-secret server-only origin for the authenticated Sign Worker. The path is repository-owned.
MEMORIES_PRIVATE_UPLOAD_ORIGIN=
# Non-secret HTTPS origin for the authenticated Retrieval Worker. The path is repository-owned.
MEMORIES_PRIVATE_RETRIEVAL_ORIGIN=
# Vercel Cron standard bearer secret. Generate independently from both Worker key pairs.
CRON_SECRET=
# Optional read-only usage for /dashboard/admin/recuerdos (Account Analytics: Read).
MEMORIES_CLOUDFLARE_ACCOUNT_ID=
MEMORIES_CLOUDFLARE_ANALYTICS_TOKEN=
MEMORIES_R2_BUCKET_NAME=

# ------------------------------------------------------------------------------
# RSVP and intake security
# ------------------------------------------------------------------------------
# Generate local placeholders with: openssl rand -hex 32
TRUST_DEVICE_SECRET=local-trust-device-secret-placeholder
# Optional: seals unpaid preview photo URLs; derived from the service-role key when empty.
PREVIEW_MEDIA_SECRET=
TRUST_DEVICE_MAX_AGE_DAYS=30

# ------------------------------------------------------------------------------
# Local admin and auth behavior
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAILS=admin@example.com
RSVP_ADMIN_PASSWORD=rsvp-password-placeholder
LOCAL_SUPER_ADMIN_PASSWORD=local-super-admin-password-placeholder
REQUIRE_FRESH_MFA_FOR_ADMIN=false
DEV_MFA_BYPASS=false

# ------------------------------------------------------------------------------
# Cloudinary provisioning (server-only operational scripts)
# ------------------------------------------------------------------------------
# Used only by trusted provisioning scripts. Never expose these with PUBLIC_.
CLOUDINARY_CLOUD_NAME=local-cloudinary-cloud-placeholder
CLOUDINARY_API_KEY=local-cloudinary-api-key-placeholder
CLOUDINARY_API_SECRET=local-cloudinary-api-secret-placeholder

# ------------------------------------------------------------------------------
# Preview MFA bypass (hosted Preview only — see docs/env-workflow.md)
# ------------------------------------------------------------------------------
PREVIEW_MFA_BYPASS=false
PREVIEW_ADMIN_EMAILS=

# ------------------------------------------------------------------------------
# Email and contact
# ------------------------------------------------------------------------------
GMAIL_USER=local-email@example.com
GMAIL_PASS=local-gmail-app-password-placeholder
CONTACT_FORM_RECIPIENT_EMAIL=contact@example.com
CONTACT_WHATSAPP=521000000000

# ------------------------------------------------------------------------------
# Public analytics placeholders
# ------------------------------------------------------------------------------

# GA4 Measurement ID.
PUBLIC_GA_MEASUREMENT_ID=G-LOCALPLACEHOLDER

# ------------------------------------------------------------------------------
# Meta Pixel (advertising) — browser-safe, optional, requires marketing consent
# ------------------------------------------------------------------------------
PUBLIC_META_PIXEL_ID=
PUBLIC_META_PIXEL_ENABLED=false

# ------------------------------------------------------------------------------
# Cloudflare Web Analytics — browser-safe, cookieless, optional (site token)
# ------------------------------------------------------------------------------
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# ------------------------------------------------------------------------------
# Meta Conversions API (CAPI) — server-only
# ------------------------------------------------------------------------------
# Allowed values: disabled | test | production
# Keep disabled by default for local development.
# Never expose META_CAPI_ACCESS_TOKEN with PUBLIC_.
META_CAPI_DELIVERY_MODE=disabled

# Required only when META_CAPI_DELIVERY_MODE is "test" or "production".
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=

# Required only when META_CAPI_DELIVERY_MODE is "test".
# Get this from Meta Events Manager → Test Events.
META_TEST_EVENT_CODE=

# ------------------------------------------------------------------------------
# Platform usage console (server-only, read-only credentials)
# ------------------------------------------------------------------------------
# Used only by the super-admin platform usage console. Least-privilege tokens:
# Supabase Management scopes analytics_usage_read + infra_disk_config_read.
# Project refs are not secrets.
# Optional restricted Cloudinary key; the console falls back to the upload key.
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF_PREVIEW=
SUPABASE_PROJECT_REF_PRODUCTION=
CLOUDINARY_USAGE_API_KEY=
CLOUDINARY_USAGE_API_SECRET=

# ------------------------------------------------------------------------------
# Platform usage console (Local-only per-environment diagnostics)
# ------------------------------------------------------------------------------
# Optional. Local reads NAME_PREVIEW / NAME_PRODUCTION first and falls back to
# the shared name; deployments read only the plain names above. Use them to see
# each environment's configuration status from the local dashboard.
MEMORIES_CLOUDFLARE_ANALYTICS_TOKEN_PREVIEW=
MEMORIES_CLOUDFLARE_ANALYTICS_TOKEN_PRODUCTION=
MEMORIES_R2_BUCKET_NAME_PREVIEW=
MEMORIES_R2_BUCKET_NAME_PRODUCTION=
SUPABASE_MANAGEMENT_TOKEN_PREVIEW=
SUPABASE_MANAGEMENT_TOKEN_PRODUCTION=

# Shared memories gallery links (HMAC key, >= 32 random bytes). Server-only secret.
MEMORIES_SHARE_SECRET=
