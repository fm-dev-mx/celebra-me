# ==============================================================================
# Celebra-me Local development template (copy to .env.local)
# ==============================================================================
# Names and non-sensitive placeholders only; never add real credentials.
# Read by the Astro dev server (lane bootstrap: scripts/shared/celebra-runtime-env.ts)
# and the Local DB workflows (scripts/db/db-workflow-lib.ts).
# Never put Production refs, URLs or keys here.
# Sibling templates: .env.preview.local.example, .env.production.local.example,
# .env.e2e.local.example. Every name needs a comment; `pnpm env:audit` checks it.
# See docs/env-workflow.md for the canonical environment workflow.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
# Node mode for local processes; the lane bootstrap only loads env files in development.
NODE_ENV=development
# Public origin of the local site; used for absolute links and canonical URLs.
BASE_URL=http://localhost:4321
# Database a local process targets: local | preview. Lane detection sets it; override only
# for intentional tests. Never a hosted identity and never a mutation authorization.
CELEBRA_RUNTIME_TARGET=local

# ------------------------------------------------------------------------------
# Supabase (Local stack from `supabase start`)
# ------------------------------------------------------------------------------
# Server-side Supabase API URL; must stay on Local Supabase in this file.
SUPABASE_URL=http://127.0.0.1:54321
# Server-side anon key reported by `supabase status`.
SUPABASE_ANON_KEY=local-anon-key-placeholder
# Server-only service-role key reported by `supabase status`. Never expose it with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-placeholder
# Browser-safe copies of the URL and anon key.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=local-anon-key-placeholder

# ------------------------------------------------------------------------------
# Event memories (guest photo/video QR) — server-only, Local Workers
# ------------------------------------------------------------------------------
# Two independent PKCS#8 P-256 PEM private keys that sign requests to the Sign and
# Retrieval Workers. Never expose them with PUBLIC_.
MEMORIES_UPLOAD_REQUEST_SIGNING_PRIVATE_KEY=
MEMORIES_RETRIEVAL_REQUEST_SIGNING_PRIVATE_KEY=
# Non-secret origins of the Local Sign and Retrieval Workers; the paths stay in code.
MEMORIES_PRIVATE_UPLOAD_ORIGIN=
MEMORIES_PRIVATE_RETRIEVAL_ORIGIN=
# HMAC key (>= 32 random bytes) that signs shared gallery links. Optional locally.
MEMORIES_SHARE_SECRET=

# ------------------------------------------------------------------------------
# RSVP and intake security
# ------------------------------------------------------------------------------
# Signs trusted-device cookies. Generate with: openssl rand -hex 32
TRUST_DEVICE_SECRET=local-trust-device-secret-placeholder
# Days a trusted device skips MFA.
TRUST_DEVICE_MAX_AGE_DAYS=30
# Optional: seals unpaid preview photo URLs; derived from the service-role key when empty.

# ------------------------------------------------------------------------------
# Local admin and auth behavior
# ------------------------------------------------------------------------------
# Comma-separated super admins; the first entry is the project owner and the account that
# `pnpm db:local:bootstrap-admin` creates.
SUPER_ADMIN_EMAILS=admin@example.com
# Local DB workflow passwords for the seeded RSVP admin and the local super admin.
RSVP_ADMIN_PASSWORD=rsvp-password-placeholder
LOCAL_SUPER_ADMIN_PASSWORD=local-super-admin-password-placeholder
# true forces a fresh MFA check before admin actions.
REQUIRE_FRESH_MFA_FOR_ADMIN=false
# true skips MFA on the Astro dev server only (never in a built bundle).
DEV_MFA_BYPASS=false

# ------------------------------------------------------------------------------
# Contact
# ------------------------------------------------------------------------------
# WhatsApp number (country code, digits only) behind the site contact buttons.
CONTACT_WHATSAPP=521000000000

# ------------------------------------------------------------------------------
# Browser analytics (browser-safe, optional)
# ------------------------------------------------------------------------------
# GA4 Measurement ID.
PUBLIC_GA_MEASUREMENT_ID=G-LOCALPLACEHOLDER
# Meta Pixel id and switch; the pixel also requires marketing consent.
PUBLIC_META_PIXEL_ID=
PUBLIC_META_PIXEL_ENABLED=false
# Cloudflare Web Analytics site token (cookieless).
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# ------------------------------------------------------------------------------
# Meta Conversions API (CAPI) — server-only
# ------------------------------------------------------------------------------
# Delivery mode: disabled | test | production. Keep disabled for local development.
META_CAPI_DELIVERY_MODE=disabled
# Required only when the mode is test or production. Never expose the token with PUBLIC_.
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
# Required only when the mode is test (Meta Events Manager → Test Events).
META_TEST_EVENT_CODE=

# ------------------------------------------------------------------------------
# Meta aggregate insights — server-only, optional read access, separate from CAPI
# ------------------------------------------------------------------------------
# Read token for explicitly assigned assets. Never expose with PUBLIC_ or in URLs.
META_GRAPH_ACCESS_TOKEN=
# Marketing API account identifier, including the act_ prefix.
META_AD_ACCOUNT_ID=
# Facebook Page identifier for aggregate Page insights.
META_PAGE_ID=
# Professional Instagram account identifier for aggregate account insights.
META_IG_USER_ID=

# ------------------------------------------------------------------------------
# Platform usage console (super admin, read-only credentials, optional)
# ------------------------------------------------------------------------------
# Cloudflare account and Account Analytics: Read token for R2 and Worker usage.
MEMORIES_CLOUDFLARE_ACCOUNT_ID=
MEMORIES_CLOUDFLARE_ANALYTICS_TOKEN=
# R2 bucket whose usage the console reports.
MEMORIES_R2_BUCKET_NAME=
# Supabase Management token (analytics_usage_read + infra_disk_config_read).
SUPABASE_MANAGEMENT_TOKEN=
# Non-secret Supabase project refs; Local shows both environments.
SUPABASE_PROJECT_REF_PREVIEW=
SUPABASE_PROJECT_REF_PRODUCTION=
