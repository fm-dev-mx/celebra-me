---
/** src/layouts/Layout.astro */
import '@/styles/global.scss';

import Header from '@/components/home/HomeHeader.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import ConsentBanner from '@/components/common/ConsentBanner.astro';
import SvgFilters from '@/components/common/SvgFilters.astro';
import {
	buildSocialImageMetadata,
	resolvePublicSiteOrigin,
} from '@/lib/invitation/social-metadata';
import {
	classifyTrackingRoute,
	resolveSpeedInsightsConfig,
} from '@/lib/tracking/route-policy';

// Typography: Montserrat UI font is loaded globally. Preset-specific fonts are loaded dynamically.
import '@fontsource-variable/montserrat';

import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description?: string;
	image?: string | ImageMetadata;
	hideHeader?: boolean;
	className?: string;
	isDemo?: boolean;
	themeMode?: 'light' | 'dark';
	transparentHeader?: boolean;
	headLinks?: Array<{
		rel: 'preconnect' | 'preload' | 'stylesheet';
		href: string;
		as?: 'image' | 'style';
		media?: string;
		type?: string;
		fetchpriority?: 'high' | 'low' | 'auto';
		deferredCss?: boolean;
	}>;
}

const {
	title,
	description = 'Celebra.me - Invitaciones digitales',
	image = '/images/og-image.webp',
	hideHeader = false,
	className,
	isDemo = false,
	themeMode = 'dark',
	transparentHeader = true,
	headLinks = [],
} = Astro.props as Props;

const vercelEnvironment = process.env.VERCEL_ENV;
const isVercelProduction = vercelEnvironment === 'production';
const isMetaDeliveryBlocked = Boolean(vercelEnvironment && vercelEnvironment !== 'production');

const resolvedImageSrc = typeof image === 'string' ? image : image.src;

const canonicalOrigin = resolvePublicSiteOrigin();

let canonicalUrl = new URL(Astro.url.pathname, canonicalOrigin);
if (canonicalUrl.pathname !== '/' && canonicalUrl.pathname.endsWith('/')) {
	canonicalUrl.pathname = canonicalUrl.pathname.replace(/\/+$/, '');
}

const socialImage = buildSocialImageMetadata(resolvedImageSrc, { origin: canonicalOrigin });
const ogImage = socialImage.url;

const routePolicy = classifyTrackingRoute(Astro.url);
const loadCommercialTracking = isVercelProduction && routePolicy.internalAllowed;

const speedInsightsConfig = resolveSpeedInsightsConfig(Astro.url, {
	vercelEnv: vercelEnvironment,
});
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:width" content={String(socialImage.width)} />
		<meta property="og:image:height" content={String(socialImage.height)} />
		<meta property="og:image:type" content={socialImage.type} />
		<meta property="og:image:alt" content={title} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="Celebra.me" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{
			headLinks.map((l) => (
				<link
					rel={l.rel}
					href={l.href}
					as={l.as}
					media={l.media}
					type={l.type}
					fetchpriority={l.fetchpriority}
					data-invitation-deferred-css={l.deferredCss ? 'true' : undefined}
				/>
			))
		}
		{
			headLinks.some((l) => l.deferredCss) && (
				<noscript>
					{headLinks
						.filter((l) => l.deferredCss)
						.map((l) => (
							<link rel="stylesheet" href={l.href} />
						))}
				</noscript>
			)
		}

		<slot name="head" />
		<SvgFilters />
	</head>
	<body
		class:list={[className, { 'is-demo': isDemo }]}
		data-theme-mode={themeMode}
		data-tracking-route-class={loadCommercialTracking ? routePolicy.routeClass : undefined}
		data-meta-delivery-blocked={isMetaDeliveryBlocked ? 'true' : undefined}
	>
		{!hideHeader && <Header transparentOnHero={transparentHeader} />}

		<main>
			<slot />
		</main>

		<ConsentBanner />
		{isVercelProduction && <Analytics />}
		{speedInsightsConfig.enabled && (
			<SpeedInsights sampleRate={speedInsightsConfig.sampleRate} />
		)}
		{loadCommercialTracking && (
			<script>
				import { initCommercialTracking } from '@/lib/tracking/client';
				initCommercialTracking();
			</script>
		)}
	</body>
</html>
