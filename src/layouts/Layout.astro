---
/** src/layouts/Layout.astro */
import '@/styles/global.scss';

import Header from '@/components/home/HomeHeader.astro';
import ConsentBanner from '@/components/common/ConsentBanner.astro';
import LeadCaptureDialog from '@/components/common/LeadCaptureDialog.astro';
import SvgFilters from '@/components/common/SvgFilters.astro';
import BrandIcons from '@/components/common/BrandIcons.astro';
import { BRAND_SOCIAL_IMAGE } from '@/lib/brand/brand-logo';
import {
	buildSocialImageMetadata,
	resolvePublicSiteOrigin,
} from '@/lib/invitation/social-metadata';
import { readHostedDeployEnvironment } from '@/lib/server/deploy-identity';
import { classifyTrackingRoute } from '@/lib/tracking/route-policy';
import { resolveWebAnalyticsBeacon } from '@/lib/tracking/web-analytics';
import { getWebAnalyticsToken } from '@/lib/tracking/web-analytics-env';
import { getEstimatedLeadValue } from '@/lib/commercial/meta-capi/estimated-lead-value';

// Typography: Montserrat UI font is loaded globally. Preset-specific fonts are loaded dynamically.
import '@fontsource-variable/montserrat';

import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	image?: string | ImageMetadata;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	robots?: string;
	/** Leave out canonical and social URLs (pages whose path must not be echoed back). */
	omitCanonical?: boolean;
	/** Public path used for canonical and social URLs when it differs from the request path. */
	canonicalPath?: string;
	hideHeader?: boolean;
	className?: string;
	isDemo?: boolean;
	themeMode?: 'light' | 'dark';
	transparentHeader?: boolean;
	headLinks?: Array<{
		rel: 'preconnect' | 'preload' | 'stylesheet';
		href: string;
		as?: 'image' | 'style';
		media?: string;
		type?: string;
		fetchpriority?: 'high' | 'low' | 'auto';
		imagesrcset?: string;
		imagesizes?: string;
		deferredCss?: boolean;
	}>;
}

const {
	title,
	description = 'Celebra-me - Invitaciones digitales',
	ogTitle,
	ogDescription,
	image = BRAND_SOCIAL_IMAGE.src,
	imageAlt,
	imageWidth,
	imageHeight,
	robots,
	omitCanonical = false,
	canonicalPath,
	hideHeader = false,
	className,
	isDemo = false,
	themeMode = 'dark',
	transparentHeader = true,
	headLinks = [],
} = Astro.props as Props;

const deployEnvironment = readHostedDeployEnvironment();
const isProductionRuntime = deployEnvironment === 'production';
const isMetaDeliveryBlocked = deployEnvironment === 'preview';

const resolvedImageSrc = typeof image === 'string' ? image : image.src;

const canonicalOrigin = resolvePublicSiteOrigin();
const copyrightNotice = `© ${new Date().getFullYear()} Celebra-me. Todos los derechos reservados.`;

let canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, canonicalOrigin);
if (canonicalUrl.pathname !== '/' && canonicalUrl.pathname.endsWith('/')) {
	canonicalUrl.pathname = canonicalUrl.pathname.replace(/\/+$/, '');
}

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;

const socialImage = buildSocialImageMetadata(resolvedImageSrc, {
	origin: canonicalOrigin,
	width: imageWidth,
	height: imageHeight,
});
const ogImage = socialImage.url;

const routePolicy = classifyTrackingRoute(Astro.url);
const loadCommercialTracking = isProductionRuntime && routePolicy.internalAllowed;
// «Aparta su fecha» opens from the WhatsApp CTAs of the landing and the demos, in every runtime.
const showLeadCapture = routePolicy.routeClass === 'commercial' || routePolicy.routeClass === 'demo';

// Cookieless Cloudflare Web Analytics: no consent gate; off when the site token is blank.
const webAnalyticsBeacon = resolveWebAnalyticsBeacon(getWebAnalyticsToken());
const estimatedLeadValue = loadCommercialTracking ? await getEstimatedLeadValue() : undefined;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		{robots && <meta name="robots" content={robots} />}
		<meta name="author" content="Celebra-me" />
		<meta name="copyright" content={copyrightNotice} />
		<link rel="license" href="/terminos#propiedad-intelectual" />
		<BrandIcons withManifest />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		{!omitCanonical && <meta property="og:url" content={canonicalUrl.href} />}
		<meta property="og:title" content={resolvedOgTitle} />
		<meta property="og:description" content={resolvedOgDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:width" content={String(socialImage.width)} />
		<meta property="og:image:height" content={String(socialImage.height)} />
		<meta property="og:image:type" content={socialImage.type} />
		<meta property="og:image:alt" content={imageAlt ?? resolvedOgTitle} />
		{!omitCanonical && <link rel="canonical" href={canonicalUrl.href} />}
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="Celebra-me" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		{!omitCanonical && <meta name="twitter:url" content={canonicalUrl.href} />}
		<meta name="twitter:title" content={resolvedOgTitle} />
		<meta name="twitter:description" content={resolvedOgDescription} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={imageAlt ?? resolvedOgTitle} />

		{
			headLinks.map((l) => (
				<link
					rel={l.rel}
					href={l.href}
					as={l.as}
					media={l.media}
					type={l.type}
					fetchpriority={l.fetchpriority}
					imagesrcset={l.imagesrcset}
					imagesizes={l.imagesizes}
					data-invitation-deferred-css={l.deferredCss ? 'true' : undefined}
				/>
			))
		}
		{
			headLinks.some((l) => l.deferredCss) && (
				<noscript>
					{headLinks
						.filter((l) => l.deferredCss)
						.map((l) => (
							<link rel="stylesheet" href={l.href} />
						))}
				</noscript>
			)
		}

		<slot name="head" />
		<SvgFilters />
	</head>
	<body
		class:list={[className, { 'is-demo': isDemo }]}
		data-theme-mode={themeMode}
		data-tracking-route-class={loadCommercialTracking ? routePolicy.routeClass : undefined}
		data-meta-delivery-blocked={isMetaDeliveryBlocked ? 'true' : undefined}
		data-meta-estimated-lead-value={loadCommercialTracking && estimatedLeadValue ? String(estimatedLeadValue) : undefined}
	>
		{!hideHeader && <Header transparentOnHero={transparentHeader} />}

		<main>
			<slot />
		</main>

		{showLeadCapture && <LeadCaptureDialog />}
		<ConsentBanner />
		{
			webAnalyticsBeacon && (
				<script
					is:inline
					type="module"
					src={webAnalyticsBeacon.src}
					data-cf-beacon={webAnalyticsBeacon.beaconConfig}
				/>
			)
		}
		{loadCommercialTracking && (
			<script>
				import { initCommercialTracking } from '@/lib/tracking/client';
				initCommercialTracking();
			</script>
		)}
	</body>
</html>
