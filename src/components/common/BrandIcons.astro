---
/** Favicon, touch icon and manifest links for every page head (logo_2026_v2 web/ icons). */
import { BRAND_ICONS } from '@/lib/brand/brand-logo';

interface Props {
	/** Public pages link the web manifest; private ones (dashboard, guest data) skip it. */
	withManifest?: boolean;
}

const { withManifest = false } = Astro.props;
---

<link rel="icon" type="image/svg+xml" href={BRAND_ICONS.faviconSvg} />
<link rel="icon" type="image/x-icon" href={BRAND_ICONS.faviconIco} sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" href={BRAND_ICONS.favicon32} sizes="32x32" />
<link rel="icon" type="image/png" href={BRAND_ICONS.favicon16} sizes="16x16" />
<link rel="apple-touch-icon" href={BRAND_ICONS.appleTouchIcon} sizes="180x180" />
{withManifest && <link rel="manifest" href="/site.webmanifest" />}
