---
import type { ImageDelivery } from '@/lib/assets/image-delivery';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	plainImgSrc,
	shouldOptimizeThroughImageService,
} from '@/lib/assets/image-delivery-policy';

interface Props {
	delivery?: ImageDelivery;
	src: ImageMetadata | string;
	alt: string;
	width: number;
	height: number;
	class?: string;
	loading?: 'eager' | 'lazy';
	decoding?: 'async' | 'auto' | 'sync';
	fetchpriority?: 'high' | 'low' | 'auto';
	sizes?: string;
	widths?: number[] | readonly number[];
	format?: 'avif' | 'jpeg' | 'jpg' | 'png' | 'svg' | 'webp';
	quality?: number;
}

const {
	src,
	delivery,
	alt,
	width: defaultWidth,
	height: defaultHeight,
	class: className,
	loading,
	decoding,
	fetchpriority,
	sizes,
	widths: defaultWidths,
	format: defaultFormat,
	quality: defaultQuality,
} = Astro.props;

const widths = delivery?.width ? undefined : defaultWidths;
const width = delivery?.width ?? defaultWidth;
const height = delivery?.height ?? defaultHeight;
// A delivery width without a height keeps the source aspect ratio: the default height belongs
// to the default width and would crop the transform.
const transformHeight = delivery?.width && !delivery.height ? undefined : height;
const remoteSize =
	transformHeight !== undefined
		? { width, height: transformHeight }
		: { width, inferSize: true as const };
const localSize = transformHeight !== undefined ? { width, height: transformHeight } : { width };
const format = delivery?.format ?? defaultFormat;
const quality = delivery?.quality ?? defaultQuality;
const optimize = shouldOptimizeThroughImageService(src, delivery);
---

{
	optimize ? (
		typeof src === 'string' ? (
			<Image
				src={src}
				alt={alt}
				{...remoteSize}
				class={className}
				loading={loading}
				decoding={decoding}
				fetchpriority={fetchpriority}
				format={format}
				quality={quality}
				{...widths ? { widths: widths as number[], sizes } : {}}
			/>
		) : widths && sizes ? (
			<Image
				src={src}
				alt={alt}
				widths={widths as number[]}
				sizes={sizes}
				class={className}
				loading={loading}
				decoding={decoding}
				fetchpriority={fetchpriority}
				format={format}
				quality={quality}
			/>
		) : (
			<Image
				src={src}
				alt={alt}
				{...localSize}
				class={className}
				loading={loading}
				decoding={decoding}
				fetchpriority={fetchpriority}
				format={format}
				quality={quality}
			/>
		)
	) : (
		<img
			src={plainImgSrc(src)}
			alt={alt}
			width={width}
			height={height}
			class={className}
			loading={loading}
			decoding={decoding}
			fetchpriority={fetchpriority}
		/>
	)
}
