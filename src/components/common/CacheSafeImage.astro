---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	plainImgSrc,
	shouldOptimizeThroughVercelImage,
} from '@/lib/assets/vercel-image-policy';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	width: number;
	height: number;
	class?: string;
	loading?: 'eager' | 'lazy';
	decoding?: 'async' | 'auto' | 'sync';
	fetchpriority?: 'high' | 'low' | 'auto';
	sizes?: string;
	widths?: number[] | readonly number[];
	format?: 'avif' | 'jpeg' | 'jpg' | 'png' | 'svg' | 'webp';
	quality?: number;
}

const {
	src,
	alt,
	width,
	height,
	class: className,
	loading,
	decoding,
	fetchpriority,
	sizes,
	widths,
	format,
	quality,
} = Astro.props;

const optimize = shouldOptimizeThroughVercelImage(src);
---

{
	optimize ? (
		typeof src === 'string' ? (
			<Image
				src={src}
				alt={alt}
				width={width}
				height={height}
				class={className}
				loading={loading}
				decoding={decoding}
				fetchpriority={fetchpriority}
				format={format}
				quality={quality}
				{...widths ? { widths: widths as number[], sizes } : {}}
			/>
		) : widths && sizes ? (
			<Image
				src={src}
				alt={alt}
				widths={widths as number[]}
				sizes={sizes}
				class={className}
				loading={loading}
				decoding={decoding}
				fetchpriority={fetchpriority}
				format={format}
				quality={quality}
			/>
		) : (
			<Image
				src={src}
				alt={alt}
				width={width}
				height={height}
				class={className}
				loading={loading}
				decoding={decoding}
				fetchpriority={fetchpriority}
				format={format}
				quality={quality}
			/>
		)
	) : (
		<img
			src={plainImgSrc(src)}
			alt={alt}
			width={width}
			height={height}
			class={className}
			loading={loading}
			decoding={decoding}
			fetchpriority={fetchpriority}
		/>
	)
}
