---
import Icon from '@/components/common/icons/Icon.astro';
import { MonogramSealIcon } from './MonogramSeal';
import { WaxMonogramSealIcon } from './WaxMonogramSeal';
import {
	SEAL_ICON_MAP,
	isParametricSealIcon,
	type EnvelopeSealIcon,
} from '@/lib/invitation/reveal-card';

interface Props {
	sealIcon: EnvelopeSealIcon;
	sealInitials?: string;
	class?: string;
}

const { sealIcon, sealInitials, class: className } = Astro.props;
const sealIconName = SEAL_ICON_MAP[sealIcon];
const initials = sealInitials?.trim();
---

{
	sealIcon === 'wax-monogram' ? (
		<WaxMonogramSealIcon size={32} initials={initials} className={className} />
	) : isParametricSealIcon(sealIcon) && initials ? (
		<MonogramSealIcon size={32} initials={initials} className={className} />
	) : (
		<Icon name={sealIconName} class={className} />
	)
}
