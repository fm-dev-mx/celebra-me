---
// Deprecated filename retained as a thin compatibility wrapper for internal imports.
// The rendered implementation is repository-owned and deterministic.
import type { LocationMapStyle } from '@/lib/invitation/location-presentation';
import SchematicVenueMap from './SchematicVenueMap.astro';

interface Props {
	lat: number;
	lng: number;
	title?: string;
	address?: string;
	mapStyle?: LocationMapStyle;
}

const { lat, lng, title, address, mapStyle = 'minimal' } = Astro.props as Props;
---
<div data-map-preview="static"><SchematicVenueMap lat={lat} lng={lng} title={title} address={address} mapStyle={mapStyle} /></div>
