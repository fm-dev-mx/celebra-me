---
// Deprecated filename retained as a thin compatibility wrapper for internal imports.
// The shared renderer preserves the public Production map preview.
import type { LocationMapStyle } from '@/lib/invitation/location-presentation';
import StaticVenueMap from '@/components/invitation/components/StaticVenueMap.astro';

interface Props {
	lat: number;
	lng: number;
	zoom?: number;
	title?: string;
	address?: string;
	mapStyle?: LocationMapStyle;
}

const { lat, lng, zoom, title, address, mapStyle = 'minimal' } = Astro.props as Props;
---

<div data-map-preview="static">
	<StaticVenueMap lat={lat} lng={lng} zoom={zoom} title={title} address={address} mapStyle={mapStyle} />
</div>
