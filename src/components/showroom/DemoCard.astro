---
import OptimizedImage from '@components/common/OptimizedImage.astro';
import Icon from '@components/common/icons/Icon.astro';

import { getEventAsset } from '@/lib/assets/asset-registry';

import type { DemoShowroomItem } from '@/interfaces/ui/sections/demo-showroom.interface';

interface Props {
	item: DemoShowroomItem;
	isActive?: boolean;
	position?: number;
}

const { item, isActive = false, position = 1 } = Astro.props;
const selectorThumbnail = item.selectorThumbnail ?? item.thumbnail;
const thumbnail = getEventAsset(selectorThumbnail.assetSlug, selectorThumbnail.key);
const descriptor = item.styleTags.slice(0, 2).join(' · ');
---

{
	thumbnail && (
		<a
			class:list={['demo-style', { 'demo-style--active': isActive }]}
			href={item.href}
			aria-current={isActive ? 'true' : undefined}
			data-demo-rank={position}
			data-track-event="cta_clicked"
			data-track-section="demo_showroom_style_selector"
			data-track-cta="demo_style_selector"
			data-track-intent="demo"
			data-demo-slug={item.slug}
		>
			<span class="demo-style__media" aria-hidden="true">
				<OptimizedImage
					imagePath={thumbnail}
					alt=""
					width={220}
					height={164}
					class="demo-style__image"
					loading={position === 1 ? 'eager' : 'lazy'}
					decoding="async"
					fetchpriority={position === 1 ? 'high' : 'auto'}
					quality={78}
					widths={[140, 220, 320, 440]}
					sizes="(max-width: 767px) 5.25rem, 6rem"
				/>
			</span>
			<span class="demo-style__copy">
				<span class="demo-style__title">{item.title}</span>
				<span class="demo-style__descriptor">{descriptor}</span>
			</span>
			<Icon name="ArrowRight" class="demo-style__icon" />
		</a>
	)
}
