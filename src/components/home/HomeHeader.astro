---
/**
 * src/components/home/HomeHeader.astro
 *
 * Landing Page implementation of the Header.
 * Consumes HeaderBase and injects marketing content.
 */

import HeaderBase from '@/components/common/HeaderBase.astro';
import NavBarMobile from '@/components/ui/header/NavBarMobile.astro';
import Logo from '@/components/ui/Logo.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import { PRIMARY_CTA_TRUST_LINE } from '@/data/landing-page.data';
import '@styles/home/_home-header.scss';

interface Props {
    transparentOnHero?: boolean;
}

const { transparentOnHero = true } = Astro.props;

const navLinks = [
    { label: 'Demos', href: '/#tipo-evento' },
    { label: 'Planes', href: '/#pricing' },
    { label: 'Nosotros', href: '/#nosotros' },
];

const loginLink = '/login?next=%2Fdashboard%2Finvitados';
---

<HeaderBase
    transparentOnHero={transparentOnHero}
    headerId="home-header"
>

    <!-- SLOT: Logo -->
    <a href="/" slot="logo" class="home-header__logo-container" aria-label="Celebra-me Inicio">
        <Logo version="compacto" tone="oscuro" width={128} class="home-header__logo" />
    </a>

    <!-- SLOT: Desktop Nav -->
    <div slot="desktop-nav" class="home-header__desktop">
        <div class="home-nav">
            {navLinks.map(link => (
                <a href={link.href} class="home-nav__link">{link.label}</a>
            ))}
        </div>

        <div class="home-nav-actions">
            <a href={loginLink} class="home-nav-actions__login">
                Iniciar sesión
            </a>
            <div class="home-nav-actions__cta-group">
                <WhatsAppButton
                    className="home-nav-actions__cta"
                    trackSection="header"
                    trackCta="whatsapp-header"
                    campaignSection="HEADER"
                />
                <span class="home-nav-actions__trust">{PRIMARY_CTA_TRUST_LINE}</span>
            </div>
        </div>
    </div>

    <div slot="mobile-nav-premium">
        <NavBarMobile
            links={navLinks}
            headerId="home-header"
            loginLink={loginLink}
            loginLabel="Iniciar sesión"
        >
            <div slot="cta" class="mobile-nav-actions__cta-group">
                <WhatsAppButton
                    className="mobile-nav-actions__cta"
                    trackSection="header"
                    trackCta="whatsapp-header-menu"
                    campaignSection="HEADER"
                />
                <span class="mobile-nav-actions__trust">{PRIMARY_CTA_TRUST_LINE}</span>
            </div>
        </NavBarMobile>
    </div>

</HeaderBase>
