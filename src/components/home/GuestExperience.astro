---
// src/components/home/GuestExperience.astro
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.tsx';
import type { GuestExperienceData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

// Import stylesheet
import '@/styles/home/_guest-experience.scss';

interface Props {
	data: GuestExperienceData;
}

const { data } = Astro.props;
const phone = getContactPhone();

// Render title with intentional line break after first sentence
const titleHtml = data.title.replace('. ', '.<br>');
---

<Section id="experiencia-invitados" class="guest-experience" data-screenshot="landing-guest-experience">
	<div class="guest-experience__bg-overlay"></div>

	<Container class="guest-experience__container">
		<div class="guest-experience__grid">
			{/* Visual — product composition: WhatsApp cue + invitation + pass */}
			<div
				class="guest-experience__visual animate-on-scroll"
				data-delay="100ms"
			>
				<div class="guest-experience__scene">
					{/* WhatsApp chat bubble (tier 1 — small contextual cue) */}
					<div class="guest-experience__chat-bubble" aria-hidden="true">
						<p class="guest-experience__chat-text">📨 Te compartimos tu invitación</p>
						<span class="guest-experience__chat-time">10:28 a.m.</span>
					</div>

					{/* Invitation card (tier 2 — supporting background layer) */}
					<div class="guest-experience__invitation-card" aria-hidden="true">
						<span class="guest-experience__invitation-eyebrow">Celebra·me</span>
						<p class="guest-experience__invitation-names">Ana &amp; Luis</p>
						<p class="guest-experience__invitation-date">22 de noviembre · 5:00 p.m.</p>
					</div>

					{/* Access pass (tier 3 — primary focal point) */}
					<div class="guest-experience__pass-card" aria-hidden="true">
						<div class="guest-experience__pass-body">
							<span class="guest-experience__pass-label">Invitado</span>
							<span class="guest-experience__pass-type">Familia</span>
							<span class="guest-experience__pass-guest">Mariana López</span>
							<div class="guest-experience__pass-spots">
								<span class="guest-experience__pass-spot-count">2</span>
								<span class="guest-experience__pass-spot-label">lugares<br/>reservados</span>
							</div>
							<span class="guest-experience__pass-badge">Acceso personal</span>
						</div>
					</div>
				</div>
			</div>

			{/* Header — eyebrow + title */}
			<header
				class="guest-experience__header animate-on-scroll"
				data-delay="200ms"
			>
				{data.eyebrow && (
					<p class="guest-experience__eyebrow">{data.eyebrow}</p>
				)}
				<h2 class="guest-experience__title" set:html={titleHtml}></h2>
			</header>

			{/* Description */}
			<p
				class="guest-experience__description animate-on-scroll"
				data-delay="300ms"
			>
				{data.description}
			</p>

			{/* Numbered editorial value points */}
			<div class="guest-experience__values">
				{data.values.map((value, i) => (
					<div
						class="guest-experience__value-item animate-on-scroll"
						data-delay={`${420 + i * 120}ms`}
					>
						<span class="guest-experience__value-number">{String(i + 1).padStart(2, '0')}</span>
						<div class="guest-experience__value-body">
							<span class="guest-experience__value-name">{value.name}</span>
							<span class="guest-experience__value-desc">{value.description}</span>
						</div>
					</div>
				))}
			</div>

			{/* Closing line */}
			{data.closingLine && (
				<p class="guest-experience__closing-line animate-on-scroll" data-delay="500ms">
					{data.closingLine}
				</p>
			)}

			{/* CTA */}
			<div
				class="guest-experience__actions animate-on-scroll"
				data-delay="560ms"
			>
				<WhatsAppButton
					phone={phone}
					message={data.cta.message}
					label={data.cta.label}
				/>
			</div>
		</div>
	</Container>
</Section>
<script>
	import { createIntersectionObserver } from '@/utils/animations';

	const section = document.querySelector('.guest-experience');
	const shouldReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll('.animate-on-scroll').forEach((element) => {
		if (element instanceof HTMLElement && element.dataset.delay) {
			element.style.setProperty('--animation-delay', element.dataset.delay);
		}
	});

	if (section instanceof HTMLElement && !shouldReduceMotion) {
		section.classList.add('guest-experience--motion-ready');

		createIntersectionObserver(
			'.guest-experience--motion-ready .animate-on-scroll',
			(target) => target.classList.add('is-visible'),
			{ rootMargin: '-5% 0px', threshold: 0.15 },
		);
	}
</script>
