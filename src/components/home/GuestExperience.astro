---
// src/components/home/GuestExperience.astro
import { Image } from 'astro:assets';
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import type { GuestExperienceData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

// Real screens from the XV Celestial Blue demo (fictitious guest): the personalized pass a guest
// sees and the RSVP choice that follows it.
import guestPassScreen from '@/assets/images/showroom/guest-pass-screen.webp';
import guestRsvpCard from '@/assets/images/showroom/guest-rsvp-card.webp';

import '@/styles/home/_guest-experience.scss';

interface Props {
	data: GuestExperienceData;
}

const { data } = Astro.props;
const phone = getContactPhone();
---

<Section
	id="experiencia-invitados"
	class="guest-experience"
	data-track-section="guest-experience"
	data-screenshot="landing-guest-experience"
	aria-labelledby="guest-experience-title"
>
	<Container class="guest-experience__container">
		<header class="guest-experience__header">
			{data.eyebrow && <p class="guest-experience__eyebrow reveal-fade-up stagger-1">{data.eyebrow}</p>}
			<h2 id="guest-experience-title" class="guest-experience__title reveal-fade-up stagger-2">{data.title}</h2>
			<p class="guest-experience__description reveal-fade-up stagger-3">{data.description}</p>
		</header>

		<figure class="guest-experience__visual reveal-fade-up stagger-3">
			<div class="landing-phone">
				<div class="landing-phone__screen">
					<Image
						src={guestPassScreen}
						alt="Pase personalizado en una invitación demo: nombre del invitado y cuatro lugares reservados"
						class="landing-phone__image"
						widths={[280, 560, 780]}
						sizes="(max-width: 767px) 13.5rem, 17.5rem"
						quality={78}
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
			<Image
				src={guestRsvpCard}
				alt="Confirmación de asistencia en la invitación: Sí, asistiré o No podré asistir"
				class="guest-experience__rsvp"
				widths={[260, 520]}
				sizes="(max-width: 767px) 58vw, 16rem"
				quality={80}
				loading="lazy"
				decoding="async"
			/>
		</figure>

		<div class="guest-experience__body">
			<ul class="guest-experience__values reveal-fade-up stagger-4" role="list">
				{data.values.map((value) => (
					<li class="guest-experience__value-item">
						<strong class="guest-experience__value-name">{value.name}</strong>
						<span class="guest-experience__value-desc">{value.description}</span>
					</li>
				))}
			</ul>

			{data.closingLine && <p class="guest-experience__closing-line">{data.closingLine}</p>}

			<WhatsAppButton
				className="guest-experience__cta"
				phone={phone}
				message={data.cta.message}
				label={data.cta.label}
				trackSection="guest-experience"
				trackCta="whatsapp-guest-experience"
				campaignSection="GUESTS"
			/>
		</div>
	</Container>
</Section>
