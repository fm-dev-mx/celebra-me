---
import FAQList from '@components/ui/FAQList.astro';

import type { FAQData } from '@/interfaces/ui/sections/landing-page.interface';

interface Props {
	data: FAQData;
}

const { data } = Astro.props;
---

<!-- FAQ Section -->
<section id="faq-section" class="faq-section" data-screenshot="landing-faq">
	<div class="container">
		<header class="faq-header">
			{data.pretitle && <span class="faq-pretitle reveal-fade-up stagger-1">{data.pretitle}</span>}
			<h2 class="faq-title reveal-fade-up stagger-2">{data.title}</h2>
			{data.subtitle && <p class="faq-subtitle reveal-fade-up stagger-3">{data.subtitle}</p>}
		</header>

		<div class="reveal-fade-up stagger-3">
			<FAQList faqs={data.faqs} />
		</div>
	</div>
</section>
