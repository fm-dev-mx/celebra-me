---
import ActionIcon from '@components/common/actions/ActionIcon.astro';
import FAQList from '@components/ui/FAQList.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';

import type { FAQData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

interface Props {
	data: FAQData;
}

// Destructure the data prop
const { data } = Astro.props;
const phone = getContactPhone();
---

<!-- FAQ Section -->
<section id="faq-section" class="faq-section" data-screenshot="landing-faq">
	<div class="faq-noise"></div>

	<div class="container">
		<header class="faq-header">
			<span class="faq-pretitle">Claridad en cada detalle</span>
			<h2 class="faq-title">{data.title}</h2>
			<p class="faq-subtitle">
				Resolvemos sus dudas para que pueda concentrarse en lo más importante: su celebración.
			</p>
		</header>

		<FAQList faqs={data.faqs} />

		<div class="faq-cta">
			<p class="faq-cta__eyebrow">Asesoría directa</p>
			<h3 class="faq-cta__title">¿Prefiere resolverlo directamente?</h3>
			<p class="faq-cta__text">
				Le ayudamos por WhatsApp a elegir el nivel adecuado según su evento, cantidad de invitados y estilo visual.
			</p>
			<WhatsAppButton
				className="faq-cta__button"
				phone={phone}
				message="Hola, quiero hacer válida la promo de lanzamiento de mi invitación digital premium.\n\nCupón: LANZAMIENTO-899"
				label="Hablar por WhatsApp"
				trackSection="faq"
				trackCta="whatsapp-faq"
				trackCampaign="FINAL-LANZAMIENTO-899"
				trackValue={899}
				trackCurrency="MXN"
				promoCode="LANZAMIENTO-899"
				ariaLabel="Hablar por WhatsApp"
			/>
		</div>

		<!-- Scroll Action to return to contact section -->
		<div class="faq-footer">
			<ActionIcon
				icon="ArrowDownIcon"
				variant="scroll"
				href="#contacto"
				color="primary"
				title="Ir a sección de Contacto"
			/>
		</div>
	</div>
</section>
