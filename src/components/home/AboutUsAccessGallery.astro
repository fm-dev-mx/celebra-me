---
// src/components/home/AboutUsAccessGallery.astro
//
// A compact editorial flat-lay of 3 stacked access cards for the About Us section.
// Uses Celebra-me's existing visual language with cream/card tones and gold accents.
---

<div class="access-gallery">
	<!-- Behind card — warm rose accent (XV / Enchanted Rose palette) -->
	<div class="access-gallery__card access-gallery__card--behind-behind">
		<div class="access-gallery__card-body">
			<div class="access-gallery__ornament-tl"></div>
			<div class="access-gallery__ornament-br"></div>
			<div class="access-gallery__seal-silhouette">
				<svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M50 15C55 35 75 50 90 50C75 50 55 65 50 85C45 65 25 50 10 50C25 50 45 35 50 15Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round" opacity="0.3"/>
					<circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="0.4" stroke-dasharray="1 3" opacity="0.2"/>
				</svg>
			</div>
		</div>
	</div>

	<!-- Behind card — gold/champagne accent (Wedding / Jewelry Box palette) -->
	<div class="access-gallery__card access-gallery__card--behind">
		<div class="access-gallery__card-body">
			<div class="access-gallery__ornament-tl"></div>
			<div class="access-gallery__ornament-br"></div>
			<div class="access-gallery__seal-silhouette">
				<svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M50 15C55 35 75 50 90 50C75 50 55 65 50 85C45 65 25 50 10 50C25 50 45 35 50 15Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round" opacity="0.3"/>
					<circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="0.4" stroke-dasharray="1 3" opacity="0.2"/>
				</svg>
			</div>
		</div>
	</div>

	<!-- Front card — main premium access card -->
	<div class="access-gallery__card access-gallery__card--front">
		<div class="access-gallery__card-body">
			<!-- Corner ornaments -->
			<div class="access-gallery__ornament-tl"></div>
			<div class="access-gallery__ornament-tr"></div>
			<div class="access-gallery__ornament-bl"></div>
			<div class="access-gallery__ornament-br"></div>

			<!-- Seal icon -->
			<div class="access-gallery__seal" aria-hidden="true">
				<svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M50 15C55 35 75 50 90 50C75 50 55 65 50 85C45 65 25 50 10 50C25 50 45 35 50 15Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
					<path d="M50 35C52 42 58 48 65 50C58 52 52 58 50 65C48 58 42 52 35 50C42 48 48 42 50 35Z" fill="currentColor" opacity="0.25"/>
					<circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="0.5" stroke-dasharray="1 3" opacity="0.3"/>
					<circle cx="50" cy="50" r="2" fill="currentColor"/>
				</svg>
			</div>

			<!-- Header -->
			<header class="access-gallery__header">
				<span class="access-gallery__eyebrow">Pase de acceso</span>
			</header>

			<!-- Guest name -->
			<div class="access-gallery__guest-section">
				<span class="access-gallery__label">Invitado</span>
				<strong class="access-gallery__guest">Tus invitados</strong>
			</div>

			<!-- Divider -->
			<div class="access-gallery__divider" aria-hidden="true"></div>

			<!-- Seats badge -->
			<div class="access-gallery__quota">
				<span class="access-gallery__label">Lugares reservados</span>
				<div class="access-gallery__count-frame">
					<span class="access-gallery__count">8</span>
				</div>
			</div>

			<!-- Tagline -->
			<p class="access-gallery__tagline">Acceso personalizado</p>
		</div>
	</div>
</div>

<style lang="scss">
// ---------------------------------------------------------------------------
// About Us Access Gallery — editorial card stack for the landing visual
// ---------------------------------------------------------------------------

.access-gallery {
	position: relative;
	width: 100%;
	height: 100%;
	min-height: 380px;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 2rem 1.5rem;

	// --------------- Shared card base ---------------

	&__card {
		position: absolute;
		width: min(72%, 340px);
		aspect-ratio: 3 / 4;
		border-radius: 0.875rem;
		overflow: hidden;
		transition: transform 0.6s var(--about-ease-slow, ease);

		// Cream/card body with warm tone
		background: linear-gradient(
			165deg,
			rgb(253 250 245) 0%,
			rgb(248 243 235) 50%,
			rgb(240 234 224) 100%
		);
		box-shadow:
			0 2px 8px rgb(0 0 0 / 6%),
			0 8px 24px rgb(0 0 0 / 10%);
	}

	&__card-body {
		position: relative;
		width: 100%;
		height: 100%;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		overflow: hidden;

		// Subtle inner border via pseudo-element
		&::before {
			content: '';
			position: absolute;
			inset: 0.625rem;
			border: 1px solid rgb(var(--color-action-accent-rgb) / 14%);
			border-radius: 0.625rem;
			pointer-events: none;
			z-index: 0;
		}
	}

	// --------------- Behind cards (decorative layers) ---------------

	&__card--behind-behind {
		transform: translateX(14%) translateY(-8%) rotate(2.5deg);
		z-index: 0;
		filter: brightness(0.96) saturate(0.8);

		.access-gallery__card-body {
			background: linear-gradient(
				165deg,
				rgb(250 240 235) 0%,
				rgb(242 230 222) 50%,
				rgb(230 218 208) 100%
			);
		}

		.access-gallery__ornament-tl,
		.access-gallery__ornament-br {
			border-color: rgb(180 120 110 / 30%);
		}

		.access-gallery__seal-silhouette {
			color: rgb(180 120 110 / 20%);
		}
	}

	&__card--behind {
		transform: translateX(-14%) translateY(-4%) rotate(-2.5deg);
		z-index: 1;
		filter: brightness(0.98) saturate(0.85);

		.access-gallery__card-body {
			background: linear-gradient(
				165deg,
				rgb(248 245 238) 0%,
				rgb(242 237 226) 50%,
				rgb(233 226 212) 100%
			);
		}

		.access-gallery__ornament-tl,
		.access-gallery__ornament-br {
			border-color: rgb(200 170 110 / 30%);
		}

		.access-gallery__seal-silhouette {
			color: rgb(200 170 110 / 20%);
		}
	}

	// --------------- Front card (main premium card) ---------------

	&__card--front {
		z-index: 2;
		transform: translateY(0) rotate(0deg);
		box-shadow:
			0 4px 12px rgb(0 0 0 / 8%),
			0 12px 40px -8px rgb(0 0 0 / 14%),
			0 0 0 1px rgb(var(--color-action-accent-rgb) / 8%);
	}

	// --------------- Corner ornaments ---------------

	&__ornament-tl,
	&__ornament-tr,
	&__ornament-bl,
	&__ornament-br {
		position: absolute;
		width: 1.25rem;
		height: 1.25rem;
		border-color: rgb(var(--color-action-accent-rgb) / 35%);
		z-index: 2;
		pointer-events: none;

		&::before {
			content: '';
			position: absolute;
			width: 0.25rem;
			height: 0.25rem;
			background: currentcolor;
			border-radius: 50%;
			box-shadow: 0 0 4px var(--color-action-accent);
		}
	}

	&__ornament-tl {
		top: 1rem;
		left: 1rem;
		border-top: 1.5px solid;
		border-left: 1.5px solid;
		&::before { top: -2px; left: -2px; }
	}

	&__ornament-tr {
		top: 1rem;
		right: 1rem;
		border-top: 1.5px solid;
		border-right: 1.5px solid;
		&::before { top: -2px; right: -2px; }
	}

	&__ornament-bl {
		bottom: 1rem;
		left: 1rem;
		border-bottom: 1.5px solid;
		border-left: 1.5px solid;
		&::before { bottom: -2px; left: -2px; }
	}

	&__ornament-br {
		bottom: 1rem;
		right: 1rem;
		border-bottom: 1.5px solid;
		border-right: 1.5px solid;
		&::before { bottom: -2px; right: -2px; }
	}

	// --------------- Seal (front card only) ---------------

	&__seal-silhouette {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 5rem;
		aspect-ratio: 1;
		pointer-events: none;
		z-index: 0;
	}

	&__seal {
		width: 2.8rem;
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		color: rgb(var(--color-action-accent-rgb) / 60%);
		margin-bottom: 0.5rem;

		&::before {
			content: '';
			position: absolute;
			inset: 0;
			border-radius: 50%;
			background: rgb(var(--color-action-accent-rgb) / 6%);
		}

		svg {
			width: 100%;
			height: 100%;
		}
	}

	// --------------- Header (front card) ---------------

	&__header {
		text-align: center;
		position: relative;
		z-index: 1;
	}

	&__eyebrow {
		display: inline-block;
		font-family: var(--font-body, serif);
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgb(var(--color-action-accent-rgb) / 55%);
	}

	// --------------- Guest name (front card) ---------------

	&__guest-section {
		text-align: center;
		position: relative;
		z-index: 1;
		display: grid;
		gap: 0.3rem;
		padding: 0.25rem 1.5rem;
	}

	&__label {
		font-family: var(--font-body, serif);
		font-size: 0.55rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgb(var(--color-action-accent-rgb) / 40%);
	}

	&__guest {
		display: block;
		font-family: var(--font-display, serif);
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 500;
		line-height: 1;
		color: var(--color-text-primary, #1a1a1a);
		letter-spacing: 0.02em;
	}

	// --------------- Divider ---------------

	&__divider {
		position: relative;
		width: 55%;
		height: 1px;
		margin: 0.65rem 0;
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgb(var(--color-action-accent-rgb) / 20%) 20%,
			rgb(var(--color-action-accent-rgb) / 20%) 80%,
			transparent 100%
		);
		z-index: 1;

		&::after {
			content: '';
			position: absolute;
			top: 50%;
			left: 50%;
			width: 0.4rem;
			height: 0.4rem;
			transform: translate(-50%, -50%) rotate(45deg);
			background: rgb(248 243 235);
			border: 1px solid rgb(var(--color-action-accent-rgb) / 20%);
			box-shadow: 0 0 0 0.15rem rgb(248 243 235);
		}
	}

	// --------------- Seats badge ---------------

	&__quota {
		text-align: center;
		display: grid;
		gap: 0.35rem;
		position: relative;
		z-index: 1;
	}

	&__count-frame {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 5.5rem;
		padding: 0.4rem 1rem 0.5rem;
		border-radius: 0.625rem;
		border: 1px solid rgb(var(--color-action-accent-rgb) / 18%);
		background: linear-gradient(
			180deg,
			rgb(255 255 255 / 55%),
			rgb(255 255 255 / 18%)
		);
		box-shadow: 0 1px 4px rgb(0 0 0 / 4%);
	}

	&__count {
		font-family: var(--font-display, serif);
		font-size: clamp(2rem, 4.5vw, 2.8rem);
		font-weight: 500;
		line-height: 0.9;
		color: var(--color-text-primary, #1a1a1a);
	}

	// --------------- Tagline (front card) ---------------

	&__tagline {
		margin: 0;
		padding-top: 0.5rem;
		font-family: var(--font-body, serif);
		font-size: 0.6rem;
		font-style: italic;
		color: rgb(var(--color-action-accent-rgb) / 40%);
		letter-spacing: 0.04em;
		position: relative;
		z-index: 1;
	}

	// --------------- Responsive ---------------

	@media (width <= 767px) {
		min-height: 300px;
		padding: 1.5rem 0.75rem;

		&__card {
			width: min(78%, 280px);
		}

		&__card--behind-behind {
			transform: translateX(12%) translateY(-6%) rotate(2deg);
		}

		&__card--behind {
			transform: translateX(-12%) translateY(-3%) rotate(-2deg);
		}

		&__guest {
			font-size: clamp(1.3rem, 5vw, 1.6rem);
		}

		&__count {
			font-size: clamp(1.8rem, 6vw, 2.2rem);
		}

		&__count-frame {
			min-width: 4.5rem;
			padding: 0.3rem 0.75rem 0.4rem;
		}

		&__seal {
			width: 2.2rem;
		}
	}

	@media (width >= 768px) and (width <= 1024px) {
		&__card {
			width: min(68%, 300px);
		}

		&__guest {
			font-size: clamp(1.4rem, 3.5vw, 1.8rem);
		}

		&__count {
			font-size: clamp(1.8rem, 4.5vw, 2.4rem);
		}
	}
}
</style>
