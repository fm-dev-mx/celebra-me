---
// src/components/home/Testimonials.astro
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import TestimonialsGrid from '@components/home/TestimonialsGrid.astro';

import type { TestimonialsData } from '@/interfaces/ui/sections/landing-page.interface';

import '@/styles/home/_testimonials.scss';

interface Props {
	data: TestimonialsData;
}

const { data } = Astro.props;
---

<Section
	id="testimonios"
	class="testimonials-section"
	fullWidth={true}
	data-screenshot="landing-testimonials"
>
	<Container class="w-full">
		<TestimonialsGrid {...data} />
	</Container>
</Section>
