---
/**
 * src/components/home/Hero.astro
 * Hero "Prime" Component
 */
import ActionBase from '@components/common/actions/ActionBase.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import type { HeroData } from '@/interfaces/ui/sections/landing-page.interface';

import heroBrideDesktop from '@/assets/images/hero/hero-bride-desktop.webp';
import heroBrideMobile from '@/assets/images/hero/hero-bride-mobile.webp';
import heroQuinceaneraDesktop from '@/assets/images/hero/hero-quinceanera-desktop.webp';
import heroQuinceaneraMobile from '@/assets/images/hero/hero-quinceanera-mobile.webp';
import heroDetailDesktop from '@/assets/images/hero/hero-detail-desktop.webp';
import heroDetailMobile from '@/assets/images/hero/hero-detail-mobile.webp';
import heroFamilyDesktop from '@/assets/images/hero/hero-family-desktop.webp';
import heroFamilyMobile from '@/assets/images/hero/hero-family-mobile.webp';

import '@/styles/components/_hero.scss';

interface Props {
	data: HeroData;
}

const { data } = Astro.props;

const heroImages = [
	{ desktop: heroBrideDesktop, mobile: heroBrideMobile },
	{ desktop: heroQuinceaneraDesktop, mobile: heroQuinceaneraMobile },
	{ desktop: heroDetailDesktop, mobile: heroDetailMobile },
	{ desktop: heroFamilyDesktop, mobile: heroFamilyMobile },
];
---

<section class="hero-prime" id="inicio" role="region" aria-labelledby="hero-title" data-track-section="hero" data-screenshot="landing-hero">
	<div class="hero-prime__bg" aria-hidden="true">
		{
			heroImages.map((image, index) => (
				<picture
					class={`hero-prime__bg-picture${index === 0 ? ' hero-prime__bg-picture--active' : ''}`}
					data-hero-bg={index}
				>
					<source media="(min-width: 768px)" srcset={image.desktop.src} width={image.desktop.width} height={image.desktop.height} />
					<img
						src={image.mobile.src}
						alt=""
						width={image.mobile.width}
						height={image.mobile.height}
						loading={index === 0 ? 'eager' : 'lazy'}
						decoding={index === 0 ? 'sync' : 'async'}
						fetchpriority={index === 0 ? 'high' : 'auto'}
					/>
				</picture>
			))
		}
	</div>

	<div class="hero-prime__overlay" aria-hidden="true"></div>

	<div class="hero-prime__content">
		<div class="hero-prime__left">
			<p class="hero-prime__eyebrow stagger-1">Invitaciones digitales premium</p>

			<h1 class="hero-prime__title stagger-2" id="hero-title">
				<span class="hero-prime__copy-desktop">{data.title}</span>
				<span class="hero-prime__copy-mobile">{data.mobileTitle ?? data.title}</span>
			</h1>

			<p class="hero-prime__subtitle stagger-3">
				<span class="hero-prime__copy-desktop">{data.subtitle}</span>
				<span class="hero-prime__copy-mobile">{data.mobileSubtitle ?? data.subtitle}</span>
			</p>

			<div class="hero-prime__actions stagger-4">
				<WhatsAppButton
					phone={data.whatsappPhone}
					message={data.whatsappMessage}
					label={data.primaryCtaLabel}
					trackSection="hero"
					trackCta="whatsapp-hero"
					trackCampaign="HERO-LANZAMIENTO-899"
					trackValue={899}
					trackCurrency="MXN"
					promoCode="LANZAMIENTO-899"
					ariaLabel="Cotizar por WhatsApp"
				/>
				<ActionBase
					as="a"
					href={data.secondaryCtaUrl || '#tipo-evento'}
					variant="text"
					color="white"
					class="hero-prime__secondary-action"
					data-track-event="cta_clicked"
					data-track-section="hero"
					data-track-cta="hero_secondary"
					data-track-label={data.secondaryCtaLabel}
					data-track-intent="section_nav"
					data-track-destination="event-types"
					data-campaign-code="DEMO-LANZAMIENTO-899"
					data-promo-code="LANZAMIENTO-899"
					data-track-value="899"
					data-track-currency="MXN"
				>
					{data.secondaryCtaLabel}
				</ActionBase>
			</div>

			<p class="hero-prime__proof-line stagger-5">RSVP · pases digitales · invitados organizados</p>
		</div>
	</div>
</section>

<script>
	/**
	 * Hero background crossfade — subtle autoplay rotation
	 * through event photography images.
	 * Respects prefers-reduced-motion; no user interaction needed.
	 */
	const initHeroBgRotation = () => {
		const hero = document.getElementById('inicio');
		if (!(hero instanceof HTMLElement)) return;

		const pictures = hero.querySelectorAll<HTMLElement>('.hero-prime__bg-picture[data-hero-bg]');
		if (pictures.length < 2) return;

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let intervalId = 0;
		let currentIndex = 0;
		const controller = new AbortController();

		const advance = () => {
			pictures.forEach((pic, i) => {
				pic.classList.toggle('hero-prime__bg-picture--active', i === currentIndex);
			});
			currentIndex = (currentIndex + 1) % pictures.length;
		};

		const start = () => {
			stop();
			if (prefersReducedMotion.matches) {
				// Show first image only, no rotation
				pictures.forEach((pic, i) => {
					pic.classList.toggle('hero-prime__bg-picture--active', i === 0);
				});
				currentIndex = 0;
				return;
			}
			// Ensure first frame is visible.
			pictures[0].classList.add('hero-prime__bg-picture--active');
			currentIndex = 1;
			intervalId = window.setInterval(advance, 8000);
		};

		const stop = () => {
			if (intervalId) {
				clearInterval(intervalId);
				intervalId = 0;
			}
		};

		prefersReducedMotion.addEventListener('change', start, { signal: controller.signal });

		// Delay start slightly to not compete with initial paint
		requestAnimationFrame(() => requestAnimationFrame(start));
	};

	initHeroBgRotation();
</script>
