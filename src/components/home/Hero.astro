---
/**
 * src/components/home/Hero.astro
 * Hero "Prime" Component
 */
import ActionBase from '@/components/common/actions/ActionBase.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import type { HeroData } from '@/interfaces/ui/sections/landing-page.interface';
import {
	buildCampaignCode,
	formatMxn,
	getGeneralPromoCode,
	getStartingPrice,
	getRenderCampaign,
	getStartingRegularPrice,
	PROMO_CURRENCY,
} from '@/data/promo-campaign.data';

// One static, event-neutral image: a laid table with a place card, the "pass for every guest".
import heroDesktop from '@/assets/images/hero/hero-detail-desktop.webp';
import heroMobile from '@/assets/images/hero/hero-detail-mobile.webp';

import '@/styles/components/_hero.scss';

interface Props {
	data: HeroData;
}

const { data } = Astro.props;
// Built with the campaign of the build day; PromoStatus.astro switches it for the visitor's date.
const campaign = getRenderCampaign();

---

<section class="hero-prime" id="inicio" role="region" aria-labelledby="hero-title" data-track-section="hero" data-screenshot="landing-hero">
	<div class="hero-prime__bg" aria-hidden="true">
		<picture>
			<source media="(min-width: 768px)" srcset={heroDesktop.src} width={heroDesktop.width} height={heroDesktop.height} />
			<img
				src={heroMobile.src}
				alt=""
				width={heroMobile.width}
				height={heroMobile.height}
				loading="eager"
				decoding="sync"
				fetchpriority="high"
			/>
		</picture>
	</div>

	<div class="hero-prime__overlay" aria-hidden="true"></div>

	<div class="hero-prime__content">
		<div class="hero-prime__left">
			{data.eyebrow && <p class="hero-prime__eyebrow stagger-1">{data.eyebrow}</p>}

			<h1 class="hero-prime__title stagger-2" id="hero-title">
				<span class="hero-prime__copy-desktop">{data.title}</span>
				<span class="hero-prime__copy-mobile">{data.mobileTitle ?? data.title}</span>
			</h1>

			<p class="hero-prime__subtitle stagger-3">
				<span class="hero-prime__copy-desktop">{data.subtitle}</span>
				<span class="hero-prime__copy-mobile">{data.mobileSubtitle ?? data.subtitle}</span>{' '}
				<span class="hero-prime__price-line">
					{data.priceLine.prefix}{' '}
					{campaign && <span data-promo-only data-promo-field="starting-price">{formatMxn(getStartingPrice(campaign))}</span>}<span data-promo-fallback={campaign ? '' : undefined}>{formatMxn(getStartingRegularPrice())}</span>{' '}
					{data.priceLine.suffix}
				</span>
			</p>

			<div class="hero-prime__actions stagger-4">
				<WhatsAppButton
					label={data.primaryCtaLabel}
					trackSection="hero"
					trackCta="whatsapp-hero"
					campaignSection="HERO"
				/>
				<p class="hero-prime__trust-line">{data.primaryCtaTrustLine}</p>
				<p class="hero-prime__payment-note">{data.paymentNote}</p>
				<ActionBase
					as="a"
					href={data.secondaryCtaUrl || '#tipo-evento'}
					variant="text"
					color="white"
					class="hero-prime__secondary-action"
					data-track-event="cta_clicked"
					data-track-section="hero"
					data-track-cta="hero_secondary"
					data-track-label={data.secondaryCtaLabel}
					data-track-intent="demo_showroom"
					data-track-destination="demo"
					data-demo-slug={data.secondaryCtaDemoSlug}
					data-campaign-code={buildCampaignCode('DEMO', getGeneralPromoCode(campaign))}
					data-promo-code={getGeneralPromoCode(campaign) ?? undefined}
					data-track-value={getStartingPrice(campaign)}
					data-track-currency={PROMO_CURRENCY}
					data-promo-quote="general"
					data-campaign-section="DEMO"
				>
					{data.secondaryCtaLabel}
				</ActionBase>
			</div>

			{data.proofLine && <p class="hero-prime__proof-line stagger-5">{data.proofLine}</p>}
		</div>
	</div>
</section>
