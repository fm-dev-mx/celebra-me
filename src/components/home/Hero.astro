---
/**
 * src/components/home/Hero.astro
 * Landing hero: promise, price, WhatsApp CTA, event chips and a fan of three demo phones. Chips and
 * phones are links to the showroom (`#<event>`); the showroom script selects the event or demo.
 */
import { Image } from 'astro:assets';
import Icon from '@/components/common/icons/Icon.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import type { HeroData } from '@/interfaces/ui/sections/landing-page.interface';
import type { VitrinaDemo, VitrinaEvent } from '@/data/landing-vitrina.data';
import {
	formatMxn,
	getStartingPrice,
	getRenderCampaign,
	getStartingRegularPrice,
} from '@/data/promo-campaign.data';
import { getEventAsset } from '@/lib/assets/asset-registry';

import '@/styles/home/_landing-hero.scss';

interface Props {
	data: HeroData;
	events: readonly VitrinaEvent[];
	/** Left, right and center phones; the center one is the largest and loads first. */
	fan: readonly VitrinaDemo[];
}

const { data, events, fan } = Astro.props;
// Built with the campaign of the build day; PromoStatus.astro switches it for the visitor's date.
const campaign = getRenderCampaign();

const [titleLead, titleTail] =
	data.titleEmphasis && data.title.includes(data.titleEmphasis)
		? data.title.split(data.titleEmphasis)
		: [data.title, undefined];

const fanPhones = fan.map((demo, index) => ({
	demo,
	image: getEventAsset(demo.slug, demo.cover),
	isCenter: index === fan.length - 1,
}));
---

<section
	class="hero-prime"
	id="inicio"
	role="region"
	aria-labelledby="hero-title"
	data-track-section="hero"
	data-screenshot="landing-hero"
>
	<div class="hero-prime__content">
		<div class="hero-prime__left">
			{data.eyebrow && <p class="hero-prime__eyebrow">{data.eyebrow}</p>}

			<h1 class="hero-prime__title" id="hero-title">
				{titleLead}{titleTail !== undefined && <em>{data.titleEmphasis}</em>}{titleTail}
			</h1>

			<p class="hero-prime__subtitle">
				<span class="hero-prime__copy-desktop">{data.subtitle}</span>
				<span class="hero-prime__copy-mobile">{data.mobileSubtitle ?? data.subtitle}</span>
			</p>

			<p class="hero-prime__price-line">
				{data.priceLine.prefix}{' '}
				<strong>
					{campaign && <span data-promo-only data-promo-field="starting-price">{formatMxn(getStartingPrice(campaign))}</span>}<span data-promo-fallback={campaign ? '' : undefined}>{formatMxn(getStartingRegularPrice())}</span>
				</strong>{' '}
				{data.priceLine.suffix}
			</p>

			<div class="hero-prime__actions">
				<WhatsAppButton
					label={data.primaryCtaLabel}
					trackSection="hero"
					trackCta="whatsapp-hero"
					campaignSection="HERO"
				/>
				<p class="hero-prime__trust-line">{data.primaryCtaTrustLine}</p>
				<p class="hero-prime__payment-note">{data.paymentNote}</p>
			</div>

			<nav class="hero-prime__events" aria-labelledby="hero-events-label">
				<span class="hero-prime__events-label" id="hero-events-label">{data.eventsLabel}</span>
				<div class="hero-prime__chips">
					{
						events.map((event) => (
							<a
								class="hero-prime__chip"
								href={`#${event.publicSlug}`}
								data-vitrina-event={event.publicSlug}
								data-track-event="cta_clicked"
								data-track-section="hero"
								data-track-cta="hero_event_chip"
								data-track-label={event.label}
								data-track-intent="demo_showroom"
								data-track-destination="demo"
								data-event-type={event.eventType}
							>
								<Icon name={event.icon} size={18} />
								{event.label}
								<small>
									{event.demos.length}
									<span class="sr-only">{event.demos.length === 1 ? 'estilo' : 'estilos'}</span>
								</small>
							</a>
						))
					}
				</div>
			</nav>
		</div>

		<div class="hero-prime__fan">
			{
				fanPhones.map(({ demo, image, isCenter }) =>
					image ? (
						<a
							class:list={['hero-prime__phone', { 'hero-prime__phone--center': isCenter }]}
							href={`#${demo.publicSlug}`}
							data-vitrina-event={demo.publicSlug}
							data-vitrina-pick={demo.slug}
							aria-label={`Ver la demo ${demo.name}`}
						>
							<Image
								src={image}
								alt=""
								widths={[240, 420]}
								sizes="(min-width: 900px) 210px, 118px"
								loading={isCenter ? 'eager' : 'lazy'}
								fetchpriority={isCenter ? 'high' : undefined}
								data-demo-style={demo.slug}
							/>
						</a>
					) : null,
				)
			}
			<span class="hero-prime__fan-label">{data.fanLabel}</span>
		</div>
	</div>
</section>
