---
/**
 * src/components/home/Hero.astro
 * Hero "Prime" Component
 */
import ActionBase from '@components/common/actions/ActionBase.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import type { HeroData } from '@/interfaces/ui/sections/landing-page.interface';
import { Image } from 'astro:assets';

import heroXv from '@/assets/images/hero/xv.png';

import '@/styles/components/_hero.scss';

interface Props {
	data: HeroData;
}

const { data } = Astro.props;
---

<section class="hero-prime" id="inicio" role="region" aria-labelledby="hero-title" data-track-section="hero" data-screenshot="landing-hero">
	<div class="hero-prime__bg" aria-hidden="true">
		<picture class="hero-prime__bg-picture hero-prime__bg-picture--active">
			<Image src={heroXv} alt=""  width={1920} height={1080} quality={80} loading="eager" decoding="sync" fetchpriority="high" />
		</picture>
	</div>

	<div class="hero-prime__overlay" aria-hidden="true"></div>

	<div class="hero-prime__content">
		<div class="hero-prime__left">
			<p class="hero-prime__eyebrow stagger-1">Invitaciones digitales premium</p>

			<h1 class="hero-prime__title stagger-2" id="hero-title">
				{data.title}
			</h1>

			<p class="hero-prime__subtitle stagger-3">
				{data.subtitle}
			</p>

			<div class="hero-prime__actions stagger-4">
				<WhatsAppButton
					phone={data.whatsappPhone}
					message={data.whatsappMessage}
					label={data.primaryCtaLabel}
					trackSection="hero"
					trackCta="whatsapp-hero"
					trackCampaign="HERO-LANZAMIENTO-899"
					trackValue={899}
					trackCurrency="MXN"
					promoCode="LANZAMIENTO-899"
					ariaLabel="Cotizar por WhatsApp"
				/>
				<ActionBase
					as="a"
					href={data.secondaryCtaUrl || '#tipo-evento'}
					variant="text"
					color="white"
					class="hero-prime__secondary-action"
					data-track-event="cta_clicked"
					data-track-section="hero"
					data-track-cta="hero_secondary"
					data-track-label={data.secondaryCtaLabel}
					data-track-intent="section_nav"
					data-track-destination="event-types"
					data-campaign-code="DEMO-LANZAMIENTO-899"
					data-promo-code="LANZAMIENTO-899"
					data-track-value="899"
					data-track-currency="MXN"
				>
					{data.secondaryCtaLabel}
				</ActionBase>
			</div>
		</div>
	</div>
</section>
