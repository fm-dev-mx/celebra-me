---
// src/components/home/HowItWorks.astro
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';

import type { HowItWorksData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

import '@/styles/home/_how-it-works.scss';

interface Props {
	data: HowItWorksData;
}

const { data } = Astro.props;
const phone = getContactPhone();
---

<Section
	id="como-funciona"
	class="how-it-works"
	data-track-section="how-it-works"
	data-screenshot="landing-process"
	aria-labelledby="how-it-works-title"
>
	<Container class="how-it-works__container">
		<header class="how-it-works__header">
			{data.eyebrow && <p class="how-it-works__eyebrow reveal-fade-up stagger-1">{data.eyebrow}</p>}
			<h2 id="how-it-works-title" class="how-it-works__title reveal-fade-up stagger-2">{data.title}</h2>
			{data.subtitle && <p class="how-it-works__subtitle reveal-fade-up stagger-3">{data.subtitle}</p>}
		</header>

		<ol class="how-it-works__steps reveal-fade-up stagger-3" role="list">
			{
				data.steps.map((step, index) => (
					<li class="how-it-works__step" data-step={index + 1}>
						<span class="how-it-works__step-number" aria-hidden="true">
							{String(index + 1).padStart(2, '0')}
						</span>
						<div class="how-it-works__step-content">
							<h3 class="how-it-works__step-title">{step.title}</h3>
							{step.description && <p class="how-it-works__step-description">{step.description}</p>}
						</div>
					</li>
				))
			}
		</ol>

		{
			data.cta && (
				<div class="how-it-works__actions reveal-fade-up stagger-4">
					<WhatsAppButton
						className="how-it-works__cta"
						phone={phone}
						label={data.cta.label}
						trackSection="how-it-works"
						trackCta="whatsapp-process"
						campaignSection="PROCESS"
					/>
				</div>
			)
		}
	</Container>
</Section>
