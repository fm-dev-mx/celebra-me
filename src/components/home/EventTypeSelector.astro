---
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import Icon from '@components/common/icons/Icon.astro';

import type { DemoShowroomEvent } from '@/interfaces/ui/sections/demo-showroom.interface';

import '@/styles/home/_event-selector.scss';

interface Props {
	events: readonly DemoShowroomEvent[];
}

const { events } = Astro.props;
---

<Section
	id="tipo-evento"
	class="event-selector"
	data-track-section="event-types"
	aria-labelledby="event-selector-title"
	data-screenshot="landing-event-types"
>
	<Container class="event-selector__container">
		<header class="event-selector__header">
			<p class="event-selector__eyebrow">Demos por tipo de evento</p>
			<h2 id="event-selector-title" class="event-selector__title">
				¿Qué tipo de evento está preparando?
			</h2>
			<p class="event-selector__subtitle">
				Elija una categoría para ver demos y opciones pensadas para su celebración.
			</p>
		</header>

		<div class="event-selector__grid" aria-label="Tipos de evento disponibles">
			{
				events.map((event) => (
					<a
						class="event-selector__card"
						href={event.showroomHref}
						data-track-event="cta_clicked"
						data-track-section="event-types"
						data-track-cta={`event_types_${event.eventType}`}
						data-track-label={event.ctaLabel}
						data-track-intent="demo_showroom"
						data-track-destination="event-types"
						data-campaign-code="DEMO-LANZAMIENTO-899"
						data-promo-code="LANZAMIENTO-899"
						data-track-value="899"
						data-track-currency="MXN"
					>
						<span class="event-selector__icon" aria-hidden="true">
							<Icon name={event.icon} />
						</span>
						<span class="event-selector__content">
							<span class="event-selector__label">{event.label}</span>
							<span class="event-selector__description">{event.description}</span>
							<span class="event-selector__cta">
								{event.ctaLabel}
								<Icon name="ArrowRight" class="event-selector__cta-icon" />
							</span>
						</span>
					</a>
				))
			}
		</div>
	</Container>
</Section>
