---
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import Icon from '@components/common/icons/Icon.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import { Image } from 'astro:assets';
import { getContactPhone } from '@/utils/whatsapp';

import type { ImageMetadata } from 'astro';
import type { DemoShowroomEvent } from '@/interfaces/ui/sections/demo-showroom.interface';
import type { EventType } from '@/lib/theme/theme-contract';
import type { LandingPageData } from '@/interfaces/ui/sections/landing-page.interface';

import showroomBabyShowerHero from '@/assets/images/showroom/event-showroom-baby-shower-hero.webp';
import showroomBautizoHero from '@/assets/images/showroom/event-showroom-bautizo-hero.webp';
import showroomBodaHero from '@/assets/images/showroom/event-showroom-boda-hero.webp';
import showroomCumpleanosHero from '@/assets/images/showroom/event-showroom-cumpleanos-hero.webp';
import showroomXvHero from '@/assets/images/showroom/event-showroom-xv-hero.webp';

import '@/styles/home/_event-selector.scss';

interface Props {
	events: readonly DemoShowroomEvent[];
	landingData?: LandingPageData;
}

const { events, landingData } = Astro.props;
const phone = getContactPhone();
const es = landingData?.eventSelector;

const previewImages: Partial<Record<EventType, ImageMetadata>> = {
	xv: showroomXvHero,
	boda: showroomBodaHero,
	bautizo: showroomBautizoHero,
	cumple: showroomCumpleanosHero,
	'baby-shower': showroomBabyShowerHero,
};

const getPreviewImage = (eventType: EventType) => previewImages[eventType] || showroomXvHero;
---

<Section
	id="tipo-evento"
	class="event-selector"
	data-event-showroom
	data-track-section="event-types"
	aria-labelledby="event-selector-title"
	data-screenshot="landing-event-types"
>
	<Container class="event-selector__container">
		<header class="event-selector__header">
			<p class="event-selector__eyebrow reveal-fade-up stagger-1">{es?.eyebrow || 'Demos por tipo de evento'}</p>
			<h2 id="event-selector-title" class="event-selector__title reveal-fade-up stagger-2">
				{es?.title || 'Explora una experiencia diseñada para cada celebración'}
			</h2>
			<p class="event-selector__subtitle reveal-fade-up stagger-3">
				{es?.description || 'Elige tu tipo de evento y mira cómo se adaptan la invitación, el RSVP, los pases y la cotización.'}
			</p>
		</header>

		<div class="event-showroom reveal-fade-up stagger-4">
			<div class="event-showroom__tabs-shell" data-event-tab-shell>
				<div class="event-showroom__tabs" role="tablist" aria-label="Tipos de evento" data-event-tablist>
					{events.map((event, index) => (
						<button
							class:list={["event-showroom__tab-btn", { active: index === 0 }]}
							role="tab"
							aria-selected={index === 0 ? "true" : "false"}
							aria-controls={`panel-${event.eventType}`}
							id={`tab-${event.eventType}`}
							data-tab-event={event.eventType}
							data-event-tab
							tabindex={index === 0 ? 0 : -1}
						>
							<Icon name={event.icon} size={18} />
							{event.label}
						</button>
					))}
				</div>
			</div>

			<div class="event-showroom__panels">
				{events.map((event, index) => {
					const preview = event.homeSelector.preview;
					const showroom = event.homeSelector.showroom;
					const quote = event.homeSelector.quoteCta;
					const previewImage = getPreviewImage(event.eventType);

					return (
					<div
						class:list={["event-showroom__panel-item", { active: index === 0 }]}
						id={`panel-${event.eventType}`}
						role="tabpanel"
						aria-labelledby={`tab-${event.eventType}`}
						data-panel-event={event.eventType}
						data-event-panel
						aria-hidden={index === 0 ? "false" : "true"}
						{...(index === 0 ? {} : { inert: true })}
					>
						<div class="event-showroom__panel-content">
							<div class="event-showroom__mockup-side">
								<figure class="event-showroom__phone-frame" aria-label={`Vista previa de invitación para ${event.label}`}>
									<div class="event-showroom__phone-screen">
										<Image
											src={previewImage}
											alt={preview.imageAlt}
											class="event-showroom__phone-image"
											width={360}
											height={640}
											quality={82}
											loading={index === 0 ? "eager" : "lazy"}
											decoding="async"
										/>
										<div class="event-showroom__phone-overlay">
											<div class="event-showroom__phone-copy">
												<p class="event-showroom__card-kicker" data-showroom-kicker>{preview.eyebrow}</p>
												<p class="event-showroom__card-title" data-showroom-title>{preview.title}</p>
												<p class="event-showroom__card-subtitle">{preview.subtitle}</p>
												<div class="event-showroom__card-details">
													<span>{preview.date}</span>
													<span>{preview.venue}</span>
												</div>
												<ul class="event-showroom__card-features" aria-label="Funciones incluidas">
													{preview.chips.map((chip) => (
														<li data-showroom-feature>{chip}</li>
													))}
												</ul>
												<p class="event-showroom__card-action">{preview.actionLabel}</p>
											</div>
										</div>
									</div>
								</figure>
							</div>
							<div class="event-showroom__info-side">
								<p class="event-showroom__info-kicker">{showroom.kicker}</p>
								<h3 class="event-showroom__info-title">{showroom.title}</h3>
								<p class="event-showroom__info-text">{showroom.description}</p>
								<div class="event-showroom__actions">
									<a
										href={event.showroomHref}
										class="action-btn action-btn--secondary"
										data-track-event="cta_clicked"
										data-track-section="event-types"
										data-track-cta={`showroom_view_demo_${event.eventType}`}
										data-track-label="Ver demo"
										data-track-intent="demo_showroom"
										data-track-destination="demo-showroom"
									>
										{es?.cta || 'Ver demo'}
										<Icon name="ArrowRight" size={16} />
									</a>
									<WhatsAppButton
										className="action-btn action-btn--primary"
										phone={phone}
										message={quote.message}
										label={quote.label}
										trackSection="event-types"
										trackCta={`showroom_quote_${event.eventType}`}
										trackCampaign="DEMO-LANZAMIENTO-899"
										trackValue={quote.trackValue}
										trackCurrency="MXN"
										promoCode={quote.promoCode}
										trackPackage={quote.packageInterest}
										packageName={quote.packageName}
										eventType={event.eventType}
										eventLabel={event.label}
										ariaLabel={`Cotizar estilo ${event.label}`}
									/>
								</div>
							</div>
						</div>
					</div>
					);
				})}
			</div>
		</div>
	</Container>
</Section>

<script>
	const root = document.querySelector('[data-event-showroom]');
	if (root instanceof HTMLElement) {
		const tabShell = root.querySelector<HTMLElement>('[data-event-tab-shell]');
		const tabList = root.querySelector<HTMLElement>('[data-event-tablist]');
		const tabs = Array.from(root.querySelectorAll<HTMLElement>('[data-event-tab]'));
		const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-event-panel]'));
		const activeTab = root.querySelector<HTMLElement>('.event-showroom__tab-btn.active');
		const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
		const autoplayStartDelayMs = 1000;
		const autoplayIntervalMs = 3800;
		const autoplayAdvanceLimit = Math.min(3, Math.max(0, tabs.length - 1));
		const panelTransitionMs = 420;
		const hasResizeObserver = 'ResizeObserver' in window;

		let activeIndex = Math.max(
			0,
			tabs.findIndex(
				(tab) => tab instanceof HTMLElement && tab.getAttribute('aria-selected') === 'true',
			),
		);
		let autoplayStartTimer: number | undefined;
		let autoplayNextTimer: number | undefined;
		let panelTransitionTimer: number | undefined;
		let autoplayArmed = false;
		let autoplayFinished = false;
		let userInteracted = false;
		let sectionVisible = false;
		let autoplaySteps = 0;
		let overflowObserver: ResizeObserver | undefined;

		root.style.setProperty('--event-showroom-autoplay-duration', `${autoplayIntervalMs}ms`);

		if (activeTab instanceof HTMLElement) {
			document.documentElement.setAttribute(
				'data-selected-event',
				activeTab.getAttribute('data-tab-event') || 'xv',
			);
		}

		const setSectionAutoplaying = (isAutoplaying: boolean) => {
			if (isAutoplaying) {
				root.setAttribute('data-autoplaying', 'true');
			} else {
				root.removeAttribute('data-autoplaying');
			}
		};

		const updateOverflowCue = () => {
			if (!(tabList instanceof HTMLElement)) return;
			const hasOverflow = tabList.scrollWidth > tabList.clientWidth + 1;
			const canScrollLeft = hasOverflow && tabList.scrollLeft > 8;
			const canScrollRight =
				hasOverflow &&
				tabList.scrollLeft + tabList.clientWidth < tabList.scrollWidth - 8;

			tabList.setAttribute('data-overflow', hasOverflow ? 'true' : 'false');
			tabList.setAttribute('data-can-scroll-left', canScrollLeft ? 'true' : 'false');
			tabList.setAttribute('data-can-scroll-right', canScrollRight ? 'true' : 'false');

			if (tabShell instanceof HTMLElement) {
				tabShell.setAttribute('data-overflow', hasOverflow ? 'true' : 'false');
				tabShell.setAttribute('data-can-scroll-left', canScrollLeft ? 'true' : 'false');
				tabShell.setAttribute('data-can-scroll-right', canScrollRight ? 'true' : 'false');
			}
		};

		const clearAutoplayTimers = () => {
			if (autoplayStartTimer !== undefined) window.clearTimeout(autoplayStartTimer);
			if (autoplayNextTimer !== undefined) window.clearTimeout(autoplayNextTimer);
			autoplayStartTimer = undefined;
			autoplayNextTimer = undefined;
			autoplayArmed = false;
		};

		const clearPanelTransitionTimer = () => {
			if (panelTransitionTimer !== undefined) window.clearTimeout(panelTransitionTimer);
			panelTransitionTimer = undefined;
		};

		const revealTabsAroundActive = (targetTab: HTMLElement) => {
			if (!(tabList instanceof HTMLElement)) return;
			if (tabList.scrollWidth <= tabList.clientWidth + 1) return;
			const targetLeft =
				targetTab.offsetLeft - (tabList.clientWidth - targetTab.offsetWidth) / 2;
			const maxScrollLeft = tabList.scrollWidth - tabList.clientWidth;

			tabList.scrollTo({
				left: Math.max(0, Math.min(targetLeft, maxScrollLeft)),
				behavior: reducedMotionQuery.matches ? 'auto' : 'smooth',
			});
		};

		const finishAutoplay = (markFinished = true) => {
			clearAutoplayTimers();
			clearPanelTransitionTimer();
			setSectionAutoplaying(false);
			if (markFinished) autoplayFinished = true;
		};

		const resetLeavingPanels = () => {
			panels.forEach((panel) => {
				if (!(panel instanceof HTMLElement)) return;
				panel.classList.remove('is-entering', 'is-leaving');
			});
		};

		const activateTab = (
			tab: HTMLElement,
			options: { source: 'user' | 'autoplay'; focus?: boolean } = { source: 'user', focus: false },
		) => {
			if (!(tab instanceof HTMLElement)) return;
			const targetEvent = tab.getAttribute('data-tab-event');
			if (!targetEvent) return;
			const targetIndex = tabs.indexOf(tab);
			if (targetIndex < 0) return;

			if (options.source === 'user') {
				userInteracted = true;
				finishAutoplay(true);
			}

			const previousPanel = panels[activeIndex];
			const nextPanel = panels[targetIndex];
			const targetIsCurrent = targetIndex === activeIndex;

			if (!(nextPanel instanceof HTMLElement)) return;

			clearPanelTransitionTimer();
			resetLeavingPanels();
			document.documentElement.setAttribute('data-selected-event', targetEvent);

			tabs.forEach((currentTab) => {
				if (!(currentTab instanceof HTMLElement)) return;
				currentTab.classList.remove('active');
				currentTab.setAttribute('aria-selected', 'false');
				currentTab.setAttribute('tabindex', '-1');
			});

			tab.classList.add('active');
			tab.setAttribute('aria-selected', 'true');
			tab.setAttribute('tabindex', '0');

			revealTabsAroundActive(tab);

			if (options.source === 'user' && options.focus) {
				tab.focus({ preventScroll: true });
			}

			if (previousPanel instanceof HTMLElement && !targetIsCurrent) {
				previousPanel.classList.remove('active');
				previousPanel.classList.add('is-leaving');
				previousPanel.setAttribute('aria-hidden', 'true');
				previousPanel.setAttribute('inert', '');
			}

			nextPanel.classList.add('active');
			nextPanel.removeAttribute('inert');
			nextPanel.setAttribute('aria-hidden', 'false');
			nextPanel.classList.add('is-entering');

			activeIndex = targetIndex;

			panelTransitionTimer = window.setTimeout(() => {
				if (previousPanel instanceof HTMLElement && previousPanel !== nextPanel) {
					previousPanel.classList.remove('is-leaving');
				}
				nextPanel.classList.remove('is-entering');
			}, panelTransitionMs);
		};

		const queueNextGuidedAdvance = () => {
			if (
				autoplayFinished ||
				userInteracted ||
				reducedMotionQuery.matches ||
				tabs.length < 2 ||
				!sectionVisible
			) {
				return;
			}

			const nextIndex = activeIndex + 1;
			if (nextIndex >= tabs.length || autoplaySteps >= autoplayAdvanceLimit) {
				finishAutoplay(true);
				return;
			}

			setSectionAutoplaying(true);
			activateTab(tabs[nextIndex], { source: 'autoplay' });
			autoplaySteps += 1;

			if (autoplaySteps >= autoplayAdvanceLimit || activeIndex >= tabs.length - 1) {
				finishAutoplay(true);
				return;
			}

			autoplayNextTimer = window.setTimeout(queueNextGuidedAdvance, autoplayIntervalMs);
		};

		const startAutoplay = () => {
			if (
				autoplayArmed ||
				autoplayFinished ||
				userInteracted ||
				reducedMotionQuery.matches ||
				tabs.length < 2 ||
				!sectionVisible
			) {
				return;
			}

			autoplayArmed = true;
			clearAutoplayTimers();
			autoplayStartTimer = window.setTimeout(() => {
				autoplayArmed = false;
				if (
					autoplayFinished ||
					userInteracted ||
					reducedMotionQuery.matches ||
					!sectionVisible
				) {
					return;
				}

				autoplaySteps = 0;
				setSectionAutoplaying(true);
				queueNextGuidedAdvance();
			}, autoplayStartDelayMs);
		};

		const stopForUserIntent = () => {
			userInteracted = true;
			finishAutoplay(true);
		};

		tabs.forEach((tab) => {
			if (!(tab instanceof HTMLElement)) return;
			tab.addEventListener('click', () => {
				stopForUserIntent();
				activateTab(tab, { source: 'user' });
			});
		});

		if (tabList instanceof HTMLElement) {
			tabList.addEventListener('pointerdown', stopForUserIntent, true);
			tabList.addEventListener('touchstart', stopForUserIntent, { passive: true, capture: true });
			tabList.addEventListener('keydown', (event) => {
				if (!(event instanceof KeyboardEvent)) return;
				const currentIndex = tabs.findIndex(
					(tab) => tab instanceof HTMLElement && tab.getAttribute('aria-selected') === 'true',
				);
				if (currentIndex < 0) return;

				const lastIndex = tabs.length - 1;
				let nextIndex = currentIndex;

				if (event.key === 'ArrowRight') nextIndex = currentIndex === lastIndex ? 0 : currentIndex + 1;
				if (event.key === 'ArrowLeft') nextIndex = currentIndex === 0 ? lastIndex : currentIndex - 1;
				if (event.key === 'Home') nextIndex = 0;
				if (event.key === 'End') nextIndex = lastIndex;

				if (nextIndex === currentIndex) return;

				stopForUserIntent();
				event.preventDefault();
				activateTab(tabs[nextIndex], { source: 'user', focus: true });
			});

			const observerCallback = () => updateOverflowCue();
			if (hasResizeObserver) {
				overflowObserver = new ResizeObserver(observerCallback);
				overflowObserver.observe(tabList);
				window.addEventListener('pagehide', () => overflowObserver?.disconnect(), { once: true });
			}
			tabList.addEventListener('scroll', observerCallback, { passive: true });
			window.addEventListener('resize', observerCallback, { passive: true });
			window.addEventListener('orientationchange', observerCallback, { passive: true });
			window.requestAnimationFrame(observerCallback);
		}

		root.addEventListener('pointerenter', stopForUserIntent, true);
		root.addEventListener('focusin', stopForUserIntent, true);
		root.addEventListener(
			'click',
			(event) => {
				const target = event.target;
				if (!(target instanceof HTMLElement)) return;
				if (target.closest('a, button, [role="tab"]')) {
					stopForUserIntent();
				}
			},
			true,
		);

		if (reducedMotionQuery.matches) {
			finishAutoplay(false);
		}

		const visibilityObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.target !== root) return;
					sectionVisible = entry.isIntersecting;
					if (sectionVisible) {
						startAutoplay();
					} else {
						finishAutoplay(false);
					}
				});
			},
			{
				threshold: 0.35,
			},
		);

		visibilityObserver.observe(root);
	}
</script>
