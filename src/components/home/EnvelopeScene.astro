---
/**
 * src/components/home/EnvelopeScene.astro
 *
 * Scroll scene: the guest's envelope opens and the invitation card rises out of it, while four
 * notes point at what sets Celebra-me apart, one per stage of the opening. CSS only:
 * where `animation-timeline` is supported and motion is allowed, a sticky stage plays the opening
 * across the pinned span; otherwise the stage rests open (card in front, flap up). Layers keep a
 * fixed stacking order; the card is clipped at the envelope mouth while it is still inside.
 */
import { Image } from 'astro:assets';
import type { VitrinaDemo } from '@/data/landing-vitrina.data';
import { getEventAsset } from '@/lib/assets/asset-registry';

import '@/styles/home/_landing-scenes.scss';

interface Props {
	demo: VitrinaDemo;
}

const { demo } = Astro.props;
const cover = getEventAsset(demo.slug, demo.cover);
const [year, month, day] = demo.date.split('-');

// One note per stage of the opening: closed envelope, broken seal, card rising, card out.
const NOTES = [
	{
		title: 'Un pase para cada familia',
		text: 'El sobre lleva el nombre de sus invitados y cuántos lugares tienen.',
	},
	{
		title: 'Diseñada para usted',
		text: 'Cada invitación se diseña para su evento; no es una plantilla.',
	},
	{
		title: 'Confirman en un toque',
		text: 'Responden desde la misma invitación y usted lo ve en su panel.',
	},
	{
		title: 'La ubicación, solo para quien confirma',
		text: 'Al confirmar ven cómo llegar con Google Maps, Waze o Apple Maps.',
	},
] as const;
---

<section class="envelope-scene" aria-labelledby="envelope-title" data-track-section="envelope_scene">
	<header class="envelope-scene__intro">
		<p class="envelope-scene__eyebrow">Así empieza cada invitación</p>
		<h2 class="envelope-scene__title" id="envelope-title">Cada detalle del sobre trabaja para usted</h2>
		<p class="envelope-scene__lede">Baje despacio para abrirlo.</p>
	</header>
	<div class="envelope-scene__track">
		<div class="envelope-scene__stage">
			<div
				class="envelope"
				role="img"
				aria-label={`Sobre para la Familia Rivas con 2 pases; dentro, la invitación de ${demo.person}`}
			>
				<div class="envelope__back"></div>
				<div class="envelope__flap"></div>
				<div class="envelope__card">
					{
						cover && (
							<Image
								src={cover}
								alt=""
								widths={[320, 560]}
								sizes="300px"
								loading="lazy"
							/>
						)
					}
					<div class="envelope__shade"></div>
					<div class="envelope__title">
						<span>{demo.kicker}</span>
						<strong>{demo.person}</strong>
						<span>{day} · {month} · {year}</span>
					</div>
				</div>
				<div class="envelope__front">
					<span>Para: Familia Rivas · 2 pases</span>
				</div>
				<div class="envelope__seal">{demo.person.charAt(0)}</div>
			</div>
			<ol class="envelope-notes">
				{
					NOTES.map((note, index) => (
						<li class="envelope-notes__item">
							<span class="envelope-notes__number" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
							<strong>{note.title}</strong>
							<span>{note.text}</span>
						</li>
					))
				}
			</ol>
			<div class="envelope-scene__progress" aria-hidden="true"><i></i></div>
		</div>
	</div>
</section>
