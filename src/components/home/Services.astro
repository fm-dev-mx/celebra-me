---
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';

import type { ServicesData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

import '@/styles/home/_services.scss';

interface Props {
	data: ServicesData;
}

const { data } = Astro.props;
const phone = getContactPhone();
---

<Section id="servicios" class="services section-padding" data-track-section="services" data-screenshot="landing-includes">
	<Container class="services__container">
		<header class="services__header">
			<h2 class="services__heading">{data.title}</h2>
			<p class="services__subtitle">{data.subtitle}</p>
		</header>

		<div class="services__spec-list" role="list">
			{
				data.items.map((item) => {
					return (
						<div class="services__spec-row" role="listitem">
							<span class="services__spec-accent" aria-hidden="true"></span>
							<div class="services__spec-content">
								<h3 class="services__spec-title">{item.title}</h3>
								<p class="services__spec-detail">{item.description}</p>
							</div>
						</div>
					);
				})
			}
		</div>

		<div class="services__actions">
			<WhatsAppButton
				className="services__cta"
				phone={phone}
				message="Hola, quiero hacer válida la promo de lanzamiento de mi invitación digital premium.\n\nCupón: LANZAMIENTO-899"
				label={data.cta.label}
				trackSection="services"
				trackCta="whatsapp-includes"
				trackCampaign="DEMO-LANZAMIENTO-899"
				trackValue={899}
				trackCurrency="MXN"
				promoCode="LANZAMIENTO-899"
				ariaLabel="Cotizar una invitación con estas funciones por WhatsApp"
			/>
		</div>
	</Container>
</Section>
