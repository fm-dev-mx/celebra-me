---
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import ActionBase from '@components/common/actions/ActionBase.astro';
import Icon from '@components/common/icons/Icon.astro';

import type { ServicesData } from '@/interfaces/ui/sections/landing-page.interface';

import '@/styles/home/_services.scss';

interface Props {
	data: ServicesData;
}

const { data } = Astro.props;
---

<Section id="servicios" class="services section-padding" data-track-section="services">
	<Container class="services__container">
		<header class="services__header">
			<h2 class="services__heading">{data.title}</h2>
			<p class="services__subtitle">{data.subtitle}</p>
		</header>

		<div class="services__grid">
			{
				data.items.map((item) => {
					return (
						<article class="services__card">
							<div class="services__icon-wrapper" aria-hidden="true">
								<Icon name={item.icon || 'CheckIcon'} class="services__icon" />
							</div>
							<div class="services__card-body">
								<h3 class="services__title">{item.title}</h3>
								<p class="services__description">{item.description}</p>
							</div>
						</article>
					);
				})
			}
		</div>

		<div class="services__actions">
			<ActionBase
				as="a"
				href={data.cta.href}
				class="services__cta"
				data-track-event="cta_clicked"
				data-track-section="services"
				data-track-cta="services_contact"
				data-track-intent="lead_consultation"
			>
				<span>{data.cta.label}</span>
				<Icon name="ArrowRightIcon" class="services__cta-icon" />
			</ActionBase>
		</div>
	</Container>
</Section>
