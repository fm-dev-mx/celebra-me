---
// src/components/home/AboutUs.astro
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import AboutUsAccessGallery from '@/components/home/AboutUsAccessGallery.astro';
import ActionBase from '@components/common/actions/ActionBase.astro';

import Icon from '@components/common/icons/Icon.astro';

import type { AboutData } from '@/interfaces/ui/sections/landing-page.interface';

// Import stylesheet
import '@/styles/home/_about-us.scss';

interface Props {
	data: AboutData;
}

const { data } = Astro.props;

// Render title with intentional line break after first sentence
const titleHtml = data.title.replace('. ', '.<br>');
---

<Section id="nosotros" class="about-us" data-screenshot="landing-essence">
	<div class="about-us__bg-overlay"></div>

	<Container class="about-us__container">
		<div class="about-us__grid">
			{/* Header — eyebrow + title */}
			<header
				class="about-us__header animate-on-scroll"
				data-delay="100ms"
			>
				{data.eyebrow && (
					<p class="about-us__eyebrow">{data.eyebrow}</p>
				)}
				<h2 class="about-us__title" set:html={titleHtml}></h2>
			</header>

			{/* Description */}
			<p
				class="about-us__description animate-on-scroll"
				data-delay="300ms"
			>
				{data.description}
			</p>

			{/* Visual — editorial access card gallery */}
			<div
				class="about-us__visual animate-on-scroll"
				data-delay="360ms"
			>
				<div class="about-us__card-wrapper">
					<div class="about-us__card-frame"></div>
					<AboutUsAccessGallery />
					<div class="about-us__card-glow"></div>
				</div>
				<p class="about-us__image-caption">Una primera impresión digital, diseñada para sentirse cuidada.</p>
			</div>

			{/* Numbered editorial value points */}
			<div class="about-us__values">
				{data.values.map((value, i) => (
					<div
						class="about-us__value-item animate-on-scroll"
						data-delay={`${420 + i * 120}ms`}
					>
						<span class="about-us__value-number">{String(i + 1).padStart(2, '0')}</span>
						<div class="about-us__value-body">
							<span class="about-us__value-name">{value.name}</span>
							<span class="about-us__value-desc">{value.description}</span>
						</div>
					</div>
				))}
			</div>

			{/* Microstatement */}
			<p class="about-us__microstatement animate-on-scroll" data-delay="500ms">
				La invitación no solo anuncia el evento: prepara la experiencia desde el primer mensaje.
			</p>

			{/* CTA */}
			<div
				class="about-us__actions animate-on-scroll"
				data-delay="560ms"
			>
				<ActionBase
					variant="outline"
					color="primary"
					as="a"
					href={data.cta.href}
					class="about-us__cta"
				>
					{data.cta.label}
					<Icon name="ArrowRight" class="about-us__cta-icon" />
				</ActionBase>
			</div>
		</div>
	</Container>
</Section>
<script>
	import { createIntersectionObserver } from '@/utils/animations';

	const aboutSection = document.querySelector('.about-us');
	const shouldReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll('.animate-on-scroll').forEach((element) => {
		if (element instanceof HTMLElement && element.dataset.delay) {
			element.style.setProperty('--animation-delay', element.dataset.delay);
		}
	});

	if (aboutSection instanceof HTMLElement && !shouldReduceMotion) {
		aboutSection.classList.add('about-us--motion-ready');

		createIntersectionObserver(
			'.about-us--motion-ready .animate-on-scroll',
			(target) => target.classList.add('is-visible'),
			{ rootMargin: '-5% 0px', threshold: 0.15 },
		);
	}
</script>
