---
// src/components/home/AboutUs.astro
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import OptimizedImage from '@components/common/OptimizedImage.astro';
import ActionBase from '@components/common/actions/ActionBase.astro';

import Icon from '@components/common/icons/Icon.astro';
import { getCommonAsset } from '@/lib/assets/asset-registry';

import type { AboutData } from '@/interfaces/ui/sections/landing-page.interface';

// Import stylesheet
import '@/styles/home/_about-us.scss';

interface Props {
	data: AboutData;
}

const { data } = Astro.props;
const aboutToast = getCommonAsset('aboutToast');
---

<Section id="nosotros" class="about-us" data-screenshot="landing-essence">
	<div class="about-us__bg-overlay"></div>

	<Container class="about-us__container">
		<div class="about-us__grid">
			{/* Visual side — image dominant */}
			<div
				class="about-us__visual animate-on-scroll"
				data-delay="200ms"
			>
				<div class="about-us__image-wrapper">
					<div class="about-us__image-frame"></div>
					<OptimizedImage
						imagePath={aboutToast}
						alt="Celebración elegante con brindis"
						width={800}
						height={1000}
						class="about-us__image"
						quality={80}
						widths={[320, 480, 640]}
						sizes="(max-width: 767px) 334px, 44vw"
					/>
					<div class="about-us__image-glow"></div>
					<div class="about-us__image-decoration"></div>
				</div>
			</div>

			{/* Content side — editorial flow */}
			<div class="about-us__content">
				<header
					class="about-us__header animate-on-scroll"
					data-delay="100ms"
				>
					<h2 class="about-us__title">{data.title}</h2>
					<div class="about-us__underline"></div>
				</header>

				<p
					class="about-us__description animate-on-scroll"
					data-delay="300ms"
				>
					{data.description}
				</p>

				{/* Pullquote — typographic statement */}
				<blockquote
					class="about-us__pullquote animate-on-scroll"
					data-delay="380ms"
				>
					Elegante, clara y lista para compartir.
				</blockquote>

				{/* Simplified editorial values — no dots/marks, flowing lines */}
				<div class="about-us__values animate-on-scroll" data-delay="420ms">
					{data.values.map((value) => (
						<p class="about-us__value-line">
							<strong>{value.name}.</strong> {value.description}
						</p>
					))}
				</div>

				<div
					class="about-us__actions animate-on-scroll"
					data-delay="560ms"
				>
					<ActionBase
						variant="outline"
						color="primary"
						as="a"
						href={data.cta.href}
						class="about-us__cta"
					>
						{data.cta.label}
						<Icon name="ArrowRight" class="about-us__cta-icon" />
					</ActionBase>
				</div>
			</div>
		</div>
	</Container>
</Section>
<script>
	import { createIntersectionObserver } from '@/utils/animations';

	const aboutSection = document.querySelector('.about-us');
	const shouldReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll('.animate-on-scroll').forEach((element) => {
		if (element instanceof HTMLElement && element.dataset.delay) {
			element.style.setProperty('--animation-delay', element.dataset.delay);
		}
	});

	if (aboutSection instanceof HTMLElement && !shouldReduceMotion) {
		aboutSection.classList.add('about-us--motion-ready');

		createIntersectionObserver(
			'.about-us--motion-ready .animate-on-scroll',
			(target) => target.classList.add('is-visible'),
			{ rootMargin: '-5% 0px', threshold: 0.15 },
		);
	}
</script>
