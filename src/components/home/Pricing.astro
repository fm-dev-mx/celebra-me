---
import CheckIcon from '@components/ui/CheckIcon.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import type { PricingData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

interface Props {
	data: PricingData;
}

const { data } = Astro.props;
const phone = getContactPhone();

const cleanPriceAmount = (amountStr: string): number => Number(amountStr.replace(/,/g, ''));
---

<section id="pricing" class="pricing-section" data-track-section="pricing" data-screenshot="landing-pricing">
	<div class="pricing-noise"></div>

	<div class="container">
		<div class="pricing-panel">
			<header class="pricing-header">
				<span class="pricing-eyebrow reveal-fade-up stagger-1">{data.eyebrow}</span>
				<h2 class="pricing-title reveal-fade-up stagger-2">{data.title}</h2>
				<p class="pricing-intro reveal-fade-up stagger-3">{data.intro}</p>
				<p class="pricing-note reveal-fade-up stagger-4">{data.note}</p>
			</header>

			<div class="pricing-grid reveal-fade-up stagger-5" aria-label="Niveles de experiencia">
				{
					data.tiers.map((tier, index) => {
						const priceValue = cleanPriceAmount(tier.price.amount);
						const tierPromoCode = `LANZAMIENTO-${priceValue}`;
						const tierCampaignCode = `PRICING-LANZAMIENTO-${priceValue}`;

						return (
							<article
								class:list={[
									'pricing-card',
									{ 'is-primary': tier.isPrimary },
									{ 'is-exclusive': tier.isExclusive },
								]}
								data-index={index}
								data-tier={tier.id}
								data-track-package-view
								data-package-id={tier.id ?? tier.title.toLowerCase()}
								data-package-name={tier.title}
								data-source-area="pricing"
							>
								{tier.isPrimary && tier.badge && <div class="pricing-badge">{tier.badge}</div>}

								<div class="card-content">
									<header class="tier-header">
										<h3 class="tier-name">{tier.title}</h3>
										<p class="tier-desc">{tier.description}</p>
									</header>

									<div class="tier-price" aria-label={`${tier.price.amount} ${tier.price.currency}`}>
										<span class="currency-symbol">$</span>
										<span class="amount">{tier.price.amount}</span>
										<span class="currency-code">{tier.price.currency}</span>
										{tier.price.period && <span class="period">{tier.price.period}</span>}
									</div>

									{tier.regularPrice && <p class="regular-price">{tier.regularPrice}</p>}
									<p class="tier-ideal">{tier.idealFor}</p>

									<div class="tier-sections">
										{tier.sections.map((section) => (
											<div class="tier-section">
												<h4 class="section-title">{section.title}</h4>
												<ul class="section-items">
													{section.items.map((item) => (
														<li class="section-item">
															<CheckIcon />
															<span>{item}</span>
														</li>
													))}
												</ul>
											</div>
										))}
									</div>

									<WhatsAppButton
										className="cta-button"
										phone={phone}
										message={tier.ctaMessage}
										label={`Elegir ${tier.title}`}
										ariaLabel={`Elegir ${tier.title}`}
										trackSection="pricing"
										trackCta={`pricing_${tier.id ?? tier.title.toLowerCase().replaceAll(' ', '_')}`}
										trackIntent="package_interest"
										trackCampaign={tierCampaignCode}
										trackPackage={tier.id ?? tier.title.toLowerCase()}
										packageName={tier.title}
										trackValue={priceValue}
										trackCurrency="MXN"
										promoCode={tierPromoCode}
									/>
								</div>
							</article>
						);
					})
				}
			</div>

			<aside class="pricing-guide reveal-fade-up stagger-5" aria-labelledby="pricing-guide-title">
				<div>
					<h3 id="pricing-guide-title">{data.decisionGuide.title}</h3>
					<ul>
						{data.decisionGuide.rows.map((row) => <li>{row}</li>)}
					</ul>
				</div>
				<WhatsAppButton
					className="pricing-guide__cta"
					phone={phone}
					message={data.decisionGuide.message}
					label={data.decisionGuide.cta}
					trackSection="pricing"
					trackCta="pricing_decision_help"
					trackIntent="package_help"
					trackCampaign="PRICING-DECISION-GUIDE"
					trackCurrency="MXN"
					ariaLabel={data.decisionGuide.cta}
					preserveMessage
				/>
			</aside>
		</div>
	</div>
</section>
