---
import CheckIcon from '@components/ui/CheckIcon.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import type { PricingData } from '@/interfaces/ui/sections/landing-page.interface';
import {
	formatMxn,
	formatMxnAmount,
	getPromoPackage,
	getValidityNote,
	PROMO_CAMPAIGN,
} from '@/data/promo-campaign.data';
import { getContactPhone } from '@/utils/whatsapp';

interface Props {
	data: PricingData;
}

const { data } = Astro.props;
const phone = getContactPhone();
const validityNote = getValidityNote();
const currency = PROMO_CAMPAIGN.currency;
---

<section id="pricing" class="pricing-section" data-track-section="pricing" data-screenshot="landing-pricing">
	<div class="pricing-noise"></div>

	<div class="container">
		<div class="pricing-panel">
			<header class="pricing-header">
				<span class="pricing-eyebrow reveal-fade-up stagger-1">{data.eyebrow}</span>
				<h2 class="pricing-title reveal-fade-up stagger-2">{data.title}</h2>
				<p class="pricing-intro reveal-fade-up stagger-3">{data.intro}</p>
				<p class="pricing-note reveal-fade-up stagger-4" data-promo-only>
					<span>{validityNote}</span>
					<span class="pricing-note__countdown" data-promo-days-left></span>
				</p>
			</header>

			<div class="pricing-grid reveal-fade-up stagger-5" aria-label="Paquetes">
				{
					data.tiers.map((tier, index) => {
						const pkg = getPromoPackage(tier.packageId);

						return (
							<article
								class:list={[
									'pricing-card',
									{ 'is-primary': tier.isPrimary },
									{ 'is-exclusive': tier.isExclusive },
								]}
								data-index={index}
								data-tier={pkg.id}
								data-track-package-view
								data-package-id={pkg.id}
								data-package-name={pkg.name}
								data-source-area="pricing"
							>
								{tier.isPrimary && tier.badge && <div class="pricing-badge">{tier.badge}</div>}

								<div class="card-content">
									<header class="tier-header">
										<h3 class="tier-name">{pkg.name}</h3>
									</header>

									<div class="tier-pricing">
										<p class="tier-promo-label" data-promo-only>{PROMO_CAMPAIGN.label}</p>
										<div
											class="tier-price"
											data-promo-only
											aria-label={`${formatMxn(pkg.promoPrice)} ${currency}, pago único`}
										>
											<span class="currency-symbol">$</span>
											<span class="amount">{formatMxnAmount(pkg.promoPrice)}</span>
											<span class="currency-code">{currency}</span>
											<span class="period">pago único</span>
										</div>
										<div
											class="tier-price"
											data-promo-fallback
											aria-label={`${formatMxn(pkg.regularPrice)} ${currency}, pago único`}
										>
											<span class="currency-symbol">$</span>
											<span class="amount">{formatMxnAmount(pkg.regularPrice)}</span>
											<span class="currency-code">{currency}</span>
											<span class="period">pago único</span>
										</div>
										<p class="regular-price" data-promo-only>
											Precio regular: <s>{formatMxn(pkg.regularPrice)} {currency}</s>
										</p>
									</div>

									<div class="tier-sections">
										{tier.includesFrom && <p class="tier-includes-from">{tier.includesFrom}</p>}
										<ul class="section-items">
											{tier.includes.map((item) => (
												<li class="section-item">
													<CheckIcon />
													<span>{item}</span>
												</li>
											))}
										</ul>
									</div>

									<dl class="tier-details">
										{tier.details.map((detail) => (
											<div class="tier-details__row">
												<dt>{detail.label}</dt>
												<dd>{detail.value}</dd>
											</div>
										))}
									</dl>

									<WhatsAppButton
										className="cta-button"
										phone={phone}
										packageId={pkg.id}
										ariaLabel={`Cotizar el paquete ${pkg.name} por WhatsApp`}
										trackSection="pricing"
										trackCta={`pricing_${pkg.id}`}
										trackIntent="package_interest"
										campaignSection="PRICING"
									/>
								</div>
							</article>
						);
					})
				}
			</div>

			<aside class="pricing-guide pricing-extras reveal-fade-up stagger-5" aria-labelledby="pricing-extras-title">
				<div>
					<h3 id="pricing-extras-title">{data.extras.title}</h3>
					<ul>
						{data.extras.items.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</aside>
		</div>
	</div>
</section>
