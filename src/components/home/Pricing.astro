---
import CheckIcon from '@components/ui/CheckIcon.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import type { PricingData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

interface Props {
	data: PricingData;
}

const { data } = Astro.props;
const phone = getContactPhone();
const promoCode = 'LANZAMIENTO-899';
const launchValue = 899;
// Future: numbered promo folios require reliable persistence; frontend-only counters are not acceptable.
---

<section id="pricing" class="pricing-section" data-track-section="pricing" data-screenshot="landing-pricing">
	<div class="pricing-noise"></div>

	<div class="container">
		<header class="pricing-header">
			<span class="pricing-eyebrow">{data.eyebrow}</span>
			<h2 class="pricing-title">{data.title}</h2>
			<p class="pricing-intro">{data.intro}</p>
			<p class="pricing-note">{data.note}</p>
		</header>

		<div class="pricing-grid">
			{
				data.tiers.map((tier, index) => (
					<article
						class:list={[
							'pricing-card',
							{ 'is-primary': tier.isPrimary },
							{ 'is-exclusive': tier.isExclusive },
						]}
						data-index={index}
					>
						{tier.badge && <div class="pricing-badge">{tier.badge}</div>}

						<div class="card-content">
							<h3 class="tier-name">{tier.title}</h3>
							<p class="tier-desc">{tier.description}</p>

							<div class="tier-price">
								{tier.price.currency ? (
									<>
										<span class="currency-symbol">$</span>
										<span class="amount">{tier.price.amount}</span>
										<span class="currency-code">{tier.price.currency}</span>
										{tier.price.period && <span class="period">/ {tier.price.period}</span>}
									</>
								) : (
									<span class="amount amount--text">{tier.price.amount}</span>
								)}
							</div>

							{tier.regularPrice && <p class="regular-price">{tier.regularPrice}</p>}

							<div class="tier-sections">
								{tier.sections.map((section) => (
									<div class="tier-section">
										<h4 class="section-title">{section.title}</h4>
										<ul class="section-items">
											{section.items.map((item) => (
												<li class="section-item">
													<CheckIcon />
													<span>{item}</span>
												</li>
											))}
										</ul>
									</div>
								))}
							</div>

							{tier.footnote && <p class="tier-footnote">{tier.footnote}</p>}

							<WhatsAppButton
								className="cta-button"
								phone={phone}
								message={tier.ctaMessage}
								label={tier.cta}
								ariaLabel={`Elegir plan ${tier.title}`}
								trackSection="pricing"
								trackCta={`pricing_${tier.title.toLowerCase().replaceAll(' ', '_')}`}
								trackIntent="package_interest"
								trackCampaign="PRICING-LANZAMIENTO-899"
								trackPackage={tier.id ?? tier.title.toLowerCase()}
								trackValue={launchValue}
								trackCurrency="MXN"
								promoCode={promoCode}
							/>
						</div>
					</article>
				))
			}
		</div>

		<div class="pricing-actions">
			<WhatsAppButton
				className="pricing-whatsapp"
				phone={phone}
				message="Hola, quiero hacer válida la promo de lanzamiento de mi invitación digital premium de $899 MXN.\n\nCupón: LANZAMIENTO-899"
				label="Elegir mi nivel por WhatsApp"
				trackSection="pricing"
				trackCta="whatsapp-pricing"
				trackIntent="package_interest"
				trackCampaign="PRICING-LANZAMIENTO-899"
				trackValue={launchValue}
				trackCurrency="MXN"
				promoCode={promoCode}
				ariaLabel="Elegir mi nivel por WhatsApp"
			/>
		</div>
	</div>
</section>
