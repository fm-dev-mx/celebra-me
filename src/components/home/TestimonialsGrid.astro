---
// src/components/home/TestimonialsGrid.astro
// Editorial quote carousel: one testimonial at a time, advanced only by the visitor.
import type { TestimonialItem } from '@/interfaces/ui/sections/landing-page.interface';

interface Props {
	eyebrow?: string;
	title?: string;
	subtitle?: string;
	testimonials: TestimonialItem[];
	notice?: string;
	proofLine?: string;
}

const { eyebrow, title, subtitle, testimonials = [], notice, proofLine } = Astro.props;

const total = testimonials.length;
if (!total) return null;
const pad = (value: number) => String(value).padStart(2, '0');
---

<div class="testimonials" data-testimonials-rotator>
	<div class="testimonials__left">
		{eyebrow && <p class="testimonials__eyebrow reveal-fade-up stagger-1">{eyebrow}</p>}
		{title && <h2 class="testimonials__title reveal-fade-up stagger-2">{title}</h2>}
		{subtitle && <p class="testimonials__desc reveal-fade-up stagger-3">{subtitle}</p>}
		{proofLine && <p class="testimonials__proof-line reveal-fade-up stagger-4">{proofLine}</p>}
	</div>

	<div class="testimonials__right reveal-fade-up stagger-3">
		<div class="testimonials__rotator">
			{
				testimonials.map((t, i) => (
					<article
						class:list={['testimonials__card', { 'testimonials__card--active': i === 0 }]}
						role="group"
						aria-roledescription="slide"
						aria-label={`Testimonio ${i + 1} de ${total}`}
						aria-hidden={i === 0 ? 'false' : 'true'}
					>
						<p class="testimonials__text">“{t.text}”</p>
						<footer class="testimonials__footer">
							<span class="testimonials__name">{t.role}</span>
							{t.eventLabel && <span class="testimonials__role">{t.eventLabel}</span>}
						</footer>
					</article>
				))
			}
		</div>

		{
			total > 1 && (
				<div class="testimonials__controls">
					<button
						type="button"
						class="testimonials__nav"
						data-testimonial-prev
						aria-label="Testimonio anterior"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M15 6l-6 6 6 6" />
						</svg>
					</button>
					<span class="testimonials__counter" aria-live="polite">
						{pad(1)} / {pad(total)}
					</span>
					<button
						type="button"
						class="testimonials__nav"
						data-testimonial-next
						aria-label="Testimonio siguiente"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M9 6l6 6-6 6" />
						</svg>
					</button>
				</div>
			)
		}
		{notice && <p class="testimonials__notice">{notice}</p>}
	</div>
</div>

<script>
	// Quotes never change on their own: the visitor moves through them with the buttons.
	const root = document.querySelector<HTMLElement>('[data-testimonials-rotator]');

	if (root) {
		const cards = Array.from(root.querySelectorAll<HTMLElement>('.testimonials__card'));
		const counter = root.querySelector<HTMLElement>('.testimonials__counter');
		const pad = (value: number) => String(value).padStart(2, '0');
		let currentIndex = 0;

		const show = (index: number) => {
			currentIndex = (index + cards.length) % cards.length;
			cards.forEach((card, i) => {
				card.classList.toggle('testimonials__card--active', i === currentIndex);
				card.setAttribute('aria-hidden', String(i !== currentIndex));
			});
			if (counter) counter.textContent = `${pad(currentIndex + 1)} / ${pad(cards.length)}`;
		};

		root.querySelector('[data-testimonial-prev]')?.addEventListener('click', () =>
			show(currentIndex - 1),
		);
		root.querySelector('[data-testimonial-next]')?.addEventListener('click', () =>
			show(currentIndex + 1),
		);
	}
</script>
