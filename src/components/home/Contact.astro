---
// src/components/home/Contact.astro
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import type { ContactData } from '@/interfaces/ui/sections/landing-page.interface';

import '@/styles/home/_contact.scss';

interface Props {
	data: ContactData;
}

const { data } = Astro.props;
---

<!-- Contact Section -->
<section
	id="contacto"
	class="contact-section"
	data-track-section="contact"
	data-screenshot="landing-contact"
	aria-labelledby="contact-title"
>
	<div class="container contact-layout">
		<div class="contact-intro">
			<header class="contact-header">
				{data.eyebrow && <p class="contact-eyebrow reveal-fade-up stagger-1">{data.eyebrow}</p>}
				<h2 id="contact-title" class="contact-title reveal-fade-up stagger-2">{data.title}</h2>
				{data.subtitle && <p class="contact-subtitle reveal-fade-up stagger-3">{data.subtitle}</p>}
			</header>

			{data.about && (
				<div id="nosotros" class="contact-about" data-screenshot="landing-about">
					<h3 class="contact-about__title">{data.about.title}</h3>
					<p class="contact-about__text">{data.about.text}</p>
					<a class="contact-about__email" href={`mailto:${data.about.email}`}>
						{data.about.email}
					</a>
				</div>
			)}
		</div>

		<div class="contact-whatsapp-card reveal-fade-up stagger-4">
			{data.cardIntro && <p class="contact-whatsapp-card__intro">{data.cardIntro}</p>}
			{data.checklist && data.checklist.length > 0 && (
				<ul class="contact-whatsapp-card__list">
					{data.checklist.map((item) => <li>{item}</li>)}
				</ul>
			)}
			<WhatsAppButton
				className="contact-whatsapp-card__cta"
				message={data.cta?.message}
				label={data.cta?.label}
				trackSection="contact"
				trackCta="contact_whatsapp"
				campaignSection="FINAL"
			/>
			{data.microcopy && <p class="contact-microcopy">{data.microcopy}</p>}
		</div>
	</div>
</section>
