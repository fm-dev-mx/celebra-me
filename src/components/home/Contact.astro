---
// src/components/home/Contact.astro
import ContactForm from '@components/ui/ContactForm.astro';
import ActionIcon from '@components/common/actions/ActionIcon.astro';
import Icon from '@components/common/icons/Icon.astro';
import type { ContactData } from '@/interfaces/ui/sections/landing-page.interface';
import { getWhatsAppLink, getContactPhone, isPlaceholderContactPhone } from '@/utils/whatsapp';

// Import stylesheet
import '@/styles/home/_contact.scss';

interface Props {
	data: ContactData;
}

// Destructure the data prop
const { data } = Astro.props;

const hasValidWhatsApp = !isPlaceholderContactPhone(getContactPhone());
const whatsappMessage =
	'Hola, quiero hacer válida la promo de lanzamiento de mi invitación digital premium.\n\nCupón: LANZAMIENTO-899';
---

<!-- Contact Section -->
<section id="contacto" class="contact-section" data-track-section="contact" data-screenshot="landing-contact">
	<div class="contact-texture"></div>

	<div class="container">
		<header class="contact-header">
			<span class="contact-pretitle">Asesoría personalizada</span>
			<h2 class="contact-title">{data.title}</h2>
			<div class="contact-divider"></div>
		</header>

		<div class="contact-grid">
			<!-- Contact Information -->
			<div class="contact-info">
				<div class="contact-info__content">
					<h3 class="contact-info__title">Atención personalizada</h3>
					<p class="contact-info__description">
						Cuéntenos qué está organizando y le ayudamos a elegir el paquete adecuado para su celebración.
					</p>

					<div class="contact-channels">
						{hasValidWhatsApp && (
							<a
								href={getWhatsAppLink(whatsappMessage)}
								target="_blank"
								class="channel-link"
								data-track-event="whatsapp_contact_clicked"
								data-track-section="contact"
								data-track-cta="contact_whatsapp"
								data-track-label="Contáctanos por WhatsApp"
								data-track-intent="whatsapp"
								data-track-destination="whatsapp"
								data-campaign-code="FINAL-LANZAMIENTO-899"
								data-promo-code="LANZAMIENTO-899"
								data-track-value="899"
								data-track-currency="MXN"
							>
								<div class="channel-icon-wrapper">
									<Icon name="WhatsApp" size={24} />
								</div>
								<div class="channel-text">
									<span class="channel-label">Asesoría Inmediata</span>
									<span class="channel-value">Contáctanos por WhatsApp</span>
								</div>
							</a>
						)}

						<a
							href="mailto:contacto@celebra-me.com"
							target="_blank"
							class="channel-link"
							data-track-event="cta_clicked"
							data-track-section="contact"
							data-track-cta="contact_email"
							data-track-intent="email"
						>
							<div class="channel-icon-wrapper">
								<Icon name="Message" size={24} />
							</div>
							<div class="channel-text">
								<span class="channel-label">Vía Correo</span>
								<span class="channel-value">contacto@celebra-me.com</span>
							</div>
						</a>
					</div>
				</div>

				<div class="contact-info__footer">
					<p>Atención personalizada en cada detalle • Celebra-me © 2026</p>
				</div>
			</div>

			<!-- Contact Form Component -->
			<div class="contact-form-wrapper">
				<ContactForm />
			</div>
		</div>

		<!-- Scroll Action -->
		<div class="contact-footer">
			<ActionIcon
				icon="ArrowUpIcon"
				variant="scroll"
				href="#pricing"
				color="secondary"
				title="Regresar a los planes"
			/>
		</div>
	</div>
</section>
