---
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import type { ProductProofData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

import '@/styles/home/_product-proof.scss';

interface Props {
	data: ProductProofData;
}

const { data } = Astro.props;
const phone = getContactPhone();
---

<Section
	id="prueba-producto"
	class="product-proof"
	data-track-section="product-proof"
	aria-labelledby="product-proof-title"
>
	<!-- Subtle top gold hairline separator -->
	<div class="product-proof__top-separator" aria-hidden="true"></div>

	<Container class="product-proof__container">
		<div class="product-proof__layout">
			<div class="product-proof__narrative">
				<p class="product-proof__eyebrow reveal-fade-up stagger-1">INVITACIÓN + CONFIRMACIÓN</p>
				<h2 id="product-proof-title" class="product-proof__title reveal-fade-up stagger-2">{data.title}</h2>
				<p class="product-proof__description reveal-fade-up stagger-3">{data.description}</p>
				
				<div class="product-proof__cta-desktop">
					<WhatsAppButton
						className="product-proof__cta reveal-fade-up stagger-4"
						phone={phone}
						message={data.cta.message}
						label={data.cta.label}
						trackSection="product-proof"
						trackCta="whatsapp-product-proof"
						trackCampaign="DEMO-LANZAMIENTO-899"
						trackValue={899}
						trackCurrency="MXN"
						promoCode="LANZAMIENTO-899"
						ariaLabel="Solicitar asesoría por WhatsApp"
					/>
				</div>
			</div>

			<div class="product-proof__showcase reveal-fade-up stagger-5" aria-label="Invitación personalizada con funciones integradas">
				<div class="invitation-object">
					<div class="invitation-object__paper">
						<p class="invitation-object__label">Celebra-me Signature</p>
						<p class="invitation-object__date">Sábado · 15 de marzo</p>
						<h3 class="invitation-object__names">Mariana<br />&amp; Diego</h3>
						<p class="invitation-object__copy">Boda · RSVP personalizado · pase familiar</p>
						<div class="invitation-object__actions" aria-hidden="true">
							<span>Confirmar asistencia</span>
							<span>Ver pase</span>
						</div>
					</div>

					<div class="invitation-object__control-panel" aria-hidden="true">
						<div class="control-panel__row">
							<span class="control-panel__label">ASISTENCIA</span>
							<span class="control-panel__value control-panel__value--confirmed">
								<span class="control-panel__dot"></span>Confirmada
							</span>
						</div>
						<div class="control-panel__row">
							<span class="control-panel__label">PASE FAMILIAR</span>
							<span class="control-panel__value">2 invitados</span>
						</div>
						<div class="control-panel__row">
							<span class="control-panel__label">UBICACIÓN</span>
							<span class="control-panel__value">Enviada</span>
						</div>
					</div>

					<div class="invitation-object__phone" aria-hidden="true">
						<span class="invitation-object__phone-status">Confirmada</span>
						<span class="invitation-object__phone-pass">Pase 2 / 2</span>
					</div>
				</div>

				<div class="product-callouts" role="list">
					<div class="product-callout product-callout--top" role="listitem">
						<span class="product-callout__status"></span>
						<strong>RSVP confirmado</strong>
						<small>Respuesta registrada al instante</small>
					</div>
					<div class="product-callout product-callout--right" role="listitem">
						<span class="product-callout__status"></span>
						<strong>Pase 2/2</strong>
						<small>Acceso claro para cada familia</small>
					</div>
					<div class="product-callout product-callout--bottom" role="listitem">
						<span class="product-callout__status"></span>
						<strong>Ubicación lista</strong>
						<small>Datos listos antes del evento</small>
					</div>
					<div class="product-callout product-callout--left" role="listitem">
						<span class="product-callout__status"></span>
						<strong>Galería y música</strong>
						<small>Detalles que elevan la experiencia</small>
					</div>
				</div>
			</div>
		</div>

		<div class="product-proof__mobile-footer">
			<p class="product-proof__proof-line">Menos dudas para sus invitados. Menos mensajes para usted.</p>
			<WhatsAppButton
				className="product-proof__cta"
				phone={phone}
				message={data.cta.message}
				label={data.cta.label}
				trackSection="product-proof"
				trackCta="whatsapp-product-proof"
				trackCampaign="DEMO-LANZAMIENTO-899"
				trackValue={899}
				trackCurrency="MXN"
				promoCode="LANZAMIENTO-899"
				ariaLabel="Solicitar asesoría por WhatsApp"
			/>
		</div>

		<div class="product-proof__rail" aria-labelledby="proof-rail-heading">
			<h3 id="proof-rail-heading" class="product-proof__rail-title">Una invitación diseñada para coordinar sin perseguir mensajes</h3>
			
			<div class="proof-rail-flow" role="list">
				<div class="proof-rail-flow__item" role="listitem">
					<span class="proof-rail-flow__num">01</span>
					<div class="proof-rail-flow__content">
						<strong class="proof-rail-flow__label">Recibidas</strong>
						<span class="proof-rail-flow__text">Quién recibió la invitación</span>
					</div>
				</div>
				<div class="proof-rail-flow__item" role="listitem">
					<span class="proof-rail-flow__num">02</span>
					<div class="proof-rail-flow__content">
						<strong class="proof-rail-flow__label">Confirmadas</strong>
						<span class="proof-rail-flow__text">Quién confirmó asistencia</span>
					</div>
				</div>
				<div class="proof-rail-flow__item" role="listitem">
					<span class="proof-rail-flow__num">03</span>
					<div class="proof-rail-flow__content">
						<strong class="proof-rail-flow__label">Pases</strong>
						<span class="proof-rail-flow__text">Cuántos pases están registrados</span>
					</div>
				</div>
				<div class="proof-rail-flow__item" role="listitem">
					<span class="proof-rail-flow__num">04</span>
					<div class="proof-rail-flow__content">
						<strong class="proof-rail-flow__label">Recordatorios</strong>
						<span class="proof-rail-flow__text">A quién falta recordar</span>
					</div>
				</div>
			</div>
		</div>
	</Container>

	<!-- Subtle bottom gold hairline separator and fade transition -->
	<div class="product-proof__bottom-separator" aria-hidden="true"></div>
</Section>
