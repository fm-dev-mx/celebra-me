---
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import Icon from '@components/common/icons/Icon.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import type { ProductProofData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

import '@/styles/home/_product-proof.scss';

interface Props {
	data: ProductProofData;
}

const { data } = Astro.props;
const phone = getContactPhone();
---

<Section
	id="prueba-producto"
	class="product-proof"
	data-track-section="product-proof"
	aria-labelledby="product-proof-title"
>
	<Container class="product-proof__container">
		<div class="product-proof__intro">
			<p class="product-proof__eyebrow">Menos mensajes. Más control.</p>
			<h2 id="product-proof-title" class="product-proof__title">{data.title}</h2>
			<p class="product-proof__description">{data.description}</p>
			
			<div class="product-proof__comparison">
				<div class="comparison-card comparison-card--antes">
					<div class="comparison-card__badge">Antes</div>
					<h3 class="comparison-card__title">El caos habitual</h3>
					<ul class="comparison-card__list">
						<li>Mensajes sueltos y grupos saturados</li>
						<li>Confirmaciones a medias o duplicadas</li>
						<li>Cambios de ubicación sin leer</li>
					</ul>
				</div>
				<div class="comparison-card comparison-card--con">
					<div class="comparison-card__badge">Con Celebra-me</div>
					<h3 class="comparison-card__title">El control absoluto</h3>
					<ul class="comparison-card__list">
						<li>Confirmación (RSVP) automatizada y directa</li>
						<li>Control estricto de pases y acompañantes</li>
						<li>Itinerario y ubicaciones claras en un solo enlace</li>
					</ul>
				</div>
				<div class="comparison-card comparison-card--resultado">
					<div class="comparison-card__badge">Resultado</div>
					<h3 class="comparison-card__title">Tranquilidad para ti</h3>
					<p class="comparison-card__text">Invitados 100% informados en tiempo real, pases digitales listos en su celular y un panel de anfitrión siempre actualizado.</p>
				</div>
			</div>

			<WhatsAppButton
				className="product-proof__cta"
				phone={phone}
				message={data.cta.message}
				label={data.cta.label}
				trackSection="product-proof"
				trackCta="whatsapp-product-proof"
				trackCampaign="DEMO-LANZAMIENTO-899"
				trackValue={899}
				trackCurrency="MXN"
				promoCode="LANZAMIENTO-899"
				ariaLabel="Hablar sobre mi evento por WhatsApp"
			/>
		</div>

		<div class="product-proof__panel" aria-label="Funciones operativas de la invitación">
			{data.items.map((item) => (
				<article class="product-proof__item">
					<span class="product-proof__item-icon" aria-hidden="true">
						<Icon name={item.icon || 'CheckIcon'} />
					</span>
					<div class="product-proof__item-body">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</div>
				</article>
			))}
		</div>
	</Container>
</Section>
