---
import Container from '@components/layout/Container.astro';
import Section from '@components/layout/Section.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import type { ProductProofData } from '@/interfaces/ui/sections/landing-page.interface';
import { getContactPhone } from '@/utils/whatsapp';

import '@/styles/home/_product-proof.scss';

interface Props {
	data: ProductProofData;
}

const { data } = Astro.props;
const phone = getContactPhone();

// Sample guests for the panel preview. Labels, statuses and the metadata row mirror the real
// guest dashboard (`GuestSummary.tsx`, `GuestCard.tsx`, `GuestMobileDock.tsx`, `guest-presenter.ts`);
// names and counts are fictitious.
const sampleGuests = [
	{ name: 'Familia Torres', status: 'Confirmada', tone: 'confirmed', meta: '#01 · 4/4 asistentes' },
	{
		name: 'Ana y Luis',
		status: 'Por confirmar',
		tone: 'pending',
		meta: '#02 · 0/2 asistentes',
		action: 'Recordar',
	},
	{ name: 'Tía Carmen', status: 'Enviada', tone: 'sent', meta: '#03 · 0/3 asistentes' },
	{ name: 'Familia Ruiz', status: 'Confirmada', tone: 'confirmed', meta: '#04 · 5/5 asistentes' },
];
---

<Section
	id="prueba-producto"
	class="product-proof"
	data-track-section="product-proof"
	data-screenshot="landing-product-proof"
	aria-labelledby="product-proof-title"
>
	<Container class="product-proof__container">
		<header class="product-proof__header">
			{data.eyebrow && <p class="product-proof__eyebrow reveal-fade-up stagger-1">{data.eyebrow}</p>}
			<h2 id="product-proof-title" class="product-proof__title reveal-fade-up stagger-2">{data.title}</h2>
			<p class="product-proof__description reveal-fade-up stagger-3">{data.description}</p>
		</header>

		<figure class="product-proof__visual reveal-fade-up stagger-3">
			<div class="landing-phone" role="img" aria-label="Ejemplo del panel de invitados con confirmaciones">
				<div class="landing-phone__screen panel-preview" aria-hidden="true">
					<div class="panel-preview__event">
						<span class="panel-preview__event-label">Evento</span>
						<span class="panel-preview__event-name">XV años · Camila Torres Rivas</span>
					</div>
					<div class="panel-preview__summary">
						<span><small>Enviadas</small><strong>18<em>/</em>24</strong></span>
						<span><small>Confirmadas</small><strong>12</strong></span>
						<span><small>Asistentes</small><strong>31<em>/</em>52</strong></span>
					</div>
					<ul class="panel-preview__list">
						{sampleGuests.map((guest) => (
							<li class="panel-preview__card">
								<span class="panel-preview__name">{guest.name}</span>
								<span class={`panel-preview__status panel-preview__status--${guest.tone}`}>{guest.status}</span>
								<span class="panel-preview__meta">{guest.meta}</span>
								{guest.action && <span class="panel-preview__action">{guest.action}</span>}
							</li>
						))}
					</ul>
					<div class="panel-preview__dock">
						<span class="panel-preview__dock-item">+ Agregar</span>
						<span class="panel-preview__dock-item panel-preview__dock-item--main">→ Recordar (6)</span>
					</div>
				</div>
			</div>
			<figcaption class="product-proof__caption">Panel con datos de ejemplo.</figcaption>
		</figure>

		<div class="product-proof__body">
			<ul class="proof-rail-flow reveal-fade-up stagger-4" role="list">
				{data.features.map((item) => (
					<li class="proof-rail-flow__item">
						<strong class="proof-rail-flow__label">{item.title}</strong>
						<span class="proof-rail-flow__text">{item.text}</span>
					</li>
				))}
			</ul>

			<WhatsAppButton
				className="product-proof__cta"
				phone={phone}
				label={data.cta.label}
				trackSection="product-proof"
				trackCta="whatsapp-product-proof"
				campaignSection="PROOF"
			/>
		</div>
	</Container>
</Section>
