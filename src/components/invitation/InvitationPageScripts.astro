---
// Page-level progressive enhancements shared by the public and the dashboard preview routes.
// Render inside the `.event-theme-wrapper`: each script locates it from `document.currentScript`.
---

<script is:inline>
	// Overscroll and rubber-band areas show the document canvas: paint it with the
	// invitation paper instead of the site default.
	// Opt-in `--page-scrollbar-color` ("thumb track") themes the page scrollbar; with a
	// transparent track the canvas shows through, so while a solid envelope covers the
	// page the canvas takes the envelope color and no light strip remains at the edge.
	(function() {
		const wrapper = document.currentScript ? document.currentScript.closest('.event-theme-wrapper') : null;
		if (!wrapper) return;
		const root = document.documentElement;
		const paint = () => {
			const styles = getComputedStyle(wrapper);
			const paper = styles.getPropertyValue('--color-surface-primary').trim();
			const scrollbar = styles.getPropertyValue('--page-scrollbar-color').trim();
			let canvas = paper;
			if (scrollbar) {
				root.style.scrollbarColor = scrollbar;
				const envelope = wrapper.querySelector('ds-envelope-reveal');
				if (envelope && !envelope.hidden && root.classList.contains('envelope-open')) {
					const cover = getComputedStyle(envelope).backgroundColor;
					if (cover && cover !== 'rgba(0, 0, 0, 0)') canvas = cover;
				}
			}
			if (canvas) root.style.backgroundColor = canvas;
		};
		paint();
		window.addEventListener('load', paint, { once: true });
		window.addEventListener('envelope:opened', paint, { once: true });
	})();
</script>
<script is:inline>
	// Photograph loading state: each image gets `is-loaded` once its bytes have arrived
	// (`is-instant` as well when it was already complete before the first paint), and the
	// wrapper gets `has-image-fade`, so a profile that declares `--image-fade-animation` fades
	// late images in over its own placeholder. Without this script nothing is hidden.
	(function() {
		const wrapper = document.currentScript ? document.currentScript.closest('.event-theme-wrapper') : null;
		if (!wrapper) return;
		// Opt-in: only a profile that declares the fade animation hides late images.
		if (!getComputedStyle(wrapper).getPropertyValue('--image-fade-animation').trim()) return;
		const mark = (image, instant) => {
			image.classList.add('is-loaded');
			if (instant) image.classList.add('is-instant');
		};
		const settle = (event) => {
			if (event.target instanceof HTMLImageElement) mark(event.target, document.readyState === 'loading');
		};
		wrapper.addEventListener('load', settle, true);
		wrapper.addEventListener('error', settle, true);
		const scan = () => {
			wrapper.querySelectorAll('img:not(.is-loaded)').forEach((image) => {
				if (image.complete) mark(image, true);
			});
		};
		wrapper.classList.add('has-image-fade');
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', scan, { once: true });
		} else {
			scan();
		}
	})();
</script>
