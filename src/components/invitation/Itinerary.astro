---
import SplitWords from '@/components/invitation/SplitWords.astro';
import '@/styles/invitation/_itinerary.scss';
import TimelineList from './TimelineList.astro';
import ItineraryProgram from './ItineraryProgram.astro';
import ItineraryStackedCards from './ItineraryStackedCards.astro';
import ItineraryRibbonRoute from './ItineraryRibbonRoute.astro';
import type { ItineraryItem } from '@/lib/adapters/types';
import type { ItineraryVariant } from '@/lib/invitation/section-variants';
import type { ItineraryScene } from '@/lib/schemas/content/itinerary.schema';

interface Props {
	title?: string;
	subtitle?: string;
	items: ItineraryItem[];
	variant: ItineraryVariant;
	monogram?: string;
	closingNote?: string;
	/** Pinned scroll scene; the schema allows it on the standard variant only. */
	scene?: ItineraryScene;
}

const { title = "Itinerario", items, variant, monogram, subtitle, closingNote, scene } = Astro.props;
const isRibbonRoute = scene === 'ribbon-route' && variant === 'standard' && items.length >= 2;
---

<section class="itinerary" id="itinerary" data-screenshot-section="itinerary" data-variant={variant} data-itinerary-scene={isRibbonRoute ? scene : undefined}>
	<div class="itinerary__container">
		{isRibbonRoute ? (
			<ItineraryRibbonRoute title={title} subtitle={subtitle} items={items} closingNote={closingNote} />
		) : (
		<>
		{title && (
			<div class="itinerary__header">
				<SplitWords class="itinerary__title" text={title} />
				{subtitle && (
					<p class="itinerary__subtitle" data-itinerary-subtitle data-reveal-role="lede">{subtitle}</p>
				)}
				<div class="itinerary__header-flourish" aria-hidden="true">
					<span class="flourish-line"></span>
					<span class="flourish-diamond"></span>
					<span class="flourish-line"></span>
				</div>
			</div>
		)}

		<div class="itinerary__timeline">
			<div class="itinerary__line-start" aria-hidden="true"></div>

			{variant === 'timeline-paper' ? (
				<ItineraryProgram items={items} monogram={monogram} />
			) : variant === 'stacked-cards' ? (
				<ItineraryStackedCards items={items} />
			) : (
				<TimelineList items={items} />
			)}

			<div class="itinerary__line-end" aria-hidden="true"></div>
		</div>

		{closingNote && (
			<p class="itinerary__closing-note" data-itinerary-closing-note>{closingNote}</p>
		)}
		</>
		)}
	</div>
</section>
