---
// src/components/invitation/TimelineList.astro
import Icon from '@/components/common/icons/Icon.astro';
import type { IconName } from '@/lib/icons/icon-catalog';
import { formatTime12h, isValidTime } from '@/lib/time/time-format';

type TimelineItemData = {
	iconName: IconName;
	label: string;
	description?: string;
	time: string;
};

interface Props {
	items: TimelineItemData[];
	variant?: import('@/lib/theme/theme-contract').ItineraryVariant;
}

const { items, variant } = Astro.props;
---

<div class="itinerary__items-wrapper" data-itinerary-wrapper data-variant={variant}>
	<div class="itinerary__animated-line-container" aria-hidden="true">
		<svg width="2" height="100%" viewBox="0 0 2 100" preserveAspectRatio="none">
			<path
				d="M 1 0 L 1 100"
				stroke="var(--itinerary-line-color, var(--color-text-emphasis))"
				stroke-width="2"
			/>
		</svg>
	</div>

	<div class="itinerary__items">
		{items.map((item, index) => {
			const align = index % 2 === 0 ? 'left' : 'right';
			const timeValid = isValidTime(item.time);
			const timeStatus = timeValid ? 'confirmed' : 'pending';
			return (
				<div
					class:list={['itinerary__item', `itinerary__item--${align}`]}
					data-itinerary-item
					data-time-status={timeStatus}
					data-reveal-item
				>
					<div class="itinerary__item-content">
						{timeValid ? (
							<div class="itinerary__item-time">{formatTime12h(item.time)}</div>
						) : (
							<div class="itinerary__item-time itinerary__item-time--pending" data-itinerary-time-pending>
								Por confirmar
							</div>
						)}
						<h4 class="itinerary__item-label">{item.label}</h4>
						{item.description && (
							<p class="itinerary__item-description">{item.description}</p>
						)}
					</div>

					<div class="itinerary__item-icon-wrapper">
						<div class="itinerary__item-icon-inner">
							<Icon name={item.iconName} size={24} />
						</div>
					</div>

					<div class="itinerary__item-dot" aria-hidden="true" />
				</div>
			);
		})}
	</div>
</div>
