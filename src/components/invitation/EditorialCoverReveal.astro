---
// Editorial Cover Reveal — replaces the envelope when revealVariant === 'editorial-cover'.
import CacheSafeImage from '@/components/common/CacheSafeImage.astro';
import type { ImageMetadata } from 'astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import type { EditorialCoverExperience } from '@/lib/schemas/content/envelope.schema';
import type { CoverContentsEntry } from '@/lib/invitation/cover-contents';

interface Props {
	coverEdition?: string;
	coverVolume?: string;
	coverIssue?: string;
	/** One or two cover lines printed on the face; defaults to the XV edition lines. */
	coverLines?: string[];
	microcopy: string;
	eventSlug: string;
	variant?: string;
	/** Hero data for cover composition */
	heroName: string;
	heroSecondaryName?: string;
	heroLabel?: string;
	heroDate: string;
	heroVenueName?: string;
	previewState?: 'closed' | 'opened' | 'letter';
	/** Dedicated cover photograph (envelope.backdropImage); takes precedence over hero images. */
	coverImage?: ImageMetadata | ImageAsset;
	backgroundImage?: ImageMetadata | ImageAsset;
	portrait?: ImageMetadata | ImageAsset;
	focalPoint?: string;
	focalPointMobile?: string;
	/** 'collector' renders the drag-to-open bending magazine; default is the standard cover. */
	coverExperience?: EditorialCoverExperience;
	/** Collector edition: guest the copy is printed for ("Edición exclusiva para: …"). */
	guestName?: string;
	/** Collector edition: seats reserved for that guest. */
	guestSeats?: number;
	/** Collector edition: table of contents, in the invitation's section order. */
	coverContents?: CoverContentsEntry[];
	/** Collector edition: photograph printed on the first inner page (hands off to the hero). */
	spreadImage?: ImageMetadata | ImageAsset;
}

const {
	coverEdition = 'I',
	coverVolume,
	coverIssue,
	coverLines: coverLinesProp,
	microcopy,
	eventSlug,
	variant,
	heroName,
	heroSecondaryName,
	heroLabel,
	heroDate,
	heroVenueName,
	previewState,
	coverImage: dedicatedCoverImage,
	backgroundImage,
	portrait,
	focalPoint,
	focalPointMobile,
	coverExperience = 'standard',
	guestName,
	guestSeats,
	coverContents = [],
	spreadImage,
} = Astro.props;

const isCollector = coverExperience === 'collector';

// ── Collector edition copy: magazine furniture that never repeats the hero's text. ──
const heroDateValue = new Date(heroDate);
const issueMonth = heroDateValue
	.toLocaleDateString('es-MX', { month: 'long', timeZone: 'UTC' })
	.toUpperCase();
const issueYear = heroDateValue.getUTCFullYear();
const issueRail = [
	coverVolume && `VOL. ${coverVolume}`,
	coverEdition && `NÚM. ${coverEdition}`,
	`${issueMonth} ${issueYear}`,
].filter(Boolean) as string[];
// Decorative ISSN built from the event day and month (e.g. 13 Nov 2026 → 1311-2026).
const issn = `ISSN ${String(heroDateValue.getUTCDate()).padStart(2, '0')}${String(
	heroDateValue.getUTCMonth() + 1,
).padStart(2, '0')}-${issueYear}`;
const coverTeasers = coverContents.slice(0, 2);
const trimmedGuestName = guestName?.trim();
const seatsLabel =
	typeof guestSeats === 'number' && guestSeats > 0
		? `${guestSeats} ${guestSeats === 1 ? 'pase' : 'pases'}`
		: undefined;
// Deterministic, decorative barcode derived from the slug.
let barcodeX = 0;
const barcodeRects = Array.from(`${eventSlug}-celebra-me`)
	.flatMap((char, index) => {
		const code = char.charCodeAt(0);
		return [
			{ width: 1 + (code % 3), gap: 1 + ((code >> 2) % 2) },
			{ width: 1 + ((code + index) % 2), gap: 1 + ((code >> 1) % 3) },
		];
	})
	.slice(0, 34)
	.map((bar) => {
		const rect = { x: barcodeX, width: bar.width };
		barcodeX += bar.width + bar.gap;
		return rect;
	});
const barcodeWidth = barcodeX;

const ctaText = coverEdition ? 'ABRIR INVITACIÓN' : 'DESCUBRIR';
const coverLines =
	coverLinesProp && coverLinesProp.length > 0
		? coverLinesProp
		: ['Una noche de estreno', 'Retrato de una celebración'];
const coverKicker = coverEdition ? `Edición ${coverEdition}` : heroLabel;
const formattedDate = heroDateValue.toLocaleDateString('es-MX', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});

// Build magazine-style metadata for the cover rail.
const issueParts: { label: string; value: string }[] = [];
if (coverVolume) issueParts.push({ label: 'VOL.', value: coverVolume });
if (coverIssue) issueParts.push({ label: 'NÚM.', value: coverIssue });
if (coverEdition) issueParts.push({ label: 'EDICIÓN', value: coverEdition });

// Resolve the cover image: dedicated cover photograph, then hero background, then portrait.
const resolveImage = (image: ImageMetadata | ImageAsset): ImageMetadata | string =>
	'src' in image ? image.src : image;

const hasImageSource = (image?: ImageMetadata | ImageAsset): image is ImageMetadata | ImageAsset =>
	Boolean(image && ('src' in image ? image.src : image));

const coverImage = [dedicatedCoverImage, backgroundImage, portrait].find(hasImageSource);
const coverDelivery = coverImage && 'delivery' in coverImage ? coverImage.delivery : undefined;
const resolvedImage = coverImage ? resolveImage(coverImage) : null;
const spreadSource = spreadImage ? resolveImage(spreadImage) : null;
const spreadDelivery = spreadImage && 'delivery' in spreadImage ? spreadImage.delivery : undefined;

// For SSR fallback when JS is disabled: compute the skip URL
const skipParams = new URLSearchParams(Astro.url.search);
skipParams.set('skipEnvelope', 'true');
const skipUrl = `${Astro.url.pathname}?${skipParams.toString()}`;
const shouldRenderHidden =
	Astro.url.searchParams.get('skipEnvelope') === 'true' || previewState === 'opened';
---

<ds-editorial-cover
	class:list={['editorial-cover-wrapper', previewState === 'letter' && 'is-letter-held']}
	data-screenshot="reveal-section"
	data-event-slug={eventSlug}
	data-variant={variant || ''}
	data-preview-state={previewState}
	data-cover-experience={coverExperience}
	hidden={shouldRenderHidden ? true : undefined}
>
	<div class="editorial-cover-container">
		{isCollector ? (
			<>
				<!-- Collector edition: a printed magazine on a table; the guest turns the cover. -->
				<div class="ec-book" data-collector-book aria-hidden="true">
					<span class="ec-book__edge"></span>

					<!-- First inner page (right-hand page of the opening spread). -->
					<div class="ec-book__first-page">
						{spreadSource && (
							<CacheSafeImage
								class="ec-page__photo"
								src={spreadSource}
								delivery={spreadDelivery}
								alt=""
								width={1080}
								height={1620}
								format="webp"
								quality={80}
								loading="eager"
							/>
						)}
						<span class="ec-page__folio">pág. 03</span>
					</div>

					<div class="ec-book__front" data-collector-front>
						{resolvedImage && (
							<CacheSafeImage
								class="ec-face__image"
								src={resolvedImage}
								delivery={coverDelivery}
								alt=""
								width={1080}
								height={1620}
								format="webp"
								quality={82}
								loading="eager"
								fetchpriority="high"
							/>
						)}
						<span class="ec-face__gloss"></span>
						<span class="ec-face__spine"></span>
						<span class="ec-face__masthead">CELEBRA · ME</span>
						<span class="ec-face__rail">
							{issueRail.map((part) => <span>{part}</span>)}
						</span>
						<span class="ec-face__kicker">En portada</span>
						<span class="ec-face__star">
							{heroName}
							{heroSecondaryName && <> &amp; {heroSecondaryName}</>}
						</span>
						{coverTeasers.length > 0 && (
							<span class="ec-face__teasers">
								{coverTeasers.map((entry) => (
									<span class="ec-face__teaser">
										<span class="ec-face__teaser-kicker">{entry.kicker}</span>
										<span class="ec-face__teaser-dash" aria-hidden="true">—</span>
										<span class="ec-face__teaser-label">{entry.deck ?? entry.label}</span>
										<span class="ec-face__teaser-page">{entry.page}</span>
									</span>
								))}
							</span>
						)}
						<span class="ec-face__seal">
							<span class="ec-face__seal-line">Número</span>
							<span class="ec-face__seal-mark" aria-hidden="true">✦</span>
							<span class="ec-face__seal-line">de colección</span>
						</span>
						<span class="ec-face__sill">
							<span class="ec-face__label">
								{trimmedGuestName ? (
									<>
										<span class="ec-face__label-kicker">Edición exclusiva para</span>
										<span class="ec-face__label-name">
											{trimmedGuestName}
											{seatsLabel && <span class="ec-face__label-seats"> · {seatsLabel}</span>}
										</span>
									</>
								) : (
									<span class="ec-face__label-kicker">Ejemplar de colección</span>
								)}
							</span>
							<span class="ec-face__barcode">
								<svg viewBox={`0 0 ${barcodeWidth} 24`} preserveAspectRatio="none">
									{barcodeRects.map((rect) => (
										<rect x={rect.x} y="0" width={rect.width} height="24" />
									))}
								</svg>
								<span class="ec-face__price">{issn}</span>
							</span>
						</span>
						<span class="ec-face__corner"></span>
					</div>

					<!-- Inside front cover: printed contents, reflected across the fold while turning. -->
					<div class="ec-book__flap" data-collector-flap>
						<div class="ec-book__flap-content">
							<span class="ec-inside__kicker">En este número</span>
							<span class="ec-inside__list">
								{coverContents.map((entry) => (
									<span class="ec-inside__entry">
										<span class="ec-inside__page">{entry.page}</span>
										<span class="ec-inside__label">{entry.label}</span>
									</span>
								))}
							</span>
							<span class="ec-inside__mark">{coverEdition ?? 'XV'}</span>
							<span class="ec-inside__folio">pág. 02</span>
						</div>
					</div>

					<div class="ec-book__shadows">
						<span class="ec-book__fold" data-collector-fold></span>
					</div>
				</div>

				<div class="sr-only">
					<h1>
						{heroName}
						{heroSecondaryName && <> &amp; {heroSecondaryName}</>}
					</h1>
					{coverKicker && <p>{coverKicker}</p>}
					<p>{formattedDate}</p>
					{heroVenueName && <p>{heroVenueName}</p>}
				</div>

				<!-- Bookmark ribbon between the pages: the call to action. -->
				<div class="editorial-cover__action ec-ribbon-anchor">
					<button
						type="button"
						class="editorial-cover__cta ec-ribbon"
						data-editorial-open
						aria-label={microcopy}
					>
						<span class="ec-ribbon__text" aria-hidden="true">Abrir</span>
					</button>
					<noscript>
						<a href={skipUrl} class="editorial-cover__cta editorial-cover__cta--fallback">
							<span class="editorial-cover__cta-text">{ctaText}</span>
						</a>
					</noscript>
				</div>
				<p class="ec-hint" aria-hidden="true">Jale el listón o pase la página.</p>
			</>
		) : (
		<>
		<!-- Photographic cover background -->
		{resolvedImage && (
			<div class="editorial-cover__background" aria-hidden="true">
				<CacheSafeImage
					src={resolvedImage}
					delivery={coverDelivery}
					alt=""
					width={1080}
					height={1920}
					format="webp"
					quality={80}
					loading="eager"
				/>
			</div>
		)}

		<!-- Paper grain overlay -->
		<div class="editorial-cover__grain" aria-hidden="true"></div>

		<!-- Magazine masthead -->
		<header class="editorial-masthead">
			<p class="editorial-masthead__eyebrow">Portada digital</p>
			<span class="editorial-masthead__brand">CELEBRA <span aria-hidden="true">·</span> ME</span>
		</header>

		{issueParts.length > 0 && (
			<aside class="editorial-cover__metadata" aria-label="Datos de portada">
				{issueParts.map((item) => (
					<span class="editorial-cover__metadata-item">
						<span class="editorial-cover__metadata-label">{item.label}</span>
						<span class="editorial-cover__metadata-value">{item.value}</span>
					</span>
				))}
			</aside>
		)}

		<!-- Cover headline area -->
		<div class="editorial-cover__content">
			<div class="editorial-cover__cover-lines" aria-label="Líneas editoriales">
				<span class="editorial-cover__cover-line">{coverLines[0]}</span>
				<span class="editorial-cover__cover-line editorial-cover__cover-line--secondary">
					{coverLines[1]}
				</span>
			</div>

			{coverKicker && <span class="editorial-cover__label">{coverKicker}</span>}

			<h1 class="editorial-cover__headline">
				{heroName}
				{heroSecondaryName && (
					<>
						<br />
						<span class="editorial-cover__ampersand">&</span>
						<span class="editorial-cover__secondary">{heroSecondaryName}</span>
					</>
				)}
			</h1>
		</div>

		<!-- Event details -->
		<div class="editorial-cover__details" aria-label="Datos del evento">
			<p class="editorial-cover__date">{formattedDate}</p>
			{heroVenueName && <p class="editorial-cover__venue">{heroVenueName}</p>}
		</div>

		<!-- CTA button -->
		<div class="editorial-cover__action">
			<button
				type="button"
				class="editorial-cover__cta"
				data-editorial-open
				aria-label={microcopy}
			>
				<span class="editorial-cover__cta-text">{ctaText}</span>
				<svg class="editorial-cover__cta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14M12 5l7 7-7 7"/>
				</svg>
			</button>
			<!-- No-JS fallback -->
			<noscript>
				<a href={skipUrl} class="editorial-cover__cta editorial-cover__cta--fallback">
					<span class="editorial-cover__cta-text">{ctaText}</span>
				</a>
			</noscript>
		</div>

		<!-- Magazine footer metadata -->
		<footer class="editorial-cover__footer">
			<span class="editorial-cover__issue">Colección editorial · Celebra Me</span>
		</footer>
		</>
		)}
	</div>
</ds-editorial-cover>

<script>
	import { setupCollectorReveal } from './editorial-cover/collector-reveal';
	import { isVisualCaptureMode } from '@/lib/invitation/visual-capture-mode';

	const EXIT_ANIMATION_MS = 1600;
	const EXIT_COMPLETION_FALLBACK_MS = EXIT_ANIMATION_MS + 600;

	class DsEditorialCover extends HTMLElement {
		connectedCallback() {
			const { eventSlug } = this.dataset;
			if (!eventSlug) return;

			const invitationRoot = this.closest('.event-theme-wrapper[data-event-slug]');
			if (!invitationRoot) return;

			const isDemoInvitation = (invitationRoot as HTMLElement).dataset.isDemo === 'true';
			const openButton = this.querySelector<HTMLButtonElement>('[data-editorial-open]');
			let hasRevealed = false;

			const clearRevealPhase = () => {
				delete this.dataset.editorialRevealPhase;

				if (invitationRoot instanceof HTMLElement) {
					delete invitationRoot.dataset.editorialRevealPhase;
				}
			};

			const setRevealPhase = () => {
				this.dataset.editorialRevealPhase = 'revealing';

				if (invitationRoot instanceof HTMLElement) {
					invitationRoot.dataset.editorialRevealPhase = 'revealing';
				}
			};

			// Screenshot contract: ?reveal=letter — keep cover measurable (not hidden).
			if (this.dataset.previewState === 'letter') {
				this.classList.add('is-letter-held');
				this.hidden = false;
				document.documentElement.classList.add('envelope-open');
				if (invitationRoot instanceof HTMLElement) {
					invitationRoot.dataset.revealState = 'letter-held';
				}
				return;
			}

			// Preview state handling
			if (this.dataset.previewState === 'opened') {
				clearRevealPhase();
				document.documentElement.classList.remove('envelope-open');
				if (invitationRoot instanceof HTMLElement) {
					invitationRoot.dataset.revealState = 'revealed';
				}
				this.hidden = true;
				return;
			}

			let ctaHintTimer = 0;
			let lastCtaHint = 0;
			let touchStartY = 0;
			// Disabling the button drops focus to <body>, so remember where focus was at commit.
			let focusWasInside = false;
			const completeReveal = () => {
				if (hasRevealed) return;
				hasRevealed = true;

				// Clean up CTA scroll hint
				window.clearTimeout(ctaHintTimer);
				if (openButton) openButton.removeAttribute('data-cta-hint');

				const shouldMoveFocus = focusWasInside || this.contains(document.activeElement);

				clearRevealPhase();
				document.documentElement.classList.remove('envelope-open');

				if (invitationRoot instanceof HTMLElement) {
					invitationRoot.dataset.revealState = 'revealed';
				}

				window.requestAnimationFrame(() => {
					const hero = document.getElementById('inicio');
					if (hero instanceof HTMLElement) {
						hero.scrollIntoView({ block: 'start', inline: 'nearest', behavior: 'auto' });
						if (shouldMoveFocus) {
							if (!hero.hasAttribute('tabindex')) {
								hero.setAttribute('tabindex', '-1');
							}
							hero.focus({ preventScroll: true });
						}
					} else {
						window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
					}

					this.hidden = true;
				});

				window.dispatchEvent(new CustomEvent('envelope:opened', { detail: { eventSlug } }));
			};

			// Check localStorage skip (same as envelope)
			const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			// Capture tooling must not meet a timer-scheduled idle cue mid-animation.
			const collectorReducedMotion = motionPreference || isVisualCaptureMode();
			const storageKey = 'envelope-opened-' + eventSlug;
			const stored = (() => {
				try {
					return !isDemoInvitation && localStorage.getItem(storageKey) === 'true';
				} catch {
					return false;
				}
			})();
			const skipEnvelope = new URLSearchParams(window.location.search).get('skipEnvelope') === 'true';
			const forceEnvelope = new URLSearchParams(window.location.search).get('forceEnvelope') === 'true';

			// skipEnvelope param — same noscript fallback path as envelope
			if (skipEnvelope) {
				completeReveal();
				this.hidden = true;
				return;
			}

			if (stored && !forceEnvelope) {
				completeReveal();
				this.hidden = true;
				return;
			}

			document.documentElement.classList.add('envelope-open');

			const rememberOpened = () => {
				if (isDemoInvitation) return;
				try {
					localStorage.setItem(storageKey, 'true');
				} catch {
					// Ignore localStorage access errors
				}
			};

			if (this.dataset.coverExperience === 'collector') {
				setupCollectorReveal({
					root: this,
					openButton,
					reducedMotion: collectorReducedMotion,
					onCommit: () => {
						focusWasInside = this.contains(document.activeElement);
						if (openButton) {
							openButton.disabled = true;
							openButton.setAttribute('aria-disabled', 'true');
						}
						rememberOpened();
					},
					onExitStart: setRevealPhase,
					onComplete: completeReveal,
				});
			}

			openButton?.addEventListener('click', (event) => {
				if (this.dataset.coverExperience === 'collector') return;
				event.stopPropagation();
				event.preventDefault();
				openButton.disabled = true;
				openButton.setAttribute('aria-disabled', 'true');

				rememberOpened();

				if (motionPreference) {
					completeReveal();
					return;
				}

				this.classList.add('is-opening');
				setRevealPhase();

				const onAnimationEnd = (e: AnimationEvent) => {
					if (e.animationName.includes('editorialCoverWrapperExit')) {
						this.removeEventListener('animationend', onAnimationEnd);
						completeReveal();
					}
				};

				this.addEventListener('animationend', onAnimationEnd);

				// Fallback timeout
				window.setTimeout(() => {
					if (!hasRevealed) {
						this.removeEventListener('animationend', onAnimationEnd);
						completeReveal();
					}
				}, EXIT_COMPLETION_FALLBACK_MS);
			});

			// ── Scroll-intent CTA hint ──
			// When the cover is sealed and the user tries to scroll (wheel, touch,
			// or keyboard arrow/page), briefly highlight the CTA to indicate it
			// must be pressed to open the invitation.
			const CTA_HINT_DURATION_MS = 1200;
			const CTA_HINT_THROTTLE_MS = 2000;

			const cueCta = () => {
				if (hasRevealed || !openButton || motionPreference) return;
				const now = Date.now();
				if (now - lastCtaHint < CTA_HINT_THROTTLE_MS) return;
				lastCtaHint = now;

				openButton.dataset.ctaHint = 'active';
				window.clearTimeout(ctaHintTimer);
				ctaHintTimer = window.setTimeout(() => {
					openButton.removeAttribute('data-cta-hint');
				}, CTA_HINT_DURATION_MS);
			};

			// Desktop mouse-wheel scroll
			this.addEventListener('wheel', () => { cueCta(); }, { passive: true });

			// Mobile touch scroll — track touch start and hint on threshold
			this.addEventListener('touchstart', (e: TouchEvent) => {
				touchStartY = e.touches[0]?.clientY ?? 0;
			}, { passive: true });

			this.addEventListener('touchmove', (e: TouchEvent) => {
				const dy = Math.abs((e.touches[0]?.clientY ?? 0) - touchStartY);
				if (dy > 8) cueCta();
			}, { passive: true });

			// Keyboard scroll intent — only when CTA is not focused (so Enter/Space on
			// the button still activates it without the hint interfering)
			this.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.target === openButton) return;
				if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp'].includes(e.key)) {
					cueCta();
				}
			});
		}
	}

	customElements.define('ds-editorial-cover', DsEditorialCover);
</script>

<style define:vars={{ coverFocalPoint: focalPoint || 'center', coverFocalPointMobile: focalPointMobile || 'center' }}>
	.editorial-cover-wrapper {
		--cover-focal-point: var(--coverFocalPoint);
		--cover-focal-point-mobile: var(--coverFocalPointMobile);
	}
</style>
