---
import '@/styles/invitation/_interlude.scss';
import OptimizedImage from '@/components/common/OptimizedImage.astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';

interface Props {
	image: ImageAsset;
	alt?: string;
	height?: 'screen' | 'tall' | 'medium';
	presentation?: 'bleed' | 'framed';
	focalPoint?: string;
	focalPointDesktop?: string;
	lightX?: string;
	lightY?: string;
	overlayOpacity?: string;
	interludeIndex?: number;
}

const {
	image,
	alt = '',
	height = 'screen',
	presentation = 'bleed',
	focalPoint,
	focalPointDesktop,
	lightX,
	lightY,
	overlayOpacity,
	interludeIndex,
} = Astro.props;

// Interludes render after the hero/reveal sections
// they are below the initial mobile viewport. Keep them lazy to avoid competing
// with the real above-the-fold/LCP content.

// Framed interludes keep the photograph's own ratio, so the image box uses intrinsic
// dimensions when the asset carries them and the bleed canvas size otherwise.
const isFramed = presentation === 'framed';
const intrinsic = typeof image.src === 'object' ? image.src : undefined;
const imageWidth = isFramed && intrinsic ? intrinsic.width : 1920;
const imageHeight = isFramed && intrinsic ? intrinsic.height : 1400;
---

<section
	class="invitation-interlude"
	data-variant="standard"
	data-presentation={presentation}
	data-height={isFramed ? undefined : height}
	data-interlude-index={interludeIndex}
	data-screenshot-section={`interlude${interludeIndex ? `-${interludeIndex}` : ''}`}
	data-focal-point={focalPoint}
	data-focal-point-desktop={focalPointDesktop}
	data-light-x={lightX}
	data-light-y={lightY}
	data-overlay-opacity={overlayOpacity}
	aria-label={alt}
>
	<div class="invitation-interlude__media">
		<OptimizedImage
			imagePath={image}
			alt={alt}
			width={imageWidth}
			height={imageHeight}
			class="invitation-interlude__image"
			loading="lazy"
			decoding="async"
			fetchpriority="low"
			quality={80}
		/>
	</div>
</section>
