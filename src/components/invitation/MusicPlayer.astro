---
import Icon from '@/components/common/icons/Icon.astro';
import '@/styles/invitation/_music-player.scss';

interface Props {
	url?: string;
	autoPlay?: boolean;
	title?: string;
	revealMode?: 'envelope' | 'immediate';
	variant?: string;
	/** Second at which playback starts and loops back to (skips an intro). */
	startAt?: number;
}

const {
	url = '',
	autoPlay = false,
	title = 'Reproducir música',
	revealMode = 'envelope',
	variant,
	startAt = 0,
} = Astro.props;

const hasAudio = Boolean(url.trim());
const startSeconds = Number.isFinite(startAt) && startAt > 0 ? startAt : 0;
// A media fragment starts the first play at the offset; looping back is handled in the script.
const audioSrc = hasAudio && startSeconds > 0 ? `${url}#t=${startSeconds}` : url;
const promptText = 'Reproducir música';
const isVisualCapture =
	Astro.url.searchParams.has('screenshot') || Astro.url.searchParams.has('skipEnvelope');
// Music that starts with the envelope tap must be buffered by then; other tracks load on demand.
const preload =
	!isVisualCapture && hasAudio && autoPlay && revealMode === 'envelope' ? 'auto' : 'none';
---

<div
	class="music-player"
	data-music-player
	data-auto-play={hasAudio && autoPlay ? 'true' : 'false'}
	data-reveal-mode={revealMode}
	data-variant={variant}
	data-has-audio={hasAudio ? 'true' : 'false'}
	data-title={title || promptText}
	data-pending-label={promptText}
	data-start-at={startSeconds > 0 ? String(startSeconds) : undefined}
>
	{hasAudio ? (
		<audio src={audioSrc} loop={startSeconds === 0} preload={preload} data-music-audio></audio>
	) : null}

	<span class="music-player__prompt" data-music-prompt>{promptText}</span>

	<div class="music-player__controls">
		<button
			type="button"
			class="music-player__button music-player__button--play music-player__button--pulsing"
			data-music-toggle
			aria-label={title || promptText}
		>
			<span data-icon-play><Icon name="Play" size={24} /></span>
			<span data-icon-pause hidden><Icon name="Pause" size={24} /></span>
		</button>
	</div>
</div>

<script>
	const players = Array.from(document.querySelectorAll('[data-music-player]'));

	players.forEach((player) => {
		if (!(player instanceof HTMLElement)) {
			return;
		}

		const invitationRoot = player.closest('[data-event-slug]');
		const audio = player.querySelector('[data-music-audio]');
		const prompt = player.querySelector('[data-music-prompt]');
		const toggle = player.querySelector('[data-music-toggle]');
		const playIcon = player.querySelector('[data-icon-play]');
		const pauseIcon = player.querySelector('[data-icon-pause]');
		const autoPlay = player.dataset.autoPlay === 'true';
		const revealMode = player.dataset.revealMode || 'envelope';
		const hasAudio = player.dataset.hasAudio === 'true';
		const audioTitle = player.dataset.title || 'Reproducir música';
		const startAt = Number(player.dataset.startAt || 0);

		// Offset playback: make sure the first play starts at `startAt` and every loop returns there.
		if (audio instanceof HTMLAudioElement && startAt > 0) {
			audio.addEventListener(
				'loadedmetadata',
				() => {
					if (audio.currentTime < startAt - 0.5) audio.currentTime = startAt;
				},
				{ once: true },
			);
			audio.addEventListener('ended', () => {
				audio.currentTime = startAt;
				void audio.play().catch(() => undefined);
			});
		}
		const pendingTitle = player.dataset.pendingLabel || 'La canción se anunciará pronto';

		if (
			!(toggle instanceof HTMLButtonElement) ||
			!(playIcon instanceof HTMLElement) ||
			!(pauseIcon instanceof HTMLElement)
		) {
			return;
		}

		const FADE_IN_MS = 1200;
		const promptText = player.dataset.pendingLabel || 'Reproducir música';
		let isPlaying = false;
		let isStarting = false;
		let fadeFrame: number | undefined = undefined;
		let dismissTimer: number | undefined = undefined;

		const syncState = () => {
			playIcon.hidden = isPlaying;
			pauseIcon.hidden = !isPlaying;
			toggle.classList.toggle('music-player__button--pulsing', hasAudio && !isPlaying);
			toggle.setAttribute('aria-label', isPlaying ? 'Pausar música' : hasAudio ? audioTitle : pendingTitle);
		};

		const fadeOutPrompt = () => {
			if (!(prompt instanceof HTMLElement)) {
				return;
			}
			prompt.classList.add('is-fading-out');
			prompt.classList.remove('is-fading-in');
			prompt.addEventListener(
				'animationend',
				() => {
					if (prompt.classList.contains('is-fading-out')) {
						prompt.hidden = true;
						prompt.classList.remove('is-fading-out');
					}
				},
				{ once: true }
			);
		};

		const hidePromptLater = (delayMs = 4000) => {
			if (!(prompt instanceof HTMLElement)) {
				return;
			}
			window.clearTimeout(dismissTimer);
			dismissTimer = window.setTimeout(fadeOutPrompt, delayMs);
		};

		const showPrompt = (text: string) => {
			if (!(prompt instanceof HTMLElement)) {
				return;
			}
			prompt.textContent = text;
			prompt.classList.remove('is-fading-out');
			prompt.classList.add('is-fading-in');
			prompt.hidden = false;
		};

		// Volume ramp after the first frame of sound. iOS ignores `volume` (always 1), so there the
		// track simply starts at full level.
		const fadeIn = (media: HTMLAudioElement) => {
			if (media.paused) return;
			window.cancelAnimationFrame(fadeFrame ?? 0);
			const startedAt = performance.now();
			media.volume = 0;
			const step = (now: number) => {
				const progress = Math.min(1, (now - startedAt) / FADE_IN_MS);
				media.volume = progress * progress;
				if (progress < 1 && !media.paused) {
					fadeFrame = window.requestAnimationFrame(step);
				} else {
					media.volume = 1;
				}
			};
			fadeFrame = window.requestAnimationFrame(step);
		};

		// `play()` runs synchronously in the caller's gesture; a rejection (autoplay policy, failed
		// load) leaves the control paused and asks for one tap instead of logging an error.
		const play = (withFade: boolean) => {
			if (!hasAudio || !(audio instanceof HTMLAudioElement) || isPlaying || isStarting) {
				return;
			}
			isStarting = true;
			if (withFade) {
				audio.volume = 0;
			}
			audio
				.play()
				.then(() => {
					if (withFade) {
						fadeIn(audio);
						showPrompt('Pausar música');
						hidePromptLater();
					}
				})
				.catch(() => {
					audio.volume = 1;
					showPrompt(promptText);
					hidePromptLater(6000);
				})
				.finally(() => {
					isStarting = false;
				});
		};

		// The button mirrors the element, whatever paused or resumed it (toggle, OS media controls,
		// an interrupted stream).
		if (audio instanceof HTMLAudioElement) {
			audio.addEventListener('playing', () => {
				isPlaying = true;
				syncState();
			});
			audio.addEventListener('pause', () => {
				isPlaying = false;
				window.cancelAnimationFrame(fadeFrame ?? 0);
				audio.volume = 1;
				syncState();
			});
		}

		const removeStartListeners = () => {
			window.removeEventListener('envelope:open-requested', startAudio);
			window.removeEventListener('envelope:opened', startAudio);
			document.removeEventListener('click', startAudio);
			document.removeEventListener('touchstart', startAudio);
		};

		const startAudio = () => {
			removeStartListeners();
			play(true);
		};

		if (hasAudio && autoPlay) {
			if (revealMode === 'envelope') {
				// Start inside the envelope tap; `envelope:opened` stays as a fallback for reveals that
				// skip the tap (it may be refused without a gesture, which leaves the control paused).
				window.addEventListener('envelope:open-requested', startAudio, { once: true });
				window.addEventListener('envelope:opened', startAudio, { once: true });
			} else {
				document.addEventListener('click', startAudio, { once: true });
				document.addEventListener('touchstart', startAudio, { once: true });
			}
		}

		const isInvitationRevealed = () =>
			invitationRoot instanceof HTMLElement
				? invitationRoot.dataset.revealState === 'revealed'
				: true;

		const handleScrollDismiss = () => {
			if (window.scrollY > 100 && prompt instanceof HTMLElement && !prompt.hidden) {
				window.clearTimeout(dismissTimer);
				dismissTimer = window.setTimeout(fadeOutPrompt, 1500);
				window.removeEventListener('scroll', handleScrollDismiss);
			}
		};

		if (revealMode === 'immediate' || isInvitationRevealed()) {
			hidePromptLater();
			window.addEventListener('scroll', handleScrollDismiss, { passive: true });
		} else {
			window.addEventListener('envelope:opened', () => {
				hidePromptLater();
				window.addEventListener('scroll', handleScrollDismiss, { passive: true });
			}, { once: true });
		}

		toggle.addEventListener('click', () => {
			removeStartListeners();
			if (!hasAudio || !(audio instanceof HTMLAudioElement)) {
				if (prompt instanceof HTMLElement) {
					prompt.hidden = false;
					prompt.classList.remove('is-fading-out');
					prompt.classList.add('is-fading-in');
					hidePromptLater(2500);
				}
				return;
			}

			if (isPlaying) {
				audio.pause();
				return;
			}

			play(false);
			if (prompt instanceof HTMLElement && !prompt.hidden) {
				fadeOutPrompt();
			}
			window.removeEventListener('scroll', handleScrollDismiss);
		});

		syncState();
	});
</script>
