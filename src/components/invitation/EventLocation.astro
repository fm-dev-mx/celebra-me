---
/*
  EventLocation Component
  Displays modern, interactive cards for the event venues.
 */
import '@/styles/invitation/_event-location.scss';
import VenueCard from '@/components/invitation/components/VenueCard.astro';
import VenueProgramEntry from '@/components/invitation/components/VenueProgramEntry.astro';
import { formatVenueDateForDisplay } from '@/lib/invitation/venue-datetime';
import { groupVenues, type GroupedVenue, type VenueEntry } from '@/lib/invitation/location-helper';
import Icon from '@/components/common/icons/Icon.astro';
import SectionNavButton from '@/components/invitation/components/SectionNavButton.astro';
import { sanitizeIndicationHtml } from '@/lib/invitation/indication-html';
import { plainImgSrc } from '@/lib/assets/vercel-image-policy';
import { buildVenueCalendarLinks } from '@/lib/calendar/venue-calendar-links';

import type { ImageAsset } from '@/lib/assets/asset-registry';
import type { IconName } from '@/lib/icons/icon-catalog';
import type { IndicationStyleVariant } from '@/lib/theme/theme-contract';
import type {
	LocationIndicationsLayout,
	LocationIndicationsStyle,
	LocationMapStyle,
	LocationPresentation,
} from '@/lib/invitation/location-presentation';
import type { LocationVariant } from '@/lib/invitation/section-variants';

interface Indication {
	iconName: IconName;
	styleVariant: IndicationStyleVariant;
	text: string;
	title?: string;
}

interface Props {
	isLocked?: boolean;
	lockedTitle?: string;
	lockedMessage?: string;
	lockedCtaLabel?: string;
	venues: VenueEntry[];
	indications?: Indication[];
	variant: LocationVariant;
	mapStyle: LocationMapStyle;
	presentation?: LocationPresentation;
	showFlourishes?: boolean;
	showNavigationButtons?: boolean;
	indicationsStyle?: LocationIndicationsStyle;
	indicationsHeading?: string;
	indicationsLayout?: LocationIndicationsLayout;
	showCalendarLinks?: boolean;
	calendarEventTitle?: string;
	eventTimeZone?: string;
	nextSectionLink?: {
		href: string;
		label?: string;
	};
	introEyebrow?: string;
	introHeading?: string;
	introLede?: string;
	/** Decorative cutout printed after the intro. */
	ornament?: ImageAsset;
}

const {
	isLocked = false,
	lockedTitle = 'Ubicación reservada',
	lockedMessage = 'Los detalles del lugar se mostrarán después de confirmar asistencia.',
	lockedCtaLabel = 'Confirmar asistencia',
	venues: venueEntries,
	indications,
	variant,
	mapStyle,
	presentation,
	showFlourishes = true,
	showNavigationButtons = true,
	indicationsStyle = 'list',
	indicationsHeading,
	indicationsLayout = 'list',
	showCalendarLinks = false,
	calendarEventTitle,
	eventTimeZone,
	nextSectionLink,
	introEyebrow,
	introHeading,
	introLede,
	ornament,
} = Astro.props;

const displayVenues = groupVenues(venueEntries);

const sharedDate = displayVenues.length > 1 && displayVenues.every((venue) => venue.date === displayVenues[0].date) ? formatVenueDateForDisplay(displayVenues[0].date) : '';
const isSingleVenue = displayVenues.length === 1;
const calendarFor = (venue: GroupedVenue) =>
	showCalendarLinks && calendarEventTitle
		? buildVenueCalendarLinks(venue, { eventTitle: calendarEventTitle, timeZone: eventTimeZone })
		: null;
const isIndicationsBand = indicationsLayout === 'band';
// Enclosure: the indications become a small details card of the suite, without icons.
const isIndicationsEnclosure = indicationsLayout === 'enclosure';
// The printed-program variant owns its rhythm: no venue cards and no section nav button.
const isProgramSheet = variant === 'program-sheet';
const venueType = (venue: GroupedVenue) =>
	venue.type === 'ceremony' || venue.type === 'reception' || venue.type === 'grouped' ? venue.type : 'custom';
---

<section class="event-location" id="event-location" data-screenshot-section="location" data-variant={variant} data-presentation={presentation}>
	<span class="event-location__anchor" id="location" aria-hidden="true"></span>
	{(introEyebrow || introHeading || introLede) && (
		<header class="event-location__intro">
			{introEyebrow && <p class="event-location__eyebrow">{introEyebrow}</p>}
			{introHeading && <h2 class="event-location__heading">{introHeading}</h2>}
			{introLede && <p class="event-location__lede">{introLede}</p>}
		</header>
	)}
	{ornament && (
		<img
			class="event-location__ornament"
			src={plainImgSrc(ornament.src)}
			alt=""
			width="288"
			height="144"
			loading="lazy"
			decoding="async"
		/>
	)}
	{!isLocked && sharedDate && <p class="event-location__shared-date">{sharedDate}</p>}
	{isLocked ? (
		<div class="event-location__locked" data-gated-location>
			<div class="event-location__locked-icon" aria-hidden="true">
				<Icon name="Forbidden" size={28} />
			</div>
			<h3 class="event-location__locked-title">{lockedTitle}</h3>
			<p class="event-location__locked-message">{lockedMessage}</p>
			<a class="event-location__locked-cta" href="#rsvp">{lockedCtaLabel}</a>
		</div>
	) : (
		isProgramSheet ? (
		<div class={`event-location__program ${isSingleVenue ? 'event-location__program--single' : ''}`}>
			{displayVenues.map((venue: GroupedVenue) => (
				<VenueProgramEntry venue={venue} type={venueType(venue)} calendar={calendarFor(venue)} />
			))}
		</div>
		) : (
		<div class={`event-location__container ${isSingleVenue ? 'event-location__container--single' : ''}`}>
			{displayVenues.map((venue: GroupedVenue) => (
				<VenueCard
					venue={venue}
					type={venueType(venue)}
					mapStyle={mapStyle}
					presentation={presentation}
					showFlourishes={showFlourishes}
					showNavigationButtons={showNavigationButtons}
					calendar={calendarFor(venue)}
				/>
			))}
		</div>
		)
	)}
	{indications && indications.length > 0 && isIndicationsEnclosure && (
		<div class="event-location__indications-container" data-indications-layout="enclosure">
			<div class="event-location__enclosure">
				{indicationsHeading && <h2 class="event-location__indications-heading">{indicationsHeading}</h2>}
				{indications.map((indication) => {
					const isReserved = indication.styleVariant === 'reserved';
					return (
						<div class={`event-location__enclosure-note ${isReserved ? 'event-location__enclosure-note--reserved' : ''}`}>
							{isReserved && <span class="event-location__enclosure-swatch" aria-hidden="true"></span>}
							<div class="event-location__enclosure-copy">
								{indication.title && <p class="event-location__enclosure-title">{indication.title}</p>}
								<p class="event-location__enclosure-text" set:html={sanitizeIndicationHtml(indication.text)} />
							</div>
						</div>
					);
				})}
			</div>
		</div>
	)}
	{indications && indications.length > 0 && !isIndicationsEnclosure && (
		<div class="event-location__indications-container" data-indications-layout={indicationsLayout}>
			{!isIndicationsBand && <div class="event-location__divider" aria-hidden="true"></div>}
			{indicationsHeading && (isIndicationsBand ? (
				<h2 class="event-location__indications-heading">{indicationsHeading}</h2>
			) : (
				<p class="event-location__indications-heading">{indicationsHeading}</p>
			))}
			<div class="event-location__indications" data-indications-style={indicationsStyle}>
				{indications.map((indication, index) => {
					const isReserved = indication.styleVariant === 'reserved';
					const editorialNoteTitle = indication.title;
					return (
						<>
						{isIndicationsBand && index === 1 && (
							<div class="event-location__divider" aria-hidden="true"></div>
						)}
						<div class={`event-location__indication-item ${isReserved ? 'event-location__indication-item--reserved' : ''}`}>
							<div class="event-location__indication-icon">
								<Icon name={indication.iconName} size={24} />
							</div>
							<div class="event-location__indication-copy">
								{editorialNoteTitle && (
									<p class="event-location__indication-title">
										{!isIndicationsBand && (
											<span class="event-location__indication-number">
												{String(index + 1).padStart(2, '0')}
											</span>
										)}
										<span class="event-location__indication-label">{editorialNoteTitle}</span>
									</p>
								)}
								<p
									class="event-location__indication-text"
									set:html={sanitizeIndicationHtml(indication.text)}
								/>
							</div>
						</div>
						</>
					);
				})}
			</div>
		</div>
	)}

	{nextSectionLink && !isProgramSheet && (
		<div class="nav-button-container">
			<SectionNavButton
				href={nextSectionLink.href}
				class="event-location"
				section={nextSectionLink.label}
			/>
		</div>
	)}

</section>
<script>
	import { initCopyButtons, revealIOSOnly } from '@/utils/ui';

	const sections = document.querySelectorAll('.event-location');

	if (sections.length > 0) {
		initCopyButtons('.copy-button', 'data-address');
		revealIOSOnly('[data-apple-link]');
		initCalendarMenus();
	}

	// The calendar menu is a native <details> (it works without JavaScript), which only closes
	// from its own summary. Close it on a press outside, on Escape (focus returns to the summary),
	// after choosing an option, and when another calendar menu opens.
	function initCalendarMenus() {
		const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.event-location__calendar'));
		if (menus.length === 0) return;

		const closeAll = (except?: HTMLDetailsElement) => {
			for (const menu of menus) {
				if (menu !== except && menu.open) menu.open = false;
			}
		};

		for (const menu of menus) {
			menu.addEventListener('toggle', () => {
				if (menu.open) closeAll(menu);
			});
			menu.querySelectorAll('.event-location__calendar-options a').forEach((option) => {
				option.addEventListener('click', () => {
					menu.open = false;
				});
			});
		}

		document.addEventListener('pointerdown', (event) => {
			const target = event.target;
			if (!(target instanceof Node)) return;
			for (const menu of menus) {
				if (menu.open && !menu.contains(target)) menu.open = false;
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			const open = menus.find((menu) => menu.open);
			if (!open) return;
			open.open = false;
			open.querySelector<HTMLElement>('summary')?.focus();
		});
	}

	if (document.querySelector('[data-gated-location]')) {
		window.addEventListener('celebrame:rsvp-confirmed', (event) => {
			const inviteId = event instanceof CustomEvent ? event.detail?.inviteId : undefined;
			if (typeof inviteId !== 'string' || inviteId.length === 0) return;

			const nextUrl = new URL(window.location.href);
			nextUrl.searchParams.set('invite', inviteId);
			nextUrl.hash = 'event-location';
			window.location.assign(nextUrl.toString());
		});
	}
</script>
