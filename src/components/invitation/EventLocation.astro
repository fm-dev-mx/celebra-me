---
import SplitWords from '@/components/invitation/SplitWords.astro';
/*
  EventLocation Component
  Displays modern, interactive cards for the event venues.
 */
import '@/styles/invitation/_event-location.scss';
import VenueCard from '@/components/invitation/components/VenueCard.astro';
import VenueProgramEntry from '@/components/invitation/components/VenueProgramEntry.astro';
import VenueStarStop from '@/components/invitation/components/VenueStarStop.astro';
import ScrollScene from '@/components/invitation/ScrollScene.astro';
import { formatVenueDateForDisplay } from '@/lib/invitation/venue-datetime';
import { groupVenues, type GroupedVenue } from '@/lib/invitation/location-helper';
import Icon from '@/components/common/icons/Icon.astro';
import SectionNavButton from '@/components/invitation/components/SectionNavButton.astro';
import { sanitizeIndicationHtml } from '@/lib/invitation/indication-html';
import { plainImgSrc } from '@/lib/assets/image-delivery-policy';
import { buildVenueCalendarLinks } from '@/lib/calendar/venue-calendar-links';

import type { ImageAsset } from '@/lib/assets/asset-registry';
import type { Indication, VenueEntry } from '@/lib/adapters/types';
import type {
	LocationIndicationsLayout,
	LocationIndicationsStyle,
	LocationMapStyle,
	LocationPresentation,
	LocationScene,
	LocationVenueCard,
} from '@/lib/invitation/location-presentation';
import type { LocationVariant } from '@/lib/invitation/section-variants';

interface Props {
	isLocked?: boolean;
	lockedTitle?: string;
	lockedMessage?: string;
	lockedCtaLabel?: string;
	venues: VenueEntry[];
	indications?: Indication[];
	variant: LocationVariant;
	mapStyle: LocationMapStyle;
	presentation?: LocationPresentation;
	showFlourishes?: boolean;
	showNavigationButtons?: boolean;
	indicationsStyle?: LocationIndicationsStyle;
	indicationsHeading?: string;
	indicationsLayout?: LocationIndicationsLayout;
	showCalendarLinks?: boolean;
	/** Pinned scroll scene over the program; see LocationPresentationOptions.scene. */
	scene?: LocationScene;
	/** `compact`: time-led venue cards without the map tile (stacked-venue-plates). */
	venueCard?: LocationVenueCard;
	calendarEventTitle?: string;
	eventTimeZone?: string;
	nextSectionLink?: {
		href: string;
		label?: string;
	};
	introEyebrow?: string;
	introHeading?: string;
	introLede?: string;
	/** Decorative cutout printed after the intro. */
	ornament?: ImageAsset;
}

const {
	isLocked = false,
	lockedTitle = 'Ubicación reservada',
	lockedMessage = 'Los detalles del lugar se mostrarán después de confirmar asistencia.',
	lockedCtaLabel = 'Confirmar asistencia',
	venues: venueEntries,
	indications,
	variant,
	mapStyle,
	presentation,
	showFlourishes = true,
	showNavigationButtons = true,
	indicationsStyle = 'list',
	indicationsHeading,
	indicationsLayout = 'list',
	showCalendarLinks = false,
	scene,
	venueCard,
	calendarEventTitle,
	eventTimeZone,
	nextSectionLink,
	introEyebrow,
	introHeading,
	introLede,
	ornament,
} = Astro.props;

const displayVenues = groupVenues(venueEntries);

const sharedDate = displayVenues.length > 1 && displayVenues.every((venue) => venue.date === displayVenues[0].date) ? formatVenueDateForDisplay(displayVenues[0].date) : '';
const isSingleVenue = displayVenues.length === 1;
const calendarFor = (venue: GroupedVenue) =>
	showCalendarLinks && calendarEventTitle
		? buildVenueCalendarLinks(venue, { eventTitle: calendarEventTitle, timeZone: eventTimeZone })
		: null;
const isIndicationsBand = indicationsLayout === 'band';
// Enclosure: the indications become a small details card of the suite, without icons.
const isIndicationsEnclosure = indicationsLayout === 'enclosure';
// The printed program owns its rhythm; pinned routes also guide guests to the next chapter.
const isProgramSheet = variant === 'program-sheet';
// Star route: editorial rows on a starred line; its notes are light and the lede becomes a footnote.
const isStarRoute = variant === 'star-route';
const headerLede = isStarRoute ? undefined : introLede;
// A route scene pins the intro and the program together; it needs two stops to travel.
const isRouteScene = scene !== undefined && isProgramSheet && !isLocked && displayVenues.length >= 2;
const isButterflyRoute = isRouteScene && scene === 'butterfly-route';
const SceneWrapper = isRouteScene ? ScrollScene : Fragment;
const sceneProps = isRouteScene ? { length: 3 as const, class: 'location-route' } : {};
// Route between the first and the last stop, drawn in a 390 × 500 box; the traveler's offset-path
// in _lantern-route.scss repeats it.
const ROUTE_PATH = 'M 70 40 C 330 90, 40 210, 250 270 S 300 430, 120 470';
// Hairline butterfly in a 100 × 86 box, head up; the route turns it to face its way.
const BUTTERFLY_PATH =
	'M50 44C58 22 82 10 90 22c7 12-12 26-40 24zM50 44C42 22 18 10 10 22c-7 12 12 26 40 24zM50 47c12 4 26 16 20 28-6 10-16-2-20-24zM50 47c-12 4-26 16-20 28 6 10 16-2 20-24zM50 40v22M50 40c-2-10-6-16-12-20M50 40c2-10 6-16 12-20';
const venueType = (venue: GroupedVenue) =>
	venue.type === 'ceremony' || venue.type === 'reception' || venue.type === 'grouped' ? venue.type : 'custom';
---

<section class="event-location" id="event-location" data-screenshot-section="location" data-variant={variant} data-presentation={presentation} data-location-scene={isRouteScene ? scene : undefined}>
	<span class="event-location__anchor" id="location" aria-hidden="true"></span>
	<SceneWrapper {...sceneProps}>
	{isRouteScene && <div class="location-route__sky" aria-hidden="true"></div>}
	{(introEyebrow || introHeading || headerLede) && (
		<header class="event-location__intro">
			{introEyebrow && <p class="event-location__eyebrow" data-reveal-role="label">{introEyebrow}</p>}
			{introHeading && <SplitWords class="event-location__heading" text={introHeading} />}
			{headerLede && <p class="event-location__lede" data-reveal-role="lede">{headerLede}</p>}
		</header>
	)}
	{ornament && (
		<img
			class="event-location__ornament"
			src={plainImgSrc(ornament.src)}
			alt=""
			width="288"
			height="144"
			loading="lazy"
			decoding="async"
		/>
	)}
	{!isLocked && sharedDate && <p class="event-location__shared-date">{sharedDate}</p>}
	{isLocked ? (
		<div class="event-location__locked" data-gated-location>
			<div class="event-location__locked-icon" aria-hidden="true">
				<Icon name="Forbidden" size={28} />
			</div>
			<h3 class="event-location__locked-title">{lockedTitle}</h3>
			<p class="event-location__locked-message">{lockedMessage}</p>
			<a class="event-location__locked-cta" href="#rsvp">{lockedCtaLabel}</a>
		</div>
	) : (
		isProgramSheet ? (
		<>
		{isRouteScene && (
			<div class="location-route__map">
			<div class="location-route__map-plane">
			<svg class="location-route__drawing" viewBox="0 0 390 500" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
				<path class="location-route__trail" d={ROUTE_PATH} />
				<path class="location-route__path" d={ROUTE_PATH} pathLength="1" />
				<circle class="location-route__stop" cx="70" cy="40" r="6" />
				<circle class="location-route__stop" cx="120" cy="470" r="6" />
				{isButterflyRoute ? (
				<g class="location-route__butterfly">
					<path class="location-route__butterfly-wings" transform="translate(-30 -26) scale(0.6)" d={BUTTERFLY_PATH} />
				</g>
				) : (
				<g class="location-route__lantern">
					<circle class="location-route__lantern-glow" r="30" />
					<path class="location-route__lantern-body" d="M-10 -16h20l3 30h-26Z" />
					<path class="location-route__lantern-cap" d="M-5 -23h10v7h-10Z" />
				</g>
				)}
			</svg>
			<p class="location-route__note">Siga bajando <span aria-hidden="true">↓</span></p>
			</div>
			</div>
		)}
		<div class={`event-location__program ${isSingleVenue ? 'event-location__program--single' : ''}`}>
			{displayVenues.map((venue: GroupedVenue) => (
				<VenueProgramEntry venue={venue} type={venueType(venue)} calendar={calendarFor(venue)} reveal={!isRouteScene} />
			))}
		</div>
		</>
		) : isStarRoute ? (
		<ol class="event-location__star-route">
			{displayVenues.map((venue: GroupedVenue) => (
				<li class="event-location__star-row">
					<VenueStarStop venue={venue} type={venueType(venue)} calendar={calendarFor(venue)} />
				</li>
			))}
		</ol>
		) : (
		<div class={`event-location__container ${isSingleVenue ? 'event-location__container--single' : ''}`}>
			{displayVenues.map((venue: GroupedVenue) => (
				<VenueCard
					venue={venue}
					type={venueType(venue)}
					mapStyle={mapStyle}
					presentation={presentation}
					showFlourishes={showFlourishes}
					showNavigationButtons={showNavigationButtons}
					compact={venueCard === 'compact'}
					vignette={variant === 'night-route'}
					reveal={variant !== 'night-route'}
					calendar={calendarFor(venue)}
				/>
			))}
		</div>
		)
	)}
	{isRouteScene && (
		<p class="location-route__continuation">
			{isButterflyRoute ? (
			<svg class="location-route__continuation-mark" width="24" height="44" viewBox="0 0 24 44" fill="none" aria-hidden="true" focusable="false">
				<path transform="translate(1 2) scale(0.22)" d={BUTTERFLY_PATH} stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
				<path d="M12 27v5M7 36l5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			) : (
			<svg class="location-route__continuation-mark" width="24" height="44" viewBox="0 0 24 44" fill="none" aria-hidden="true" focusable="false">
				<path d="M12 1v5M8 7h8M8 23h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
				<path d="M8 8h8l2 4v6l-2 4H8l-2-4v-6z" stroke="currentColor" stroke-width="1.2" />
				<path d="M12 11v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				<path d="M12 27v5M7 36l5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			)}
			<span><span class="location-route__continuation-label">Siga bajando</span><span class="location-route__continuation-detail">La invitación continúa</span></span>
		</p>
	)}
	</SceneWrapper>
	{indications && indications.length > 0 && isStarRoute && (
		<div class="event-location__star-notes" data-reveal-item>
			{indicationsHeading && <h2 class="event-location__star-notes-heading">{indicationsHeading}</h2>}
			<ul class="event-location__star-notes-list">
				{indications.map((indication) => {
					const isReserved = indication.styleVariant === 'reserved';
					return (
						<li class:list={['event-location__star-note', { 'event-location__star-note--reserved': isReserved }]}>
							<span class="event-location__star-note-mark" aria-hidden="true"></span>
							<span class="event-location__star-note-copy">
								{indication.title && <span class="event-location__star-note-title">{indication.title}</span>}
								<span class="event-location__star-note-text" set:html={sanitizeIndicationHtml(indication.text)} />
							</span>
						</li>
					);
				})}
			</ul>
		</div>
	)}
	{indications && indications.length > 0 && !isStarRoute && isIndicationsEnclosure && (
		<div class="event-location__indications-container" data-indications-layout="enclosure">
			<div class="event-location__enclosure" data-reveal-role="item">
				{indicationsHeading && <h2 class="event-location__indications-heading">{indicationsHeading}</h2>}
				{indications.map((indication) => {
					const isReserved = indication.styleVariant === 'reserved';
					return (
						<div class={`event-location__enclosure-note ${isReserved ? 'event-location__enclosure-note--reserved' : ''}`}>
							{isReserved && <span class="event-location__enclosure-swatch" aria-hidden="true"></span>}
							<div class="event-location__enclosure-copy">
								{indication.title && <p class="event-location__enclosure-title">{indication.title}</p>}
								<p class="event-location__enclosure-text" set:html={sanitizeIndicationHtml(indication.text)} />
							</div>
						</div>
					);
				})}
			</div>
		</div>
	)}
	{indications && indications.length > 0 && !isStarRoute && !isIndicationsEnclosure && (
		<div class="event-location__indications-container" data-indications-layout={indicationsLayout}>
			{!isIndicationsBand && <div class="event-location__divider" aria-hidden="true"></div>}
			{indicationsHeading && (isIndicationsBand ? (
				<h2 class="event-location__indications-heading">{indicationsHeading}</h2>
			) : (
				<p class="event-location__indications-heading">{indicationsHeading}</p>
			))}
			<div class="event-location__indications" data-indications-style={indicationsStyle}>
				{indications.map((indication, index) => {
					const isReserved = indication.styleVariant === 'reserved';
					const editorialNoteTitle = indication.title;
					return (
						<>
						{isIndicationsBand && index === 1 && (
							<div class="event-location__divider" aria-hidden="true"></div>
						)}
						<div class={`event-location__indication-item ${isReserved ? 'event-location__indication-item--reserved' : ''}`}>
							<div class="event-location__indication-icon">
								<Icon name={indication.iconName} size={24} />
							</div>
							<div class="event-location__indication-copy">
								{editorialNoteTitle && (
									<p class="event-location__indication-title">
										{!isIndicationsBand && (
											<span class="event-location__indication-number">
												{String(index + 1).padStart(2, '0')}
											</span>
										)}
										<span class="event-location__indication-label">{editorialNoteTitle}</span>
									</p>
								)}
								<p
									class="event-location__indication-text"
									set:html={sanitizeIndicationHtml(indication.text)}
								/>
							</div>
						</div>
						</>
					);
				})}
			</div>
		</div>
	)}

	{isStarRoute && introLede && <p class="event-location__footnote">{introLede}</p>}

	{nextSectionLink && (!isProgramSheet || isRouteScene) && (
		<div class:list={['nav-button-container', { 'location-route__next': isRouteScene }]}>
			<SectionNavButton
				href={nextSectionLink.href}
				class="event-location"
				section={isRouteScene ? `Continúe: ${nextSectionLink.label ?? 'siguiente capítulo'}` : nextSectionLink.label}
			/>
		</div>
	)}

</section>
<script>
	import { initCopyButtons, revealIOSOnly } from '@/utils/ui';

	const sections = document.querySelectorAll('.event-location');

	if (sections.length > 0) {
		initCopyButtons('.copy-button', 'data-address');
		revealIOSOnly('[data-apple-link]');
		initCalendarMenus();
	}

	// The calendar menu is a native <details> (it works without JavaScript), which only closes
	// from its own summary. Close it on a press outside, on Escape (focus returns to the summary),
	// after choosing an option, and when another calendar menu opens.
	function initCalendarMenus() {
		const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.event-location__calendar'));
		if (menus.length === 0) return;

		const closeAll = (except?: HTMLDetailsElement) => {
			for (const menu of menus) {
				if (menu !== except && menu.open) menu.open = false;
			}
		};

		for (const menu of menus) {
			menu.addEventListener('toggle', () => {
				if (menu.open) closeAll(menu);
			});
			menu.querySelectorAll('.event-location__calendar-options a').forEach((option) => {
				option.addEventListener('click', () => {
					menu.open = false;
				});
			});
		}

		document.addEventListener('pointerdown', (event) => {
			const target = event.target;
			if (!(target instanceof Node)) return;
			for (const menu of menus) {
				if (menu.open && !menu.contains(target)) menu.open = false;
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			const open = menus.find((menu) => menu.open);
			if (!open) return;
			open.open = false;
			open.querySelector<HTMLElement>('summary')?.focus();
		});
	}

	if (document.querySelector('[data-gated-location]')) {
		window.addEventListener('celebrame:rsvp-confirmed', (event) => {
			const inviteId = event instanceof CustomEvent ? event.detail?.inviteId : undefined;
			if (typeof inviteId !== 'string' || inviteId.length === 0) return;

			const nextUrl = new URL(window.location.href);
			nextUrl.searchParams.set('invite', inviteId);
			nextUrl.hash = 'event-location';
			window.location.assign(nextUrl.toString());
		});
	}
</script>
