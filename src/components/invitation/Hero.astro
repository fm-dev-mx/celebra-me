---
import { resolveExplicitImageDelivery } from '@/lib/assets/image-delivery.server';
import type { ImageDelivery } from '@/lib/assets/image-delivery';
import { getImage } from 'astro:assets';
import CacheSafeImage from '@/components/common/CacheSafeImage.astro';
import type { ImageMetadata } from 'astro';
import {
	plainImgSrc,
	shouldOptimizeThroughVercelImage,
} from '@/lib/assets/vercel-image-policy';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import type { HeroVariant } from '@/lib/invitation/section-variants';
import '@/styles/invitation/_hero.scss';
import EditorialCoverHero from './EditorialCoverHero.astro';
import FramedPortraitHero from './FramedPortraitHero.astro';
import CeremonialPortraitHero from './CeremonialPortraitHero.astro';

interface Props {
	ornament?: ImageAsset;
	accentOrnament?: ImageAsset;
	ambience?: ImageAsset;
	name: string;
	secondaryName?: string;
	label?: string;
	nickname?: string;
	date: string;
	time?: string;
	venueName?: string;
	backgroundImage: ImageMetadata | ImageAsset;
	backgroundImageDesktop?: { src: string; delivery?: ImageDelivery };
	backgroundImageMobile?: ImageMetadata | ImageAsset;
	portrait?: ImageMetadata | ImageAsset;
	variant: HeroVariant;
	scrollLabel?: string;
	focalPoint?: string;
	focalPointMobile?: string;
	focalPointTablet?: string;
	focalPointDesktop?: string;
	highPriority?: boolean;
}

const {
	name,
	secondaryName,
	label,
	nickname,
	date,
	time,
	venueName,
	backgroundImage,
	backgroundImageDesktop,
	backgroundImageMobile,
	portrait,
	variant,
	scrollLabel,
	focalPoint,
	focalPointMobile,
	focalPointTablet,
	focalPointDesktop,
	highPriority = true,
} = Astro.props;

const isEditorialCover = variant === 'editorial-cover';
const isFramedPortrait = variant === 'framed-portrait';
const isCeremonialPortrait = variant === 'ceremonial-portrait';

let displayLabel: string | undefined;
let ageLockupMatch: RegExpMatchArray | null = null;
let bgSrc: ImageMetadata | string | undefined;
let mobileBgSrc: string | null = null;
let desktopBgSrc: string | null = null;
let portraitSrc: ImageMetadata | string | null = null;
let formattedDate = '';
let firstName = '';
let surnames: string[] = [];
let fpDefault = '50% 40%';
let fpMobile = fpDefault;
let fpTablet = fpDefault;
let fpDesktop = fpDefault;

if (!isEditorialCover && !isFramedPortrait && !isCeremonialPortrait) {
	displayLabel =
		label &&
		(label.toLowerCase().trim() === 'xv edition' || label.toLowerCase().trim() === 'xv edición')
			? 'CAPÍTULO XV'
			: label;

	ageLockupMatch = displayLabel ? displayLabel.trim().match(/^(\d+)\s+(AÑOS)$/iu) : null;

	const resolveImage = (image: ImageMetadata | ImageAsset): ImageMetadata | string =>
		'src' in image ? image.src : image;

	bgSrc = resolveImage(backgroundImage);
	const resolvedMobileBg = backgroundImageMobile ? resolveImage(backgroundImageMobile) : null;
	const remoteMobileBgSrc =
		backgroundImageMobile &&
		'src' in backgroundImageMobile &&
		typeof backgroundImageMobile.src === 'string'
			? backgroundImageMobile.src
			: null;

	const mobileDelivery =
		backgroundImageMobile && 'delivery' in backgroundImageMobile
			? backgroundImageMobile.delivery
			: undefined;
	mobileBgSrc = resolvedMobileBg && !mobileDelivery
		? remoteMobileBgSrc
			? remoteMobileBgSrc
			: shouldOptimizeThroughVercelImage(resolvedMobileBg)
				? (
						await getImage({
							src: resolvedMobileBg,
							width:
								typeof resolvedMobileBg === 'object' && 'width' in resolvedMobileBg
									? Math.min(1080, resolvedMobileBg.width)
									: 1080,
							format: 'webp',
							quality: 84,
						})
					).src
				: plainImgSrc(resolvedMobileBg)
		: null;

	if (mobileDelivery && resolvedMobileBg) {
		mobileBgSrc = await resolveExplicitImageDelivery(resolvedMobileBg, mobileDelivery, { width: 1080, quality: 84, format: 'webp' });
	}
	desktopBgSrc = backgroundImageDesktop ? backgroundImageDesktop.src : null;
	if (backgroundImageDesktop?.delivery) {
		desktopBgSrc = await resolveExplicitImageDelivery(backgroundImageDesktop.src, backgroundImageDesktop.delivery, { width: 1920, quality: 84, format: 'webp' });
	}
	portraitSrc = portrait ? resolveImage(portrait) : null;

	formattedDate = new Date(date).toLocaleDateString('es-MX', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
		timeZone: 'UTC',
	});

	const names = name.trim().split(/\s+/);
	firstName = names.slice(0, 2).join(' ');
	surnames = names.slice(2);

	fpDefault = focalPoint || '50% 40%';
	fpMobile = focalPointMobile || fpDefault;
	fpTablet = focalPointTablet || fpDefault;
	fpDesktop = focalPointDesktop || fpDefault;
}

---

{
	isCeremonialPortrait ? (
	<CeremonialPortraitHero {...Astro.props} />
	) : isFramedPortrait ? (
	<FramedPortraitHero {...Astro.props} />
	) : isEditorialCover ? (
	<EditorialCoverHero {...Astro.props} />
	) : (
	<section
		id="inicio"
		class="invitation-hero"
		data-variant={variant}
		data-screenshot="invitation-open-hero"
		data-screenshot-section="hero"
	>
			<div class="invitation-hero__background">
				<picture>
					{mobileBgSrc && (
						<source media="(max-width: 991px)" srcset={mobileBgSrc} />
					)}
					{desktopBgSrc && (
						<source media="(min-width: 992px)" srcset={desktopBgSrc} />
					)}
					{bgSrc && (
						<CacheSafeImage
							src={bgSrc}
							delivery={'delivery' in backgroundImage ? backgroundImage.delivery : undefined}
							alt={name}
							width={1080}
							height={1920}
							format="webp"
							quality={84}
							loading="eager"
							fetchpriority={highPriority ? 'high' : undefined}
						/>
					)}
				</picture>
			</div>

			<div class="invitation-hero__content">
				{displayLabel &&
					(ageLockupMatch ? (
						<span
							class="invitation-hero__label invitation-hero__label--age-lockup"
							aria-label={displayLabel}
						>
							<span class="invitation-hero__label-age" aria-hidden="true">
								{ageLockupMatch[1]}
							</span>
							<span class="invitation-hero__label-unit" aria-hidden="true">
								{ageLockupMatch[2]}
							</span>
						</span>
					) : (
						<span class="invitation-hero__label">{displayLabel}</span>
					))}

				<div class="invitation-hero__title-wrapper">
					<h1 class="invitation-hero__title">
						<span class="invitation-hero__title-line">
							{firstName.split(/\s+/).map((word, index, words) => (
								<span
									class={`invitation-hero__title-word invitation-hero__title-word--${word.toLowerCase().replace(/[^a-z0-9]/g, '')}`}
								>
									{word}{index < words.length - 1 ? ' ' : ''}
								</span>
							))}
						</span>
						{surnames.length > 0 && (
							<>
								<br />
								<span class="invitation-hero__title-line invitation-hero__title-line--surname">
									{surnames.join(' ')}
								</span>
							</>
						)}
						{secondaryName && (
							<>
								<br />
								<span class="invitation-hero__ampersand">&</span>
								<span class="invitation-hero__secondary-name">{secondaryName}</span>
							</>
						)}
					</h1>
				</div>

				{nickname && (
					<div class="invitation-hero__nickname-badge">
						<span>{nickname}</span>
					</div>
				)}

				{portraitSrc && (
					<div class="invitation-hero__portrait">
						<CacheSafeImage
							src={portraitSrc}
							delivery={portrait && 'delivery' in portrait ? portrait.delivery : undefined}
							alt={`Retrato de ${name}`}
							width={600}
							height={800}
							format="webp"
							quality={90}
						/>
					</div>
				)}

				<div class="invitation-hero__divider"></div>

				<div class="invitation-hero__details">
					<p class="invitation-hero__date">{formattedDate}</p>
					{time && <p class="invitation-hero__time">{time}</p>}
					{venueName && <p class="invitation-hero__venue">
						<span class="calligraphy-accent">en</span> {venueName}
					</p>}
				</div>
			</div>

			<div class="invitation-hero__scroll-indicator">
				<span class="invitation-hero__scroll-text">{scrollLabel || 'Desliza'}</span>
				<div class="invitation-hero__scroll-chevron">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m6 9 6 6 6-6"/>
					</svg>
				</div>
			</div>
		</section>
	)
}

<style define:vars={{
	fpDefault,
	fpMobile,
	fpTablet,
	fpDesktop,
}}>
	.invitation-hero {
		--hero-focal-point-default: var(--fpDefault);
		--hero-focal-point-mobile: var(--fpMobile);
		--hero-focal-point-tablet: var(--fpTablet);
		--hero-focal-point-desktop: var(--fpDesktop);
	}
</style>
