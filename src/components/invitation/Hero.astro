---
// src/components/invitation/Hero.astro
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import type { ThemePreset } from '@/lib/theme/theme-contract';
import type { HeroStructuralVariant } from '@/lib/invitation/structural-variants';
import '@/styles/invitation/_hero.scss';
import EditorialMagazineHero from './EditorialMagazineHero.astro';

interface Props {
	name: string;
	secondaryName?: string;
	label?: string;
	nickname?: string;
	date: string;
	time?: string;
	venueName?: string;
	backgroundImage: ImageMetadata | ImageAsset;
	backgroundImageDesktop?: { src: string };
	backgroundImageMobile?: ImageMetadata | ImageAsset;
	portrait?: ImageMetadata | ImageAsset;
	variant?: ThemePreset;
	structuralVariant?: HeroStructuralVariant;
	scrollLabel?: string;
	focalPoint?: string;
	focalPointMobile?: string;
	focalPointTablet?: string;
	focalPointDesktop?: string;
	highPriority?: boolean;
}

const {
	name,
	secondaryName,
	label,
	nickname,
	date,
	time,
	venueName,
	backgroundImage,
	backgroundImageDesktop,
	backgroundImageMobile,
	portrait,
	variant,
	structuralVariant = 'standard',
	scrollLabel,
	focalPoint,
	focalPointMobile,
	focalPointTablet,
	focalPointDesktop,
	highPriority = true,
} = Astro.props;

const isEditorialMagazine = structuralVariant === 'editorial-cover';

let displayLabel: string | undefined;
let ageLockupMatch: RegExpMatchArray | null = null;
let bgSrc: ImageMetadata | undefined;
let mobileBgSrc: string | null = null;
let desktopBgSrc: string | null = null;
let portraitSrc: ImageMetadata | null = null;
let formattedDate = '';
let firstName = '';
let surnames: string[] = [];
let fpDefault = '50% 40%';
let fpMobile = fpDefault;
let fpTablet = fpDefault;
let fpDesktop = fpDefault;

if (!isEditorialMagazine) {
	displayLabel =
		label &&
		(label.toLowerCase().trim() === 'xv edition' || label.toLowerCase().trim() === 'xv edición')
			? 'CAPÍTULO XV'
			: label;

	ageLockupMatch = displayLabel ? displayLabel.trim().match(/^(\d+)\s+(AÑOS)$/iu) : null;

	const resolveImage = (image: ImageMetadata | ImageAsset): ImageMetadata =>
		'src' in image ? (image.src as ImageMetadata) : image;

	bgSrc = resolveImage(backgroundImage);
	const resolvedMobileBg = backgroundImageMobile ? resolveImage(backgroundImageMobile) : null;
	const remoteMobileBgSrc =
		backgroundImageMobile &&
		'src' in backgroundImageMobile &&
		typeof backgroundImageMobile.src === 'string'
			? backgroundImageMobile.src
			: null;

	mobileBgSrc = resolvedMobileBg
		? remoteMobileBgSrc
			? remoteMobileBgSrc
			: (
					await getImage({
						src: resolvedMobileBg,
						width: Math.min(1080, resolvedMobileBg.width),
						format: 'webp',
						quality: 84,
					})
				).src
		: null;

	desktopBgSrc = backgroundImageDesktop ? backgroundImageDesktop.src : null;
	portraitSrc = portrait ? resolveImage(portrait) : null;

	formattedDate = new Date(date).toLocaleDateString('es-MX', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
		timeZone: 'UTC',
	});

	const names = name.trim().split(/\s+/);
	firstName = names.slice(0, 2).join(' ');
	surnames = names.slice(2);

	fpDefault = focalPoint || '50% 40%';
	fpMobile = focalPointMobile || fpDefault;
	fpTablet = focalPointTablet || fpDefault;
	fpDesktop = focalPointDesktop || fpDefault;
}

---

{
	isEditorialMagazine ? (
	<EditorialMagazineHero {...Astro.props} />
	) : (
	<section
		id="inicio"
		class="invitation-hero"
		data-variant={variant}
		data-structural-variant={structuralVariant}
		data-screenshot="invitation-open-hero"
		data-screenshot-section="hero"
	>
			<div class="invitation-hero__background">
				<picture>
					{mobileBgSrc && (
						<source media="(max-width: 991px)" srcset={mobileBgSrc} />
					)}
					{desktopBgSrc && (
						<source media="(min-width: 992px)" srcset={desktopBgSrc} />
					)}
					{bgSrc && (
						<Image
							src={bgSrc}
							alt={name}
							width={1080}
							height={1920}
							format="webp"
							quality={84}
							loading="eager"
							fetchpriority={highPriority ? 'high' : undefined}
						/>
					)}
				</picture>
			</div>

			<div class="invitation-hero__content">
				{displayLabel &&
					(ageLockupMatch ? (
						<span
							class="invitation-hero__label invitation-hero__label--age-lockup"
							aria-label={displayLabel}
						>
							<span class="invitation-hero__label-age" aria-hidden="true">
								{ageLockupMatch[1]}
							</span>
							<span class="invitation-hero__label-unit" aria-hidden="true">
								{ageLockupMatch[2]}
							</span>
						</span>
					) : (
						<span class="invitation-hero__label">{displayLabel}</span>
					))}

				<div class="invitation-hero__title-wrapper">
					<h1 class="invitation-hero__title">
						<span class="invitation-hero__title-line">
							{firstName.split(/\s+/).map((word, index, words) => (
								<span
									class={`invitation-hero__title-word invitation-hero__title-word--${word.toLowerCase().replace(/[^a-z0-9]/g, '')}`}
								>
									{word}{index < words.length - 1 ? ' ' : ''}
								</span>
							))}
						</span>
						{surnames.length > 0 && (
							<>
								<br />
								<span class="invitation-hero__title-line invitation-hero__title-line--surname">
									{surnames.join(' ')}
								</span>
							</>
						)}
						{secondaryName && (
							<>
								<br />
								<span class="invitation-hero__ampersand">&</span>
								<span class="invitation-hero__secondary-name">{secondaryName}</span>
							</>
						)}
					</h1>
				</div>

				{nickname && (
					<div class="invitation-hero__nickname-badge">
						<span>{nickname}</span>
					</div>
				)}

				{portraitSrc && (
					<div class="invitation-hero__portrait">
						<Image
							src={portraitSrc}
							alt={`Retrato de ${name}`}
							width={600}
							height={800}
							format="webp"
							quality={90}
						/>
					</div>
				)}

				<div class="invitation-hero__divider"></div>

				<div class="invitation-hero__details">
					<p class="invitation-hero__date">{formattedDate}</p>
					{time && <p class="invitation-hero__time">{time}</p>}
					{venueName && <p class="invitation-hero__venue">
						<span class="calligraphy-accent">en</span> {venueName}
					</p>}
				</div>
			</div>

			<div class="invitation-hero__scroll-indicator">
				<span class="invitation-hero__scroll-text">{scrollLabel || 'Desliza'}</span>
				<div class="invitation-hero__scroll-chevron">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m6 9 6 6 6-6"/>
					</svg>
				</div>
			</div>
		</section>
	)
}

<style define:vars={{
	fpDefault,
	fpMobile,
	fpTablet,
	fpDesktop,
}}>
	.invitation-hero {
		--hero-focal-point-default: var(--fpDefault);
		--hero-focal-point-mobile: var(--fpMobile);
		--hero-focal-point-tablet: var(--fpTablet);
		--hero-focal-point-desktop: var(--fpDesktop);
	}
</style>
