---
/* eslint-disable no-restricted-syntax -- each word carries its stagger index as a custom property */
/**
 * Title split into words on the server for the editorial reveal. A heading keeps its full text for
 * assistive technology in `aria-label`; other elements carry it as visually hidden text. The word
 * spans are presentational. Outside the editorial recipe they are plain inline text, so the title
 * renders as before.
 */
interface Props {
	text: string;
	as?: 'h2' | 'h3' | 'p';
	class?: string;
	id?: string;
	/** Index of the first word, so several lines of one text stagger as one sequence. */
	offset?: number;
}

const { text, as: Tag = 'h2', class: className, id, offset = 0 } = Astro.props as Props;
const words: string[] = text.trim().split(/\s+/).filter(Boolean);
const isHeading = Tag !== 'p';
---

<Tag class={className} id={id} aria-label={isHeading ? text : undefined} data-reveal-role="title">
	{!isHeading && <span class="sr-only">{text}</span>}
	{
		words.map((word, index) => (
			<>
				<span class="word" style={`--i:${offset + index}`} aria-hidden="true">{word}</span>
				{index < words.length - 1 ? ' ' : ''}
			</>
		))
	}
</Tag>
