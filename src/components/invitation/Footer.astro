---
// src/components/invitation/Footer.astro
import '@/styles/invitation/_footer.scss';
import '@/styles/invitation/_floating-cta.scss';
import Logo from '@/components/ui/Logo.astro';
import OptimizedImage from '@/components/common/OptimizedImage.astro';
import type { SharedSectionVariant } from '@/lib/invitation/section-variants';
import { getContactPhone, getWhatsAppLink, isPlaceholderContactPhone } from '@/utils/whatsapp';

interface Props {
	eventSlug?: string;
	showEnvelope?: boolean;
	variant: SharedSectionVariant;
	closingPhrase?: string;
	showFooterBranding?: boolean;
	showContactCta?: boolean;
	/** Turns the floating reply button on unless the profile sets it off (a personal link). */
	floatingCtaByDefault?: boolean;
	/** Attribution line for a licensed song, linking to its same-site credit page. */
	musicCredit?: { title?: string; creditsUrl: string };
	class?: string;
}

const {
	eventSlug,
	showEnvelope = false,
	variant,
	closingPhrase,
	showFooterBranding = true,
	showContactCta = true,
	floatingCtaByDefault = false,
	musicCredit,
	class: className,
} = Astro.props;
const hasReplay = Boolean(showEnvelope && eventSlug);

const whatsappMessage = 'Hola, estoy interesado en crear una invitación digital.';
const whatsappLink = getWhatsAppLink(whatsappMessage);
const shouldShowContactCta = showContactCta && !isPlaceholderContactPhone(getContactPhone());
const rightsYear = new Date().getFullYear();
---

<!-- Floating reply button; on by default on a personal link, otherwise only when the profile turns
     it on (floating-cta.ts). -->
<div
	class="floating-cta"
	data-floating-cta
	data-floating-cta-default={floatingCtaByDefault ? 'on' : undefined}
	data-visible="false"
	hidden
>
	<div
		id="floating-cta-calendar"
		class="floating-cta__panel"
		role="group"
		aria-label="Agendar en su calendario"
		data-floating-cta-panel
		hidden
	>
	</div>
	<a class="floating-cta__button" href="#rsvp" data-floating-cta-confirm>Confirmar asistencia</a>
	<button
		type="button"
		class="floating-cta__button"
		aria-expanded="false"
		aria-controls="floating-cta-calendar"
		data-floating-cta-calendar
		hidden
	>
		Agendar
	</button>
</div>

<footer
	class:list={['invitation-footer', className]}
	data-variant={variant}
>
	<!-- Reply at the end; shown only when the profile turns it on and the guest has not answered
	     (footer-reply.ts). Its words come from the profile. -->
	<div class="footer-reply" data-footer-reply hidden>
		<span class="footer-reply__lantern" aria-hidden="true"></span>
		<div class="footer-reply__pending" data-footer-reply-pending hidden>
			<p class="footer-reply__eyebrow"></p>
			<p class="footer-reply__question"></p>
			<a class="footer-reply__button" href="#rsvp" data-footer-reply-confirm>Confirmar asistencia</a>
			<p class="footer-reply__note"></p>
		</div>
		<p class="footer-reply__answered" data-footer-reply-answered hidden></p>
	</div>

	{closingPhrase && (
		<p class="footer__closing-phrase">{closingPhrase}</p>
	)}

	<div class="footer__divider" aria-hidden="true"></div>

	<div class="footer__content">
		{showFooterBranding || shouldShowContactCta ? (
		<div class="footer__primary-row">
			{showFooterBranding && (
			<div class="footer__info">
				<p class="powered-by">Powered by</p>
				<Logo altText="Celebra-me" class="footer-brand-logo" />
			</div>
			)}

			{shouldShowContactCta && (
			<div class="footer__actions">
				<a
					class="whatsapp-button"
					href={whatsappLink}
					target="_blank"
					rel="noopener noreferrer"
				>
					<OptimizedImage
						imagePath="/icons/whatsappIcon.svg"
						alt="WhatsApp"
						width={16}
						height={16}
						class="footer-action__icon-media"
					/>
					<span>Contáctenos</span>
				</a>
			</div>
			)}
		</div>
		) : null}

		{showFooterBranding && (
			<p class="footer__rights">
				© {rightsYear} Celebra-me · Diseño protegido ·{' '}
				<a href="/terminos#propiedad-intelectual">Términos</a>
			</p>
		)}

		{musicCredit && (
			<p class="footer__music-credit">
				Música: {musicCredit.title ? `${musicCredit.title} · ` : ''}
				<a href={musicCredit.creditsUrl} target="_blank" rel="noopener noreferrer">
					Créditos y licencia
				</a>
			</p>
		)}

		{hasReplay && (
			<button
				type="button"
				class="footer__replay-link"
				data-slug={eventSlug}
				aria-label="Volver a ver la apertura del sobre"
			>
				Volver a ver la apertura
			</button>
		)}
	</div>
</footer>

<script>
	import { initFloatingCta } from '@/lib/invitation/floating-cta';
	import { holdFooterUntilSecondScroll } from '@/lib/invitation/footer-reveal';
	import { initFooterReply } from '@/lib/invitation/footer-reply';

	holdFooterUntilSecondScroll(document.querySelector('.invitation-footer'));
	initFooterReply(document.querySelector('[data-footer-reply]'));
	initFloatingCta(document.querySelector('[data-floating-cta]'));
</script>

{hasReplay && (
	<script>
		const replayLink = document.querySelector('.footer__replay-link');

		if (replayLink instanceof HTMLElement) {
			replayLink.addEventListener('click', () => {
				const slug = replayLink.dataset.slug;
				if (!slug) {
					return;
				}

				localStorage.removeItem(`envelope-opened-${slug}`);
				// The replayed opening lands on the hero, not back here at the footer; the gate
				// itself holds the reloaded page at the top.
				window.scrollTo(0, 0);
				window.location.reload();
			});
		}
	</script>
)}
