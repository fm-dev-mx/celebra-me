---
// Section-owned renderer for the semantic `editorial-cover` Hero variant.
import type { ImageDelivery } from '@/lib/assets/image-delivery';
import CacheSafeImage from '@/components/common/CacheSafeImage.astro';
import { plainImgSrc } from '@/lib/assets/image-delivery-policy';
import { formatSpanishLongDate } from '@/lib/invitation/venue-datetime';
import type { HeroImageSources } from '@/lib/invitation/hero-image-sources';
import type { ImageMetadata } from 'astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import type { HeroVariant } from '@/lib/invitation/section-variants';

interface Props {
	name: string;
	secondaryName?: string;
	label?: string;
	nickname?: string;
	date: string;
	time?: string;
	venueName?: string;
	backgroundImage: ImageMetadata | ImageAsset;
	backgroundImageDesktop?: { src: string; delivery?: ImageDelivery };
	backgroundImageMobile?: ImageMetadata | ImageAsset;
	portrait?: ImageMetadata | ImageAsset;
	/** Decorative emblem printed above the title (hero.ornament). */
	ornament?: ImageAsset;
	/** Decorative cutout printed below the details (hero.accentOrnament). */
	accentOrnament?: ImageAsset;
	variant: HeroVariant;
	focalPoint?: string;
	focalPointMobile?: string;
	focalPointTablet?: string;
	focalPointDesktop?: string;
	tagline?: string;
	photoCredit?: string;
	/** Short edition mark of the event type; the watermark default. */
	editionMark?: string;
	/** Watermark behind the cover and the page rail label; edition mark and XV page defaults. */
	coverMark?: string;
	coverPage?: string;
	/** Shows the "DISEÑO / CELEBRA ME" credit line; on by default. */
	designCredit?: boolean;
	highPriority?: boolean;
	/** Image sources resolved once by Hero.astro. */
	imageSources: HeroImageSources;
	/** Folio label resolved by Hero.astro. */
	displayLabel?: string;
}

const {
	name,
	secondaryName,
	nickname,
	date,
	time,
	venueName,
	backgroundImage,
	portrait,
	ornament,
	accentOrnament,
	variant,
	focalPoint,
	focalPointMobile,
	focalPointTablet,
	focalPointDesktop,
	tagline,
	photoCredit,
	editionMark = 'XV',
	coverMark = editionMark,
	coverPage = 'PÁG. 15',
	designCredit = true,
	highPriority = true,
	imageSources,
	displayLabel,
} = Astro.props;

const { bgSrc, mobileBgSrc, desktopBgSrc, portraitSrc } = imageSources;

// Dates formatting
const formattedDate = formatSpanishLongDate(date);

// Name parser for aggressive editorial composition
const names = name.trim().split(/\s+/);
let firstName = name;
let lastNames = '';
if (names.length >= 2) {
	firstName = names[0].toUpperCase();
	lastNames = names.slice(1).join(' ');
}

const fpDefault = focalPoint || '50% 40%';
const fpMobile = focalPointMobile || fpDefault;
const fpTablet = focalPointTablet || fpDefault;
const fpDesktop = focalPointDesktop || fpDefault;
---

<section
	id="inicio"
	class="invitation-hero"
	data-variant={variant}
	data-screenshot="invitation-open-hero"
	data-screenshot-section="hero"
>
	<!-- Graphic editorial watermark behind all content -->
	<div class="invitation-hero__watermark" aria-hidden="true">{coverMark}</div>

	<div class="invitation-hero__background">
		<picture>
			{mobileBgSrc && (
				<source media="(max-width: 991px)" srcset={mobileBgSrc} />
			)}
			{desktopBgSrc && (
				<source media="(min-width: 992px)" srcset={desktopBgSrc} />
			)}
			<CacheSafeImage
				src={bgSrc}
				delivery={'delivery' in backgroundImage ? backgroundImage.delivery : undefined}
				alt={name}
				width={1080}
				height={1920}
				format="webp"
				quality={80}
				loading="eager"
				fetchpriority={highPriority ? 'high' : undefined}
			/>
		</picture>
	</div>

	<!-- Top Folio Header Rail -->
	<div class="invitation-hero__folio-header">
		<span class="invitation-hero__folio-label">{displayLabel}</span>
		<div class="invitation-hero__folio-line"></div>
		<span class="invitation-hero__folio-page">{coverPage}</span>
	</div>

	<div class="invitation-hero__content">
		{portraitSrc && (
			<div class="invitation-hero__portrait">
				<CacheSafeImage
					src={portraitSrc}
					delivery={portrait && 'delivery' in portrait ? portrait.delivery : undefined}
					alt={`Retrato de ${name}`}
					width={600}
					height={800}
					format="webp"
					quality={90}
					loading="eager"
				/>
			</div>
		)}

		<div class="invitation-hero__text-column">
			{ornament && (
				<img
					class="invitation-hero__ornament"
					src={plainImgSrc(ornament.src)}
					alt=""
					width="240"
					height="120"
					loading="eager"
					decoding="async"
				/>
			)}
			<div class="invitation-hero__title-wrapper">
				<h1 class="invitation-hero__title">
					<span class="invitation-hero__first-name">{firstName}</span>
					{lastNames && <span class="invitation-hero__last-name">{lastNames}</span>}
					{secondaryName && (
						<>
							<span class="invitation-hero__ampersand">&</span>
							<span class="invitation-hero__secondary-name">{secondaryName}</span>
						</>
					)}
				</h1>
			</div>

			{nickname && (
				<div class="invitation-hero__nickname-badge">
					<span>{nickname}</span>
				</div>
			)}

			{tagline && <p class="invitation-hero__deck">{tagline}</p>}

			<div class="invitation-hero__divider"></div>

			<div class="invitation-hero__details">
				<p class="invitation-hero__date">{formattedDate}</p>
				{time && <p class="invitation-hero__time">{time}</p>}
				{venueName && <p class="invitation-hero__venue">
					<span class="calligraphy-accent">en</span> {venueName}
				</p>}
			</div>

			{accentOrnament && (
				<img
					class="invitation-hero__accent-ornament"
					src={plainImgSrc(accentOrnament.src)}
					alt=""
					width="320"
					height="160"
					loading="eager"
					decoding="async"
				/>
			)}

			<!-- Fashion/Publication credits block -->
			{(photoCredit || designCredit) && (
				<div class="invitation-hero__credits">
					{photoCredit && <span class="invitation-hero__credit-item">FOTOGRAFÍA / {photoCredit}</span>}
					{photoCredit && designCredit && <span class="invitation-hero__credit-divider">•</span>}
					{designCredit && <span class="invitation-hero__credit-item">DISEÑO / CELEBRA ME</span>}
				</div>
			)}
		</div>
	</div>
</section>

<style define:vars={{
	fpDefault,
	fpMobile,
	fpTablet,
	fpDesktop,
}}>
	.invitation-hero {
		--hero-focal-point-default: var(--fpDefault);
		--hero-focal-point-mobile: var(--fpMobile);
		--hero-focal-point-tablet: var(--fpTablet);
		--hero-focal-point-desktop: var(--fpDesktop);
	}
</style>
