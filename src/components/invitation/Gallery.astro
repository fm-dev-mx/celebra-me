---
import SplitWords from '@/components/invitation/SplitWords.astro';
import type { ImageMetadata } from 'astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import PhotoGallery from './PhotoGallery.astro';
import ScrollScene from './ScrollScene.astro';
import GalleryLightbox from './GalleryLightbox.astro';
import {
	resolveGalleryMobileBrowse,
	resolveGalleryPairedArrangement,
} from '@/lib/invitation/gallery-presentation';
import '@/styles/invitation/_gallery.scss';
import type {
	GalleryMobileBrowseMode,
	GalleryPairedArrangement,
	GalleryPresentation,
} from '@/lib/invitation/gallery-presentation';
import type { GalleryVariant } from '@/lib/invitation/section-variants';

interface GalleryItem {
	image: ImageMetadata | ImageAsset;
	caption?: string;
	focalPoint?: string;
	focalPointMobile?: string;
	focalPointTablet?: string;
	focalPointDesktop?: string;
}

interface Props {
	eyebrow?: string;
	title?: string;
	subtitle?: string;
	items: GalleryItem[];
	variant: GalleryVariant;
	presentation?: GalleryPresentation;
	variantOptions?: {
		mobileBrowse?: GalleryMobileBrowseMode;
		arrangement?: GalleryPairedArrangement;
	};
}

const {
	eyebrow = '',
	title,
	subtitle,
	items,
	variant,
	presentation,
	variantOptions,
} = Astro.props;
const isMagazineSpread = variant === 'magazine-spread';
const resolvedMobileBrowse = resolveGalleryMobileBrowse(variantOptions);
const usesMobileRail = isMagazineSpread && resolvedMobileBrowse === 'rail';
// Only paired-portraits declares an arrangement; other variants keep their markup unchanged.
const pairedArrangement =
	variant === 'paired-portraits' ? resolveGalleryPairedArrangement(variantOptions) : undefined;
const hasLastItem = Astro.slots.has('last-item');
const shownItems = hasLastItem ? items.slice(0, -1) : items;
// album-assemble pins the album page in a scroll scene; photos land one per step of the scroll.
const isAlbum = variant === 'album-assemble';
const SceneWrapper = isAlbum ? ScrollScene : Fragment;
const sceneProps = isAlbum
	? { length: 4 as const, steps: shownItems.length, class: 'gallery-album' }
	: {};
const pad = (value: number) => String(value).padStart(2, '0');

if (!items || items.length === 0) return null;
---

<section id="galeria" class="gallery-section" data-variant={variant} data-screenshot-section="gallery" {...(presentation && { 'data-presentation': presentation })} data-mobile-browse={resolvedMobileBrowse} {...(pairedArrangement && { 'data-arrangement': pairedArrangement })}>
	<SceneWrapper {...sceneProps}>
	<div class="gallery-section__container" data-gallery>
		<header class="gallery-section__header">
			{eyebrow && <span class="gallery-section__eyebrow" data-reveal-role="label">{eyebrow}</span>}
			{title?.trim() && <SplitWords class="gallery-section__title" text={title} />}
			{subtitle && <p class="gallery-section__subtitle" data-reveal-role="lede">{subtitle}</p>}
			{usesMobileRail && (
				<p class="gallery-section__swipe-hint">Desliza la edición</p>
			)}
			{isAlbum && (
				<span class="gallery-album__count" aria-hidden="true">
					<span class="gallery-album__count-roll">
						{shownItems.map((_, index) => (
							<span>{pad(index + 1)} / {pad(shownItems.length)}</span>
						))}
					</span>
				</span>
			)}
		</header>

		<PhotoGallery items={shownItems} variant={variant} revealItems={!isAlbum} />
		{isAlbum && (
			<div class="gallery-album__footer" aria-hidden="true">
				<span class="gallery-album__progress"><span class="gallery-album__progress-bar" /></span>
				<span class="gallery-album__hint">Siga bajando para armar el álbum</span>
			</div>
		)}
		<slot name="last-item" />
	</div>
	</SceneWrapper>
</section>

<GalleryLightbox variant={variant} />
