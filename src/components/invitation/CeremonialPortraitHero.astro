---
import { formatSpanishLongDate } from '@/lib/invitation/venue-datetime';
import { plainImgSrc } from '@/lib/assets/image-delivery-policy';
import { resolveExplicitImageDelivery } from '@/lib/assets/image-delivery.server';
import type { ImageDelivery } from '@/lib/assets/image-delivery';
import type { ImageMetadata } from 'astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import CacheSafeImage from '@/components/common/CacheSafeImage.astro';
import CeremonialFiligree from './CeremonialFiligree.astro';

interface Props {
	name: string;
	secondaryName?: string;
	label?: string;
	date: string;
	backgroundImage?: ImageMetadata | ImageAsset;
	backgroundImageDesktop?: { src: string; delivery?: ImageDelivery };
	backgroundImageMobile?: ImageMetadata | ImageAsset;
	scrollLabel?: string;
	ambience?: ImageAsset;
	highPriority?: boolean;
}
const {
	name,
	secondaryName,
	label,
	date,
	backgroundImage,
	backgroundImageDesktop,
	backgroundImageMobile,
	scrollLabel = 'Desliza',
	ambience,
	highPriority = true,
} = Astro.props;
const words = name.trim().split(/\s+/);
const split = Math.ceil(words.length / 2);
const lines = [words.slice(0, split).join(' '), words.slice(split).join(' ')].filter(Boolean);
const delivery = backgroundImage && 'delivery' in backgroundImage ? backgroundImage.delivery : undefined;
const formattedDate = formatSpanishLongDate(date);
// Art-directed sources honor their declared delivery, like the other hero variants.
const resolveSource = async (
	image: { src: string | ImageMetadata; delivery?: ImageDelivery } | undefined,
	width: number,
): Promise<string | null> => {
	if (!image) return null;
	return image.delivery
		? resolveExplicitImageDelivery(image.src, image.delivery, { width, quality: 84, format: 'webp' })
		: plainImgSrc(image.src);
};
const desktopSrc = await resolveSource(backgroundImageDesktop, 1920);
const mobileSrc = await resolveSource(
	backgroundImageMobile && {
		src: backgroundImageMobile.src,
		delivery: 'delivery' in backgroundImageMobile ? backgroundImageMobile.delivery : undefined,
	},
	1080,
);
---
<section id="inicio" class="invitation-hero ceremonial-portrait-hero" data-variant="ceremonial-portrait" data-screenshot="invitation-open-hero" data-screenshot-section="hero">

	<div class="ceremonial-portrait-hero__scrim" aria-hidden="true"></div>
	{ambience && <img class="ceremonial-portrait-hero__ambience" src={plainImgSrc(ambience.src)} alt="" width="900" height="1350" loading="lazy" decoding="async" />}
	<CeremonialFiligree class="ceremonial-portrait-hero__side ceremonial-portrait-hero__side--left" />
	<CeremonialFiligree class="ceremonial-portrait-hero__side ceremonial-portrait-hero__side--right" />
	<div class="ceremonial-portrait-hero__paper">
	<div class="ceremonial-portrait-hero__content">
		<CeremonialFiligree class="ceremonial-portrait-hero__crest" />
		{label && <p class="ceremonial-portrait-hero__label">{label}</p>}
		<h1 class="ceremonial-portrait-hero__name">{lines.map(line => <span>{line}</span>)}{secondaryName && <span>&amp; {secondaryName}</span>}</h1>
		<p class="ceremonial-portrait-hero__date">{formattedDate}</p>
	</div>
	{backgroundImage && (
		<figure class="ceremonial-portrait-hero__photograph ceremonial-portrait-hero__media"><picture>
			{desktopSrc && <source media="(min-width: 64rem)" srcset={desktopSrc} />}
			{mobileSrc && <source media="(max-width: 63.999rem)" srcset={mobileSrc} />}
			<CacheSafeImage
				src={backgroundImage.src}
				delivery={delivery}
				alt=""
				width={delivery?.width ?? 1476}
				height={delivery?.height ?? 1600}
				loading="eager"
				fetchpriority={highPriority ? 'high' : undefined}
				decoding="async"
			/>
		</picture></figure>
	)}
	</div>
	<div class="invitation-hero__scroll-indicator ceremonial-portrait-hero__scroll-indicator" aria-hidden="true">
		<span class="invitation-hero__scroll-text">{scrollLabel}</span>
		<div class="invitation-hero__scroll-chevron">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="m6 9 6 6 6-6" />
			</svg>
		</div>
	</div>
</section>
