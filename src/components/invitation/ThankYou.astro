---
import '@/styles/invitation/_thank-you.scss';
import OptimizedImage from '@/components/common/OptimizedImage.astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import type { ThankYouVariant } from '@/lib/invitation/section-variants';

interface Props {
	message: string;
	closingName: string;
	date?: string;
	image?: string | ImageAsset;
	variant?: ThankYouVariant;
	focalPoint?: string;
	overlayAnchor?: 'left' | 'right' | 'top' | 'bottom';
	overlaySafeArea?: {
		x: number;
		y: number;
		width: number;
		height: number;
	};
}

const {
	message,
	closingName,
	date,
	image,
	variant = 'standard',
	focalPoint,
	overlayAnchor,
	overlaySafeArea,
} = Astro.props;
const usesEditorialLayout = variant === 'editorial-back-cover';
const hasSubjectAwareOverlay = Boolean(overlayAnchor || overlaySafeArea);

const firstLetter = message.charAt(0);
const remainingMessage = message.slice(1);

const IMAGE_CONFIGS = {
	'subject-aware': {
		width: 1600,
		height: 2000,
		widths: [640, 960, 1200, 1600],
		sizes: '100vw',
		format: 'webp' as const,
		quality: 90,
		class: 'photo-image',
	},
	standard: {
		width: 400,
		height: 400,
		class: 'photo-image',
	},
} as const;

const needsLargePhoto = hasSubjectAwareOverlay || variant === 'full-bleed-photo';
const configKey: keyof typeof IMAGE_CONFIGS = needsLargePhoto ? 'subject-aware' : 'standard';
const imageConfig = IMAGE_CONFIGS[configKey];

---

<section
	id="thank-you-section"
	data-screenshot-section="thankYou"
	class="thank-you-section"
	data-variant={variant}
	data-overlay-anchor={overlayAnchor}
	data-has-overlay-safe-area={overlaySafeArea ? 'true' : undefined}
>
	{
		usesEditorialLayout ? (
			<div class="thank-you-editorial">
				<div class="thank-you-editorial__ambient" aria-hidden="true" />
				{image && (
					<figure class="thank-you-editorial__media photo-frame">
						<div class="thank-you-editorial__image-shell">
							<OptimizedImage
								imagePath={image}
								alt={closingName}
								{...imageConfig}
							/>
						</div>
					</figure>
				)}

				<div class="thank-you-editorial__copy">
					<div class="message-container">
						<p class="thank-you-message">
							<span class="drop-cap">{firstLetter}</span>{remainingMessage}
						</p>
					</div>

					<div class="signature-block">
						<p class="closing-name">
							{closingName}
						</p>
						{date && <p class="closing-date">{date}</p>}
					</div>
				</div>
			</div>
	) : (
			<div class="thank-you-content">
				{image && (
					<div class="photo-frame">
						<OptimizedImage
							imagePath={image}
							alt={closingName}
							{...imageConfig}
						/>
					</div>
				)}
				<div class="message-container">
					<p class="thank-you-message">
						<span class="drop-cap">{firstLetter}</span>{remainingMessage}
					</p>
				</div>

				<div class="signature-block">
					<p class="closing-name">
						{closingName}
					</p>
					{date && <p class="closing-date">{date}</p>}
				</div>
			</div>
	)
}
</section>

<style define:vars={{
	safeX: overlaySafeArea ? `${overlaySafeArea.x * 100}%` : '0%',
	safeY: overlaySafeArea ? `${overlaySafeArea.y * 100}%` : '0%',
	safeW: overlaySafeArea ? `${overlaySafeArea.width * 100}%` : '0%',
	safeH: overlaySafeArea ? `${overlaySafeArea.height * 100}%` : '0%',
	thankYouFocalPoint: focalPoint || 'center',
}}>
	.thank-you-section {
		--thank-you-focal-point: var(--thankYouFocalPoint);
		--thank-you-safe-x: var(--safeX);
		--thank-you-safe-y: var(--safeY);
		--thank-you-safe-width: var(--safeW);
		--thank-you-safe-height: var(--safeH);
	}

	.closing-date {
		margin: 0.5rem 0 0;
		color: var(--color-text-secondary);
		font-family: var(--font-label);
		font-size: clamp(0.75rem, 1.8vw, 0.95rem);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}
</style>
