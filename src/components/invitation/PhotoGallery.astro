---
/* eslint-disable no-restricted-syntax -- item-level focal points must override theme crop fallbacks */
import type { ImageMetadata } from 'astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import { getGalleryPreviewRole } from '@/lib/components/gallery/gallery-presentation';
import { resolveGalleryLayoutVariant } from '@/lib/invitation/structural-variants';

interface GalleryItem {
	image: ImageMetadata | ImageAsset;
	alt?: string;
	caption?: string;
	key?: string;
	layoutRole?: 'feature' | 'wide' | 'standard';
	aspectRatio?: string;
	focalPoint?: string;
	focalPointMobile?: string;
	focalPointTablet?: string;
	focalPointDesktop?: string;
}

interface Props {
	items: GalleryItem[];
	variant?: string;
	visualVariant?: string;
	structuralVariantExplicit?: boolean;
}

const { items, variant = 'uniform-grid', visualVariant, structuralVariantExplicit = false } = Astro.props;
const structuralVariant = resolveGalleryLayoutVariant(variant, variant, 'jewelry-box');
const renderedVisualVariant = visualVariant ?? variant;
const isEditorialMagazine = structuralVariant === 'magazine-spread';

const resolveImage = (image: ImageMetadata | ImageAsset) => {
	const src = typeof image.src === 'string' ? image.src : image.src.src;
	const meta = 'width' in image ? image : (typeof image.src !== 'string' ? image.src : null);
	return { src, width: meta?.width ?? 800, height: meta?.height ?? 1000 };
};
---

<div class="gallery-grid" data-gallery data-variant={renderedVisualVariant} {...(structuralVariantExplicit && { 'data-structural-variant': structuralVariant })}>
	{
		items.map((item, index) => {
			const { src, width, height } = resolveImage(item.image);
			const layoutRole = getGalleryPreviewRole(index, structuralVariant, item.layoutRole);
			const layoutClass = `gallery-grid__item--${layoutRole}`;
			const aspectStyle = item.aspectRatio ? `aspect-ratio: ${item.aspectRatio};` : '';
			return (
			<div
				class:list={['gallery-grid__item', layoutClass]}
				data-gallery-item
				data-reveal-item
				data-gallery-index={index}
				data-layout-role={layoutRole}
				data-image-key={item.key}
				data-gallery-src={src}
				data-gallery-caption={item.caption ?? ''}
				style={`${aspectStyle}${item.focalPoint ? `--gallery-item-focal-point: ${item.focalPoint};` : ''}${item.focalPointMobile ? `--gallery-item-focal-point-mobile: ${item.focalPointMobile};` : ''}${item.focalPointTablet ? `--gallery-item-focal-point-tablet: ${item.focalPointTablet};` : ''}${item.focalPointDesktop ? `--gallery-item-focal-point-desktop: ${item.focalPointDesktop};` : ''}`}
				tabindex="0"
				role="button"
				aria-label={item.alt || item.caption || `Ver imagen ${index + 1}`}
			>
			<img
					src={src}
					alt={item.alt || item.caption || `Imagen ${index + 1}`}
					width={width}
					height={height}
					loading="lazy"
					decoding="async"
					fetchpriority={index >= 2 ? 'low' : undefined}
				/>
				<!-- "LOOK" is intentionally English — editorial fashion label style -->
				{isEditorialMagazine && (
					<span class="gallery-grid__editorial-label">
						LOOK {String(index + 1).padStart(2, '0')}
					</span>
				)}
				{item.caption && (
					<div class="gallery-grid__overlay">
						<p class="gallery-grid__caption">{item.caption}</p>
					</div>
				)}
			</div>
			);
		})
	}
</div>

<script>
	const initGallery = () => {
		const gallery = document.querySelector('[data-gallery]');
		if (!gallery) return;
		const galleryItems = Array.from(gallery.querySelectorAll('[data-gallery-item]'));

		const invitationRoot = gallery.closest('[data-event-slug]');

		const openLightbox = (item: HTMLElement) => {
			if (
				invitationRoot instanceof HTMLElement &&
				invitationRoot.dataset.revealState !== 'revealed'
			) {
				return;
			}
			document.dispatchEvent(
				new CustomEvent('gallery:open', {
					detail: {
						src: item.dataset.gallerySrc || '',
						caption: item.dataset.galleryCaption || '',
						alt: item.getAttribute('aria-label') || ''
					}
				})
			);
		};

		galleryItems.forEach((item) => {
			const htmlItem = item as HTMLElement;
			htmlItem.addEventListener('click', () => openLightbox(htmlItem));
			htmlItem.addEventListener('keydown', (event: KeyboardEvent) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					openLightbox(htmlItem);
				}
			});
		});
	};

	initGallery();
</script>

