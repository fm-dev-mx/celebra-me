---
/*
  VenueCard Component
  Extracted from EventLocation.astro to avoid duplication.
*/
import OptimizedImage from '@/components/common/OptimizedImage.astro';
import GoogleMap from '@/components/common/GoogleMap.astro';
import Icon from '@/components/common/icons/Icon.astro';
import { resolveVenueMapPreviewUrl } from '@/lib/invitation/location-helper';

import type { ImageMetadata } from 'astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import {
	resolveLocationMediaMode,
	type LocationPresentation,
} from '@/lib/invitation/presentation-options';

interface VenueEventItem {
	name: string;
	time: string;
}

interface VenueData {
	venueEvent: string;
	venueName: string;
	address: string;
	date: string;
	time: string;
	mapUrl?: string;
	appleMapsUrl?: string;
	googleMapsUrl?: string;
	wazeUrl?: string;
	image?: string | ImageMetadata | ImageAsset;
	focalPoint?: string;
	coordinates?: {
		lat: number;
		lng: number;
		zoom?: number;
	};
	events?: VenueEventItem[];
}

interface Props {
	venue: VenueData;
	type: 'ceremony' | 'reception' | 'custom' | 'grouped';
	variant?: string;
	presentation?: LocationPresentation;
	showFlourishes?: boolean;
	showNavigationButtons?: boolean;
	accessLabel?: string;
}

const {
	venue,
	type,
	variant = 'structured',
	presentation,
	showFlourishes = true,
	showNavigationButtons = true,
	accessLabel,
} = Astro.props;

// Format venue date as human-readable Spanish string.
// Invitation dates are floating event-local values serialized with a UTC
// suffix (e.g. "2026-08-01T18:00:00.000Z"). We use timeZone: 'UTC' to
// avoid visual date shifting on non-UTC servers.
function formatVenueDate(raw: string): string | null {
	if (!raw) return null;
	try {
		const d = new Date(raw);
		if (isNaN(d.getTime())) return null;
		return d.toLocaleDateString('es-MX', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
			timeZone: 'UTC',
		});
	} catch {
		return null;
	}
}

const formattedDate = formatVenueDate(venue.date);
const mediaMode = resolveLocationMediaMode(presentation, {
	hasCoordinates: Boolean(venue.coordinates),
	hasImage: Boolean(venue.image),
});
const mapPreviewUrl = resolveVenueMapPreviewUrl(venue);
const hasMapLink = Boolean(mapPreviewUrl);
const useMapPreviewLink = showNavigationButtons === false && hasMapLink;
---

<div class="event-location__card-wrapper" data-reveal-item>
	{accessLabel && <p class="event-location__access-label">{accessLabel}</p>}
	<h3 class="event-location__card-title">{venue.venueEvent}</h3>
	{showFlourishes && (
		<div class="event-location__card-flourish" aria-hidden="true">
			<span class="flourish-line"></span>
			<span class="flourish-diamond"></span>
			<span class="flourish-line"></span>
		</div>
	)}
	<article class={`event-location__card event-location__card--${type}`} data-media-mode={mediaMode}>
		{mediaMode !== 'none' && !useMapPreviewLink && (
			<div class="event-location__card-image-outer-frame">
				<div class="event-location__card-image-inner-frame">
					<div class="event-location__card-image-container" data-focal-point={venue.focalPoint}>
						{mediaMode === 'map' && venue.coordinates && (
							<GoogleMap
								lat={venue.coordinates.lat}
								lng={venue.coordinates.lng}
								zoom={venue.coordinates.zoom}
								title={venue.venueName}
								variant={variant}
							/>
						)}
						{mediaMode === 'image' && venue.image && (
							<OptimizedImage
								imagePath={venue.image}
								alt={venue.venueName}
								class="event-location__card-image"
							/>
						)}
					</div>
				</div>
			</div>
		)}
		{/* Venue-specific map preview plate for mediaMode === 'none'.
		    Linked to the canonical map URL; carries the address as the
		    source of truth and a venue-type-driven decorative composition. */}
		{mediaMode === 'none' && useMapPreviewLink && (
			<a
				href={mapPreviewUrl}
				class="event-location__card-map-preview event-location__card-map-preview--link"
				data-map-preview="link"
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`Abrir mapa de ${venue.venueName}`}
			>
				<span class="event-location__card-map-preview-art" aria-hidden="true">
					<span class="event-location__card-map-preview-grid"></span>
					{type === 'ceremony' && (
						<svg
							class="event-location__card-map-preview-artwork"
							data-venue-artwork="church"
							viewBox="0 0 240 112"
							aria-hidden="true"
							focusable="false"
						>
							<path class="event-location__card-map-preview-artwork-horizon" d="M18 96h204" />
							<path class="event-location__card-map-preview-artwork-silhouette" d="M52 96V61l68-27 68 27v35H52Z" />
							<path class="event-location__card-map-preview-artwork-silhouette" d="M101 96V31h38v65h-38Z" />
							<path class="event-location__card-map-preview-artwork-silhouette" d="m120 9 11 13h-22L120 9Z" />
							<path class="event-location__card-map-preview-artwork-cross" d="M117 7h6v10h9v6h-9v11h-6V23h-9v-6h9V7Z" />
							<path class="event-location__card-map-preview-artwork-detail" d="M111 96V79a9 9 0 0 1 18 0v17h-18Z" />
							<circle class="event-location__card-map-preview-artwork-detail" cx="120" cy="48" r="5" />
							<path class="event-location__card-map-preview-artwork-detail" d="M73 68h12v12H73zM155 68h12v12h-12z" />
						</svg>
					)}
					{type === 'reception' && (
						<svg
							class="event-location__card-map-preview-artwork"
							data-venue-artwork="event-hall"
							viewBox="0 0 240 112"
							aria-hidden="true"
							focusable="false"
						>
							<path class="event-location__card-map-preview-artwork-horizon" d="M18 96h204" />
							<path class="event-location__card-map-preview-artwork-silhouette" d="M36 96V59h35l12-16h74l12 16h35v37H36Z" />
							<path class="event-location__card-map-preview-artwork-silhouette" d="M78 43h84l-12-14H90L78 43Z" />
							<path class="event-location__card-map-preview-artwork-detail" d="M48 65h21v31H48zM171 65h21v31h-21z" />
							<path class="event-location__card-map-preview-artwork-detail" d="M91 65h18v16H91zM131 65h18v16h-18z" />
							<path class="event-location__card-map-preview-artwork-detail" d="M107 96V77a13 13 0 0 1 26 0v19h-26Z" />
						</svg>
					)}
					<span class="event-location__card-map-preview-pin">
						<Icon name="MapLocation" size={20} />
					</span>
				</span>
				<span class="event-location__card-map-preview-foot">
					<span class="event-location__card-map-preview-label">Ver mapa</span>
					<Icon name="ArrowRight" size={16} />
				</span>
			</a>
		)}
		{mediaMode === 'none' && !useMapPreviewLink && hasMapLink && (
			<div class="event-location__card-map-preview" data-map-preview="link">
				<div class="event-location__card-map-preview-art" aria-hidden="true">
					<span class="event-location__card-map-preview-grid"></span>
					<span class="event-location__card-map-preview-pin">
						<Icon name="MapLocation" size={24} />
					</span>
				</div>
				<div class="event-location__card-map-preview-copy">
					<span class="event-location__card-map-preview-label">Ubicación</span>
						<a
						href={mapPreviewUrl}
						class="event-location__card-map-preview-link"
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Abrir mapa de ${venue.venueName}`}
					>
						Ver mapa
						<Icon name="ArrowRight" size={16} />
					</a>
				</div>
			</div>
		)}
		{/* Card content: venue name → naturally formatted time → address with copy. */}
		<div class="event-location__card-content">
			<ul class="event-location__card-content-list">
				<li class="event-location__card-content-place">
					{venue.venueName}
				</li>
				{formattedDate && (
					<li class="event-location__card-content-date">
						{formattedDate}
					</li>
				)}
				{venue.events && venue.events.length > 0 ? (
					<li class="event-location__card-content-itinerary">
						<ul class="event-location__card-content-itinerary-list">
							{venue.events.map((evt) => (
								<li class="event-location__card-content-itinerary-item">
									<span class="event-location__card-content-itinerary-dot" />
									<span class="event-location__card-content-itinerary-label">{evt.name}</span>
									<span class="event-location__card-content-itinerary-time">{evt.time}</span>
								</li>
							))}
						</ul>
					</li>
				) : (
					<li class="event-location__card-content-hour">{venue.time}</li>
				)}
				<li class="event-location__card-content-address">
					<span class="event-location__card-content-address-text">{venue.address}</span>
					<button
						type="button"
						class="event-location__card-content-copy-button copy-button"
						data-address={venue.address}
						aria-label="Copiar dirección"
						title="Copiar dirección"
					>
						<Icon name="Copy" size={20} />
					</button>
				</li>
			</ul>

			{showNavigationButtons && (
				<div class="event-location__card-navigation-buttons">
					{venue.appleMapsUrl && (
						<a
							href={venue.appleMapsUrl}
							class="event-location__nav-button event-location__nav-button--apple u-hidden-initially"
							target="_blank"
							rel="noopener noreferrer"
							data-apple-link
						>
							Apple Maps
						</a>
					)}
					{venue.googleMapsUrl && (
						<a
							href={venue.googleMapsUrl}
							class="event-location__nav-button event-location__nav-button--maps"
							target="_blank"
							rel="noopener noreferrer"
						>
							Google Maps
						</a>
					)}
					{venue.wazeUrl && (
						<a
							href={venue.wazeUrl}
							class="event-location__nav-button event-location__nav-button--waze"
							target="_blank"
							rel="noopener noreferrer"
						>
							Waze
						</a>
					)}
					{!venue.appleMapsUrl && !venue.googleMapsUrl && venue.mapUrl && (
						<a
							href={venue.mapUrl}
							class="event-location__nav-button event-location__nav-button--primary"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon name="MapLocation" size={20} />
							Cómo llegar
						</a>
					)}
				</div>
			)}
		</div>

		{variant === 'luxury-hacienda' && (
			<>
				<span class="rivet rivet--tl"></span>
				<span class="rivet rivet--tr"></span>
				<span class="rivet rivet--bl"></span>
				<span class="rivet rivet--br"></span>
			</>
		)}
	</article>
</div>


