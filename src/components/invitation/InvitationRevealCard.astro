---
import type { RevealCardData } from '@/lib/invitation/reveal-card';

interface Props {
	card: RevealCardData;
	showAction?: boolean;
	showGuest?: boolean;
}

const { card, showAction = true, showGuest = true } = Astro.props;
---

<article class="invitation-reveal-card" aria-label={card.label} data-screenshot="reveal-letter">
	<div class="invitation-reveal-card__inner">
		<p class="invitation-reveal-card__label">{card.label}</p>
		<h2 class="invitation-reveal-card__name">
			<span>{card.primaryName}</span>
			{
				card.secondaryName && (
					<>
						<span class="invitation-reveal-card__ampersand">&</span>
						<span>{card.secondaryName}</span>
					</>
				)
			}
		</h2>
		<p class="invitation-reveal-card__date">{card.date}</p>

		{
			card.tagline && (
				<p class="invitation-reveal-card__tagline">{card.tagline}</p>
			)
		}

		<div class="invitation-reveal-card__divider" aria-hidden="true"></div>

		{
			showGuest && card.guestName && (
				<div class="invitation-reveal-card__guest">
					<p class="invitation-reveal-card__guest-label">{card.guestLabel}</p>
					<strong class="invitation-reveal-card__guest-name">{card.guestName}</strong>
				</div>
			)
		}

		{
			showAction && (
				<div class="invitation-reveal-card__action-wrapper">
					<button
						type="button"
						class="invitation-reveal-card__action"
						data-envelope-open
						aria-label="Abrir la invitación"
					>
						ABRIR LA INVITACIÓN
					</button>
				</div>
			)
		}
	</div>
</article>
