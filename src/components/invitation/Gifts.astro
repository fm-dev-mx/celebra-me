---
import '@/styles/invitation/_gifts.scss';
import { GiftIcon } from '@/components/common/icons/invitation/Gift';
import { BankCardIcon } from '@/components/common/icons/ui/BankCard';
import { CashIcon } from '@/components/common/icons/ui/Cash';
import { PayPalIcon } from '@/components/common/icons/social/PayPal';
import { CopyIcon } from '@/components/common/icons/ui/Copy';
import { CheckIcon } from '@/components/common/icons/ui/Check';
import type { GiftsPresentation } from '@/lib/invitation/gifts-presentation';
import type { GiftsVariant } from '@/lib/invitation/section-variants';

interface GiftStoreLink {
	label: string;
	url: string;
}

interface GiftStore {
	type: 'store';
	title: string;
	url?: string;
	links?: GiftStoreLink[];
	logo?: string;
	description?: string;
	// Labeled as 'Evento:' in the template (line 186). Field name kept as tableNumber
	// for backward compatibility with the data model.
	tableNumber?: string;
}

interface GiftBank {
	type: 'bank';
	title: string;
	bankName: string;
	accountHolder: string;
	clabe: string;
	accountNumber?: string;
}

interface GiftPaypal {
	type: 'paypal';
	title: string;
	url: string;
}

interface GiftCash {
	type: 'cash';
	title: string;
	text?: string;
}

type Gift = GiftStore | GiftBank | GiftPaypal | GiftCash;

interface Props {
	gifts: Gift[];
	variant: GiftsVariant;
	presentation: GiftsPresentation;
	eyebrow?: string;
	title?: string;
	subtitle?: string;
	labels?: {
		copy?: string;
		copied?: string;
		viewRegistry?: string;
		sendGift?: string;
		bank?: string;
		titular?: string;
		clabe?: string;
	};
}

const {
	gifts,
	variant,
	presentation,
	eyebrow,
	title = 'Mesa de Regalos',
	subtitle = 'Su presencia es nuestro mayor regalo, pero si desean tener un detalle, aquí les compartimos algunas opciones.',
	labels = {
		copy: 'Copiar',
		copied: '¡Copiado!',
		viewRegistry: 'Ver mesa de regalos',
		sendGift: 'Enviar Regalo',
		bank: 'Banco',
		titular: 'Titular',
		clabe: 'CLABE',
	},
} = Astro.props;

const isEditorialCatalog = variant === 'editorial-catalog';
const isLegendOnly = presentation === 'legend-only';
const displayTitle = isEditorialCatalog ? 'Mesa de cortesía' : title;

function isSafeHttpUrl(value: unknown): value is string {
	if (typeof value !== 'string') return false;
	try {
		const protocol = new URL(value).protocol;
		return protocol === 'http:' || protocol === 'https:';
	} catch {
		return false;
	}
}

function getSafeGiftLinks(gift: Gift): GiftStoreLink[] {
	if (gift.type !== 'store') return [];
	return gift.links?.filter((link) => isSafeHttpUrl(link.url)) ?? [];
}

function getSafeGiftUrl(gift: Gift): string | null {
	if (gift.type !== 'store' && gift.type !== 'paypal') return null;
	return isSafeHttpUrl(gift.url) ? gift.url : null;
}

function getGiftHeaderDescription(gift: Gift): { className: string; text: string } | null {
	if (gift.type === 'store' && gift.description)
		return { className: 'gift-card__store-label', text: gift.description };
	if (gift.type === 'cash' && gift.text)
		return { className: 'gift-card__description', text: gift.text };
	return null;
}

const ICON_MAP = {
	store: GiftIcon,
	bank: BankCardIcon,
	paypal: PayPalIcon,
	cash: CashIcon,
};

function getTableNumberEntries(tableNumberStr?: string) {
	if (!tableNumberStr) return [];
	const parts = tableNumberStr.split(/·|,|;/).map((p) => p.trim()).filter(Boolean);
	return parts.map((part) => {
		// Strictly match digits first (e.g. "237993" or "52006296" from "Sears 237993")
		const digitMatch = part.match(/\b(\d{4,})\b/);
		if (digitMatch) {
			return {
				displayLabel: part,
				cleanNumber: digitMatch[1],
			};
		}
		// Fallback: strip common store/label prefixes
		const cleanNumber = part
			.replace(/^(sears|liverpool|palacio|amazon|evento|no\.?|n°)\s*/i, '')
			.replace(/\s+/g, '');
		return {
			displayLabel: part,
			cleanNumber: cleanNumber || part,
		};
	});
}

const safeGiftLinks = gifts.map(getSafeGiftLinks);
const safeGiftUrls = gifts.map(getSafeGiftUrl);
---

<section id="regalos" class="gifts-section" data-screenshot-section="gifts" data-variant={variant} data-presentation={presentation}>
	<div class="gifts-section__container">
		<header class="gifts-section__header">
			{eyebrow && <span class="gifts-section__eyebrow">{eyebrow}</span>}
			<h2 class="gifts-section__title">{displayTitle}</h2>
			{!isLegendOnly && (
				<div class="gifts-section__flourish" aria-hidden="true">
					<span class="flourish-line"></span>
					<span class="flourish-diamond"></span>
					<span class="flourish-line"></span>
				</div>
			)}
			{subtitle && <p class="gifts-section__subtitle">{subtitle}</p>}
		</header>

		{!isLegendOnly && (
			<>
		<div class="gifts-section__separator" aria-hidden="true"></div>

		<div class="gifts-grid" data-count={gifts.length}>
			{
				gifts.map((gift, index) => {
					const Icon = ICON_MAP[gift.type];
					const giftNumber = String(index + 1).padStart(2, '0');
					const headerDescription = getGiftHeaderDescription(gift);
					const safeLinks = safeGiftLinks[index] ?? [];
					const safeGiftUrl = safeGiftUrls[index] ?? null;
					return (
						<div class={`gift-card gift-card--${gift.type}`} data-reveal-item>
							<div class="gift-card__inner">
								<div class="gift-card__content-head">
									{isEditorialCatalog && (
										<div class="gift-card__folio" aria-hidden="true">
											<span>VH</span>
											<span>EDICIÓN XV</span>
										</div>
									)}
									{isEditorialCatalog && (
										<p class="gift-card__issue-label">
											<span>{giftNumber}</span>
											<span>{gift.title}</span>
										</p>
									)}

									<div class="gift-card__icon-medallion">
										<div class="gift-card__icon-inner">
											<Icon size={24} />
										</div>
									</div>

									<h3 class="gift-card__title">{gift.title}</h3>

					{headerDescription && (
						<p class={headerDescription.className}>{headerDescription.text}</p>
					)}
								</div>

								{gift.type === 'store' && gift.tableNumber && (
									<div class="gift-card__table-number-wrapper">
										<span class="gift-card__table-number-label">Evento:</span>
										{getTableNumberEntries(gift.tableNumber).map((entry) => (
											<span class="gift-card__number-pill">
												<span class="gift-card__table-number-code">{entry.displayLabel}</span>
												<button
													type="button"
													class="copy-icon-button"
													data-copy-text={entry.cleanNumber}
													aria-label={`Copiar evento ${entry.cleanNumber}`}
													title="Copiar número"
												>
													<CopyIcon size={14} className="icon-copy" />
													<CheckIcon size={14} className="icon-check" />
												</button>
											</span>
										))}
									</div>
								)}

								{gift.type === 'bank' && (
									<div class="bank-details">
										<p class="bank-details__item">
											<strong>{labels.bank}:</strong>
											<span data-status={gift.bankName.includes('PENDIENTE') ? 'pending' : undefined}>{gift.bankName}</span>
										</p>
										<p class="bank-details__item">
											<strong>{labels.titular}:</strong>
											<span data-status={gift.accountHolder.includes('PENDIENTE') ? 'pending' : undefined}>{gift.accountHolder}</span>
										</p>
										<div class="bank-details__clabe-wrapper">
											<p class="bank-details__item">
												<strong>{labels.clabe}:</strong>
												<span class="clabe-number">{gift.clabe}</span>
											</p>
											<button
												type="button"
												class="copy-icon-button"
												data-copy-text={gift.clabe.replace(/\s+/g, '')}
												aria-label="Copiar número CLABE"
												title="Copiar CLABE"
											>
												<CopyIcon size={14} className="icon-copy" />
												<CheckIcon size={14} className="icon-check" />
											</button>
										</div>
									</div>
								)}

								{gift.type === 'store' && (safeLinks.length > 0 || safeGiftUrl) && (
									<div class="gift-card__actions">
										{safeLinks.length > 0 ? (
											safeLinks.map((link) => (
												<a
												href={link.url}
												target="_blank"
												rel="noopener noreferrer"
												class="gift-card__button"
												>
													{link.label}
												</a>
											))
										) : (
											<a href={safeGiftUrl ?? '#'} target="_blank" rel="noopener noreferrer" class="gift-card__button">
												{labels.viewRegistry}
											</a>
										)}
									</div>
								)}

								{gift.type === 'paypal' && safeGiftUrl && (
									<div class="gift-card__actions">
										<a href={safeGiftUrl} target="_blank" rel="noopener noreferrer" class="gift-card__button gift-card__button--paypal">
											{labels.sendGift}
										</a>
									</div>
								)}
							</div>
						</div>
					);
				})
			}
		</div>
			</>
		)}
	</div>
</section>
<script>

	document.querySelectorAll('.copy-icon-button').forEach((button) => {
		button.addEventListener('click', async () => {
			const textToCopy = button.getAttribute('data-copy-text');
			if (!textToCopy) {
				return;
			}

			const normalizedText = textToCopy.replace(/\s+/g, '').trim();
			try {
				await navigator.clipboard.writeText(normalizedText);
				button.classList.add('copy-success', 'copy-button--success');
				window.setTimeout(() => {
					button.classList.remove('copy-success', 'copy-button--success');
				}, 2000);
			} catch (err) {
				console.error('Failed to copy text', err);
			}
		});
	});
</script>

