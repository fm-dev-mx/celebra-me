---
import '@/styles/invitation/_event-calendar.scss';
import type { CountdownCalendarMark } from '@/lib/invitation/countdown-presentation';
import { EVENT_CALENDAR_WEEKDAYS, type EventCalendarMonth } from '@/lib/invitation/event-calendar';

interface Props {
	month: EventCalendarMonth;
	mark: CountdownCalendarMark;
}

const { month, mark } = Astro.props;
// Line-art marks drawn once around the event day (pathLength 1 drives the stroke draw).
const MARK_PATHS: Record<CountdownCalendarMark, string> = {
	ring: 'M24 5.5c10.8 0 18.7 8 18.5 18.6-.2 10.4-8.6 18.6-18.9 18.4C13.3 42.3 5.3 34 5.5 23.6 5.7 13.3 14 5.2 25.5 5.9',
	heart: 'M24 41C12 32.5 5 25.5 6.6 16.8 7.9 10 15.6 7 20.6 11.2c1.5 1.3 2.6 2.8 3.4 4.6.8-1.8 1.9-3.3 3.4-4.6 5-4.2 12.7-1.2 14 5.6C43 25.5 36 32.5 24 41Z',
	sun: 'M24 9.5c8 0 14.5 6.5 14.5 14.5S32 38.5 24 38.5 9.5 32 9.5 24 16 9.5 24 9.5ZM24 1.5v4.5M24 42v4.5M1.5 24H6M42 24h4.5M8.1 8.1l3.2 3.2M36.7 36.7l3.2 3.2M39.9 8.1l-3.2 3.2M11.3 36.7l-3.2 3.2',
};
const label = `${month.title}, día ${month.eventDay}`;
---

<figure class="event-calendar" data-mark={mark} data-reveal-role="item" role="img" aria-label={label}>
	<figcaption class="event-calendar__title" aria-hidden="true">{month.title}</figcaption>
	<div class="event-calendar__grid" aria-hidden="true">
		{EVENT_CALENDAR_WEEKDAYS.map((weekday) => <span class="event-calendar__weekday">{weekday}</span>)}
		{month.weeks.flat().map((day) => (
			day === null ? (
				<span class="event-calendar__day event-calendar__day--empty" />
			) : day === month.eventDay ? (
				<span class="event-calendar__day event-calendar__day--event">
					{day}
					<svg class="event-calendar__mark" viewBox="0 0 48 48" fill="none" focusable="false">
						<path d={MARK_PATHS[mark]} pathLength="1" />
					</svg>
				</span>
			) : (
				<span class="event-calendar__day">{day}</span>
			)
		))}
	</div>
</figure>
