---
import { formatSpanishLongDate, formatVenueTimeForDisplay, formatVenueTimeInWords } from '@/lib/invitation/venue-datetime';
import type { ImageMetadata } from 'astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import CacheSafeImage from '@/components/common/CacheSafeImage.astro';
import { splitLeadWords } from '@/lib/invitation/name-split';
import { PORTRAIT_HERO_SIZES } from '@/lib/invitation/hero-image-preload';
import ScrollConstellation from './ScrollConstellation.astro';

interface Props {
	name: string;
	nameLeadWords?: number;
	secondaryName?: string;
	label?: string;
	nickname?: string;
	date: string;
	backgroundImage: ImageMetadata | ImageAsset;
	scrollLabel?: string;
	highPriority?: boolean;
	variant?: 'framed-portrait' | 'bleed-portrait' | 'cased-portrait' | 'disco-stage';
	time?: string;
	venueName?: string;
	venueEvent?: string;
	scrollCue?: 'chevron' | 'constellation';
	ambientVideo?: { webm: string; mp4?: string; poster: string };
}

const { name, nameLeadWords, secondaryName, label, nickname, date, backgroundImage, scrollLabel: scrollLabelProp, highPriority = true, variant = 'framed-portrait', time, venueName, venueEvent, scrollCue, ambientVideo } = Astro.props;
// bleed-portrait: the photograph runs to the edges and the letter states when and where in
// written form; the scroll cue is a silver line instead of a phrase with an arrow.
const isBleed = variant === 'bleed-portrait';
const scrollLabel = scrollLabelProp ?? (isBleed ? 'Deslice para descubrir' : 'Descubra mi historia');
// Optional split into a display line and a secondary line; profiles style the two spans.
const nameSplit = splitLeadWords(name, nameLeadWords);
const formattedDate = formatSpanishLongDate(date);
const writtenDate = new Date(date).toLocaleDateString('es-MX', {
	weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).replace(',', '');
const writtenTime = time ? formatVenueTimeInWords(time) : null;
// A shorter reading of the same facts (`Sábado 21 de noviembre de 2026` / `Misa a las 6:00 p. m. · Parroquia`),
// hidden unless a profile shows it in the stacked layout (`--hero-bleed-summary-display`).
const summaryDay = new Date(date).toLocaleDateString('es-MX', {
	weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).replace(',', '');
const displayTime = time ? formatVenueTimeForDisplay(time) : null;
const summaryTime = displayTime ? `a las ${displayTime}` : (time ? formatVenueTimeInWords(time, { withPeriod: false }) : null);
const summaryWhen = [venueEvent, summaryTime].filter(Boolean).join(' ');
const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const source = backgroundImage.src;
const delivery = 'delivery' in backgroundImage ? backgroundImage.delivery : undefined;
const width = delivery?.width ?? ('width' in backgroundImage ? backgroundImage.width : 960);
const height = delivery?.height ?? ('height' in backgroundImage ? backgroundImage.height : 1440);
---

<section id="inicio" class="invitation-hero framed-portrait-hero" data-variant={variant} data-screenshot="invitation-open-hero" data-screenshot-section="hero">
	{ambientVideo && (
		<video class="framed-portrait-hero__ambient" poster={ambientVideo.poster} muted loop playsinline preload="none" aria-hidden="true" data-hero-ambient-video>
			<source src={ambientVideo.webm} type="video/webm" />
			{ambientVideo.mp4 && <source src={ambientVideo.mp4} type="video/mp4" />}
		</video>
	)}
	<div class="framed-portrait-hero__layout">
		<figure class="framed-portrait-hero__photograph">
			<CacheSafeImage src={source} delivery={delivery} alt={`Fotografía de ${name}`} width={width} height={height} sizes={PORTRAIT_HERO_SIZES} loading="eager" fetchpriority={highPriority ? 'high' : undefined} />
		</figure>
		<div class="framed-portrait-hero__letter">
			{label && <p class="framed-portrait-hero__occasion">{label}</p>}
			<h1 class="framed-portrait-hero__name">{nameSplit ? <><span class="framed-portrait-hero__name-lead">{nameSplit.lead}</span>{' '}<span class="framed-portrait-hero__name-rest">{nameSplit.rest}</span></> : name}{secondaryName && <><span aria-hidden="true"> &amp; </span>{secondaryName}</>}</h1>
			{nickname && <p class="framed-portrait-hero__introduction">{nickname}</p>}
			{isBleed && (
				<div class="framed-portrait-hero__summary">
					<p class="framed-portrait-hero__summary-date">{capitalize(summaryDay)}</p>
					{(summaryWhen || venueName) && <p class="framed-portrait-hero__summary-venue">{capitalize([summaryWhen, venueName].filter(Boolean).join(' · '))}</p>}
				</div>
			)}
			{isBleed ? (
				<dl class="framed-portrait-hero__facts">
					<div>
						<dt>Cuándo</dt>
						<dd><span class="framed-portrait-hero__when">{writtenDate}{writtenTime && ','}</span>{writtenTime && <> <span class="framed-portrait-hero__when">{writtenTime}</span></>}</dd>
					</div>
					{venueName && (
						<div>
							<dt>Dónde</dt>
							<dd>{venueName}</dd>
						</div>
					)}
				</dl>
			) : (
				<div class="framed-portrait-hero__details">
					<p>{formattedDate}</p>
					{venueName && <p class="framed-portrait-hero__details-venue">{venueName}</p>}
				</div>
			)}
		</div>
	</div>
	{isBleed ? (
		<div class="framed-portrait-hero__affordance" aria-hidden="true">
			<span class="framed-portrait-hero__scroll-prompt">{scrollLabel}</span>
			<span class="framed-portrait-hero__scroll-line"></span>
		</div>
	) : scrollCue === 'constellation' ? (
		<p class="framed-portrait-hero__constellation">
			<span class="framed-portrait-hero__constellation-label">{scrollLabel}</span>
			<ScrollConstellation />
		</p>
	) : (
		<p class="framed-portrait-hero__invitation">{scrollLabel}<span aria-hidden="true"> ↓</span></p>
	)}
</section>

<script>
	import { getMotionPreference } from '@/lib/invitation/reveal-manager';
	import { isVisualCaptureMode } from '@/lib/invitation/visual-capture-mode';

	// The loop waits for the envelope so it never competes with the opening clip, plays only
	// while the hero is on screen, and stays on its poster under reduced motion or in captures.
	const video = document.querySelector<HTMLVideoElement>('[data-hero-ambient-video]');
	const isCapture =
		isVisualCaptureMode() ||
		new URLSearchParams(window.location.search).get('screenshot') === '1';
	if (video && !isCapture && !getMotionPreference()) {
		let started = false;
		const start = () => {
			if (started) return;
			started = true;
			video.preload = 'auto';
			new IntersectionObserver(([entry]) => {
				if (entry?.isIntersecting) video.play().catch(() => {});
				else video.pause();
			}).observe(video);
		};
		const envelope = document.querySelector<HTMLElement>('ds-envelope-reveal');
		// No envelope, or it already opened (or was skipped) before this ran.
		if (!envelope || envelope.hidden) start();
		window.addEventListener('envelope:opened', start, { once: true });
	}
</script>
