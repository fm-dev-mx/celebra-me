---
import Countdown from '@/components/invitation/Countdown.astro';
import DemoConversion from '@/components/invitation/DemoConversion.astro';
import type { DemoConversionContext } from '@/lib/invitation/demo-conversion';
import EventLocation from '@/components/invitation/EventLocation.astro';
import Family from '@/components/invitation/Family.astro';
import Gallery from '@/components/invitation/Gallery.astro';
import Gifts from '@/components/invitation/Gifts.astro';
import Interlude from '@/components/invitation/Interlude.astro';
import Itinerary from '@/components/invitation/Itinerary.astro';
import LockedRsvpPreview from '@/components/invitation/LockedRsvpPreview.astro';
import MemoriesShare from '@/components/invitation/MemoriesShare.astro';
import PersonalizedAccess from '@/components/invitation/PersonalizedAccess.astro';
import Quote from '@/components/invitation/Quote.astro';
import RSVP from '@/components/invitation/RSVP';
import ThankYou from '@/components/invitation/ThankYou.astro';
import type { InvitationPageContext } from '@/lib/invitation/page-data';
import {
	buildInvitationSectionRenderDescriptors,
} from '@/lib/invitation/section-render-data';

interface Props {
	pageContext: InvitationPageContext;
	demoConversion?: DemoConversionContext;
}

const { pageContext, demoConversion } = Astro.props;
const standaloneGalleryConversion = demoConversion?.galleryImage
	? { demo: demoConversion, image: demoConversion.galleryImage }
	: undefined;
const sections = buildInvitationSectionRenderDescriptors(pageContext);

const interludeIndices = new Map<number, number>();
{
	let count = 0;
	for (const [i, s] of sections.entries()) {
		if (s.component === 'interlude') {
			count++;
			interludeIndices.set(i, count);
		}
	}
}

const interludeId = (i: number) => {
	const idx = interludeIndices.get(i);
	return idx ? `interlude-${idx}` : 'interlude';
};

const getScreenshotSection = (component: string, i: number) =>
	component === 'interlude' ? interludeId(i) : component;

// A stack intersection pins its source only when that source renders right before it.
const getStackAnchor = (component: string, i: number) => {
	const next = sections[i + 1];
	return next?.intersection === 'stack' && next.intersectionSource === component
		? 'stack'
		: undefined;
};

const expectedSectionIds = [
	'hero',
	...sections.map((s, i) => getScreenshotSection(s.component, i)),
];
---

<div
	id="invitation-sections-container"
	data-total-sections={sections.length}
	data-expected-sections={JSON.stringify(expectedSectionIds)}
>
	{
		sections.map(({component, props, afterInterlude, intersection, intersectionSource, reveal, renderMode}, index) => {
			const interludeIndex = component === 'interlude' ? interludeIndices.get(index) : undefined;
			const stackAnchor = getStackAnchor(component, index);

			return (
				<div
					data-section-id={`section-${index}-${component}`}
					data-screenshot-section={getScreenshotSection(component, index)}
					class="invitation-section-wrapper"
					data-section-kind={component}
					data-intersection={intersection}
					data-intersection-source={intersectionSource}
					data-intersection-anchor={stackAnchor}
					data-reveal={reveal}
					{...(afterInterlude && { 'data-after-interlude': '' })}
				>
					{component === 'interlude' && <Interlude {...props} interludeIndex={interludeIndex} />}
					{component === 'quote' && <Quote {...props} />}
					{component === 'family' && <Family {...props} />}
					{component === 'gallery' && (standaloneGalleryConversion ? (
						<Gallery {...props}>
							<DemoConversion slot="after-gallery" placement="gallery" demo={standaloneGalleryConversion.demo} galleryItem={standaloneGalleryConversion.image} />
						</Gallery>
					) : demoConversion && props.items?.length ? (
						<Gallery {...props}>
							<DemoConversion slot="last-item" placement="gallery" demo={demoConversion} galleryItem={props.items[props.items.length - 1]} />
						</Gallery>
					) : <Gallery {...props} />)}
					{component === 'countdown' && <Countdown {...props} />}
					{component === 'location' && <EventLocation {...props} />}
					{component === 'itinerary' && <Itinerary {...props} />}
					{component === 'rsvp' && (renderMode === 'locked' ? (
						<LockedRsvpPreview title={props.title} variant={props.variant} lockedMessage={props.lockedMessage} />
					) : (
						<RSVP client:visible {...props} />
					))}
					{component === 'gifts' && <Gifts {...props} />}
					{component === 'thankYou' && <ThankYou {...props} />}
					{component === 'personalized-access' && <PersonalizedAccess {...props} />}
					{component === 'memories' && <MemoriesShare {...props} />}
				</div>
			);
		})
	}
</div>

<script>
	import { initInvitationMotion } from '@/lib/invitation/motion-coordinator';
	import { initScrollScenes } from '@/lib/invitation/scroll-scene';
	import { initSmoothScroll } from '@/lib/invitation/smooth-scroll';

	initInvitationMotion();
	initScrollScenes();
	initSmoothScroll();
</script>
