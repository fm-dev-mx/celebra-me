---
import { buildInvitationDeferredCssPromotionInlineScript } from '@/lib/invitation/invitation-deferred-css-promotion';

interface Props {
	eventSlug: string;
	isDemo: boolean;
}

const { eventSlug, isDemo } = Astro.props;
const promotionScript = buildInvitationDeferredCssPromotionInlineScript({
	storageKey: `envelope-opened-${eventSlug}`,
	isDemo,
});
---

<script is:inline set:html={promotionScript}></script>
