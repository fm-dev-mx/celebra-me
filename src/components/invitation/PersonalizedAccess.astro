---
import type { PersonalizedAccessVariant } from '@/lib/invitation/section-variants';
import type { PersonalizedAccessPassStyle } from '@/lib/invitation/personalized-access-presentation';

interface Props {
	ticket?: { signature: string; monogram: string };
	maxAllowedAttendees: number;
	guestName: string;
	eventYear?: string;
	/** Short edition mark of the event type for the pass serial. */
	editionMark?: string;
	isDemoPreview?: boolean;
	variant: PersonalizedAccessVariant;
	title?: string;
	subtitle?: string;
	footerText?: string;
	noteText?: string;
	passStyle?: PersonalizedAccessPassStyle;
	/** Decorative QR check-in preview; drawn on demo previews only, until check-in ships. */
	checkInQr?: boolean;
}

const {
	ticket,
	maxAllowedAttendees,
	guestName,
	eventYear,
	editionMark = 'XV',
	isDemoPreview,
	variant,
	title = 'Pase de acceso',
	subtitle = 'Este pase te identifica como invitado y muestra el número de lugares reservados.',
	footerText = 'Confirma tu asistencia en la sección de RSVP al final de la invitación.',
	noteText,
	passStyle = 'classic',
	checkInQr = false,
} = Astro.props;

const seatsLabel =
	maxAllowedAttendees === 1 ? 'Lugar reservado' : 'Lugares reservados';

const personWord = maxAllowedAttendees === 1 ? 'persona' : 'personas';
const formattedNoteText = noteText
	? noteText
			.replace('{count}', String(maxAllowedAttendees))
			.replace('{personWord}', personWord)
	: undefined;

const accessAriaLabel = `Pase de acceso para ${guestName}. ${maxAllowedAttendees} ${seatsLabel.toLowerCase()}.`;

// Decorative ornaments are variant-specific
const isReplyCard = variant === 'reply-card';
// The race credential swaps the seal for a checkered flag and draws its own edges.
const isRaceCredential = variant === 'formal-pass' && passStyle === 'race-credential';
const showOrnaments = variant !== 'standard' && !isReplyCard && !isRaceCredential;

// The reply card writes the seats out ("dos lugares") under the numeral, as stationery does.
const SEAT_WORDS = ['', 'un', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez'];
const writtenSeats =
	maxAllowedAttendees >= 1 && maxAllowedAttendees < SEAT_WORDS.length
		? `${SEAT_WORDS[maxAllowedAttendees]} ${maxAllowedAttendees === 1 ? 'lugar' : 'lugares'}`
		: `${maxAllowedAttendees} ${maxAllowedAttendees === 1 ? 'lugar' : 'lugares'}`;

// Preview of the upcoming QR check-in: a QR-shaped pattern seeded by the guest name. It encodes
// nothing, so it only appears on demo previews.
const showCheckInQr = checkInQr && Boolean(isDemoPreview);
const QR_SIZE = 25;
let qrPath = '';
if (showCheckInQr) {
	let seed = 2166136261;
	for (const char of guestName) seed = Math.imul(seed ^ char.charCodeAt(0), 16777619);
	const random = () => {
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
	const finderOrigins = [[0, 0], [QR_SIZE - 7, 0], [0, QR_SIZE - 7]];
	const inFinderZone = (x: number, y: number) =>
		finderOrigins.some(([fx, fy]) => x >= fx - 1 && x <= fx + 7 && y >= fy - 1 && y <= fy + 7);
	const isFinderModule = (x: number, y: number) =>
		finderOrigins.some(([fx, fy]) => {
			const dx = x - fx;
			const dy = y - fy;
			if (dx < 0 || dx > 6 || dy < 0 || dy > 6) return false;
			const ring = Math.min(dx, dy, 6 - dx, 6 - dy);
			return ring !== 1;
		});
	for (let y = 0; y < QR_SIZE; y++) {
		for (let x = 0; x < QR_SIZE; x++) {
			const dark = inFinderZone(x, y)
				? isFinderModule(x, y)
				: y === 6 || x === 6
					? (x + y) % 2 === 0
					: random() < 0.5;
			if (dark) qrPath += `M${x} ${y}h1v1h-1z`;
		}
	}
}
---

<section
	class="personalized-access"
	aria-labelledby="personalized-access-title"
	data-screenshot-section="personalized-access"
	data-variant={variant}
	data-presentation={ticket ? "admission-ticket" : undefined}
	data-pass-style={isRaceCredential ? 'race-credential' : undefined}
>
	<div class="personalized-access__container">
		{isDemoPreview && variant === 'editorial-pass' && (
			<div class="personalized-access__demo-badge" aria-hidden="true">
				VISTA PREVIA DEMO
			</div>
		)}
		<article class="access-card" aria-label={accessAriaLabel}>
			{
				showOrnaments && (
					<div class="access-card__ornaments" aria-hidden="true">
						<div class="access-card__corner access-card__corner--tl" />
						<div class="access-card__corner access-card__corner--tr" />
						<div class="access-card__corner access-card__corner--bl" />
						<div class="access-card__corner access-card__corner--br" />
					</div>
				)
			}

			<header class="access-card__header">
				{ticket && <p class="access-card__signature">{ticket.signature}</p>}
				<span class="access-card__eyebrow" data-demo-label>
					{isDemoPreview && variant !== 'editorial-pass' ? 'Vista previa' : null}
				</span>
				{isRaceCredential && <div class="access-card__seal access-card__seal--flag" aria-hidden="true">
					<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
						<defs>
							<clipPath id="access-card-flag-cloth">
								<path d="M18 10c8-3 14 3 22 0s12-3 16-1v24c-4-2-8-2-16 1s-14-3-22 0Z"></path>
							</clipPath>
						</defs>
						<rect x="13" y="8" width="3.5" height="50" rx="1.75" fill="currentColor"></rect>
						<g clip-path="url(#access-card-flag-cloth)">
							<rect x="16" y="6" width="42" height="30" fill="currentColor" opacity="0.18"></rect>
							<path fill="currentColor" d="M18 6h8v7.5h-8zM34 6h8v7.5h-8zM50 6h8v7.5h-8zM26 13.5h8V21h-8zM42 13.5h8V21h-8zM18 21h8v7.5h-8zM34 21h8v7.5h-8zM50 21h8v7.5h-8zM26 28.5h8V36h-8zM42 28.5h8V36h-8z"></path>
						</g>
						<path d="M18 10c8-3 14 3 22 0s12-3 16-1v24c-4-2-8-2-16 1s-14-3-22 0Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
					</svg>
				</div>}
				{!isReplyCard && !isRaceCredential && <div class="access-card__seal" aria-hidden="true">
					<svg
						viewBox="0 0 100 100"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M50 15C55 35 75 50 90 50C75 50 55 65 50 85C45 65 25 50 10 50C25 50 45 35 50 15Z"
							stroke="currentColor"
							stroke-width="1.2"
							stroke-linejoin="round"></path>
						<path
							d="M50 35C52 42 58 48 65 50C58 52 52 58 50 65C48 58 42 52 35 50C42 48 48 42 50 35Z"
							fill="currentColor"
							opacity="0.25"></path>
						<circle
							cx="50"
							cy="50"
							r="46"
							stroke="currentColor"
							stroke-width="0.5"
							stroke-dasharray="1 3"
							opacity="0.3"></circle>
						<circle cx="50" cy="50" r="2" fill="currentColor"></circle>
					</svg>
				</div>}
				<h3 id="personalized-access-title" class="access-card__title">
					{title}
				</h3>
				{!ticket && <p class="access-card__subtitle">{subtitle}</p>}
			</header>

			<div class="access-card__body">
				<div class="access-card__field">
					{!ticket && <span class="access-card__label">Invitado</span>}
					<strong class="access-card__guest">{guestName}</strong>
				</div>

				{ticket && <p class="access-card__welcome">{subtitle ?? 'Será un placer celebrar con usted.'}</p>}
				<div class="access-card__divider" aria-hidden="true"></div>

				<div class="access-card__quota">
					<span class="access-card__label">{seatsLabel}</span>
					<div class="access-card__count-frame">
						<span class="access-card__count">{maxAllowedAttendees}</span>
					</div>
					{isReplyCard && <span class="access-card__count-words">{writtenSeats}</span>}
					{ticket && <span class="access-card__monogram" aria-hidden="true">{ticket.monogram}</span>}
				</div>

				{
					showCheckInQr && (
						<div class="access-card__check-in">
							<svg
								class="access-card__qr"
								viewBox={`-2 -2 ${QR_SIZE + 4} ${QR_SIZE + 4}`}
								shape-rendering="crispEdges"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path d={qrPath} fill="currentColor"></path>
							</svg>
							<div class="access-card__check-in-copy">
								<span class="access-card__check-in-badge">Próximamente</span>
								<p class="access-card__check-in-title">Registro con QR</p>
								<p class="access-card__check-in-text">
									Muestre este código al llegar y su acceso quedará registrado al instante.
								</p>
							</div>
						</div>
					)
				}

				{
					!ticket && formattedNoteText && (
						<p class="access-card__note">
							{formattedNoteText}
						</p>
					)
				}
			</div>

			{variant === 'editorial-pass' && (
				<div class="access-card__barcode-wrapper" aria-hidden="true">
					<div class="access-card__barcode"></div>
					<span class="access-card__serial">
						ED-{editionMark} · {guestName ? guestName.toUpperCase().split(/\s+/)[0] : 'INVITADO'} · {eventYear ?? editionMark}
					</span>
				</div>
			)}

			{
				!ticket && footerText && footerText.trim().length > 0 && (
					<footer class="access-card__footer">
						<p>{footerText}</p>
					</footer>
				)
			}
		</article>
	</div>
</section>

<script>
	// Cut the paper itself at the responsive stub boundary; never paint over its edge.
	const ticketObservers: ResizeObserver[] = [];
	document.querySelectorAll<HTMLElement>('[data-presentation="admission-ticket"] .access-card, [data-pass-style="race-credential"] .access-card').forEach((card) => {
		const stub = card.querySelector<HTMLElement>('.access-card__quota');
		if (!stub) return;
		const updateNotch = () => {
			if (card.offsetHeight <= 0) return;
			const cardBounds = card.getBoundingClientRect();
			const scale = cardBounds.height / card.offsetHeight;
			if (Number.isFinite(scale) && scale > 0) {
				card.style.setProperty('--ticket-notch-y', `${(stub.getBoundingClientRect().top - cardBounds.top) / scale}px`);
			}
		};
		const observer = new ResizeObserver(updateNotch);
		observer.observe(card);
		observer.observe(stub);
		ticketObservers.push(observer);
		updateNotch();
	});
	window.addEventListener('pagehide', () => ticketObservers.forEach((observer) => observer.disconnect()), { once: true });
</script>
