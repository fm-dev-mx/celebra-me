---
import InvitationRevealCard from '@/components/invitation/InvitationRevealCard.astro';
import { plainImgSrc } from '@/lib/assets/image-delivery-policy';
import SealIcon from '@/components/common/icons/invitation/SealIcon.astro';
import CeremonialFiligree from './CeremonialFiligree.astro';
import SeasideLineArt from './SeasideLineArt.astro';
import StorybookLanternsArt from './StorybookLanternsArt.astro';
import StorybookLanternSky from './StorybookLanternSky.astro';
import type { ImageAsset } from '@/lib/assets/asset-registry';
import {
	resolveEnvelopeDataVariant,
	resolveSealPresentation,
	type EnvelopeSealIcon,
	type RevealCardData,
} from '@/lib/invitation/reveal-card';

interface Props {
	name: string;
	sealStyle: 'wax' | 'ribbon' | 'flower' | 'monogram';
	sealIcon?: EnvelopeSealIcon;
	sealInitials?: string;
	sealVariant?: string;
	sealColor?: string;
	sealImage?: ImageAsset;
	backdropImage?: ImageAsset;
	revealVariant?: string;
	microcopy: string;
	documentLabel?: string;
	stampText?: string;
	stampYear?: string;
	eventSlug: string;
	tooltipText?: string;
	variant?: string;
	teaserDetails?: string;
	card: RevealCardData;
	previewState?: 'closed' | 'opened' | 'letter';
	guestPlacement?: 'inside-envelope' | 'outside-envelope';
}

const {
	name,
	sealStyle,
	sealIcon,
	sealInitials,
	sealVariant,
	sealColor,
	sealImage,
	backdropImage,
	revealVariant,
	microcopy,
	documentLabel,
	stampText,
	stampYear,
	eventSlug,
	tooltipText,
	variant,
	teaserDetails,
	card,
	previewState,
	guestPlacement = 'inside-envelope',
} = Astro.props;

const sealPresentation = resolveSealPresentation({
	sealStyle,
	sealIcon,
	sealInitials,
	sealVariant,
	sealColor,
	sealImage,
});

const isSeaside = revealVariant === 'seaside-lineart';
const isStorybook = revealVariant === 'storybook-lanterns' || revealVariant === 'storybook-butterflies';
const skyMotif = revealVariant === 'storybook-butterflies' ? 'butterflies' : 'lanterns';
const isNight = revealVariant === 'night-envelope';
const isCelestialLetter = revealVariant === 'celestial-letter';
// Storybook, night and celestial letters sit inside the envelope, behind the pocket front, and rise
// out of it.
const letterInPocket = isStorybook || isNight || isCelestialLetter;
const isWaxRenderer = ['wax-organic', 'wax-medallion'].includes(sealPresentation.renderer);
// Discrete seal-zone open cue (editorial, not a SaaS tooltip bubble).
const sealHintText = tooltipText?.trim() || 'Toque el sello';
const teaserDetailsParts = teaserDetails ? teaserDetails.split(' · ') : [];
const hasAccentTeaser = teaserDetailsParts.length === 2;
const skipParams = new URLSearchParams(Astro.url.search);
skipParams.set('skipEnvelope', 'true');
const skipUrl = `${Astro.url.pathname}?${skipParams.toString()}`;
---

<ds-envelope-reveal
	class:list={[
		'envelope-wrapper',
		previewState === 'letter' && 'is-letter-held',
		previewState === 'opened' && 'is-preview-opened',
	]}
	data-screenshot="reveal-section"
	data-event-slug={eventSlug}
	data-variant={resolveEnvelopeDataVariant(revealVariant, variant)}
	data-seal-variant={sealVariant || ''}
	data-seal-skin={sealPresentation.skin || ''}
	data-dev-skip={String(import.meta.env.DEV)}
	data-preview-state={previewState}
	data-open-chime={isStorybook ? 'true' : undefined}
	data-arch-handoff={isNight ? 'true' : undefined}
>
	{backdropImage && <img class="envelope-ambient" src={plainImgSrc(backdropImage.src)} alt="" width="960" height="1440" decoding="async" />}
	{isStorybook && <StorybookLanternSky motif={skyMotif} />}
	{isStorybook && <StorybookLanternSky scene="send-off" motif={skyMotif} />}
	<div class="envelope-container">
		<div class="envelope-base"></div>
		{
			letterInPocket && (
				<div class="envelope-reveal-stage" data-envelope-card aria-hidden="true">
					<InvitationRevealCard card={card} showGuest={guestPlacement !== 'outside-envelope'}>
						{revealVariant === 'storybook-lanterns' && <StorybookLanternsArt slot="ornament" class="invitation-reveal-card__ornament" />}
						{
							isNight && (
								<span slot="ornament" class="night-envelope-window" data-arch-window>
									<img alt="" data-arch-photo decoding="async" />
								</span>
							)
						}
					</InvitationRevealCard>
				</div>
			)
		}
		<div class="envelope-pocket"></div>

		<div class="envelope-flap" data-envelope-flap>
			{revealVariant === 'satin-filigree' && <CeremonialFiligree class="envelope-filigree" />}
			<div class="envelope-flap-shadow"></div>
		</div>

		<div class="envelope-tease">
			<div class="envelope-zone--stamp">
				{
					stampText && (
						<div class="envelope-stamp">
							<span>{stampText}</span>
							{stampYear && <small>{stampYear}</small>}
						</div>
					)
				}
				{documentLabel && <span class="envelope-manifest-label">{documentLabel}</span>}
			</div>

			<div class="envelope-zone--seal">
				<button
					type="button"
					class={`envelope-seal-button envelope-seal-button--${sealStyle}`}
					data-envelope-open
					disabled
					data-seal-icon={sealPresentation.icon || sealIcon || 'wax-organic'}
					data-seal-renderer={sealPresentation.renderer}
					data-screenshot="reveal-trigger"
					aria-label="Abrir sobre de la invitación"
				>
					<div class="envelope-seal-button__visual">
						<SealIcon
							presentation={sealPresentation}
							class="seal-icon"
						/>
						{revealVariant === 'satin-filigree' && <span class="envelope-crystal-initials" aria-hidden="true">{sealInitials}</span>}
						{(isStorybook || isNight) && sealInitials && <span class="envelope-seal-monogram" aria-hidden="true">{sealInitials}</span>}
						{
							!isWaxRenderer && (
								<div class="envelope-seal-button__pulse" aria-hidden="true"></div>
							)
						}
					</div>
					<span class="envelope-seal-hint" aria-hidden="true">{sealHintText}</span>
				</button>
			</div>

			<div class="envelope-zone--identity" aria-hidden="true">
				<h2 class="envelope-name">{name}</h2>
				{
					teaserDetails && (
						<div class="tease-details-group">
							<div class="tease-divider"></div>
							<p class="envelope-details">
								{
									hasAccentTeaser ? (
										<>
											{teaserDetailsParts[0]}
											<span aria-hidden="true"> · </span>
											<span class="envelope-details__accent">{teaserDetailsParts[1]}</span>
										</>
									) : (
										teaserDetails
									)
								}
							</p>
						</div>
					)
				}

				{
					guestPlacement === 'inside-envelope' && card.guestName && (
						<div class="guest-personalized">
							<p class="personalized-label">{card.guestLabel}</p>
							<strong class="personalized-name">{card.guestName}</strong>
						</div>
					)
				}
			</div>
		</div>
	</div>

	{
		!letterInPocket && (
			<div class="envelope-reveal-stage" data-envelope-card aria-hidden="true">
				<InvitationRevealCard
					card={card}
					showGuest={guestPlacement !== 'outside-envelope'}
				>
					{isSeaside && <SeasideLineArt slot="ornament" class="invitation-reveal-card__ornament" />}
				</InvitationRevealCard>
			</div>
		)
	}

	{
		guestPlacement === 'outside-envelope' && card.guestName && (
			<div class="envelope-guest-external">
				<p class="personalized-label">{card.guestLabel}</p>
				<strong class="personalized-name">{card.guestName}</strong>
			</div>
		)
	}

	{
		microcopy && (
			<div class="envelope-external-instruction">
				<button
					type="button"
					class="envelope-external-instruction__button"
					data-envelope-open
					disabled
					aria-label="Abrir la invitación"
				>
					{microcopy}
				</button>
				<div class="instruction-line"></div>
			</div>
		)
	}
	<noscript>
		<a class="envelope-no-js-fallback" href={skipUrl}>Continuar a la invitación</a>
	</noscript>
</ds-envelope-reveal>

<script>
	import {
		RevealManager,
		getMotionPreference,
		holdPageAtTopWhileGated,
	} from '@/lib/invitation/reveal-manager';
	import { playEnvelopeOpenChime } from '@/lib/invitation/envelope-chime';

	const EXIT_ANIMATION_MS = 2200;
	const CARD_RISE_FALLBACK_MARGIN_MS = 1200;
	const CARD_RISE_FALLBACK_FLOOR_MS = 4000;
	const SKY_TILT_MAX_DEG = 3;
	const ARCH_HANDOFF_HOLD_MS = 400;
	const ARCH_HANDOFF_MS = 1300;
	const ARCH_HANDOFF_EASE = 'cubic-bezier(0.65, 0, 0.35, 1)';

	/** Longest time in a comma-separated CSS time list (`1.2s, 300ms`), in milliseconds. */
	const readLongestMs = (value: string) =>
		value.split(',').reduce((longest, part) => {
			const trimmed = part.trim();
			const parsed = Number.parseFloat(trimmed);
			if (!Number.isFinite(parsed)) return longest;
			return Math.max(longest, trimmed.endsWith('ms') ? parsed : parsed * 1000);
		}, 0);

	/**
	 * Longest plausible `envCardRise` runtime for the active theme, read from computed style so
	 * preset overrides of `--duration-reveal` stay covered. Used as the safety deadline: if
	 * `animationend` never arrives (missing stylesheet, interrupted or throttled animation,
	 * non-animatable card), the reveal must still complete instead of stranding `sealed`.
	 */
	const resolveCardRiseFallbackMs = (card: HTMLElement) => {
		const styles = getComputedStyle(card);
		const animated =
			readLongestMs(styles.animationDelay) + readLongestMs(styles.animationDuration);

		return Math.max(CARD_RISE_FALLBACK_FLOOR_MS, animated + CARD_RISE_FALLBACK_MARGIN_MS);
	};

	/**
	 * Reading pause on the risen letter before the invitation takes over. Themes opt in through
	 * `--env-letter-hold` (unset → 0, the letter hands over as soon as it lands).
	 */
	const resolveLetterHoldMs = (host: HTMLElement) =>
		readLongestMs(getComputedStyle(host).getPropertyValue('--env-letter-hold'));

	class DsEnvelopeReveal extends HTMLElement {
		connectedCallback() {
			const { eventSlug } = this.dataset;
			if (!eventSlug) return;

			const invitationRoot = this.closest('.event-theme-wrapper[data-event-slug]');
			if (!invitationRoot) return;

			const isDemoInvitation = (invitationRoot as HTMLElement).dataset.isDemo === 'true';
			const devSkipEnabled = this.dataset.devSkip === 'true';

			const manager = new RevealManager({
				eventSlug,
				isDemoInvitation,
				devSkipEnabled,
			});

			const revealCard = this.querySelector('[data-envelope-card]');
			const openButtons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-envelope-open]'));
			let hasRevealed = false;
			let isOpening = false;
			let envelopeSkipped = false;

			// Night envelope: the letter's arched window shows the cover photograph in the cover
			// arch's proportions, so the hand-over can land the window exactly on that arch.
			const coverArch =
				this.dataset.archHandoff === 'true'
					? document.querySelector<HTMLElement>(
							'.invitation-hero[data-variant="night-arch"] .invitation-hero__background',
						)
					: null;
			const archWindow = this.querySelector<HTMLElement>('[data-arch-window]');
			const fillArchWindow = () => {
				const photo = archWindow?.querySelector<HTMLImageElement>('[data-arch-photo]');
				const coverPhoto = coverArch?.querySelector('img');
				if (!coverArch || !archWindow || !photo || !coverPhoto) return;
				if (!coverPhoto.complete) {
					coverPhoto.addEventListener('load', fillArchWindow, { once: true });
					return;
				}
				const src = coverPhoto.currentSrc || coverPhoto.src;
				const { width, height } = coverArch.getBoundingClientRect();
				if (!src || !width || !height) return;
				photo.src = src;
				photo.style.objectPosition = getComputedStyle(coverPhoto).objectPosition;
				archWindow.style.aspectRatio = `${width} / ${height}`;
				archWindow.classList.add('has-photo');
			};
			fillArchWindow();

			// Opt-in send-off (`--storybook-send-off: lanterns` or `butterflies`, matching the sky's
			// motif): once the envelope has opened, a few rise from the bottom center over the cover
			// and are removed as each one leaves.
			const releaseLanterns = () => {
				if (envelopeSkipped || getMotionPreference() || isScreenshotCaptureMode()) return;
				const sendOff = getComputedStyle(this).getPropertyValue('--storybook-send-off').trim();
				if (sendOff !== 'lanterns' && sendOff !== 'butterflies') return;
				const template = this.querySelector<HTMLTemplateElement>('template[data-lantern-send-off]');
				const layer = template?.content.firstElementChild?.cloneNode(true);
				if (!(layer instanceof HTMLElement) || typeof layer.animate !== 'function') return;
				// The send-off is styled where it lands, so the envelope's palette comes along.
				layer.style.setProperty(
					'--storybook-sky-lantern',
					getComputedStyle(this).getPropertyValue('--storybook-sky-lantern'),
				);
				layer.style.setProperty(
					'--storybook-sky-light',
					getComputedStyle(this).getPropertyValue('--storybook-sky-light'),
				);
				document.body.append(layer);
				const lanterns = Array.from(layer.querySelectorAll<HTMLElement>('.lantern-flight__lantern'));
				let flying = lanterns.length;
				lanterns.forEach((lantern) => {
					const drift = Math.round(Math.random() * 48 - 24);
					const flight = lantern.animate(
						[
							{ opacity: 0, transform: 'translate3d(0, 0, 0)' },
							{ opacity: 1, offset: 0.15 },
							{ opacity: 1, offset: 0.8 },
							{ opacity: 0, transform: `translate3d(${drift}px, calc(-100vh - 8rem), 0)` },
						],
						{
							duration: 3200 + Math.random() * 1600,
							delay: Math.random() * 900,
							easing: 'cubic-bezier(0.33, 0, 0.67, 1)',
							fill: 'both',
						},
					);
					flight.onfinish = () => {
						lantern.remove();
						flying -= 1;
						if (flying === 0) layer.remove();
					};
				});
			};

			/** Screenshot tool needs the letter laid out; do not race-hide the host. */
			const isScreenshotCaptureMode = () => {
				try {
					if (new URLSearchParams(window.location.search).get('screenshot') === '1') {
						return true;
					}
				} catch {
					// ignore
				}
				return Boolean(document.documentElement.dataset.screenshot);
			};

			// Helper: reveal card should be visible to accessibility when shown
			const showCardToAccessibility = () => {
				if (revealCard instanceof HTMLElement) {
					revealCard.removeAttribute('aria-hidden');
				}
			};

			/** Hold the open letter on-screen for click-based screenshot fallbacks.
			 * Do not add `is-preview-opened` — audit CSS hides that class with display:none.
			 * Prefer `?reveal=letter` (previewState=letter / is-letter-held) for 03/04. */
			const holdLetterForScreenshotCapture = () => {
				this.classList.add('is-letter-held');
				showCardToAccessibility();
			};

			const setControlsDisabled = (disabled: boolean) => {
				openButtons.forEach((button) => {
					button.disabled = disabled;
				});
			};

			const focusRevealedDestination = () => {
				const destination = document.querySelector<HTMLElement>(
					'#event-header a[href], [data-screenshot="invitation-open-content"] a[href], [data-screenshot="invitation-open-content"] button:not([disabled])',
				);
				if (destination) {
					destination.focus({ preventScroll: true });
					return;
				}

				const hero = document.getElementById('inicio');
				if (hero instanceof HTMLElement) {
					hero.tabIndex = -1;
					hero.focus({ preventScroll: true });
				}
			};

			// Screenshot contract: ?reveal=letter — measurable envelope + card, no teardown.
			if (this.dataset.previewState === 'letter') {
				this.classList.add('is-letter-held');
				this.hidden = false;
				document.documentElement.classList.add('envelope-open');
				if (invitationRoot instanceof HTMLElement) {
					invitationRoot.dataset.revealState = 'letter-held';
				}
				showCardToAccessibility();
				return;
			}

			if (this.dataset.previewState === 'opened') {
				this.classList.add('is-preview-opened');
				document.documentElement.classList.add('envelope-open');
				if (invitationRoot instanceof HTMLElement) {
					invitationRoot.dataset.revealState = 'preview-opened';
				}
				showCardToAccessibility();
				return;
			}

			let stopSkyTilt = () => {};
			let releaseScrollHold = () => {};

			const completeReveal = () => {
				if (hasRevealed) return;
				hasRevealed = true;
				setControlsDisabled(true);
				stopSkyTilt();
				releaseScrollHold();

				document.documentElement.classList.remove('envelope-open');
				showCardToAccessibility();

				if (invitationRoot instanceof HTMLElement) {
					invitationRoot.dataset.revealState = 'revealed';
				}
				if (this.contains(document.activeElement)) {
					focusRevealedDestination();
				}

				window.requestAnimationFrame(() => {
					const hero = document.getElementById('inicio');
					const prefersReducedMotion = getMotionPreference();
					const scrollBehavior: ScrollBehavior = prefersReducedMotion
						? 'auto'
						: 'smooth';
					const sceneFadeRaw = getComputedStyle(invitationRoot)
						.getPropertyValue('--motion-scene-fade')
						.trim();
					const parsedFade = Number.parseFloat(sceneFadeRaw);
					const sceneFadeMs =
						prefersReducedMotion || Number.isNaN(parsedFade)
							? prefersReducedMotion
								? 0
								: 240
							: sceneFadeRaw.endsWith('ms')
								? Math.round(parsedFade)
								: Math.round(parsedFade * 1000);

					const settleScroll = () => {
						if (hero instanceof HTMLElement) {
							const rect = hero.getBoundingClientRect();
							const inView =
								rect.top >= -8 &&
								rect.top <= window.innerHeight * 0.35 &&
								rect.bottom > 0;
							if (!inView) {
								hero.scrollIntoView({
									block: 'start',
									inline: 'nearest',
									behavior: scrollBehavior,
								});
							}
						} else if (window.scrollY > 0) {
							window.scrollTo({ top: 0, left: 0, behavior: scrollBehavior });
						}
					};

					if (sceneFadeMs > 0) {
						window.setTimeout(settleScroll, sceneFadeMs);
					} else {
						settleScroll();
					}
				});

				window.dispatchEvent(new CustomEvent('envelope:opened', { detail: { eventSlug } }));
				releaseLanterns();

				window.setTimeout(() => {
					// Keep host measurable during screenshot runs (display:none → 0×0 letter).
					if (!isScreenshotCaptureMode()) {
						this.hidden = true;
					}
				}, EXIT_ANIMATION_MS);
			};

			if (manager.shouldSkipEnvelope()) {
				envelopeSkipped = true;
				completeReveal();
				if (!isScreenshotCaptureMode()) {
					this.hidden = true;
				}
				return;
			}

			document.documentElement.classList.add('envelope-open');
			releaseScrollHold = holdPageAtTopWhileGated();

			// The lantern sky leans a few degrees toward a fine pointer; touch keeps its own drift.
			const sky = this.querySelector<HTMLElement>('.storybook-sky');
			if (sky && window.matchMedia('(pointer: fine)').matches && !getMotionPreference()) {
				let tiltFrame = 0;
				const onPointerMove = (event: PointerEvent) => {
					if (tiltFrame) return;
					tiltFrame = window.requestAnimationFrame(() => {
						tiltFrame = 0;
						const x = event.clientX / window.innerWidth - 0.5;
						const y = event.clientY / window.innerHeight - 0.5;
						sky.style.setProperty('--sky-tilt-x', `${(x * 2 * SKY_TILT_MAX_DEG).toFixed(2)}deg`);
						sky.style.setProperty('--sky-tilt-y', `${(-y * 2 * SKY_TILT_MAX_DEG).toFixed(2)}deg`);
					});
				};
				this.addEventListener('pointermove', onPointerMove);
				stopSkyTilt = () => {
					this.removeEventListener('pointermove', onPointerMove);
					window.cancelAnimationFrame(tiltFrame);
				};
			}

			// The window's photograph flies onto the cover arch while the letter and the night fade;
			// the cover underneath shows the same photograph in the same place, so the reveal's
			// own fade hands over without a jump. Inverse FLIP: laid out at the arch, so the
			// photograph is painted at its final size and only the transform moves.
			const handOverToArch = () => {
				const photo = archWindow?.querySelector('img');
				const from = archWindow?.getBoundingClientRect();
				const to = coverArch?.getBoundingClientRect();
				if (!coverArch || !archWindow || !photo || !from?.width || !to?.width) {
					completeReveal();
					return;
				}
				const host = this.getBoundingClientRect();
				const flight = document.createElement('div');
				flight.className = 'night-envelope-flight';
				flight.setAttribute('aria-hidden', 'true');
				flight.style.left = `${to.left - host.left}px`;
				flight.style.top = `${to.top - host.top}px`;
				flight.style.width = `${to.width}px`;
				flight.style.height = `${to.height}px`;
				flight.style.borderRadius = getComputedStyle(coverArch).borderRadius;
				flight.append(photo.cloneNode());
				this.append(flight);
				archWindow.style.visibility = 'hidden';
				this.classList.add('is-handing-off');
				if (typeof flight.animate !== 'function') {
					completeReveal();
					return;
				}
				const scale = from.width / to.width;
				flight
					.animate(
						[
							{
								transform: `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${scale})`,
							},
							{ transform: 'none' },
						],
						{ duration: ARCH_HANDOFF_MS, easing: ARCH_HANDOFF_EASE, fill: 'both' },
					)
					.finished.then(completeReveal, completeReveal);
			};

			const requestOpen = () => {
				if (hasRevealed) return;
				if (isOpening) return;
				isOpening = true;
				setControlsDisabled(true);
				// Synchronous, inside the tap: media started from this event keeps the user
				// activation that Safari iOS requires (`envelope:opened` arrives seconds later).
				window.dispatchEvent(
					new CustomEvent('envelope:open-requested', { detail: { eventSlug } }),
				);

				manager.setStoredFlag();

				// Screenshot capture intentionally holds the letter instead of hiding the host.
				if (isScreenshotCaptureMode()) {
					holdLetterForScreenshotCapture();
					return;
				}

				if (getMotionPreference()) {
					completeReveal();
					return;
				}

				// Still inside the tap, so the synthesized cue keeps the user activation.
				if (this.dataset.openChime === 'true') {
					playEnvelopeOpenChime();
				}

				this.classList.add('is-opening');
				if (this.dataset.variant === 'satin-filigree') {
					// One short flap gesture; no intermediate date card.
					window.setTimeout(completeReveal, 900);
					return;
				}

				const showLetter = () => {
					if (hasRevealed) return;
					showCardToAccessibility();

					if (archWindow?.classList.contains('has-photo')) {
						// A short rest so the letter reads before its window flies.
						window.setTimeout(handOverToArch, ARCH_HANDOFF_HOLD_MS);
						return;
					}

					const holdMs = resolveLetterHoldMs(this);
					if (holdMs <= 0) {
						completeReveal();
						return;
					}

					// The letter rests for a reading beat; any tap or key hands over sooner.
					let holdTimer = 0;
					const handOver = () => {
						window.clearTimeout(holdTimer);
						this.removeEventListener('pointerdown', handOver);
						document.removeEventListener('keydown', handOver);
						completeReveal();
					};
					holdTimer = window.setTimeout(handOver, holdMs);
					this.addEventListener('pointerdown', handOver);
					document.addEventListener('keydown', handOver);
				};

				if (revealCard instanceof HTMLElement) {
					const fallbackTimer = window.setTimeout(
						showLetter,
						resolveCardRiseFallbackMs(revealCard),
					);
					const onAnimationEnd = (e: AnimationEvent) => {
						if (e.animationName.includes('envCardRise')) {
							window.clearTimeout(fallbackTimer);
							revealCard.removeEventListener('animationend', onAnimationEnd);
							showLetter();
						}
					};
					revealCard.addEventListener('animationend', onAnimationEnd);
				} else {
					window.setTimeout(showLetter, CARD_RISE_FALLBACK_FLOOR_MS);
				}
			};

			openButtons.forEach((button) => {
				button.addEventListener('click', (event) => {
					event.stopPropagation();
					event.preventDefault();
					requestOpen();
				});
			});
			// SSR controls become actionable only after their listeners are installed.
			setControlsDisabled(false);
		}
	}

	customElements.define('ds-envelope-reveal', DsEnvelopeReveal);
</script>

