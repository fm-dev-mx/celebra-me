---
import Icon from '@/components/common/icons/Icon.astro';
import {
	buildCampaignCode,
	buildGeneralMessage,
	buildPackageMessage,
	getGeneralPromoCode,
	getPromoCode,
	getPromoPackage,
	getStartingPrice,
	PROMO_CAMPAIGN,
	type CampaignSection,
	type PromoPackageId,
} from '@/data/promo-campaign.data';
import { getWhatsAppLink } from '@/utils/whatsapp';

interface Props {
	className?: string;
	message?: string;
	label?: string;
	trackSection?: string;
	trackCta?: string;
	trackIntent?: string;
	/** Explicit campaign code; otherwise `<campaignSection>-<promo code>`. */
	trackCampaign?: string;
	/** Section prefix for the derived campaign code. */
	campaignSection?: CampaignSection;
	/** Package context; derives name, promo code, value and the package quote message. */
	packageId?: PromoPackageId;
	trackValue?: number;
	trackCurrency?: string;
	trackDestination?: string;
	promoCode?: string;
	eventType?: string;
	eventLabel?: string;
	/** Defaults to the visible label plus the destination, e.g. «Cotizar mi invitación por WhatsApp». */
	ariaLabel?: string;
	/** Keeps the message untouched by the click-time folio rewrite. */
	preserveMessage?: boolean;
	/** Omits promo attributes for CTAs that are not promo quotes. */
	withoutPromo?: boolean;
}

const {
	className = '',
	message: explicitMessage,
	label = 'Cotizar mi invitación',
	trackSection = 'hero',
	trackCta = 'hero_whatsapp',
	trackIntent = 'whatsapp',
	trackCampaign,
	campaignSection = 'FINAL',
	packageId,
	trackValue,
	trackCurrency,
	trackDestination = 'whatsapp',
	promoCode: explicitPromoCode,
	eventType,
	eventLabel,
	ariaLabel: explicitAriaLabel,
	preserveMessage = false,
	withoutPromo = false,
} = Astro.props;

const ariaLabel = explicitAriaLabel ?? `${label} por WhatsApp`;
const pkg = packageId ? getPromoPackage(packageId) : undefined;
const promoCode = withoutPromo
	? undefined
	: (explicitPromoCode ?? (pkg ? getPromoCode(pkg) : getGeneralPromoCode()));
const promoValue = withoutPromo ? undefined : (trackValue ?? pkg?.promoPrice ?? getStartingPrice());
const campaignCode = trackCampaign ?? (promoCode ? buildCampaignCode(campaignSection, promoCode) : undefined);
const currency = trackCurrency ?? (promoValue !== undefined ? PROMO_CAMPAIGN.currency : undefined);
const message = explicitMessage ?? (pkg ? buildPackageMessage(pkg) : buildGeneralMessage());

// Prerendered pages get the /api/whatsapp redirect, which reads the Worker secret at request time.
const whatsappUrl = getWhatsAppLink(message);
---

<a
	href={whatsappUrl}
	target="_blank"
	rel="noopener noreferrer"
	class:list={['whatsapp-button', className]}
	aria-label={ariaLabel}
	data-track-event="whatsapp_contact_clicked"
	data-track-section={trackSection}
	data-track-cta={trackCta}
	data-track-label={label}
	data-track-intent={trackIntent}
	data-track-destination={trackDestination}
	data-campaign-code={campaignCode}
	data-package-interest={pkg?.id}
	data-package-name={pkg?.name}
	data-promo-code={promoCode}
	data-event-type={eventType}
	data-event-label={eventLabel}
	data-track-value={promoValue}
	data-track-currency={currency}
	data-preserve-message={preserveMessage ? 'true' : undefined}
>
	<Icon name="WhatsApp" size={20} />
	<slot>{label}</slot>
</a>
