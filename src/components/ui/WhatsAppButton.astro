---
import Icon from '@/components/common/icons/Icon.astro';
import { isPlaceholderContactPhone } from '@/utils/whatsapp';

interface Props {
	className?: string;
	phone?: string;
	message?: string;
	label?: string;
	trackSection?: string;
	trackCta?: string;
	trackIntent?: string;
	trackCampaign?: string;
	trackPackage?: string;
	packageName?: string;
	trackValue?: number;
	trackCurrency?: string;
	trackDestination?: string;
	promoCode?: string;
	eventType?: string;
	eventLabel?: string;
	ariaLabel?: string;
	preserveMessage?: boolean;
}

const {
	className = '',
	phone: explicitPhone,
	message = '¡Hola! Me gustaría recibir información sobre las invitaciones digitales premium.',
	label = 'Solicitar asesoría',
	trackSection = 'hero',
	trackCta = 'hero_whatsapp',
	trackIntent = 'whatsapp',
	trackCampaign,
	trackPackage,
	packageName,
	trackValue,
	trackCurrency,
	trackDestination = 'whatsapp',
	promoCode,
	eventType,
	eventLabel,
	ariaLabel = 'Contactar por WhatsApp',
	preserveMessage = false,
} = Astro.props;

// If no phone is explicitly provided, fall back to empty string (caller provides phone).
// If the phone is a placeholder, hide the CTA to avoid broken links.
const phone = explicitPhone || '';
const isPlaceholder = phone ? isPlaceholderContactPhone(phone) : true;
const shouldRender = !isPlaceholder || import.meta.env.DEV;
const displayPhone = (isPlaceholder && import.meta.env.DEV) ? '521234567890' : phone;
const whatsappUrl = shouldRender ? `https://wa.me/${displayPhone}${message ? `?text=${encodeURIComponent(message)}` : ''}` : '';
---

{shouldRender && (
<a
	href={whatsappUrl}
	target="_blank"
	rel="noopener noreferrer"
	class:list={['whatsapp-button', className]}
	aria-label={ariaLabel}
	data-track-event="whatsapp_contact_clicked"
	data-track-section={trackSection}
	data-track-cta={trackCta}
	data-track-label={label}
	data-track-intent={trackIntent}
	data-track-destination={trackDestination}
	data-campaign-code={trackCampaign}
	data-package-interest={trackPackage}
	data-package-name={packageName}
	data-promo-code={promoCode}
	data-event-type={eventType}
	data-event-label={eventLabel}
	data-track-value={trackValue}
	data-track-currency={trackCurrency}
	data-phone={phone}
	data-preserve-message={preserveMessage ? 'true' : undefined}
>
	<Icon name="WhatsApp" size={20} />
	{label}
</a>
)}

<script>
	const FOLIO_ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
	const FOLIO_PATTERN = /Folio:\s*CM-\d+-[A-Z0-9]{4}/i;

	const getPromoCodeAndPrice = (anchor: HTMLAnchorElement) => {
		const promoCode = anchor.getAttribute('data-promo-code') || 'LANZAMIENTO-899';
		const match = promoCode.match(/(\d+)$/);
		const price = match ? match[1] : '899';
		return { promoCode, price };
	};

	const createPromoFolio = (price: string) => {
		const values = new Uint8Array(4);
		crypto.getRandomValues(values);
		const suffix = [...values]
			.map((value) => FOLIO_ALPHABET[value % FOLIO_ALPHABET.length])
			.join('');
		return `CM-${price}-${suffix}`;
	};

	const ensureWhatsAppPromoFolio = (anchor: HTMLAnchorElement) => {
		if (anchor.getAttribute('data-preserve-message') === 'true') return;

		const url = new URL(anchor.href);
		const baseMessage =
			url.searchParams.get('text') || 'Hola, quiero información sobre una invitación digital.';
		if (FOLIO_PATTERN.test(baseMessage)) return;

		// 1. Get promo code and price
		const { promoCode, price } = getPromoCodeAndPrice(anchor);

		// 2. Format the message dynamically based on context
		const isPackage = anchor.getAttribute('data-package-interest');
		const packageName = anchor.getAttribute('data-package-name') || '';
		const eventLabel = anchor.getAttribute('data-event-label') || '';
		const trackValue = anchor.getAttribute('data-track-value') || '';
		const trackCurrency = anchor.getAttribute('data-track-currency') || '';
		const packagePrice =
			trackValue && trackCurrency
				? ` de $${Number(trackValue).toLocaleString('es-MX')} ${trackCurrency}`
				: '';

		const messageHeader = (isPackage && packageName)
			? `Hola, quiero elegir el paquete ${packageName}${packagePrice} para mi invitación digital.`
			: `Hola, quiero hacer válida la promo de lanzamiento de mi invitación digital premium.`;

		const messageParts = [
			messageHeader,
			...(eventLabel ? [`Evento: ${eventLabel}`] : []),
			`Cupón: ${promoCode}`,
			`Folio: ${createPromoFolio(price)}`
		];

		url.searchParams.set('text', messageParts.join('\n\n'));
		anchor.href = url.toString();
	};

	document.addEventListener('click', (event) => {
		const target =
			event.target instanceof Element
				? event.target.closest('[data-track-event="whatsapp_contact_clicked"]')
				: null;
		if (target instanceof HTMLAnchorElement) ensureWhatsAppPromoFolio(target);
	});
</script>
