---
import Icon from '@/components/common/icons/Icon.astro';
import { PRIMARY_CTA_LABEL } from '@/data/landing-page.data';
import {
	buildCampaignCode,
	buildGeneralMessage,
	buildPackageMessage,
	getCatalogPackage,
	getGeneralPromoCode,
	getPackagePrice,
	getPromoCode,
	getRenderCampaign,
	getStartingPrice,
	PROMO_CURRENCY,
	type CampaignSection,
	type PromoPackageId,
} from '@/data/promo-campaign.data';
import { getWhatsAppLink } from '@/utils/whatsapp';

interface Props {
	className?: string;
	message?: string;
	label?: string;
	trackSection?: string;
	trackCta?: string;
	trackIntent?: string;
	/** Explicit campaign code; otherwise `<campaignSection>-<promo code>`. */
	trackCampaign?: string;
	/** Section prefix for the derived campaign code. */
	campaignSection?: CampaignSection;
	/** Package context; derives name, promo code, value and the package quote message. */
	packageId?: PromoPackageId;
	trackValue?: number;
	trackCurrency?: string;
	trackDestination?: string;
	promoCode?: string;
	eventType?: string;
	eventLabel?: string;
	/** Defaults to the visible label plus the destination, e.g. «Quiero mi invitación por WhatsApp». */
	ariaLabel?: string;
	/** Keeps the message untouched by the click-time folio rewrite. */
	preserveMessage?: boolean;
	/** Omits promo attributes for CTAs that are not promo quotes. */
	withoutPromo?: boolean;
}

const {
	className = '',
	message: explicitMessage,
	label = PRIMARY_CTA_LABEL,
	trackSection = 'hero',
	trackCta = 'hero_whatsapp',
	trackIntent = 'whatsapp',
	trackCampaign,
	campaignSection = 'FINAL',
	packageId,
	trackValue,
	trackCurrency,
	trackDestination = 'whatsapp',
	promoCode: explicitPromoCode,
	eventType,
	eventLabel,
	ariaLabel: explicitAriaLabel,
	preserveMessage = false,
	withoutPromo = false,
} = Astro.props;

const ariaLabel = explicitAriaLabel ?? `${label} por WhatsApp`;
const campaign = getRenderCampaign();
const pkg = packageId ? getCatalogPackage(packageId) : undefined;
const derivedPromoCode = pkg ? getPromoCode(pkg.id, campaign) : getGeneralPromoCode(campaign);
const promoCode = withoutPromo ? undefined : (explicitPromoCode ?? derivedPromoCode ?? undefined);
const promoValue = withoutPromo
	? undefined
	: (trackValue ?? (pkg ? getPackagePrice(pkg.id, campaign) : getStartingPrice(campaign)));
const campaignCode =
	trackCampaign ?? (withoutPromo ? undefined : buildCampaignCode(campaignSection, promoCode ?? null));
const currency = trackCurrency ?? (promoValue !== undefined ? PROMO_CURRENCY : undefined);
const message =
	explicitMessage ?? (pkg ? buildPackageMessage(pkg.id, campaign) : buildGeneralMessage(campaign));
// PromoStatus.astro rewrites the quote (codes, value and message) for the visitor's date. CTAs with
// their own code, campaign or value keep what they were given; CTAs with their own message keep the
// message but still switch codes and value, so prerendered pages never report a past campaign.
const switchesWithCalendar =
	!withoutPromo &&
	explicitPromoCode === undefined &&
	trackCampaign === undefined &&
	trackValue === undefined;
const switchesMessage = switchesWithCalendar && explicitMessage === undefined;

// Prerendered pages get the /api/whatsapp redirect, which reads the Worker secret at request time.
const whatsappUrl = getWhatsAppLink(message);
---

<a
	href={whatsappUrl}
	target="_blank"
	rel="noopener noreferrer"
	class:list={['whatsapp-button', className]}
	aria-label={ariaLabel}
	data-track-event="whatsapp_contact_clicked"
	data-track-section={trackSection}
	data-track-cta={trackCta}
	data-track-label={label}
	data-track-intent={trackIntent}
	data-track-destination={trackDestination}
	data-campaign-code={campaignCode}
	data-package-interest={pkg?.id}
	data-package-name={pkg?.name}
	data-promo-code={promoCode}
	data-event-type={eventType}
	data-event-label={eventLabel}
	data-track-value={promoValue}
	data-track-currency={currency}
	data-preserve-message={preserveMessage ? 'true' : undefined}
	data-promo-quote={switchesWithCalendar ? (pkg?.id ?? 'general') : undefined}
	data-promo-message={switchesMessage ? 'true' : undefined}
	data-campaign-section={switchesWithCalendar ? campaignSection : undefined}
>
	<Icon name="WhatsApp" size={20} />
	<slot>{label}</slot>
</a>
