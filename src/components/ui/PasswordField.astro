---
/**
 * Password input with its "Mostrar/Ocultar" button. Behavior lives in
 * `src/lib/client/auth/password-visibility.ts` (`initPasswordToggles`); styles in `_login.scss`.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'input'>, 'type' | 'id' | 'name' | 'autocomplete'> {
	id: string;
	name: string;
	autocomplete: 'current-password' | 'new-password';
}

const { id, name, autocomplete, ...inputAttrs } = Astro.props;
---

<div class="auth-password">
	<input {...inputAttrs} id={id} name={name} type="password" autocomplete={autocomplete} />
	<button
		type="button"
		class="auth-password__toggle"
		data-password-toggle
		aria-controls={id}
		aria-label="Mostrar contraseña"
	>Mostrar</button>
</div>
