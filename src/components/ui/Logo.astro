---
/**
 * The only component that renders the Celebra-me logo (logo_2026_v2 artwork, unmodified).
 * Pick the tone by the ground behind it: `claro` on light grounds, `oscuro` on dark ones.
 * Never style it with filters, shadows, rotation or non-proportional sizing.
 */
import {
	LOGO_ALT,
	getLogoSize,
	getLogoSrc,
	type LogoTone,
	type LogoVersion,
} from '@/lib/brand/brand-logo';

interface Props {
	version: LogoVersion;
	tone: LogoTone;
	/** Rendered width in CSS pixels; must respect the version's minimum. */
	width: number;
	class?: string;
	loading?: 'eager' | 'lazy';
}

const { version, tone, width, class: className, loading = 'eager' } = Astro.props;
const size = getLogoSize(version, width);
---

<img
	src={getLogoSrc(version, tone)}
	alt={LOGO_ALT}
	width={size.width}
	height={size.height}
	class:list={['logo', className]}
	loading={loading}
	decoding="async"
/>
