---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import DemoShowroomGrid from '@/components/showroom/DemoShowroomGrid.astro';

import {
	getDemoShowroomByPublicSlug,
	getFeaturedDemoShowroomItems,
	getShowroomPublicSlugs,
} from '@/data/demo-showroom.data';
import { getEventAsset } from '@/lib/assets/asset-registry';
import { getContactPhone, getWhatsAppLink, isPlaceholderContactPhone } from '@/utils/whatsapp';

import '@/styles/showroom/_demo-showroom.scss';

export function getStaticPaths() {
	return getShowroomPublicSlugs().map((publicSlug) => ({
		params: { eventType: publicSlug },
		props: { publicSlug },
	}));
}

interface Props {
	publicSlug: string;
}

const { publicSlug } = Astro.props;
const showroom = getDemoShowroomByPublicSlug(publicSlug);

if (!showroom) {
	return Astro.redirect('/', 302);
}

const featuredItems = getFeaturedDemoShowroomItems(showroom.eventType).filter((item) =>
	Boolean(getEventAsset(item.thumbnail.assetSlug, item.thumbnail.key)),
);
const phone = getContactPhone();
const showWhatsAppCta = !isPlaceholderContactPhone(phone);
const whatsAppHref = showWhatsAppCta ? getWhatsAppLink(showroom.whatsAppMessage) : '';

const eventDisplayNameBySlug: Record<string, string> = {
	xv: 'XV años',
	boda: 'boda',
	bautizo: 'bautizo',
	bautismo: 'bautizo',
	'baby-shower': 'baby shower',
	cumpleanos: 'cumpleaños',
	'primera-comunion': 'primera comunión',
};

const eventDisplayName = eventDisplayNameBySlug[publicSlug] ?? showroom.label.toLowerCase();
const adaptationTarget = publicSlug === 'xv' ? 'tus XV años' : `tu ${eventDisplayName}`;
const lookbookLabel = eventDisplayName.toUpperCase();
const introTitle = 'Elige una referencia visual para tu invitación';
const introDescription =
	'Cada demo puede adaptarse con tus nombres, colores, música, pases, ubicación y detalles del evento.';
const pageTitle = `Lookbook ${eventDisplayName} | Celebra.me`;
const pageDescription = introDescription;
const quoteHref = showWhatsAppCta ? whatsAppHref : '/#contact';
---

<Layout title={pageTitle} description={pageDescription} className="theme-preset--jewelry-box-landing" transparentHeader={false}>
	<div class="demo-showroom">
		<header class="demo-showroom__intro" data-track-section="demo_showroom_intro">
			<a class="demo-showroom__breadcrumb" href="/#tipo-evento">← Ver tipos de evento</a>
			<div class="demo-showroom__intro-copy">
				<p class="demo-showroom__eyebrow">LOOKBOOK {lookbookLabel}</p>
				<h1 class="demo-showroom__title">{introTitle}</h1>
				<p class="demo-showroom__description">{introDescription}</p>
			</div>
		</header>

		<div id="demos">
			<DemoShowroomGrid showroom={showroom} items={featuredItems} />
		</div>

		<section
			class="demo-showroom__adaptation"
			aria-labelledby="demo-showroom-adaptation-title"
			data-track-section="demo_showroom_adaptation"
		>
			<div class="demo-showroom__adaptation-copy">
				<p class="demo-showroom__eyebrow">¿Te gustó un estilo?</p>
				<h2 id="demo-showroom-adaptation-title" class="demo-showroom__final-title">
					Lo adaptamos a {adaptationTarget}
				</h2>
				<p class="demo-showroom__final-copy">
					Usamos la demo como referencia y personalizamos nombres, colores, música, pases,
					ubicación y detalles.
				</p>
			</div>
			<div class="demo-showroom__final-actions">
				{
					showWhatsAppCta ? (
						<a
							class="demo-showroom__button demo-showroom__button--primary"
							href={quoteHref}
							target="_blank"
							rel="noopener noreferrer"
							data-track-event="whatsapp_contact_clicked"
							data-track-section="demo_showroom_adaptation"
							data-track-cta={`showroom_final_whatsapp_${showroom.eventType}`}
							data-track-intent="whatsapp"
						>
							Cotizar mi invitación
						</a>
					) : (
						<a
							class="demo-showroom__button demo-showroom__button--primary"
							href={quoteHref}
							data-track-event="cta_clicked"
							data-track-section="demo_showroom_adaptation"
							data-track-cta={`showroom_final_contact_${showroom.eventType}`}
							data-track-intent="contact"
						>
							Cotizar mi invitación
						</a>
					)
				}
				<a
					class="demo-showroom__button demo-showroom__button--secondary"
					href="/#pricing"
					data-track-event="cta_clicked"
					data-track-section="demo_showroom_adaptation"
					data-track-cta={`showroom_pricing_${showroom.eventType}`}
					data-track-intent="pricing"
				>
					Ver paquetes
				</a>
			</div>
		</section>
	</div>
</Layout>
