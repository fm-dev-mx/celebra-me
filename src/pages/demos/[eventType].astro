---
export const prerender = false;

import { getDemoShowroomByPublicSlug } from '@/data/demo-showroom.data';

// The per-event lookbook moved into the landing showroom: each address, alternate slugs included,
// opens it on that event. Event types without demos (e.g. baby shower) land on the showroom start.
const showroom = getDemoShowroomByPublicSlug(Astro.params.eventType ?? '');
if (!showroom) {
	return Astro.redirect('/#tipo-evento', 302);
}
return Astro.redirect(showroom.showroomHref, 301);
---
