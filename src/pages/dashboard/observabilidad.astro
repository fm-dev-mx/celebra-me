---
export const prerender = false;

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import ObservabilityPanel from '@/components/dashboard/observability/ObservabilityPanel';
import {
	isLocalObservabilityRuntime,
	readObservabilityRuntimeEnv,
} from '@/lib/observability/runtime-gate';
import { requireAdminStrongDashboardSessionFromLocals } from '@/lib/rsvp/auth/authorization';
import { ApiError } from '@/lib/rsvp/core/errors';

import { buildObservabilitySummaryPayload } from '@/lib/observability/server/snapshot';

if (!isLocalObservabilityRuntime(readObservabilityRuntimeEnv())) {
	return Astro.redirect('/404');
}

try {
	requireAdminStrongDashboardSessionFromLocals(Astro.locals);
} catch (error) {
	if (error instanceof ApiError && error.status === 401) {
		return Astro.redirect('/login');
	}
	if (error instanceof ApiError && error.status === 403) {
		return Astro.redirect('/dashboard/mfa-setup');
	}
	throw error;
}

let initialSummary = null;
try {
	initialSummary = await buildObservabilitySummaryPayload();
} catch {
	// Fail soft to client fetch if SSR probe fails
}
---

<DashboardLayout title="Observabilidad operacional">
	<ObservabilityPanel client:load initialSummary={initialSummary} />
</DashboardLayout>

<style lang="scss" is:global>
	.observability {
		display: grid;
		gap: 1.25rem;
		min-width: 0;
	}

	.observability__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.observability__header h1 {
		margin: 0;
		font-size: clamp(1.5rem, 3vw, 2rem);
		overflow-wrap: anywhere;
	}

	.observability__eyebrow {
		margin: 0 0 0.25rem;
		color: var(--color-text-muted);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.observability__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin: 0.5rem 0 0;
		color: var(--color-text-secondary);
		font-size: 0.85rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		overflow-wrap: anywhere;
	}

	.observability__status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--dashboard-card-border);
		border-radius: 0.5rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.observability__status[data-status='HEALTHY'] {
		border-color: rgb(80 160 100 / 50%);
	}

	.observability__status[data-status='ATTENTION'] {
		border-color: rgb(200 150 60 / 55%);
	}

	.observability__status[data-status='BLOCKED'] {
		border-color: rgb(200 80 80 / 55%);
	}

	.observability__status[data-status='UNVERIFIED'] {
		border-color: rgb(140 140 160 / 55%);
	}

	.observability__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}

	.observability__section {
		min-width: 0;
		padding: 1rem;
		border: 1px solid var(--dashboard-card-border);
		border-radius: 0.75rem;
		background: rgb(248 241 228 / 3%);
	}

	.observability__section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.05rem;
	}

	.observability__table-wrap {
		overflow-x: auto;
		max-width: 100%;
	}

	.observability__table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.82rem;
	}

	.observability__table th,
	.observability__table td {
		padding: 0.45rem 0.55rem;
		border-bottom: 1px solid rgb(248 241 228 / 10%);
		text-align: left;
		vertical-align: top;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.observability__table th {
		color: var(--color-text-muted);
		font-weight: 600;
		white-space: nowrap;
	}

	.observability__badge {
		display: inline-block;
		padding: 0.15rem 0.4rem;
		border: 1px solid var(--dashboard-card-border);
		border-radius: 0.35rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.02em;
	}

	.observability__badge--mutating {
		margin-left: 0.5rem;
		border-color: rgb(200 150 60 / 60%);
	}

	.observability__commands {
		display: grid;
		gap: 0.75rem;
	}

	.observability__command {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
		margin-bottom: 0.5rem;
	}

	.observability__command code {
		display: block;
		padding: 0.55rem 0.75rem;
		border-radius: 0.5rem;
		background: rgb(0 0 0 / 25%);
		font-size: 0.78rem;
		overflow-wrap: anywhere;
		word-break: break-word;
		white-space: pre-wrap;
	}

	.observability__muted {
		color: var(--color-text-muted);
		font-size: 0.85rem;
	}

	.observability__error {
		padding: 0.85rem 1rem;
		border: 1px solid rgb(200 80 80 / 45%);
		border-radius: 0.5rem;
		color: var(--color-text-emphasis);
	}

	.observability__cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
	}

	.observability__card-text {
		margin: 0.25rem 0;
		font-size: 0.88rem;
	}

	.observability__section--attention {
		border-color: rgb(200 150 60 / 60%);
	}

	.observability__section--aligned {
		border-color: rgb(80 160 100 / 40%);
	}

	.observability__attention-title {
		color: var(--color-text-emphasis);
	}

	.observability__aligned-title {
		color: rgb(80 160 100);
	}

	.observability__category-title {
		margin: 0.25rem 0 0.5rem;
		color: var(--color-text-muted);
		font-size: 0.88rem;
	}

	.observability__command-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.observability__command-btn {
		padding: 0.15rem 0.5rem;
		font-size: 0.72rem;
	}

	.observability__detail-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.observability__detail-grid {
		display: grid;
		gap: 1.25rem;
		margin-top: 1.25rem;
	}


	.observability__note-list {
		margin: 0;
		padding-left: 1.1rem;
	}

	@media (max-width: 720px) {
		.observability__table {
			font-size: 0.75rem;
		}
	}
</style>
