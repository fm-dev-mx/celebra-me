---
export const prerender = false;

import { getCollection } from 'astro:content';
import { findDraftByInvitationId } from '@/lib/intake/repositories/invitation-content-draft.repository';
import { findInvitationById } from '@/lib/intake/repositories/invitation.repository';
import { findPublishedByInvitationId } from '@/lib/intake/repositories/published-invitation-content.repository';
import { getContentEntrySlug } from '@/lib/content/events';
import { buildDraftPreviewPageContext } from '@/lib/invitation/draft-preview-helper';
import { computeEffectiveContent } from '@/lib/intake/services/merge-content.service';
import { getAssetSlugFromContent } from '@/lib/assets/asset-slug';
import type { InvitationPageContext } from '@/lib/invitation/page-data';
import { resolvePresetCssUrl } from '@/lib/invitation/preset-css-resolver';
import { resolveInvitationCssLoadPlan } from '@/lib/invitation/section-css-resolver';
import { buildInvitationStylesheetHeadLinks } from '@/lib/invitation/invitation-css-head-links';

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import Layout from '@/layouts/Layout.astro';
import InvitationSections from '@/components/invitation/InvitationSections.astro';
import Footer from '@/components/invitation/Footer.astro';
import Hero from '@/components/invitation/Hero.astro';
import MusicPlayer from '@/components/invitation/MusicPlayer.astro';
import EventHeader from '@/components/invitation/EventHeader.astro';
import EnvelopeReveal from '@/components/invitation/EnvelopeReveal.astro';
import EditorialCoverReveal from '@/components/invitation/EditorialCoverReveal.astro';
import InvitationDeferredCssPromotion from '@/components/invitation/InvitationDeferredCssPromotion.astro';
import '@/styles/invitation.scss';
import '@/styles/invitation/_preview-banner.scss';

import { evaluatePreviewRevision } from '@/lib/editor/preview-revision';
import { resolveInvitationTheme, resolvePreviewSlug } from '@/lib/intake/services/invitation-preset-resolver';

const { id } = Astro.params;
Astro.response.headers.set('Cache-Control', 'no-store, private');

let errorMessage: string | null = null;
let previewSource: string | null = null;
let previewWarning: string | null = null;
let pageCtx: InvitationPageContext | null = null;

if (!id) {
	return Astro.redirect('/dashboard/invitaciones');
}

const invitationRecord = await findInvitationById(id);

if (!invitationRecord) {
	errorMessage = 'Invitación no encontrada.';
}

const resolvedTheme = invitationRecord
	? resolveInvitationTheme(invitationRecord)
	: null;

const effectivePreviewSlug = invitationRecord
	? resolvePreviewSlug(invitationRecord)
	: '';

const invitation = invitationRecord && resolvedTheme
	? {
			...invitationRecord,
			themeId: resolvedTheme,
			snapshot: {
				...invitationRecord.snapshot,
				themeId: resolvedTheme,
				previewSlug: effectivePreviewSlug,
			},
		}
	: null;

const entries = !errorMessage ? await getCollection('event-demos') : [];
const demoEntryForSlug = (slug: string) =>
	entries.find(
		(e: { id: string }) => getContentEntrySlug(e.id) === slug,
	);

async function tryBuildContext(
	content: Record<string, unknown>,
	label: string,
	options: {
		assetLookupSlug?: string;
		priorPublishedContent?: Record<string, unknown> | null;
	} = {},
): Promise<InvitationPageContext | null> {
	if (!invitation) return null;

	const demoContent: Record<string, unknown> =
		effectivePreviewSlug
			? (demoEntryForSlug(effectivePreviewSlug)?.data as Record<string, unknown>) ?? {}
			: {};

	const result = await buildDraftPreviewPageContext(invitation, content, demoContent, {
		assetLookupSlug: options.assetLookupSlug,
		priorPublishedContent: options.priorPublishedContent,
	});
	if (!result.ok) return null;

	previewSource = label;
	return result.pageContext;
}

const [draft, published] = await Promise.all([
	!errorMessage ? findDraftByInvitationId(id) : null,
	!errorMessage ? findPublishedByInvitationId(id) : null,
]);

const requestedRevision = Astro.url.searchParams.get('revision');
const revisionGate = evaluatePreviewRevision({
	requestedRevision,
	draftUpdatedAt: draft?.updatedAt,
	priorError: errorMessage,
});
const revisionMismatch = revisionGate.revisionMismatch;
errorMessage = revisionGate.errorMessage;

const effectiveContent =
	revisionMismatch || errorMessage
		? {}
		: computeEffectiveContent(draft?.content, published?.content);
const hasAnyContent = Object.keys(effectiveContent).length > 0;
const publishedAssetLookupSlug = getAssetSlugFromContent(published?.content);
const previewLabel = draft?.content
	? requestedRevision
		? `Borrador (revisión ${requestedRevision})`
		: 'Borrador + publicado'
	: published?.content
		? 'Versión pública'
		: 'Vacío';

if (!revisionMismatch && hasAnyContent && invitation) {
	pageCtx = await tryBuildContext(
		effectiveContent as unknown as Record<string, unknown>,
		previewLabel,
		{
			assetLookupSlug: publishedAssetLookupSlug,
			priorPublishedContent: published?.content,
		},
	);
	if (!pageCtx && published?.content && !requestedRevision) {
		pageCtx = await tryBuildContext(published.content, 'Versión pública', {
			assetLookupSlug: publishedAssetLookupSlug,
			priorPublishedContent: published.content,
		});
		if (pageCtx) {
			previewWarning = 'El borrador actual tiene errores. Mostrando la versión pública.';
		}
	}
	if (!pageCtx) {
		previewWarning = 'El contenido combinado tiene errores.';
	}
}

if (!pageCtx && !errorMessage && invitation && !revisionMismatch) {
	pageCtx = await tryBuildContext({}, 'Vacío', {
		priorPublishedContent: published?.content,
	});
	if (!pageCtx) {
		errorMessage =
			'No se pudo generar la vista previa con el contenido disponible. Revisa los datos en el editor.';
	}
}

const editUrl = `/dashboard/invitaciones/${id}/editar`;
const embeddedPreview = Astro.url.searchParams.get('embed') === '1';
const rawRevealState = Astro.url.searchParams.get('revealState');
const revealState =
	rawRevealState === 'closed' || rawRevealState === 'opened' || rawRevealState === 'internal'
		? rawRevealState
		: embeddedPreview
			? 'internal'
			: 'closed';

const wrapperDataAttributes = pageCtx
	? {
			...pageCtx.wrapper.dataAttributes,
			...(revealState === 'internal' ? { 'data-reveal-state': 'revealed' } : {}),
		}
	: undefined;

const activePresetUrl = pageCtx?.viewModel?.theme?.preset
	? resolvePresetCssUrl(pageCtx.viewModel.theme.preset)
	: undefined;

const activeSectionCssPlan =
	pageCtx?.viewModel?.theme?.preset
		? resolveInvitationCssLoadPlan({
					themePreset: pageCtx.viewModel.theme.preset,
					footerVariant: pageCtx.footerVariant,
					galleryVariant: pageCtx.viewModel.sections.gallery?.variant,
					structuralVariants: {
						hero: pageCtx.viewModel.hero.structuralVariant,
						thankYou: pageCtx.viewModel.sections.thankYou?.structuralVariant,
						gifts: pageCtx.viewModel.sections.gifts?.structuralVariant,
						rsvp: pageCtx.viewModel.sections.rsvp?.structuralVariant,
						personalizedAccess:
							pageCtx.viewModel.sections.rsvp?.personalizedAccess?.structuralVariant,
						family: pageCtx.viewModel.sections.family?.structuralVariant,
						location: pageCtx.viewModel.sections.location?.structuralVariant,
						itinerary: pageCtx.viewModel.sections.itinerary?.variant,
					},
					envelopeVariant: pageCtx.envelope?.variant,
					revealVariant: pageCtx.envelope?.revealVariant,
					visualProfileId: pageCtx.viewModel.visualProfileId,
				slug: invitationRecord?.slug ?? undefined,
			})
		: [];

const headLinks = buildInvitationStylesheetHeadLinks({
	presetUrl: activePresetUrl,
	plan: activeSectionCssPlan,
	profileIdentity: {
		visualProfileId: pageCtx?.viewModel.visualProfileId,
		slug: invitationRecord?.slug ?? undefined,
	},
	forceBlocking: revealState !== 'closed' || !pageCtx?.wrapper.showEnvelope,
});
---

{
	errorMessage ? (
		<DashboardLayout title="Vista previa no disponible">
			<main class="preview-error">
				<h2>Vista previa no disponible</h2>
				<p>{errorMessage}</p>
				<a href={editUrl} class="preview-error__back">
					&larr; Volver al editor
				</a>
			</main>
		</DashboardLayout>
	) : pageCtx ? (
		<Layout
			title={`Vista previa — ${pageCtx.viewModel.title ?? ''}`}
			description={pageCtx.layout.description}
			image={pageCtx.layout.image}
			hideHeader={true}
			className={pageCtx.layout.className}
			isDemo={false}
			themeMode="dark"
			headLinks={headLinks}
		>
			<InvitationDeferredCssPromotion
				slot="head"
				eventSlug={invitationRecord?.slug ?? pageCtx.viewModel.id}
				isDemo={false}
			/>
			<div class:list={['preview-banner', embeddedPreview && 'preview-banner--embedded']} role="banner">
				<span class="preview-banner__text">
					Vista previa interna — {previewSource}
				</span>
				{previewWarning && <span class="preview-banner__warning">{previewWarning}</span>}
				{previewSource === 'Vacío' && (
					<span class="preview-banner__hint">
						Aún no hay contenido guardado. Edita la invitación para agregarlo.
					</span>
				)}
			{!embeddedPreview && <a href={editUrl} class="preview-banner__back">&larr; Volver al editor</a>}
			</div>

<style is:inline lang="scss" set:html={pageCtx.wrapper.scopedStyles} />
			<main
				class={pageCtx.wrapper.className}
				{...wrapperDataAttributes}
			>
				{
							revealState !== 'internal' && pageCtx.envelope?.revealVariant === 'editorial-cover' ? (
								<EditorialCoverReveal
									coverEdition={pageCtx.envelope.coverEdition}
									coverVolume={pageCtx.envelope.coverVolume}
									coverIssue={pageCtx.envelope.coverIssue}
									microcopy={pageCtx.envelope.microcopy}
									eventSlug={pageCtx.envelope.eventSlug}
									variant={pageCtx.envelope.variant}
									heroName={pageCtx.viewModel.hero.name}
									heroSecondaryName={pageCtx.viewModel.hero.secondaryName}
									heroLabel={pageCtx.viewModel.hero.label}
									heroDate={pageCtx.viewModel.hero.date}
									heroVenueName={pageCtx.heroVenueName}
									previewState={revealState === 'opened' ? 'opened' : 'closed'}
									backgroundImage={pageCtx.viewModel.hero.backgroundImage}
									portrait={pageCtx.viewModel.hero.portrait}
									focalPoint={pageCtx.viewModel.hero.focalPoint}
									focalPointMobile={pageCtx.viewModel.hero.focalPointMobile}
								/>
							) : revealState !== 'internal' && pageCtx.envelope ? (
								<EnvelopeReveal
									name={pageCtx.envelope.name}
									sealStyle={pageCtx.envelope.sealStyle}
									sealIcon={pageCtx.envelope.sealIcon}
									sealInitials={pageCtx.envelope.sealInitials}
									sealVariant={pageCtx.envelope.sealVariant}
									sealColor={pageCtx.envelope.sealColor}
									sealImage={pageCtx.envelope.sealImage}
									microcopy={pageCtx.envelope.microcopy}
									documentLabel={pageCtx.envelope.documentLabel}
									stampText={pageCtx.envelope.stampText}
									stampYear={pageCtx.envelope.stampYear}
									tooltipText={pageCtx.envelope.tooltipText}
									eventSlug={pageCtx.envelope.eventSlug}
									variant={pageCtx.envelope.variant}
									teaserDetails={pageCtx.envelope.teaserDetails}
									card={pageCtx.envelope.card}
									previewState={revealState === 'opened' ? 'opened' : 'closed'}
								/>
							) : null
						}

				<EventHeader
					links={pageCtx.viewModel.navigation ?? []}
					variant={pageCtx.viewModel.theme.preset}
					initials={pageCtx.viewModel.envelope?.data?.sealInitials}
					eventName={pageCtx.viewModel.hero?.name}
					eventSubtitle={pageCtx.viewModel.hero?.label}
					isDemo={false}
				/>

				<Hero
					{...pageCtx.viewModel.hero}
					time={pageCtx.heroTime}
					venueName={pageCtx.heroVenueName}
				/>

				<InvitationSections pageContext={pageCtx} />

				<Footer
					eventSlug={pageCtx.viewModel.id}
					showEnvelope={pageCtx.wrapper.showEnvelope}
					variant={pageCtx.footerVariant}
					closingPhrase={pageCtx.footerClosingPhrase}
					showFooterBranding={pageCtx.viewModel.brandingVisibility.showFooterBranding}
					showContactCta={pageCtx.viewModel.brandingVisibility.showContactCta}
				/>

				{pageCtx.musicPlayer && (
					<MusicPlayer
						url={pageCtx.musicPlayer.url}
						autoPlay={pageCtx.musicPlayer.autoPlay}
						title={pageCtx.musicPlayer.title}
						revealMode={pageCtx.musicPlayer.revealMode}
						variant={pageCtx.musicPlayer.variant}
					/>
				)}
			</main>
		</Layout>
	) : null
}


