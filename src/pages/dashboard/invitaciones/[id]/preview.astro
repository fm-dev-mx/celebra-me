---
export const prerender = false;

import { findDraftByInvitationId } from '@/lib/intake/repositories/invitation-content-draft.repository';
import { findInvitationById } from '@/lib/intake/repositories/invitation.repository';
import { findPublishedByInvitationId } from '@/lib/intake/repositories/published-invitation-content.repository';
import { buildDraftPreviewPageContext } from '@/lib/invitation/draft-preview-helper';
import { computeEffectiveContent } from '@/lib/intake/services/merge-content.service';
import { resolveAssetSlug } from '@/lib/assets/asset-slug';
import type { InvitationPageContext } from '@/lib/invitation/page-data';
import { buildInvitationHeadLinks } from '@/lib/invitation/invitation-head-links';

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import Layout from '@/layouts/Layout.astro';
import InvitationSections from '@/components/invitation/InvitationSections.astro';
import Footer from '@/components/invitation/Footer.astro';
import Hero from '@/components/invitation/Hero.astro';
import MusicPlayer from '@/components/invitation/MusicPlayer.astro';
import EventHeader from '@/components/invitation/EventHeader.astro';
import InvitationRevealEntry from '@/components/invitation/InvitationRevealEntry.astro';
import InvitationPageScripts from '@/components/invitation/InvitationPageScripts.astro';
import InvitationDeferredCssPromotion from '@/components/invitation/InvitationDeferredCssPromotion.astro';
import '@/styles/invitation.scss';
import '@/styles/invitation/_preview-banner.scss';

import { evaluatePreviewRevision } from '@/lib/editor/preview-revision';
import { resolveInvitationTheme } from '@/lib/intake/services/invitation-preset-resolver';

const { id } = Astro.params;
Astro.response.headers.set('Cache-Control', 'no-store, private');

let errorMessage: string | null = null;
let previewSource: string | null = null;
let previewWarning: string | null = null;
let pageCtx: InvitationPageContext | null = null;

if (!id) {
	return Astro.redirect('/dashboard/invitaciones');
}

const invitation = await findInvitationById(id);

if (!invitation) {
	errorMessage = 'Invitación no encontrada.';
}

const themePreset = invitation ? resolveInvitationTheme(invitation) : null;

if (invitation && !themePreset) {
	errorMessage = `El tema configurado "${invitation.themeId}" no es un tema válido.`;
}

async function tryBuildContext(
	content: Record<string, unknown>,
	label: string,
	options: {
		assetLookupSlug?: string;
		priorPublishedContent?: Record<string, unknown> | null;
	} = {},
): Promise<InvitationPageContext | null> {
	if (!invitation || !themePreset) return null;

	const result = await buildDraftPreviewPageContext(invitation, content, {
		themePreset,
		assetLookupSlug: options.assetLookupSlug,
		priorPublishedContent: options.priorPublishedContent,
	});
	if (!result.ok) return null;

	previewSource = label;
	return result.pageContext;
}

const [draft, published] = await Promise.all([
	!errorMessage ? findDraftByInvitationId(id) : null,
	!errorMessage ? findPublishedByInvitationId(id) : null,
]);

const requestedRevision = Astro.url.searchParams.get('revision');
const revisionGate = evaluatePreviewRevision({
	requestedRevision,
	draftUpdatedAt: draft?.updatedAt,
	priorError: errorMessage,
});
const revisionMismatch = revisionGate.revisionMismatch;
errorMessage = revisionGate.errorMessage;

const effectiveContent =
	revisionMismatch || errorMessage
		? {}
		: computeEffectiveContent(draft?.content, published?.content);
const hasAnyContent = Object.keys(effectiveContent).length > 0;
const assetLookupSlug = invitation ? resolveAssetSlug(invitation, published?.content) : undefined;
const previewLabel = draft?.content
	? requestedRevision
		? `Borrador (revisión ${requestedRevision})`
		: 'Borrador + publicado'
	: published?.content
		? 'Versión pública'
		: 'Vacío';

if (!revisionMismatch && hasAnyContent && invitation) {
	pageCtx = await tryBuildContext(
		effectiveContent as unknown as Record<string, unknown>,
		previewLabel,
		{
			assetLookupSlug,
			priorPublishedContent: published?.content,
		},
	);
	if (!pageCtx && published?.content && !requestedRevision) {
		pageCtx = await tryBuildContext(published.content, 'Versión pública', {
			assetLookupSlug,
			priorPublishedContent: published.content,
		});
		if (pageCtx) {
			previewWarning = 'El borrador actual tiene errores. Mostrando la versión pública.';
		}
	}
	if (!pageCtx) {
		previewWarning = 'El contenido combinado tiene errores.';
	}
}

if (!pageCtx && !errorMessage && invitation && !revisionMismatch) {
	pageCtx = await tryBuildContext({}, 'Vacío', {
		assetLookupSlug,
		priorPublishedContent: published?.content,
	});
	if (!pageCtx) {
		errorMessage =
			'No se pudo generar la vista previa con el contenido disponible. Revise los datos en el editor.';
	}
}

const editUrl = `/dashboard/invitaciones/${id}/editar`;
const embeddedPreview = Astro.url.searchParams.get('embed') === '1';
const rawRevealState = Astro.url.searchParams.get('revealState');
const revealState =
	rawRevealState === 'closed' || rawRevealState === 'opened' || rawRevealState === 'internal'
		? rawRevealState
		: embeddedPreview
			? 'internal'
			: 'closed';

const wrapperDataAttributes = pageCtx
	? {
			...pageCtx.wrapper.dataAttributes,
			...(revealState === 'internal' ? { 'data-reveal-state': 'revealed' } : {}),
		}
	: undefined;

const headLinks = pageCtx
	? buildInvitationHeadLinks({
			page: pageCtx,
			forceBlocking: revealState !== 'closed' || !pageCtx.wrapper.showEnvelope,
		})
	: [];
---

{
	errorMessage ? (
		<DashboardLayout title="Vista previa no disponible">
			<main class="preview-error">
				<h2>Vista previa no disponible</h2>
				<p>{errorMessage}</p>
				<a href={editUrl} class="preview-error__back">
					&larr; Volver al editor
				</a>
			</main>
		</DashboardLayout>
	) : pageCtx ? (
		<Layout
			title={`Vista previa — ${pageCtx.viewModel.title ?? ''}`}
			description={pageCtx.layout.description}
			image={pageCtx.layout.image}
			hideHeader={true}
			className={pageCtx.layout.className}
			isDemo={false}
			themeMode="dark"
			headLinks={headLinks}
		>
			<InvitationDeferredCssPromotion
				slot="head"
				eventSlug={invitation?.slug ?? pageCtx.viewModel.id}
				isDemo={false}
			/>
			<div class:list={['preview-banner', embeddedPreview && 'preview-banner--embedded']} role="banner">
				<span class="preview-banner__text">
					Vista previa interna — {previewSource}
				</span>
				{previewWarning && <span class="preview-banner__warning">{previewWarning}</span>}
				{previewSource === 'Vacío' && (
					<span class="preview-banner__hint">
						Aún no hay contenido guardado. Edita la invitación para agregarlo.
					</span>
				)}
			{!embeddedPreview && <a href={editUrl} class="preview-banner__back">&larr; Volver al editor</a>}
			</div>

<style is:inline lang="scss" set:html={pageCtx.wrapper.scopedStyles} />
			<div class={pageCtx.wrapper.className} {...wrapperDataAttributes}>
				<InvitationPageScripts />
				{revealState !== 'internal' && (
					<InvitationRevealEntry
						page={pageCtx}
						previewState={revealState === 'opened' ? 'opened' : 'closed'}
					/>
				)}

				<EventHeader
					links={pageCtx.viewModel.navigation ?? []}
					variant="standard"
					initials={pageCtx.viewModel.envelope?.data?.sealInitials}
					eventName={pageCtx.viewModel.hero?.name}
					eventSubtitle={pageCtx.viewModel.hero?.label}
					isDemo={false}
				/>

				<Hero
					{...pageCtx.viewModel.hero}
					time={pageCtx.heroTime}
					venueName={pageCtx.heroVenueName}
					editionMark={pageCtx.edition?.mark}
				/>

				<InvitationSections pageContext={pageCtx} />

				<Footer
					eventSlug={pageCtx.viewModel.id}
					showEnvelope={pageCtx.wrapper.showEnvelope}
					variant="standard"
					closingPhrase={pageCtx.footerClosingPhrase}
					showFooterBranding={pageCtx.viewModel.brandingVisibility.showFooterBranding}
					showContactCta={pageCtx.viewModel.brandingVisibility.showContactCta}
				/>

				{pageCtx.musicPlayer && <MusicPlayer {...pageCtx.musicPlayer} />}
			</div>
		</Layout>
	) : null
}


