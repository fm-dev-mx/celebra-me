---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
---

<DashboardLayout title="Creación administrada">
	<section class="intake-create-retired">
		<h1>Creación desde el panel retirada</h1>
		<p>
			Las invitaciones de cliente se crean con el flujo administrado
			(<code>scripts/provision/invitations</code> y
			<code>pnpm invitation:update</code> / <code>pnpm invitation:promote</code>).
		</p>
		<p>
			<a href="/dashboard/invitaciones">Volver a invitaciones</a>
		</p>
	</section>
</DashboardLayout>
