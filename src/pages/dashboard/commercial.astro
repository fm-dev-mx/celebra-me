---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import {
	buildCommercialDashboardViewModel,
	labelLeadChannel,
	labelLeadStatus,
	loadCommercialDashboardData,
	type CommercialDashboardSummary,
	type CountItem,
	formatCount,
	formatCurrency,
	formatDateTime,
} from '@/lib/tracking/commercial-dashboard';
import { getEnv } from '@/lib/server/env';
import { supabaseRestRequest } from '@/lib/rsvp/repositories/supabase';
import SalesWorkspace from '@/components/dashboard/commercial/SalesWorkspace';
import CapiOutboxPanel from '@/components/dashboard/commercial/CapiOutboxPanel';
import type { ConversionEvent } from '@/components/dashboard/commercial/OutboxLogList';

if (!Astro.locals.session?.isSuperAdmin) {
	return Astro.redirect('/dashboard/invitados');
}

let dashboardData: CommercialDashboardSummary | null = null;
let loadError = false;
let initialConversions: ConversionEvent[] = [];

try {
	dashboardData = await loadCommercialDashboardData();
} catch (error) {
	console.error('[commercial-dashboard] Unable to load commercial analytics.', error);
	loadError = true;
}
try {
	initialConversions = await supabaseRestRequest<ConversionEvent[]>({
		pathWithQuery: 'meta_conversion_events?select=id,event_name,event_id,value,currency,status,attempt_count,last_error_message,created_at&order=created_at.desc&limit=50',
		useServiceRole: true,
	});
} catch (error) {
	console.error('[commercial-dashboard] Error loading outbox data (non-critical):', error);
}

const viewModel = dashboardData
	? buildCommercialDashboardViewModel(dashboardData, {
			capiDeliveryMode: getEnv('META_CAPI_DELIVERY_MODE'),
		})
	: null;

const renderList = (items: CountItem[]) => items.length > 0 ? items : [{ label: 'Sin datos suficientes todavía', count: 0 }];

const ORDER_STATUS_LABELS: Record<string, string> = {
	draft: 'Borrador',
	quoted: 'Cotizado',
	confirmed: 'Confirmado',
	deposit_paid: 'Anticipo pagado',
	paid: 'Pagado',
	cancelled: 'Cancelado',
	lost: 'Perdido',
};
const labelOrderStatus = (s: string) => ORDER_STATUS_LABELS[s] || s;

const HEALTH_STATUS_LABELS: Record<string, string> = {
	correct: 'Correcto',
	attention: 'Atención',
	error: 'Error',
	'safe-disabled': 'Desactivado de forma segura',
};
const labelHealthStatus = (status: string) => HEALTH_STATUS_LABELS[status] || status;
---

<DashboardLayout title="Dashboard comercial">
	<section class="commercial-dashboard">
		<header class="commercial-dashboard__header">
			<div>
				<p class="commercial-dashboard__eyebrow">Panel de control</p>
				<h2>Comercial</h2>
			</div>
			<p>
				Resumen ejecutivo de ventas, atribución de marketing y salud del sistema.
			</p>
		</header>

		{loadError && (
			<div class="dashboard-card commercial-dashboard__notice">
				<h3>Datos no disponibles</h3>
				<p>
					El panel está listo, pero las tablas comerciales aún no respondieron en este
					ambiente. Aplica la migración MVP antes de usarlo en producción.
				</p>
			</div>
		)}

		{dashboardData && viewModel && (
			<>
				<div class="commercial-context-strip">
					<span class="context-dot">Datos históricos disponibles · Sin filtro activo</span>
					<span class="context-sep"></span>
					<span>Última actividad: {formatDateTime(dashboardData.dataContext.lastActivityAt)}</span>
					<span class="context-sep"></span>
					<span>Último tracking: {formatDateTime(dashboardData.dataContext.lastTrackingEventAt)}</span>
					<span class="context-sep"></span>
					<span>Última actualización: {formatDateTime(dashboardData.dataContext.lastCommercialUpdateAt)}</span>
					<span class="context-note">{dashboardData.dataContext.limitNotice}</span>
				</div>

				<div class="commercial-dashboard__health-bar">
					<span>Tracking:</span>
					<span class:list={['health-badge', `health-badge--${viewModel.health.tracking.status}`]}>{labelHealthStatus(viewModel.health.tracking.status)}</span>
					<span class="health-bar-sep"></span>
					<span>CAPI:</span>
					<span class:list={['health-badge', `health-badge--${viewModel.health.capi.status}`]}>{labelHealthStatus(viewModel.health.capi.status)}</span>
					<span class="health-bar-sep"></span>
					<span>Datos comerciales:</span>
					<span class:list={['health-badge', `health-badge--${viewModel.health.commercial.status}`]}>{labelHealthStatus(viewModel.health.commercial.status)}</span>
				</div>

				<div class="commercial-tabs">
					<button class="tab-btn active" data-tab="resumen">Resumen</button>
					<button class="tab-btn" data-tab="ventas">Ventas</button>
					<button class="tab-btn" data-tab="atribucion">Atribución</button>
					<button class="tab-btn" data-tab="salud">Salud del sistema</button>
				</div>

				<div class="tab-content active" id="tab-resumen">
					<div class="commercial-dashboard__metrics commercial-dashboard__metrics--executive">
						{viewModel.executiveMetrics.map((card) => (
							<article class:list={['commercial-dashboard__metric', card.id === 'commercialAlerts' && viewModel.activeAlerts > 0 ? 'commercial-dashboard__metric--alert' : '']}>
								<span>{card.label}</span>
								<strong>{card.value}</strong>
								{card.helper && <small>{card.helper}</small>}
							</article>
						))}
					</div>

					<section class="dashboard-card">
						<h3>Leads recientes</h3>
						<div class="commercial-dashboard__table-wrap">
							<table class="commercial-dashboard__table">
								<thead>
									<tr>
										<th>Código</th>
										<th>Nombre</th>
										<th>Contacto</th>
										<th>Evento</th>
										<th>Estado</th>
										<th>Canal</th>
									</tr>
								</thead>
								<tbody>
									{dashboardData.recentLeads.length === 0 ? (
										<tr>
											<td colspan="6">Sin leads registrados todavía.</td>
										</tr>
									) : (
										dashboardData.recentLeads.map((lead) => (
											<tr>
												<td>{lead.lead_code}</td>
												<td>{lead.name || 'Sin nombre'}</td>
												<td>{lead.email || lead.phone || 'Sin contacto'}</td>
												<td>{lead.event_type || 'Sin clasificar'}</td>
												<td>{labelLeadStatus(lead.status)}</td>
												<td>{labelLeadChannel(lead.channel)}</td>
											</tr>
										))
									)}
								</tbody>
							</table>
						</div>
					</section>
				</div>

				<div class="tab-content" id="tab-ventas">
					<SalesWorkspace client:load />
				</div>

				<div class="tab-content" id="tab-atribucion">
					<section class="commercial-dashboard__quality">
						<header class="commercial-dashboard__quality-header">
							<h3>Tráfico e interacción</h3>
							<p>Canales de tráfico, contenido interactivo y rendimiento de demos.</p>
						</header>
						<div class="commercial-dashboard__grid">
							<section class="dashboard-card">
								<h3>Tráfico</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.campaigns).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Interacción</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.sections).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>CTAs</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.topCtas).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Demos</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.topDemos).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Desplazamiento</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.scrollDepth).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>
						</div>
					</section>

					<section class="commercial-dashboard__quality">
						<header class="commercial-dashboard__quality-header">
							<h3>Leads e ingresos</h3>
							<p>Distribución de leads por estado, canal y rendimiento por paquete.</p>
						</header>
						<div class="commercial-dashboard__grid">
							<section class="dashboard-card">
								<h3>Leads por estado</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.leadsByStatus).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Leads por canal</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.leadsByChannel).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Ingresos por paquete / tipo</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.topRevenueByEventType).map((item) => (
										<li><span>{item.label}</span><strong>{formatCurrency(item.count, 0)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Órdenes por estado</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.ordersByStatus.map((o) => ({ label: labelOrderStatus(o.label), count: o.count }))).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>
						</div>
					</section>
				</div>

				<div class="tab-content" id="tab-salud">
					<section class="commercial-dashboard__health">
						<header class="commercial-dashboard__quality-header">
							<h3>Diagnóstico del sistema</h3>
							<p>Estado detallado de tracking, CAPI y datos comerciales.</p>
						</header>
						<div class="commercial-dashboard__health-grid">
							<article class="dashboard-card commercial-dashboard__health-card">
								<div class="commercial-dashboard__health-heading">
									<h4>{viewModel.health.tracking.label}</h4>
									<span class:list={['commercial-dashboard__status', `commercial-dashboard__status--${viewModel.health.tracking.status}`]}>
										{labelHealthStatus(viewModel.health.tracking.status)}
									</span>
								</div>
								<p>{viewModel.health.tracking.message}</p>
								<ul class="commercial-dashboard__health-list">
									{viewModel.health.tracking.checks.map((check) => (
										<li>
											<span>{check.label}</span>
											<strong>{check.value}</strong>
											<small>{check.helper}</small>
										</li>
									))}
								</ul>
							</article>

							<article class="dashboard-card commercial-dashboard__health-card">
								<div class="commercial-dashboard__health-heading">
									<h4>{viewModel.health.capi.label}</h4>
									<span class:list={['commercial-dashboard__status', `commercial-dashboard__status--${viewModel.health.capi.status}`]}>
										{labelHealthStatus(viewModel.health.capi.status)}
									</span>
								</div>
								<p>{viewModel.health.capi.message}</p>
								<ul class="commercial-dashboard__health-list commercial-dashboard__health-list--compact">
									{viewModel.health.capi.checks.map((check) => (
										<li>
											<span>{check.label}</span>
											<strong>{check.value}</strong>
										</li>
									))}
								</ul>
							</article>

							<article class="dashboard-card commercial-dashboard__health-card">
								<div class="commercial-dashboard__health-heading">
									<h4>{viewModel.health.commercial.label}</h4>
									<span class:list={['commercial-dashboard__status', `commercial-dashboard__status--${viewModel.health.commercial.status}`]}>
										{labelHealthStatus(viewModel.health.commercial.status)}
									</span>
								</div>
								<p>{viewModel.health.commercial.message}</p>
								<ul class="commercial-dashboard__health-list">
									{viewModel.health.commercial.warnings.length === 0 ? (
										<li>
											<span>Alertas accionables</span>
											<strong>0</strong>
											<small>Sin alertas en los registros cargados.</small>
										</li>
									) : (
										viewModel.health.commercial.warnings.map((warning) => (
											<li>
												<span>{warning.label}</span>
												<strong>{formatCount(warning.count)}</strong>
												<small>{warning.helper}</small>
											</li>
										))
									)}
								</ul>
							</article>
						</div>
					</section>

					<section class="commercial-dashboard__quality">
						<header class="commercial-dashboard__quality-header">
							<h3>Calidad del seguimiento</h3>
							<p>Distribución de consentimiento entre eventos persistidos.</p>
						</header>
						<div class="commercial-dashboard__metrics">
							{viewModel.trackingQualityCards.map((card) => (
								<article class:list={['commercial-dashboard__metric', card.muted ? 'commercial-dashboard__metric--muted' : '']}>
									<span>{card.label}</span>
									<strong>{card.value}</strong>
									{card.helper && <small>{card.helper}</small>}
								</article>
							))}
							<article class="commercial-dashboard__metric commercial-dashboard__metric--muted">
								<span>Sesiones internas excluidas</span>
								<strong>{formatCount(dashboardData.totals.internalSessions)}</strong>
							</article>
						</div>
					</section>

					<CapiOutboxPanel client:load initialConversions={initialConversions} />
				</div>
			</>
		)}
	</section>


	<style lang="scss">
		.commercial-dashboard {
			display: grid;
			gap: 1.5rem;
		}

		.commercial-dashboard__header {
			display: flex;
			justify-content: space-between;
			gap: 1.5rem;
			align-items: end;

			h2 {
				margin: 0;
				font-size: clamp(1.9rem, 3vw, 2.7rem);
				color: var(--color-text-primary);
			}

			p {
				max-width: 46rem;
				margin: 0;
				color: var(--color-text-secondary);
				line-height: 1.6;
			}
		}

		.commercial-dashboard__eyebrow {
			margin: 0 0 0.35rem;
			color: var(--color-text-muted);
			text-transform: uppercase;
			font-size: 0.72rem;
			letter-spacing: 0.14em;
		}

		.commercial-dashboard__metrics,
		.commercial-dashboard__grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 1rem;
		}

		.commercial-dashboard__metrics--executive {
			grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		}

		.commercial-dashboard__metric {
			padding: 1.25rem;
			border: 1px solid var(--dashboard-card-border);
			border-radius: 0.75rem;
			background: var(--dashboard-card-bg);
			box-shadow: var(--shadow-subtle);

			span {
				display: block;
				color: var(--color-text-secondary);
				font-size: 0.86rem;
			}

			strong {
				display: block;
				margin-top: 0.45rem;
				font-size: 2rem;
				color: var(--color-action-primary);
			}

			small {
				display: block;
				margin-top: 0.45rem;
				color: var(--color-text-muted);
				font-size: 0.78rem;
				line-height: 1.4;
			}
		}

		.commercial-dashboard__metric--muted strong {
			color: var(--color-text-secondary);
		}

		.commercial-dashboard__metric--alert strong {
			color: #f59e0b;
		}

		.commercial-dashboard__list {
			display: grid;
			gap: 0.7rem;
			padding: 0;
			margin: 1rem 0 0;
			list-style: none;

			li {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				padding-bottom: 0.7rem;
				border-bottom: 1px solid var(--dashboard-card-border);
				color: var(--color-text-secondary);
			}

			strong {
				color: var(--color-text-primary);
			}
		}

		.commercial-dashboard__card-help {
			margin: 0.35rem 0 0;
			color: var(--color-text-muted);
			font-size: 0.82rem;
			line-height: 1.45;
		}

		/* Compact data context strip */
		.commercial-context-strip {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.5rem;
			padding: 0.6rem 1rem;
			border: 1px solid var(--dashboard-card-border);
			border-radius: 0.5rem;
			background: var(--dashboard-card-bg);
			font-size: 0.8rem;
			color: var(--color-text-secondary);
			line-height: 1.4;
		}

		.commercial-context-strip .context-dot {
			font-weight: 600;
			color: var(--color-text-primary);
		}

		.commercial-context-strip .context-sep {
			width: 1px;
			height: 1em;
			background: var(--dashboard-card-border);
			opacity: 0.5;
			flex-shrink: 0;
		}

		.commercial-context-strip .context-note {
			width: 100%;
			color: var(--color-text-muted);
			font-size: 0.75rem;
			margin-top: 0.15rem;
		}

		/* Compact health bar */
		.commercial-dashboard__health-bar {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.5rem;
			padding: 0.6rem 1rem;
			border: 1px solid var(--dashboard-card-border);
			border-radius: 0.5rem;
			background: var(--dashboard-card-bg);
			font-size: 0.86rem;
			color: var(--color-text-secondary);
		}

		.health-bar-sep {
			width: 1px;
			height: 1.2em;
			background: var(--dashboard-card-border);
			opacity: 0.4;
			flex-shrink: 0;
		}

		.health-badge {
			display: inline-flex;
			align-items: center;
			border-radius: 999px;
			padding: 0.15rem 0.5rem;
			border: 1px solid var(--dashboard-card-border);
			color: var(--color-text-secondary);
			font-size: 0.75rem;
			font-weight: 700;
			white-space: nowrap;
		}

		.health-badge--correct {
			border-color: rgba(34, 197, 94, 0.45);
			color: #22c55e;
		}

		.health-badge--attention {
			border-color: rgba(245, 158, 11, 0.45);
			color: #f59e0b;
		}

		.health-badge--error {
			border-color: rgba(239, 68, 68, 0.45);
			color: #ef4444;
		}

		.health-badge--safe-disabled {
			border-color: rgba(107, 114, 128, 0.45);
			color: var(--color-text-secondary);
		}

		/* Detailed health cards (Salud tab) */
		.commercial-dashboard__health {
			display: grid;
			gap: 0.75rem;
		}

		.commercial-dashboard__health-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 1rem;
		}

		.commercial-dashboard__health-card {
			display: grid;
			align-content: start;
			gap: 0.8rem;

			p {
				margin: 0;
				color: var(--color-text-secondary);
				font-size: 0.86rem;
				line-height: 1.5;
			}
		}

		.commercial-dashboard__health-heading {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;

			h4 {
				margin: 0;
				color: var(--color-text-primary);
				font-size: 0.95rem;
			}
		}

		.commercial-dashboard__status {
			display: inline-flex;
			align-items: center;
			border-radius: 999px;
			padding: 0.2rem 0.55rem;
			border: 1px solid var(--dashboard-card-border);
			color: var(--color-text-secondary);
			font-size: 0.72rem;
			font-weight: 700;
			white-space: nowrap;
		}

		.commercial-dashboard__status--correct {
			border-color: rgba(34, 197, 94, 0.45);
			color: #22c55e;
		}

		.commercial-dashboard__status--attention {
			border-color: rgba(245, 158, 11, 0.45);
			color: #f59e0b;
		}

		.commercial-dashboard__status--error {
			border-color: rgba(239, 68, 68, 0.45);
			color: #ef4444;
		}

		.commercial-dashboard__status--safe-disabled {
			border-color: rgba(107, 114, 128, 0.45);
			color: var(--color-text-secondary);
		}

		.commercial-dashboard__health-list {
			display: grid;
			gap: 0.6rem;
			margin: 0;
			padding: 0;
			list-style: none;

			li {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 0.15rem 0.75rem;
				padding-top: 0.6rem;
				border-top: 1px solid var(--dashboard-card-border);
			}

			span {
				color: var(--color-text-secondary);
				font-size: 0.86rem;
			}

			strong {
				color: var(--color-text-primary);
				font-size: 0.9rem;
			}

			small {
				grid-column: 1 / -1;
				color: var(--color-text-muted);
				font-size: 0.76rem;
				line-height: 1.35;
			}
		}

		.commercial-dashboard__health-list--compact li {
			grid-template-columns: 1fr auto;
		}

		.commercial-dashboard__table-wrap {
			overflow-x: auto;
		}

		.commercial-dashboard__table {
			width: 100%;
			min-width: 640px;
			border-collapse: collapse;

			th,
			td {
				padding: 0.85rem 0.75rem;
				text-align: left;
				border-bottom: 1px solid var(--dashboard-card-border);
				color: var(--color-text-secondary);
			}

			th {
				color: var(--color-text-muted);
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
		}

		@media (max-width: 760px) {
			.commercial-dashboard__header {
				display: grid;
				align-items: start;
			}
		}

		.commercial-dashboard__quality {
			margin-top: 1rem;
		}

		.commercial-dashboard__quality-header {
			margin-bottom: 0.75rem;
		}

		.commercial-dashboard__quality-header h3 {
			margin: 0 0 0.25rem;
			font-size: 0.95rem;
			color: var(--color-text-primary);
		}

		.commercial-dashboard__quality-header p {
			margin: 0;
			font-size: 0.82rem;
			color: var(--color-text-muted);
		}

		/* Tab bar */
		.commercial-tabs {
			display: flex;
			gap: 0.5rem;
			border-bottom: 1px solid var(--dashboard-card-border);
			padding-bottom: 0.5rem;
			margin-bottom: 1.5rem;
		}

		.tab-btn {
			background: none;
			border: none;
			padding: 0.5rem 1rem;
			color: var(--color-text-secondary);
			font-size: 0.9rem;
			font-weight: 500;
			cursor: pointer;
			border-radius: 0.375rem;
			transition: all 0.2s ease;

			&:hover {
				color: var(--color-text-primary);
				background: rgba(255, 255, 255, 0.05);
			}

			&.active {
				color: var(--color-action-primary);
				background: rgba(59, 130, 246, 0.1);
				font-weight: bold;
			}
		}

		.tab-content {
			display: none;

			&.active {
				display: block;
			}
		}
	</style>

	<script>
		const tabButtons = document.querySelectorAll('.tab-btn');
		const tabContents = document.querySelectorAll('.tab-content');

		tabButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const tabName = btn.getAttribute('data-tab');
				if (!tabName) return;

				tabButtons.forEach((b) => b.classList.remove('active'));
				tabContents.forEach((c) => c.classList.remove('active'));

				btn.classList.add('active');
				const targetContent = document.getElementById(`tab-${tabName}`);
				if (targetContent) {
					targetContent.classList.add('active');
				}
			});
		});
	</script>
</DashboardLayout>
