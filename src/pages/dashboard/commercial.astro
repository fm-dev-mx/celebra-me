---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import {
	buildCommercialDashboardViewModel,
	labelLeadChannel,
	labelLeadStatus,
	type CommercialDashboardSummary,
	type CountItem,
	formatCount,
	formatCurrency,
	formatDateTime,
} from '@/lib/tracking/commercial-dashboard';
import {
	labelCommercialEventType,
	presentCommercialAttribution,
} from '@/lib/tracking/commercial-presentation';
import SalesWorkspace from '@/components/dashboard/commercial/SalesWorkspace';
import CapiOutboxPanel from '@/components/dashboard/commercial/CapiOutboxPanel';
import type { ConversionEvent } from '@/components/dashboard/commercial/OutboxLogList';
import { getEnv } from '@/lib/server/env';
import type { LeadCandidate } from '@/components/dashboard/commercial/LeadCandidatesList';

if (!Astro.locals.session?.isSuperAdmin) {
	return Astro.redirect('/dashboard/invitados');
}

let dashboardData: CommercialDashboardSummary | null = null;
let loadError = false;
let initialConversions: ConversionEvent[] = [];
const dashboardServer = await import('@/lib/tracking/commercial-dashboard.server');

try {
	dashboardData = await dashboardServer.loadCommercialDashboardData();
} catch (error) {
	console.error('[commercial-dashboard] Unable to load commercial analytics.', error);
	loadError = true;
}
try {
	initialConversions = await dashboardServer.loadCommercialDashboardOutbox();
} catch (error) {
	console.error('[commercial-dashboard] Error loading outbox data (non-critical):', error);
}

const viewModel = dashboardData
	? buildCommercialDashboardViewModel(dashboardData, {
			capiDeliveryMode: getEnv('META_CAPI_DELIVERY_MODE'),
		})
	: null;

const renderList = (items: CountItem[], emptyLabel = 'Sin datos suficientes todavía') =>
	items.length > 0 ? items : [{ label: emptyLabel, count: 0 }];

const ORDER_STATUS_LABELS: Record<string, string> = {
	draft: 'Borrador',
	quoted: 'Cotizado',
	confirmed: 'Confirmado',
	deposit_paid: 'Anticipo pagado',
	paid: 'Pagado',
	cancelled: 'Cancelado',
	lost: 'Perdido',
};
const labelOrderStatus = (s: string) => ORDER_STATUS_LABELS[s] || s;

const HEALTH_STATUS_LABELS: Record<string, string> = {
	correct: 'Correcto',
	attention: 'Atención',
	error: 'Error',
	'safe-disabled': 'Desactivado de forma segura',
};
const labelHealthStatus = (status: string) => HEALTH_STATUS_LABELS[status] || status;

const initialSalesLeads: LeadCandidate[] = dashboardData?.recentLeads.map((lead, index) => ({
	id: lead.id || lead.lead_code || `recent-lead-${index}`,
	leadCode: lead.lead_code || 'Sin código',
	channel: lead.channel,
	status: lead.status,
	customerId: lead.customer_id,
	name: lead.name,
	email: lead.email,
	phone: lead.phone,
	phoneE164: lead.phone_e164,
	eventType: lead.event_type,
	packageInterest: lead.package_interest,
	utmSource: lead.utm_source,
	utmMedium: lead.utm_medium,
	utmCampaign: lead.utm_campaign,
	createdAt: lead.created_at,
})) || [];

const leadChannelAttribution = dashboardData
	? presentCommercialAttribution(dashboardData.leadsByChannel, 'Canales internos / QA')
	: null;
const revenueAttribution = dashboardData
	? presentCommercialAttribution(dashboardData.topRevenueByEventType, 'Ingresos internos / QA')
	: null;
---

<DashboardLayout title="Dashboard comercial">
	<section class="commercial-dashboard">
		<header class="commercial-dashboard__header">
			<div>
				<p class="commercial-dashboard__eyebrow">Panel de control</p>
				<h2>Comercial</h2>
			</div>
			<p>
				Un espacio para priorizar seguimientos, gestionar órdenes y consultar el rendimiento comercial.
			</p>
		</header>

		{loadError && (
			<div class="dashboard-card commercial-dashboard__notice">
				<h3>Datos no disponibles</h3>
				<p>
					El panel está listo, pero las tablas comerciales aún no respondieron en este
					ambiente. Aplica la migración MVP antes de usarlo en producción.
				</p>
			</div>
		)}

		{dashboardData && viewModel && (
			<>
				<div class="commercial-tabs" role="tablist" aria-label="Secciones del espacio comercial">
					<button class="tab-btn active" id="commercial-tab-ventas" role="tab" data-tab="ventas" aria-controls="tab-ventas" aria-selected="true">Ventas</button>
					<button class="tab-btn" id="commercial-tab-resumen" role="tab" data-tab="resumen" aria-controls="tab-resumen" aria-selected="false" tabindex="-1">Resumen</button>
					<button class="tab-btn" id="commercial-tab-atribucion" role="tab" data-tab="atribucion" aria-controls="tab-atribucion" aria-selected="false" tabindex="-1">Atribución</button>
					<button class="tab-btn" id="commercial-tab-salud" role="tab" data-tab="salud" aria-controls="tab-salud" aria-selected="false" tabindex="-1">Salud</button>
				</div>

				<div class="tab-content" id="tab-resumen" role="tabpanel" aria-labelledby="commercial-tab-resumen" tabindex="0" hidden>
					<section class="commercial-dashboard__priority">
						<header class="commercial-dashboard__command-header">
							<div class="commercial-dashboard__quality-header">
								<p class="commercial-dashboard__eyebrow">Hoy</p>
								<h3>Prioridades comerciales</h3>
								<p>Empieza por los seguimientos y cobros que pueden mover una venta.</p>
							</div>
							<button type="button" class="btn-primary commercial-dashboard__sales-cta" data-open-tab="ventas">Abrir espacio de ventas</button>
						</header>
						<div class="commercial-dashboard__priority-list">
							<article class="commercial-dashboard__priority-item">
								<span>Leads por revisar</span>
								<strong>{formatCount(dashboardData.recentLeads.length)}</strong>
								<small>Abre Ventas para buscar un prospecto y continuar el seguimiento.</small>
							</article>
							<article class="commercial-dashboard__priority-item">
								<span>Órdenes con saldo pendiente</span>
								<strong>{formatCount(dashboardData.ordersWithPendingBalance)}</strong>
								<small>Consulta cada cliente para registrar anticipos o confirmar su cobro.</small>
							</article>
							<article class="commercial-dashboard__priority-item">
								<span>Anticipos registrados</span>
								<strong>{formatCount(dashboardData.sales.depositsPaid)}</strong>
								<small>{formatCurrency(dashboardData.sales.totalRevenue, 0)} registrados en órdenes con anticipo.</small>
							</article>
							<article class:list={['commercial-dashboard__priority-item', viewModel.activeAlerts > 0 ? 'commercial-dashboard__priority-item--alert' : '']}>
								<span>Alertas comerciales</span>
								<strong>{formatCount(viewModel.activeAlerts)}</strong>
								<small>{viewModel.activeAlerts > 0 ? 'Revisa los pendientes antes de iniciar nuevas gestiones.' : 'No hay alertas comerciales en los datos cargados.'}</small>
							</article>
						</div>
					</section>

					<section class="commercial-dashboard__quality">
						<header class="commercial-dashboard__quality-header">
							<h3>Indicadores del periodo</h3>
							<p>Contexto de ventas e ingresos para acompañar las prioridades.</p>
						</header>
					<div class="commercial-dashboard__metrics commercial-dashboard__metrics--executive">
							{viewModel.executiveMetrics.filter((card) => card.id !== 'commercialAlerts').map((card) => (
							<article class:list={['commercial-dashboard__metric', card.id === 'commercialAlerts' && viewModel.activeAlerts > 0 ? 'commercial-dashboard__metric--alert' : '']}>
								<span>{card.label}</span>
								<strong>{card.value}</strong>
								{card.helper && <small>{card.helper}</small>}
							</article>
						))}
					</div>
					</section>

					<section class="dashboard-card">
						<h3>Leads recientes</h3>
						<p class="commercial-dashboard__card-help">Consulta los contactos más recientes y continúa su seguimiento desde Ventas.</p>
						<div class="commercial-dashboard__table-wrap">
							<table class="commercial-dashboard__table">
								<thead>
									<tr>
										<th>Código</th>
										<th>Nombre</th>
										<th>Contacto</th>
										<th>Evento</th>
										<th>Estado</th>
										<th>Canal</th>
									</tr>
								</thead>
								<tbody>
									{dashboardData.recentLeads.length === 0 ? (
										<tr>
											<td colspan="6">Sin leads registrados todavía.</td>
										</tr>
									) : (
										dashboardData.recentLeads.map((lead) => (
											<tr>
												<td>{lead.lead_code}</td>
												<td>{lead.name || 'Sin nombre'}</td>
												<td>{lead.email || lead.phone || 'Sin contacto'}</td>
											<td>{lead.event_type ? labelCommercialEventType(lead.event_type) : 'Sin clasificar'}</td>
												<td>{labelLeadStatus(lead.status)}</td>
												<td>{labelLeadChannel(lead.channel)}</td>
											</tr>
										))
									)}
								</tbody>
							</table>
						</div>
					</section>
				</div>

				<div class="tab-content active" id="tab-ventas" role="tabpanel" aria-labelledby="commercial-tab-ventas" tabindex="0">
					<SalesWorkspace client:load initialLeads={initialSalesLeads} />
				</div>

				<div class="tab-content" id="tab-atribucion" role="tabpanel" aria-labelledby="commercial-tab-atribucion" tabindex="0" hidden>
					<section class="commercial-dashboard__quality">
						<header class="commercial-dashboard__quality-header">
							<p class="commercial-dashboard__eyebrow">Decisión comercial</p>
							<h3>De dónde llegan los leads y qué se está vendiendo</h3>
							<p>Usa esta lectura para enfocar campañas, paquetes y seguimiento.</p>
						</header>
						<div class="commercial-dashboard__grid commercial-dashboard__grid--compact">
							<section class="dashboard-card">
								<h3>Leads por canal</h3>
								<ul class="commercial-dashboard__list">
									{renderList(leadChannelAttribution?.commercial || [], 'Sin canales comerciales confirmados').map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Ingresos por paquete / tipo</h3>
								<ul class="commercial-dashboard__list">
									{renderList(revenueAttribution?.commercial || [], 'Sin ingresos comerciales confirmados').map((item) => (
										<li><span>{item.label}</span><strong>{formatCurrency(item.count, 0)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Órdenes por estado</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.ordersByStatus.map((o) => ({ label: labelOrderStatus(o.label), count: o.count }))).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Leads por estado</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.leadsByStatus).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>
						</div>
					</section>

					<details class="commercial-dashboard__details">
						<summary>Ver detalle de intención e interacción</summary>
					<section class="commercial-dashboard__quality">
						<header class="commercial-dashboard__quality-header">
							<h3>Señales de interés</h3>
							<p>Detalle de tráfico, navegación y contenido que ayuda a explicar la intención.</p>
						</header>
						<div class="commercial-dashboard__grid">
							<section class="dashboard-card">
								<h3>Tráfico</h3>
								<ul class="commercial-dashboard__list">
									{renderList([...presentCommercialAttribution(dashboardData.campaigns).commercial, ...presentCommercialAttribution(dashboardData.campaigns).technical]).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Interacción</h3>
								<ul class="commercial-dashboard__list">
									{renderList([...presentCommercialAttribution(dashboardData.sections, 'Interacción interna / QA').commercial, ...presentCommercialAttribution(dashboardData.sections, 'Interacción interna / QA').technical]).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>CTAs</h3>
								<ul class="commercial-dashboard__list">
									{renderList([...presentCommercialAttribution(dashboardData.topCtas, 'Acciones internas / QA').commercial, ...presentCommercialAttribution(dashboardData.topCtas, 'Acciones internas / QA').technical]).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>

							<section class="dashboard-card">
								<h3>Demos</h3>
								<ul class="commercial-dashboard__list">
									{renderList([...presentCommercialAttribution(dashboardData.topDemos, 'Demos internas / QA').commercial, ...presentCommercialAttribution(dashboardData.topDemos, 'Demos internas / QA').technical]).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>
							<section class="dashboard-card">
								<h3>Desplazamiento</h3>
								<ul class="commercial-dashboard__list">
									{renderList(dashboardData.scrollDepth).map((item) => (
										<li><span>{item.label}</span><strong>{formatCount(item.count)}</strong></li>
									))}
								</ul>
							</section>
						</div>
					</section>
					{((leadChannelAttribution?.technical.length || 0) > 0 || (revenueAttribution?.technical.length || 0) > 0) && (
						<section class="commercial-dashboard__diagnostic-note" aria-labelledby="internal-attribution-title">
							<div>
								<h3 id="internal-attribution-title">Datos internos / QA</h3>
								<p>Se excluyen de la lectura comercial principal y permanecen disponibles solo para diagnóstico.</p>
							</div>
							<div class="commercial-dashboard__diagnostic-values">
								{leadChannelAttribution?.technical.map((item) => <span>{item.label}: {formatCount(item.count)}</span>)}
								{revenueAttribution?.technical.map((item) => <span>{item.label}: {formatCurrency(item.count, 0)}</span>)}
							</div>
						</section>
					)}
					</details>
				</div>

				<div class="tab-content" id="tab-salud" role="tabpanel" aria-labelledby="commercial-tab-salud" tabindex="0" hidden>
					<div class="commercial-context-strip">
						<span class="context-dot">Datos históricos disponibles · Sin filtro activo</span>
						<span>Última actividad: {formatDateTime(dashboardData.dataContext.lastActivityAt)}</span>
						<span>Último tracking: {formatDateTime(dashboardData.dataContext.lastTrackingEventAt)}</span>
						<span>Última actualización: {formatDateTime(dashboardData.dataContext.lastCommercialUpdateAt)}</span>
						<span class="context-note">{dashboardData.dataContext.limitNotice}</span>
					</div>
					<section class="commercial-dashboard__health">
						<header class="commercial-dashboard__quality-header">
							<h3>Diagnóstico del sistema</h3>
							<p>Estado detallado de tracking, CAPI y datos comerciales.</p>
						</header>
						<div class="commercial-dashboard__health-grid">
							<article class="dashboard-card commercial-dashboard__health-card">
								<div class="commercial-dashboard__health-heading">
									<h4>{viewModel.health.tracking.label}</h4>
									<span class:list={['commercial-dashboard__status', `commercial-dashboard__status--${viewModel.health.tracking.status}`]}>
										{labelHealthStatus(viewModel.health.tracking.status)}
									</span>
								</div>
								<p>{viewModel.health.tracking.message}</p>
								<ul class="commercial-dashboard__health-list">
									{viewModel.health.tracking.checks.map((check) => (
										<li>
											<span>{check.label}</span>
											<strong>{check.value}</strong>
											<small>{check.helper}</small>
										</li>
									))}
								</ul>
							</article>

							<article class="dashboard-card commercial-dashboard__health-card">
								<div class="commercial-dashboard__health-heading">
									<h4>{viewModel.health.capi.label}</h4>
									<span class:list={['commercial-dashboard__status', `commercial-dashboard__status--${viewModel.health.capi.status}`]}>
										{labelHealthStatus(viewModel.health.capi.status)}
									</span>
								</div>
								<p>{viewModel.health.capi.message}</p>
								<ul class="commercial-dashboard__health-list commercial-dashboard__health-list--compact">
									{viewModel.health.capi.checks.map((check) => (
										<li>
											<span>{check.label}</span>
											<strong>{check.value}</strong>
										</li>
									))}
								</ul>
							</article>

							<article class="dashboard-card commercial-dashboard__health-card">
								<div class="commercial-dashboard__health-heading">
									<h4>{viewModel.health.commercial.label}</h4>
									<span class:list={['commercial-dashboard__status', `commercial-dashboard__status--${viewModel.health.commercial.status}`]}>
										{labelHealthStatus(viewModel.health.commercial.status)}
									</span>
								</div>
								<p>{viewModel.health.commercial.message}</p>
								<ul class="commercial-dashboard__health-list">
									{viewModel.health.commercial.warnings.length === 0 ? (
										<li>
											<span>Alertas accionables</span>
											<strong>0</strong>
											<small>Sin alertas en los registros cargados.</small>
										</li>
									) : (
										viewModel.health.commercial.warnings.map((warning) => (
											<li>
												<span>{warning.label}</span>
												<strong>{formatCount(warning.count)}</strong>
												<small>{warning.helper}</small>
											</li>
										))
									)}
								</ul>
							</article>
						</div>
					</section>

					<details class="commercial-dashboard__details">
						<summary>Ver detalle técnico de tracking y cola CAPI</summary>
					<section class="commercial-dashboard__quality">
						<header class="commercial-dashboard__quality-header">
							<h3>Calidad del seguimiento</h3>
							<p>Distribución de consentimiento entre eventos persistidos.</p>
						</header>
						<div class="commercial-dashboard__metrics">
							{viewModel.trackingQualityCards.map((card) => (
								<article class:list={['commercial-dashboard__metric', card.muted ? 'commercial-dashboard__metric--muted' : '']}>
									<span>{card.label}</span>
									<strong>{card.value}</strong>
									{card.helper && <small>{card.helper}</small>}
								</article>
							))}
							<article class="commercial-dashboard__metric commercial-dashboard__metric--muted">
								<span>Sesiones internas excluidas</span>
								<strong>{formatCount(dashboardData.totals.internalSessions)}</strong>
							</article>
						</div>
					</section>

					<CapiOutboxPanel client:load initialConversions={initialConversions} deliveryDisabled={viewModel.health.capi.status === 'safe-disabled'} />
					</details>
				</div>
			</>
		)}
	</section>



	<script>
		const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
		const tabContents = document.querySelectorAll('.tab-content');
		const tabs = Array.from(tabButtons);

		const activateTab = (button: HTMLButtonElement) => {
			const tabName = button.getAttribute('data-tab');
			if (!tabName) return;

			tabButtons.forEach((tabButton) => {
				const isActive = tabButton === button;
				tabButton.classList.toggle('active', isActive);
				tabButton.setAttribute('aria-selected', String(isActive));
				tabButton.setAttribute('tabindex', isActive ? '0' : '-1');
			});

			tabContents.forEach((content) => {
				const isActive = content.id === `tab-${tabName}`;
				content.classList.toggle('active', isActive);
				content.toggleAttribute('hidden', !isActive);
			});
		};

		tabButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				activateTab(btn);
			});

			btn.addEventListener('keydown', (event: KeyboardEvent) => {
				if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
				event.preventDefault();
				const currentIndex = tabs.indexOf(btn);
				const nextIndex = event.key === 'Home'
					? 0
					: event.key === 'End'
						? tabs.length - 1
						: (currentIndex + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
				const nextTab = tabs[nextIndex];
				activateTab(nextTab);
				nextTab.focus();
			});
		});

		document.querySelectorAll<HTMLButtonElement>('[data-open-tab]').forEach((trigger) => {
			trigger.addEventListener('click', () => {
				const target = trigger.dataset.openTab;
				const targetButton = tabs.find((tab) => tab.dataset.tab === target);
				if (targetButton) {
					activateTab(targetButton);
					targetButton.focus();
				}
			});
		});
	</script>
</DashboardLayout>
