---
// Short public route: /{slug}. Catalog aliases resolve from static metadata before managed lookup.
// Both forms render through the shared invitation page without changing demo privacy boundaries.
export const prerender = false;

import { findPublishedEventTypeBySlug } from '@/lib/intake/repositories/published-invitation-content.repository';
import { resolveShortRouteEventType } from '@/lib/invitation/short-route';
import { findDemoByRouteSlug } from '@/lib/invitation/demo-routes';

const slug = Astro.params.slug!;
const demo = findDemoByRouteSlug(slug);
if (demo) {
	return Astro.rewrite(`/${demo.eventType}/${encodeURIComponent(demo.slug)}${Astro.url.search}`);
}
const eventType = await resolveShortRouteEventType(slug, findPublishedEventTypeBySlug);

if (!eventType) {
	return new Response(null, { status: 404, headers: { 'Cache-Control': 'no-store, private' } });
}

return Astro.rewrite(`/${eventType}/${encodeURIComponent(slug)}${Astro.url.search}`);
---
