---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import MemoriesRecovery from '@/components/memories/MemoriesRecovery';
import { buildMemoriesRecoveryPageCopy } from '@/lib/memories/copy';
import {
	MEMORIES_ORGANIZER_LOGIN_PATH,
	buildMemoriesPublicPath,
	buildMemoriesRecoveryPath,
} from '@/lib/memories/contract/private-request';
import { resolvePublicMemorySpace } from '@/lib/memories/server/space.service';

Astro.response.headers.set('Cache-Control', 'no-store, private');

const space = await resolvePublicMemorySpace(Astro.params.slug);
if (!space) {
	return new Response(null, { status: 404, headers: { 'Cache-Control': 'no-store, private' } });
}

const copy = buildMemoriesRecoveryPageCopy({ eventTitle: space.eventTitle });
---

<Layout
	title={copy.title}
	description={copy.description}
	hideHeader={true}
	className="theme-preset--jewelry-box-landing"
>
	<meta name="robots" content={copy.robots} slot="head" />

	<main
		class="status-page status-page--memories status-page--recovery"
		data-route={buildMemoriesRecoveryPath(space.publicSlug)}
		data-page="memories-recovery"
	>
		<div class="status-page__bg-decoration"></div>
		<div class="status-page__container">
			<section class="status-page__card" aria-labelledby="recovery-heading">
				<header class="status-page__header">
					<h1 id="recovery-heading" class="status-page__title">{copy.heading}</h1>
					<p class="status-page__description">{copy.body}</p>
				</header>

				<MemoriesRecovery client:load publicSlug={space.publicSlug} />

				<nav class="status-page__support-links" aria-label="Enlaces de ayuda">
					<a href={buildMemoriesPublicPath(space.publicSlug)}>{copy.backLabel}</a>
					<a href={MEMORIES_ORGANIZER_LOGIN_PATH}>{copy.organizerLabel}</a>
				</nav>
			</section>
		</div>
	</main>
</Layout>
