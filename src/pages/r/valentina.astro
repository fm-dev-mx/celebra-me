---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import ValentinaMemoriesCapture from '@/components/memories/ValentinaMemoriesCapture';
import {
	VALENTINA_MEMORIES_ROUTE_PATH,
	valentinaMemoriesPageCopy,
} from '@/data/valentina-memories.data';

const copy = valentinaMemoriesPageCopy;
---

<Layout
	title={copy.title}
	description={copy.description}
	hideHeader={true}
	className="theme-preset--jewelry-box-landing"
>
	<meta name="robots" content={copy.robots} slot="head" />

	<main
		class="status-page status-page--memories"
		data-route={VALENTINA_MEMORIES_ROUTE_PATH}
		data-page="valentina-memories"
	>
		<div class="status-page__bg-decoration"></div>

		<div class="status-page__container">
			<section class="status-page__card" aria-labelledby="memories-heading">
				<header class="status-page__header">
					<span class="status-page__subtitle">{copy.subtitle}</span>
					<h1 id="memories-heading" class="status-page__title">{copy.heading}</h1>
					<p class="status-page__description">{copy.body}</p>
				</header>

				<ValentinaMemoriesCapture client:load />

				<nav class="status-page__support-links" aria-label="Enlaces de ayuda">
					<a href={copy.recoveryCtaHref}>{copy.recoveryCtaLabel}</a>
					<a href={copy.organizerCtaHref}>{copy.organizerCtaLabel}</a>
				</nav>
			</section>
		</div>
	</main>
</Layout>
