---
export const prerender = true;
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/home/Hero.astro';
import ProductProof from '@/components/home/ProductProof.astro';
import LandingShowroom from '@/components/home/LandingShowroom.astro';
import EnvelopeScene from '@/components/home/EnvelopeScene.astro';
import WhatsAppScene from '@/components/home/WhatsAppScene.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import Pricing from '@/components/home/Pricing.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import FAQ from '@/components/home/FAQ.astro';
import Contact from '@/components/home/Contact.astro';
import Footer from '@/components/home/Footer.astro';
import PromoStatus from '@/components/home/PromoStatus.astro';
import StickyWhatsAppBar from '@/components/home/StickyWhatsAppBar.astro';
import { landingData } from '@/data/landing-page.data';
import { footerData } from '@/data/footer.data';
import { VITRINA_EVENTS, findVitrinaDemo, getVitrinaLeadDemo } from '@/data/landing-vitrina.data';
import { buildLandingSchemaJsonLd, DEFAULT_SITE_ORIGIN } from '@/lib/seo/landing-schema';
import '@/styles/landing.scss';

const siteOrigin = DEFAULT_SITE_ORIGIN;
const leadDemo = getVitrinaLeadDemo();
const leadEvent = VITRINA_EVENTS.find((event) => event.publicSlug === leadDemo.publicSlug)!;
// Hero fan: left, right, then the larger center phone (the lead demo).
const heroFan = ['demo-xv-celestial-blue', 'demo-brisa']
	.flatMap((slug) => findVitrinaDemo(slug) ?? [])
	.concat(leadDemo);
const schemaJsonLd = buildLandingSchemaJsonLd(siteOrigin);
---

<Layout
	title={landingData.seo.title}
	description={landingData.seo.description}
	ogTitle={landingData.seo.ogTitle}
	ogDescription={landingData.seo.ogDescription}
	image={landingData.seo.ogImage ?? '/images/og/og-vitrina.jpg'}
	imageAlt="Tres invitaciones digitales de Celebra-me en celulares: XV años y boda"
	canonicalPath="/"
	className="theme-preset--jewelry-box-landing"
	transparentHeader={false}
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaJsonLd)} slot="head"></script>
	<div class="landing-sections-wrapper">
		<Hero data={landingData.hero} fan={heroFan} />
		<LandingShowroom
			events={VITRINA_EVENTS}
			title={landingData.vitrina.title}
			description={landingData.vitrina.description}
		/>
		<EnvelopeScene demo={leadDemo} />
		<WhatsAppScene demo={leadDemo} eventLabel={leadEvent.messageLabel} />
		<ProductProof data={landingData.productProof} />
		<Testimonials data={landingData.testimonials} />
		<Pricing data={landingData.pricing} />
		<HowItWorks data={landingData.howItWorks} />
		<FAQ data={landingData.faq} />
		<Contact data={landingData.contact} />
		{/* The contact section above already carries WhatsApp, email and city. */}
		<Footer data={{ ...footerData, contact: undefined }} />
	</div>
	<StickyWhatsAppBar event={leadEvent} demo={leadDemo} />
	<PromoStatus />
</Layout>
<script>
	import { createIntersectionObserver } from '@/utils/animations';

	const observerOptions = {
		threshold: 0.1,
		rootMargin: '0px 0px -10% 0px',
	};

	createIntersectionObserver('section, .hero-prime', (target) => {
		target.classList.add('is-visible');
	}, observerOptions);

	const html = document.documentElement;

	const syncScrollPadding = () => {
		const currentHeight = getComputedStyle(html).getPropertyValue('--nav-current-height').trim();
		html.style.scrollPaddingTop = currentHeight || '100px';
	};

	syncScrollPadding();
	window.addEventListener('scroll', syncScrollPadding, { passive: true });
</script>
