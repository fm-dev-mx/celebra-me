---
export const prerender = false;

import InvitationSections from '@/components/invitation/InvitationSections.astro';
import { getRoutableEventEntry } from '@/lib/content/events';
import { resolveInvitationContent } from '@/lib/invitation/content-resolver';
import { buildPageContextFromViewModel, prepareInvitationPageContext } from '@/lib/invitation/page-data';
import { resolveRoutePersonalization } from '@/lib/invitation/route-personalization';
import Layout from '@/layouts/Layout.astro';
import '@/styles/invitation.scss';
import Footer from '@/components/invitation/Footer.astro';
import Hero from '@/components/invitation/Hero.astro';
import MusicPlayer from '@/components/invitation/MusicPlayer.astro';
import EventHeader from '@/components/invitation/EventHeader.astro';
import EnvelopeReveal from '@/components/invitation/EnvelopeReveal.astro';
import EditorialCoverReveal from '@/components/invitation/EditorialCoverReveal.astro';
import type { InvitationGuestContext } from '@/lib/invitation/page-data';
import type { InvitationViewModel } from '@/lib/adapters/types';
import type { ThemePreset } from '@/lib/theme/theme-contract';
import { resolvePresetCssUrl } from '@/lib/invitation/preset-css-resolver';
import { resolveInvitationCssUrls } from '@/lib/invitation/section-css-resolver';
import InvitationError from '@/components/invitation/InvitationError.astro';
import { isEventType } from '@/lib/theme/theme-contract';

import { performance } from 'node:perf_hooks';

const slug = Astro.params.slug!;
const eventType = Astro.params.eventType!;

if (!isEventType(eventType)) {
	return new Response(null, { status: 404, headers: { 'Cache-Control': 'no-store, private' } });
}
const inviteId = Astro.url.searchParams.get('invite');
const hasInviteParam = Astro.url.searchParams.has('invite');
const skipEnvelope = Astro.url.searchParams.get('skipEnvelope') === 'true';

// ── Screenshot mode ───────────────────────────────────────────────────
const screenshotMode = Astro.url.searchParams.has('screenshot');
const revealState = Astro.url.searchParams.get('reveal') as 'open' | 'closed' | 'letter' | null;
const animationsOff = screenshotMode || Astro.url.searchParams.has('animations');
const previewState =
	screenshotMode && revealState === 'open'
		? 'opened'
		: screenshotMode && revealState === 'letter'
			? 'letter'
			: undefined;

// Server-Timing instrumentation
let resolveContentDur: number | null = null;
let routePersonalizationDur: number | null = null;
let pagePrepareDur: number | null = null;
const renderStart = performance.now();

let page: ReturnType<typeof prepareInvitationPageContext> | null = null;
let guestContext: InvitationGuestContext | null = null;
let renderError: string | null = null;
let viewModel: InvitationViewModel | null = null;

try {
	const resolveContentStart = performance.now();
	const resolution = await resolveInvitationContent(slug, eventType);
	resolveContentDur = performance.now() - resolveContentStart;

	if (!resolution) {
		Astro.response.status = 404;
		Astro.response.headers.set('Cache-Control', 'no-store, private');
	} else {
		viewModel = resolution.viewModel;
		const currentPathWithQuery = Astro.url.pathname + Astro.url.search;

		let eventEntry: Awaited<ReturnType<typeof getRoutableEventEntry>> = null;
		let routeEventType: string = eventType;
		let routeIsDemo: boolean = false;

		if (resolution.source === 'static') {
			eventEntry = await getRoutableEventEntry(slug, eventType);
			if (!eventEntry) {
				Astro.response.status = 404;
				Astro.response.headers.set('Cache-Control', 'no-store, private');
			} else {
				if (eventType !== eventEntry.data.eventType) {
					const canonicalUrl = new URL(`/${eventEntry.data.eventType}/${slug}`, Astro.url);
					if (inviteId) {
						canonicalUrl.searchParams.set('invite', inviteId);
					}
					Astro.response.headers.set('Cache-Control', 'no-store, private');
					return Astro.redirect(canonicalUrl.href, 301);
				}
				routeEventType = eventEntry.data.eventType;
				routeIsDemo = Boolean(eventEntry.data.isDemo);
			}
		} else {
			routeEventType = (resolution.rawContent?.eventType as string | undefined) ?? eventType;
		}

		if (resolution.source !== 'static' || eventEntry) {
			if (inviteId) {
				const personalizationStart = performance.now();
				const personalization = await resolveRoutePersonalization({
					inviteId,
					currentPathWithQuery,
					routeEventType,
					routeSlug: slug,
					routeIsDemo,
				});
				routePersonalizationDur = performance.now() - personalizationStart;
				if (personalization.redirectPath) {
					Astro.response.headers.set('Cache-Control', 'no-store, private');
					return Astro.redirect(personalization.redirectPath, 302);
				}
				guestContext = personalization.guestContext;
			}

			if (resolution.source === 'static') {
				const prepareStart = performance.now();
				page = prepareInvitationPageContext({
					eventEntry: eventEntry!,
					slug,
					guestContext,
				});
				pagePrepareDur = performance.now() - prepareStart;
			} else {
				const prepareStart = performance.now();
				page = buildPageContextFromViewModel({
					viewModel,
					slug,
					guestContext,
					eventType: routeEventType,
					sectionStyles: resolution.rawContent?.sectionStyles as
						| { footer?: { variant?: ThemePreset } }
						| undefined,
					screenshotMode,
				});
				pagePrepareDur = performance.now() - prepareStart;
			}
		}
	}
} catch (error) {
	console.error(
		`[PublicRoute] Error rendering invitation slug="${slug}" eventType="${eventType}":`,
		error instanceof Error ? error.stack : String(error),
	);
	renderError =
		error instanceof Error ? error.message : 'Error desconocido al cargar la invitación.';
}

const cacheControl =
	!hasInviteParam && !renderError && page && viewModel
		? 'public, max-age=0, s-maxage=0, must-revalidate'
		: 'no-store, private';
Astro.response.headers.set('Cache-Control', cacheControl);

// Render-Timing — always set a simple baseline to confirm header survives Vercel
Astro.response.headers.set('X-Render-Timing', 'active');

// Extended timing header with detailed spans — only for successful pages
if (page && viewModel) {
	try {
		const entries: string[] = [];
		if (resolveContentDur !== null) {
			entries.push(`resolveContent;dur=${resolveContentDur.toFixed(2)}`);
		}
		if (routePersonalizationDur !== null) {
			entries.push(`routePersonalization;dur=${routePersonalizationDur.toFixed(2)}`);
		}
		if (pagePrepareDur !== null) {
			entries.push(`pagePrepare;dur=${pagePrepareDur.toFixed(2)}`);
		}
		entries.push(`total;dur=${(performance.now() - renderStart).toFixed(2)}`);
		Astro.response.headers.set('X-Render-Timing-Detail', entries.join(', '));
	} catch (e) {
		console.warn('[slug] Failed to set timing header:', e);
	}
}

const activePresetUrl = viewModel?.theme?.preset
	? resolvePresetCssUrl(viewModel.theme.preset)
	: undefined;

const activeSectionCssUrls =
	page && viewModel?.theme?.preset
		? resolveInvitationCssUrls({
				themePreset: viewModel.theme.preset,
				footerVariant: page.footerVariant,
				galleryVariant: viewModel.sections.gallery?.variant,
				visualProfileId: viewModel.visualProfileId,
				slug,
			})
		: [];

const headLinks = [
	...(activePresetUrl ? [{ rel: 'stylesheet' as const, href: activePresetUrl }] : []),
	...activeSectionCssUrls.map((href) => ({ rel: 'stylesheet' as const, href })),
	// Google Fonts — Parisienne (script 400) for Romina profile.
	// Other font families are served via @fontsource-variable/* packages.
	{ rel: 'preconnect' as const, href: 'https://fonts.googleapis.com' },
	{ rel: 'preconnect' as const, href: 'https://fonts.gstatic.com' },
	{
		rel: 'stylesheet' as const,
		href: 'https://fonts.googleapis.com/css2?family=Parisienne&display=swap',
	},
];

const wrapperDataAttributes = page
	? {
			...page.wrapper.dataAttributes,
			...(skipEnvelope ? { 'data-reveal-state': 'revealed' } : {}),
		}
	: {};

---

{
	renderError ? (
		<InvitationError />
	) : page && viewModel ? (
		<Layout
			title={page.layout.title}
			description={page.layout.description}
			image={page.layout.image}
			hideHeader={true}
			className={page.layout.className}
			isDemo={page.viewModel.isDemo}
			themeMode="dark"
			headLinks={headLinks}
		>
			<style is:inline lang="scss" set:html={page.wrapper.scopedStyles} />
			{
				animationsOff && (
					<style is:global>
						*, *::before, *::after {
							animation-duration: 0s !important;
							animation-delay: 0s !important;
							transition-duration: 0s !important;
							transition-delay: 0s !important;
							scroll-behavior: auto !important;
						}
					</style>
				)
			}
			<div class={page.wrapper.className} {...wrapperDataAttributes} data-screenshot="invitation-root">
				{
					!skipEnvelope && page.envelope && page.envelope.revealVariant !== 'editorial-cover' && (
						<script is:inline>
							(function() {
								try {
									const script = document.currentScript;
									const wrapper = script ? script.closest('.event-theme-wrapper') : null;
									if (!wrapper) return;
									const slug = wrapper.getAttribute('data-event-slug');
									if (!slug) return;
									const key = 'envelope-opened-' + slug;
									const isDemo = wrapper.getAttribute('data-is-demo') === 'true';
									const force = new URLSearchParams(window.location.search).get('forceEnvelope') === 'true';
									if (!isDemo && !force && window.localStorage.getItem(key) === 'true') {
										wrapper.setAttribute('data-reveal-state', 'revealed');
										const envelope = wrapper.querySelector('ds-envelope-reveal');
										if (envelope) {
											envelope.hidden = true;
										}
										document.documentElement.classList.remove('envelope-open');
									}
								} catch {
									// Ignore localStorage access errors
								}
							})();
						</script>
					)
				}

				{
							skipEnvelope ? null : page.envelope?.revealVariant === 'editorial-cover' ? (
								<EditorialCoverReveal
									coverEdition={page.envelope.coverEdition}
									coverVolume={page.envelope.coverVolume}
									coverIssue={page.envelope.coverIssue}
									microcopy={page.envelope.microcopy}
									eventSlug={page.envelope.eventSlug}
									variant={page.envelope.variant}
									heroName={page.viewModel.hero.name}
									heroSecondaryName={page.viewModel.hero.secondaryName}
									heroLabel={page.viewModel.hero.label}
									heroDate={page.viewModel.hero.date}
									heroVenueName={page.heroVenueName}
									backgroundImage={page.viewModel.hero.backgroundImage}
									portrait={page.viewModel.hero.portrait}
									focalPoint={page.viewModel.hero.focalPoint}
									focalPointMobile={page.viewModel.hero.focalPointMobile}
									previewState={previewState}
								/>
							) : page.envelope ? (
								<EnvelopeReveal
									name={page.envelope.name}
									sealStyle={page.envelope.sealStyle}
									sealIcon={page.envelope.sealIcon}
									sealInitials={page.envelope.sealInitials}
									sealVariant={page.envelope.sealVariant}
									sealColor={page.envelope.sealColor}
									sealImage={page.envelope.sealImage}
									microcopy={page.envelope.microcopy}
									documentLabel={page.envelope.documentLabel}
									stampText={page.envelope.stampText}
									stampYear={page.envelope.stampYear}
									tooltipText={page.envelope.tooltipText}
									eventSlug={page.envelope.eventSlug}
									variant={page.envelope.variant}
									teaserDetails={page.envelope.teaserDetails}
									card={page.envelope.card}
									guestPlacement={page.envelope.guestPlacement}
									previewState={previewState}
								/>
							) : null
						}

						<div data-screenshot="invitation-content">
							<EventHeader
								links={page.viewModel.navigation ?? []}
								variant={page.viewModel.theme.preset}
								initials={page.viewModel.envelope?.data?.sealInitials}
								eventName={page.viewModel.hero?.name}
								eventSubtitle={page.viewModel.hero?.label}
								isDemo={page.viewModel.isDemo}
							/>
						</div>

						<div data-screenshot="invitation-open-content">
							<Hero
								{...page.viewModel.hero}
								venueName={page.heroVenueName}
								time={page.heroTime}
								highPriority={skipEnvelope || !page.wrapper.showEnvelope}
							/>

							<InvitationSections pageContext={page} />

							{
								guestContext && (
									<script>
										import { initEngagementTracking } from '@/lib/invitation/engagement';

										const container = document.getElementById('invitation-sections-container');
										if (container) {
											const inviteId = new URLSearchParams(window.location.search).get('invite');
											const totalSections = parseInt(container.getAttribute('data-total-sections') || '0');

											if (inviteId && totalSections > 0) {
												initEngagementTracking({
													inviteId,
													totalSections,
													throttleMs: 10000
												});
											}
										}
									</script>
								)
							}

							<Footer
								eventSlug={page.viewModel.id}
								showEnvelope={page.wrapper.showEnvelope}
								variant={page.footerVariant}
								closingPhrase={page.footerClosingPhrase}
								showFooterBranding={page.viewModel.brandingVisibility.showFooterBranding}
								showContactCta={page.viewModel.brandingVisibility.showContactCta}
							/>

							{page.viewModel.music && (
								<MusicPlayer
									url={page.viewModel.music.url}
									autoPlay={
										page.viewModel.isDemo && import.meta.env.DEV
											? false
											: page.viewModel.music.autoPlay
									}
									title={page.viewModel.music.title}
									revealMode={page.viewModel.music.revealMode}
									variant={page.viewModel.theme.preset}
								/>
							)}
						</div>
					</div>
		</Layout>
	) : (
		<InvitationError />
	)
}
