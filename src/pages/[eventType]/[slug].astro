---
export const prerender = false;

import InvitationSections from '@/components/invitation/InvitationSections.astro';
import DemoConversion from '@/components/invitation/DemoConversion.astro';
import { hasDemoConversion } from '@/lib/invitation/demo-conversion';
import { getRoutableEventEntry } from '@/lib/content/events';
import { resolvePublicInvitation } from '@/lib/invitation/content-resolver';
import {
	CLIENT_INVITATION_ROBOTS,
	UNAVAILABLE_INVITATION_ROBOTS,
	resolvePublicInvitationMode,
	type PublicInvitationMode,
} from '@/lib/invitation/access/invitation-access';
import PreviewBanner from '@/components/invitation/PreviewBanner.astro';
import { invitationProvenanceReference } from '@/lib/invitation/preview/provenance';
import { buildPageContextFromViewModel, prepareInvitationPageContext } from '@/lib/invitation/page-data';
import { resolveRoutePersonalization } from '@/lib/invitation/route-personalization';
import Layout from '@/layouts/Layout.astro';
import '@/styles/invitation.scss';
import Footer from '@/components/invitation/Footer.astro';
import Hero from '@/components/invitation/Hero.astro';
import MusicPlayer from '@/components/invitation/MusicPlayer.astro';
import EventHeader from '@/components/invitation/EventHeader.astro';
import InvitationRevealEntry from '@/components/invitation/InvitationRevealEntry.astro';
import InvitationPageScripts from '@/components/invitation/InvitationPageScripts.astro';
import type { InvitationGuestContext } from '@/lib/invitation/page-data';
import type { InvitationViewModel } from '@/lib/adapters/types';
import { buildInvitationHeadLinks } from '@/lib/invitation/invitation-head-links';
import InvitationError from '@/components/invitation/InvitationError.astro';
import InvitationUnavailable from '@/components/invitation/InvitationUnavailable.astro';
import InvitationDeferredCssPromotion from '@/components/invitation/InvitationDeferredCssPromotion.astro';
import { isEventType } from '@/lib/theme/theme-contract';

const slug = Astro.params.slug!;
const eventType = Astro.params.eventType!;

if (!isEventType(eventType)) {
	return new Response(null, { status: 404, headers: { 'Cache-Control': 'no-store, private' } });
}
const inviteId = Astro.url.searchParams.get('invite');
const hasInviteParam = Astro.url.searchParams.has('invite');
const skipEnvelope = Astro.url.searchParams.get('skipEnvelope') === 'true';

// ── Screenshot mode ───────────────────────────────────────────────────
const screenshotMode = Astro.url.searchParams.has('screenshot');
const revealState = Astro.url.searchParams.get('reveal') as 'open' | 'closed' | 'letter' | null;
const animParam = Astro.url.searchParams.get('animations');
const animationsOff = screenshotMode || animParam === 'false' || animParam === 'off';
const previewState =
	screenshotMode && revealState === 'open'
		? 'opened'
		: screenshotMode && revealState === 'letter'
			? 'letter'
			: undefined;

let page: ReturnType<typeof prepareInvitationPageContext> | null = null;
let guestContext: InvitationGuestContext | null = null;
let renderError: string | null = null;
let viewModel: InvitationViewModel | null = null;
let contentSource: 'static' | 'published' | null = null;
let contentVersion: number | null = null;
let accessMode: PublicInvitationMode | null = null;
let provenanceReference: string | null = null;

try {
	const resolution = await resolvePublicInvitation(slug, eventType);
	contentSource = resolution && resolution.source !== 'unavailable' ? resolution.source : null;
	contentVersion = resolution?.source === 'published' ? resolution.version : null;
	accessMode =
		resolution?.source === 'published' ? resolvePublicInvitationMode(resolution.access) : null;
	provenanceReference =
		resolution?.source === 'published'
			? invitationProvenanceReference(resolution.invitationId)
			: null;

	if (!resolution) {
		Astro.response.status = 404;
		Astro.response.headers.set('Cache-Control', 'no-store, private');
	} else if (resolution.source === 'unavailable') {
		// Disabled by the administrator: neutral page, no personalization lookup.
		Astro.response.status = 403;
		Astro.response.headers.set('Cache-Control', 'no-store, private');
	} else {
		viewModel = resolution.viewModel;
		const currentPathWithQuery = Astro.url.pathname + Astro.url.search;

		let eventEntry: Awaited<ReturnType<typeof getRoutableEventEntry>> = null;
		let routeEventType: string = eventType;
		let routeIsDemo: boolean = false;

		if (resolution.source === 'static') {
			eventEntry = await getRoutableEventEntry(slug, eventType);
			if (!eventEntry) {
				Astro.response.status = 404;
				Astro.response.headers.set('Cache-Control', 'no-store, private');
			} else {
				if (eventType !== eventEntry.data.eventType) {
					const canonicalUrl = new URL(`/${eventEntry.data.eventType}/${slug}`, Astro.url);
					if (inviteId) {
						canonicalUrl.searchParams.set('invite', inviteId);
					}
					Astro.response.headers.set('Cache-Control', 'no-store, private');
					return Astro.redirect(canonicalUrl.href, 301);
				}
				routeEventType = eventEntry.data.eventType;
				routeIsDemo = Boolean(eventEntry.data.isDemo);
			}
		} else {
			routeEventType = (resolution.rawContent?.eventType as string | undefined) ?? eventType;
		}

		if (resolution.source !== 'static' || eventEntry) {
			if (inviteId) {
				const personalization = await resolveRoutePersonalization({
					inviteId,
					currentPathWithQuery,
					routeEventType,
					routeSlug: slug,
					routeIsDemo,
				});
				if (personalization.redirectPath) {
					Astro.response.headers.set('Cache-Control', 'no-store, private');
					return Astro.redirect(personalization.redirectPath, 302);
				}
				guestContext = personalization.guestContext;
			}

			if (resolution.source === 'static') {
				page = prepareInvitationPageContext({
					eventEntry: eventEntry!,
					guestContext,
				});
			} else {
				page = buildPageContextFromViewModel({
					viewModel,
					guestContext,
					eventType: routeEventType,
					screenshotMode,
				});
			}
		}
	}
} catch (error) {
	console.error(
		`[PublicRoute] Error rendering invitation slug="${slug}" eventType="${eventType}":`,
		error instanceof Error ? error.stack : String(error),
	);
	renderError =
		error instanceof Error ? error.message : 'Error desconocido al cargar la invitación.';
}

const cacheControl =
	!hasInviteParam && !renderError && page && viewModel
		? 'public, max-age=0, s-maxage=0, must-revalidate'
		: 'no-store, private';
Astro.response.headers.set('Cache-Control', cacheControl);

// Client invitations carry private event data: never indexed. The neutral page
// (disabled, archived, nonexistent) is not indexed either. Demos stay indexable.
const isClientInvitation = contentSource === 'published' && Boolean(page && viewModel);
const isUnavailablePage = !renderError && !(page && viewModel);
const robotsPolicy = isUnavailablePage
	? UNAVAILABLE_INVITATION_ROBOTS
	: isClientInvitation
		? CLIENT_INVITATION_ROBOTS
		: undefined;
if (robotsPolicy) Astro.response.headers.set('X-Robots-Tag', robotsPolicy);

const forceBlockingInvitationCss =
	skipEnvelope || screenshotMode || !page?.wrapper.showEnvelope || !page?.envelope;

const headLinks = page
	? buildInvitationHeadLinks({ page, forceBlocking: forceBlockingInvitationCss })
	: [];

const wrapperDataAttributes = page
	? {
			...page.wrapper.dataAttributes,
			...(skipEnvelope ? { 'data-reveal-state': 'revealed' } : {}),
			...(contentSource ? { 'data-content-source': contentSource } : {}),
			...(contentSource === 'published' && contentVersion !== null
				? { 'data-content-version': String(contentVersion) }
				: {}),
			...(accessMode ? { 'data-access-mode': accessMode } : {}),
			// Opaque per-invitation fingerprint: survives copies of the markup, never the id.
			...(provenanceReference ? { 'data-cm-ref': provenanceReference } : {}),
		}
	: {};

const isDemoConversion = Boolean(
	page && hasDemoConversion(page.viewModel.id, page.viewModel.isDemo),
);

// Unpaid client invitation: preview banner and image copy friction.
const previewMode = accessMode === 'preview' && Boolean(page);

---

{
	renderError ? (
		<InvitationError />
	) : page && viewModel ? (
		<Layout
			title={page.layout.title}
			description={page.layout.description}
			image={page.layout.image}
			robots={isClientInvitation ? CLIENT_INVITATION_ROBOTS : undefined}
			hideHeader={true}
			className={page.layout.className}
			isDemo={page.viewModel.isDemo}
			themeMode="dark"
			headLinks={headLinks}
		>
			<InvitationDeferredCssPromotion
				slot="head"
				eventSlug={slug}
				isDemo={page.viewModel.isDemo}
			/>
			<style is:inline lang="scss" set:html={page.wrapper.scopedStyles} />
			{
				animationsOff && (
					<style is:global>
						*, *::before, *::after {
							animation-duration: 0s !important;
							animation-delay: 0s !important;
							transition-duration: 0s !important;
							transition-delay: 0s !important;
							scroll-behavior: auto !important;
						}
					</style>
				)
			}
			<div class={page.wrapper.className} {...wrapperDataAttributes} data-screenshot="invitation-root">
				{previewMode && <PreviewBanner />}
				{
					previewMode && (
						<script is:inline>
							// Unpaid preview: no right-click save or drag of photos (keyboard, text and zoom untouched).
							(function() {
								const block = (event) => {
									const target = event.target;
									if (target instanceof Element && target.closest('img, picture')) event.preventDefault();
								};
								document.addEventListener('contextmenu', block);
								document.addEventListener('dragstart', block);
							})();
						</script>
					)
				}
				<InvitationPageScripts />
				{
					!skipEnvelope && page.envelope && page.envelope.revealVariant !== 'editorial-cover' && (
						<script is:inline>
							(function() {
								try {
									const script = document.currentScript;
									const wrapper = script ? script.closest('.event-theme-wrapper') : null;
									if (!wrapper) return;
									const slug = wrapper.getAttribute('data-event-slug');
									if (!slug) return;
									const key = 'envelope-opened-' + slug;
									const isDemo = wrapper.getAttribute('data-is-demo') === 'true';
									const force = new URLSearchParams(window.location.search).get('forceEnvelope') === 'true';
									if (!isDemo && !force && window.localStorage.getItem(key) === 'true') {
										wrapper.setAttribute('data-reveal-state', 'revealed');
										const envelope = wrapper.querySelector('ds-envelope-reveal');
										if (envelope) {
											envelope.hidden = true;
										}
										document.documentElement.classList.remove('envelope-open');
									}
								} catch {
									// Ignore localStorage access errors
								}
							})();
						</script>
					)
				}

				{!skipEnvelope && <InvitationRevealEntry page={page} previewState={previewState} />}

						<div data-screenshot="invitation-content">
							<EventHeader
								links={page.viewModel.navigation ?? []}
								variant="standard"
								initials={page.viewModel.envelope?.data?.sealInitials}
								eventName={page.viewModel.hero?.name}
								eventSubtitle={page.viewModel.hero?.label}
								isDemo={page.viewModel.isDemo}
							/>
						</div>

						<div data-screenshot="invitation-open-content">
							<Hero
								{...page.viewModel.hero}
								venueName={page.heroVenueName}
								time={page.heroTime}
								editionMark={page.edition?.mark}
								highPriority={true}
							/>

							<InvitationSections
								pageContext={page}
								showDemoConversion={isDemoConversion}
							/>

							{
								guestContext && (
									<script>
										import { initInvitationAnalytics } from '@/lib/invitation/invitation-analytics';

										const container = document.getElementById('invitation-sections-container');
										if (container) {
											const inviteId = new URLSearchParams(window.location.search).get('invite');
											const totalSections = parseInt(container.getAttribute('data-total-sections') || '0');

											if (inviteId && totalSections > 0) {
												initInvitationAnalytics({ inviteId, totalSections, sectionsRoot: container });
											}
										}
									</script>
								)
							}

							<Footer
								class={isDemoConversion ? 'demo-conversion-farewell' : undefined}
								eventSlug={page.viewModel.id}
								showEnvelope={page.wrapper.showEnvelope}
								variant="standard"
								closingPhrase={page.footerClosingPhrase}
								showFooterBranding={page.viewModel.brandingVisibility.showFooterBranding && !isDemoConversion}
								showContactCta={page.viewModel.brandingVisibility.showContactCta && !isDemoConversion}
							/>
							{isDemoConversion && <DemoConversion placement="closing" />}

							{page.musicPlayer && <MusicPlayer {...page.musicPlayer} />}
						</div>
					</div>
		</Layout>
	) : (
		<InvitationUnavailable />
	)
}
