---
export const prerender = false;

import { resolvePublicSiteOrigin } from '@/lib/invitation/social-metadata';
import {
  buildShortIdEarlyResponse,
  resolveShortIdPage,
} from '@/lib/invitation/short-id-resolver';
import InvitationOGShell from '@/layouts/InvitationOGShell.astro';

const { shortId } = Astro.params;

const result = await resolveShortIdPage(shortId, Astro.request, resolvePublicSiteOrigin());
const earlyResponse = buildShortIdEarlyResponse(result, Astro.response);
if (earlyResponse) return earlyResponse;
---

<InvitationOGShell result={result} />
