---
import Layout from '@/layouts/Layout.astro';
import Logo from '@/components/ui/Logo.astro';
import LoginFlowBehavior from '@/components/behavior/LoginFlowBehavior';
import { resolveNextPath } from '@/lib/rsvp/auth/login';
import '@/styles/auth.scss';
import '@/styles/auth/_login.scss';

const next = resolveNextPath(Astro.url.searchParams.get('next'), '/dashboard/invitados');
---

<Layout
	title="Acceso de Anfitrión | Celebra-me"
	description="Espacio privado de gestión para su evento. Inicie sesión para administrar sus invitados y confirmar asistencias en tiempo real."
	image="/images/og/og-login.jpg"
	imageAlt="Acceso de Anfitrión - Espacio privado de gestión para su evento"
	robots="noindex, nofollow"
	hideHeader={true}
	className="theme-preset--auth-dark"
>
	<section class="auth-shell" data-next={next} data-variant="dark">
		<header class="auth-local-header">
			<a class="auth-brand" href="/" aria-label="Volver al inicio de Celebra-me">
				<Logo variant="white" class="auth-brand__logo" altText="Celebra-me" />
				<span class="auth-brand__caption">Panel de anfitrión</span>
			</a>
			<a class="auth-back-link" href="/">Volver al inicio</a>
		</header>

		<article class="auth-card" aria-labelledby="auth-title">
			{Astro.url.searchParams.get('reason') === 'account_access_incomplete' && (
				<p class="auth-status" role="alert" data-tone="error">Su cuenta requiere que el administrador complete el acceso. Comuníquese con él para continuar.</p>
			)}
			<div class="auth-copy">
				<p class="auth-kicker">Acceso seguro para anfitriones</p>
				<h1 id="auth-title">Acceda a su panel</h1>
				<p>Gestione su evento en un solo lugar.</p>
			</div>

			<section id="panel-login" class="auth-panel">
				<form id="login-form" class="auth-form" method="post" novalidate>
					<div class="auth-field">
						<label for="login-method">¿Cómo desea ingresar?</label>
						<select id="login-method" name="method">
							<option value="password">Correo o usuario + contraseña</option>
							<option value="magic_link">Magic Link</option>
						</select>
						<p id="login-method-help" class="auth-hint" aria-live="polite"></p>
					</div>

					<div class="auth-field">
						<label for="login-email">Correo electrónico o usuario</label>
						<input
							id="login-email"
							name="email"
							type="text"
							autocomplete="username"
							placeholder="su-correo@ejemplo.com o su-usuario"
						/>
						<p id="login-email-error" class="field-error" aria-live="polite"></p>
					</div>

					<div id="login-password-wrap" class="auth-field">
						<label for="login-password">Contraseña</label>
						<input
							id="login-password"
							name="password"
							type="password"
							autocomplete="current-password"
						/>
						<p id="login-password-error" class="field-error" aria-live="polite"></p>
					</div>

					<button id="login-submit" type="submit" class="auth-submit" disabled>Continuar</button>
				</form>
			</section>

			<p id="auth-status" class="auth-status" role="status" aria-live="polite" tabindex="-1"></p>
			<noscript>
				<p>Para iniciar sesión, active JavaScript en su navegador.</p>
			</noscript>
		</article>
	</section>

	<LoginFlowBehavior client:only="react" />
</Layout>
