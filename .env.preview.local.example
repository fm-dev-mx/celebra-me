# ==============================================================================
# Preview operational secrets template (gitignored copy: .env.preview.local)
# ==============================================================================
# Copy to .env.preview.local and fill real Preview values only.
# Never put Production secrets, PROD_DB_URL, or Production project refs here.
#
# Canonical Preview Supabase project ref: iwipdvisoyerfdytuhwi
# SSOT for URL / DB URL / service_role: Supabase Dashboard of that project.
# See docs/env-workflow.md and docs/database-workflow.md.
#
# Notes:
# - Prefer PREVIEW_* names below for local scripts (invitation:update, db:preview:*).
# - `vercel env pull --environment=preview` may write SUPABASE_* aliases and can
#   redact Sensitive values as [SENSITIVE]. Replace those placeholders with the
#   real Preview service_role from Supabase before running local apply/upload.
# - Do not commit .env.preview.local (.env.*.local is gitignored).
# ==============================================================================

# ------------------------------------------------------------------------------
# Preferred Preview operational inputs (scripts/db + invitation:update)
# ------------------------------------------------------------------------------
# Paste the Preview Database URL from Supabase (must contain project ref iwipdvisoyerfdytuhwi).
PREVIEW_DB_URL=postgresql://postgres.iwipdvisoyerfdytuhwi:REPLACE_WITH_PREVIEW_DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres
PREVIEW_SUPABASE_URL=https://iwipdvisoyerfdytuhwi.supabase.co
PREVIEW_SUPABASE_SERVICE_ROLE_KEY=preview-service-role-key-placeholder

# ------------------------------------------------------------------------------
# Optional aliases (accepted by some loaders / Vercel Preview pulls)
# ------------------------------------------------------------------------------
# Keep these on the same Preview project as PREVIEW_* above.
# SUPABASE_URL=https://iwipdvisoyerfdytuhwi.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=preview-service-role-key-placeholder
# PUBLIC_SUPABASE_URL=https://iwipdvisoyerfdytuhwi.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=preview-anon-key-placeholder
# SUPABASE_ANON_KEY=preview-anon-key-placeholder

# ------------------------------------------------------------------------------
# Preview app/runtime guards (Vercel Preview only — never Production)
# ------------------------------------------------------------------------------
PREVIEW_MFA_BYPASS=false
PREVIEW_ADMIN_EMAILS=
