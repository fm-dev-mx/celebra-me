# ==============================================================================
# Celebra-me Preview lane template (copy to .env.preview.local)
# ==============================================================================
# Names only. Put real values in the ignored .env.preview.local and never commit them.
# The F11/F12 lanes overlay this file on .env.local; Preview DB workflows read it too.
# `pnpm ops:cloudflare:preview:secrets` uploads the allow-listed names below to the
# Cloudflare Preview Worker (allow-list: scripts/ops/cloudflare-worker-secrets.ts).
# Never put Production refs, URLs, or keys here. Every name needs a comment;
# `pnpm env:audit` checks it. See docs/env-workflow.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# Lane runtime (local processes only; the Worker sets its own identity in wrangler.jsonc)
# ------------------------------------------------------------------------------
# Makes a local Astro process talk to the Preview database. Never uploaded.
CELEBRA_RUNTIME_TARGET=preview

# ------------------------------------------------------------------------------
# Preview Supabase (required by the Preview lane)
# ------------------------------------------------------------------------------
# Preview project API URL, server and browser copies. Worker `vars`, never uploaded.
SUPABASE_URL=https://iwipdvisoyerfdytuhwi.supabase.co
PUBLIC_SUPABASE_URL=https://iwipdvisoyerfdytuhwi.supabase.co
# Preview anon key, server and browser copies.
SUPABASE_ANON_KEY=
PUBLIC_SUPABASE_ANON_KEY=
# Preview service-role key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Preview DB workflows (operational scripts only; never uploaded)
# ------------------------------------------------------------------------------
# Postgres connection string of the Preview project (migrations, audits, syncs).
PREVIEW_DB_URL=
# Preview API URL and service-role key for the invitation sync and purge scripts.
PREVIEW_SUPABASE_URL=https://iwipdvisoyerfdytuhwi.supabase.co
PREVIEW_SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Admin and auth
# ------------------------------------------------------------------------------
# Comma-separated super admins; the first entry is the project owner (owner review).
SUPER_ADMIN_EMAILS=
# Signs trusted-device cookies; independent from the Local value.
TRUST_DEVICE_SECRET=
# Days a trusted device skips MFA.
TRUST_DEVICE_MAX_AGE_DAYS=30
# true forces a fresh MFA check before admin actions; empty means false.
REQUIRE_FRESH_MFA_FOR_ADMIN=
# Guarded MFA bypass for the hosted Preview deployment only (CELEBRA_DEPLOY_ENV=preview,
# built from develop). Requires the email in PREVIEW_ADMIN_EMAILS. Never in Production.
PREVIEW_MFA_BYPASS=false
PREVIEW_ADMIN_EMAILS=
# Optional: seals unpaid preview photo URLs; derived from the service-role key when empty.

# ------------------------------------------------------------------------------
# Event memories (guest photo/video QR) — staging Workers
# ------------------------------------------------------------------------------
# Staging key pair, independent from Local and Production.
MEMORIES_UPLOAD_REQUEST_SIGNING_PRIVATE_KEY=
MEMORIES_RETRIEVAL_REQUEST_SIGNING_PRIVATE_KEY=
# Origins of the staging Sign and Retrieval Workers.
MEMORIES_PRIVATE_UPLOAD_ORIGIN=
MEMORIES_PRIVATE_RETRIEVAL_ORIGIN=
# HMAC key (>= 32 random bytes) that signs shared gallery links.
MEMORIES_SHARE_SECRET=

# ------------------------------------------------------------------------------
# Contact
# ------------------------------------------------------------------------------
# WhatsApp number (country code, digits only) behind the site contact buttons.
CONTACT_WHATSAPP=

# ------------------------------------------------------------------------------
# Platform usage console (read-only; deployments read the plain names)
# ------------------------------------------------------------------------------
# Cloudflare account and Account Analytics: Read token. Optional.
MEMORIES_CLOUDFLARE_ACCOUNT_ID=
MEMORIES_CLOUDFLARE_ANALYTICS_TOKEN=
# Staging R2 bucket whose usage the console reports.
MEMORIES_R2_BUCKET_NAME=
# Supabase Management token (analytics_usage_read + infra_disk_config_read). Optional.
SUPABASE_MANAGEMENT_TOKEN=
# Non-secret Preview project ref shown on the console.
SUPABASE_PROJECT_REF_PREVIEW=iwipdvisoyerfdytuhwi

# ------------------------------------------------------------------------------
# Analytics and Meta (Preview keeps CAPI in test or disabled mode)
# ------------------------------------------------------------------------------
# GA4 Measurement ID; empty disables GA4 on Preview.
PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel id and switch.
PUBLIC_META_PIXEL_ID=
PUBLIC_META_PIXEL_ENABLED=false
# CAPI delivery mode: disabled | test. Token and pixel id only when the mode is test.
META_CAPI_DELIVERY_MODE=disabled
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
# Meta Events Manager → Test Events code for test mode.
META_TEST_EVENT_CODE=
