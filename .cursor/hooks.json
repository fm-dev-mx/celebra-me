{
	"version": 1,
	"hooks": {
		"sessionStart": [
			{
				"command": "node .cursor/hooks/session-start.mjs",
				"failClosed": false
			}
		],
		"preToolUse": [
			{
				"command": "npx --no-install tsx .cursor/hooks/pre-tool-use-agent-context.ts",
				"matcher": "Shell",
				"failClosed": false
			}
		],
		"beforeShellExecution": [
			{
				"command": "npx --no-install tsx .cursor/hooks/before-shell-production.ts",
				"matcher": "supabase|psql|PROD_DB_URL|ineitkdkyrxqyressllp|prod:apply|production-apply-cli|db:migrate|migrate-cli|db:prod:patch|run-prod-patch|invitation:release|invitation-release-cli|invitation:romina-draft-reset|romina-draft-reset-cli|invitation:draft-canonicalize|draft-canonicalization-cli|invitation:draft-restore|draft-restore-cli",
				"failClosed": true
			}
		],
		"beforeMCPExecution": [
			{
				"command": "npx --no-install tsx .cursor/hooks/before-mcp-production.ts",
				"failClosed": true
			}
		]
	}
}
