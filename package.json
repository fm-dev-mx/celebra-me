{
	"name": "celebra-me.com",
	"type": "module",
	"version": "0.15.0-beta.1",
	"engines": {
		"node": ">=22.12.0 <25"
	},
	"packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
	"scripts": {
		"dev": "astro dev",
		"build": "pnpm type-check && pnpm build:app",
		"build:app": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test": "jest",
		"test:changed": "node scripts/run-related-tests.mjs",
		"test:coverage": "jest --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ci": "playwright test tests/e2e/landing.page.regressions.spec.ts tests/e2e/demo-routing-parity.spec.ts tests/e2e/invitation-route-isolation.spec.ts",
		"test:e2e:landing": "playwright test tests/e2e/landing.page.regressions.spec.ts",
		"test:e2e:ga4": "playwright test --config=playwright.ga4.config.ts",
		"test:e2e:preview": "playwright test --config=playwright.preview.config.ts",
		"test:e2e:preview:public": "playwright test --config=playwright.preview-public.config.ts",
		"test:e2e:preview:provision": "playwright test --config=playwright.preview-provision.config.ts",
		"test:e2e:preview:publish": "playwright test --config=playwright.preview-publication.config.ts",
		"test:e2e:infra": "node scripts/run-e2e-tier.mjs infra",
		"test:e2e:visual": "node scripts/run-e2e-tier.mjs visual",
		"type-check": "astro check && tsc --noEmit -p tsconfig.json",
		"ci": "pnpm type-check && pnpm validate:structure && pnpm lint && pnpm lint:styles && pnpm validate:ui-governance && pnpm validate:event-parity && pnpm validate:no-pii && pnpm test && pnpm test:e2e:ci && pnpm build:app && pnpm agent:git-safety:check",
		"ci:quick": "node scripts/ci-quick.mjs",
		"ci:diagnose": "node scripts/ci-diagnose.mjs",
		"validate:staged": "node scripts/validate-staged.mjs",
		"validate:changed": "node scripts/validate-changed.mjs",
		"validate:structure": "node scripts/validate-structure.mjs",
		"lint": "eslint .",
		"lint:styles": "stylelint \"src/**/*.scss\"",
		"lint:styles:changed": "node scripts/lint-styles-changed.mjs",
		"validate:ui-governance": "node scripts/validate-ui-governance.mjs",
		"validate:no-pii": "node scripts/validate-no-real-pii-in-content.mjs",
		"lint-staged": "lint-staged",
		"commitlint": "commitlint",
		"prepare": "husky",
		"db:migrate:new": "supabase migration new",
		"db:push": "node scripts/db/blocked-db-push.mjs",
		"db:local:reset": "echo 'BLOCKED: Use db:disposable:reset for destructive tests.' && exit 1",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:local:refresh-from-prod": "echo 'BLOCKED: pnpm db:local:refresh-from-prod runs supabase db reset. Use pnpm db:prod:backup + pnpm db:local:restore-from-dump instead.' && exit 1",
		"db:local:backup-wip": "tsx scripts/db/backup-local-wip.ts",
		"db:local:bootstrap-admin": "tsx scripts/db/bootstrap-local-admin.ts",
		"db:local:reset-ready": "echo 'BLOCKED: db:local:reset runs supabase db reset which is destructive. Use pnpm db:prod:backup + pnpm db:local:restore-from-dump instead.' && exit 1",
		"db:local:validate": "tsx scripts/db/validate-local-db.ts",
		"db:prod:backup": "tsx scripts/db/db-guard.ts check --target production --operation backup && tsx scripts/db/backup-prod.ts",
		"db:backup:verify-manifest": "tsx scripts/db/verify-backup-manifest.ts",
		"db:backup:create-manifest": "tsx scripts/db/create-backup-manifest.ts",
		"db:restore:verify-disposable": "tsx scripts/db/disposable-restore-verify.ts",
		"db:prod:migrate": "tsx scripts/db/db-guard.ts check --target production --operation migrate && tsx scripts/db/push-prod-migrations.ts",
		"db:prod:audit": "tsx scripts/db/db-guard.ts check --target production --operation audit && tsx scripts/db/audit-db.ts --target production",
		"db:preview:migrate": "tsx scripts/db/db-guard.ts check --target preview --operation migrate && tsx scripts/db/push-preview-migrations.ts",
		"db:preview:audit": "tsx scripts/db/db-guard.ts check --target preview --operation audit && tsx scripts/db/audit-db.ts --target preview",
		"db:preview:sync-invitations": "tsx scripts/db/db-guard.ts check --target preview --operation sync-invitations --db-url \"${PREVIEW_DB_URL}\" && tsx scripts/db/preview-sync-invitations.ts",
		"db:local:migrate": "tsx scripts/db/apply-local-migrations.ts",
		"db:local:audit": "tsx scripts/db/db-guard.ts check --target persistent-local --operation audit && tsx scripts/db/audit-db.ts --target persistent-local",
		"db:branch:parity": "tsx scripts/db/branch-migration-parity.ts",
		"db:branch:diagnose": "tsx scripts/db/branch-lane-diagnose.ts",
		"db:branch:remediate-disposable": "tsx scripts/db/branch-lane-disposable-remediate.ts",
		"db:disposable:start": "tsx scripts/db/disposable-test-env.ts start",
		"db:disposable:reset": "tsx scripts/db/disposable-test-env.ts reset",
		"db:disposable:test": "tsx scripts/db/disposable-test-env.ts run-tests",
		"db:validate:pipeline": "tsx scripts/db/validate-pipeline.ts",
		"db:local:refresh-from-prod-preserve-local": "echo 'BLOCKED: pnpm db:local:refresh-from-prod-preserve-local runs supabase db reset. Use pnpm db:prod:backup + pnpm db:local:restore-from-dump instead.' && exit 1",
		"db:prod:patch": "tsx scripts/db/run-prod-patch.ts",
		"db:sql:lint": "tsx scripts/db/lint-sql.ts",
		"ops": "node scripts/cli.mjs",
		"agent:git-safety:check": "node scripts/agent/git-safety.mjs check",
		"agent:git-safety:end": "node scripts/agent/git-safety.mjs end",
		"agent:git-safety:start": "node scripts/agent/git-safety.mjs start",
		"validate:event-parity": "tsx scripts/validate-event-parity.ts --allowMissingDb",
		"invitation:update": "tsx scripts/provision/invitation-update-cli.ts",
		"screenshot": "tsx scripts/screenshot/cli.ts",
		"screenshot:interactive": "tsx scripts/screenshot/cli.ts --interactive",
		"screenshot:invite": "tsx scripts/screenshot/cli.ts --type=invitation",
		"db:local:restore-from-dump": "tsx scripts/db/local-restore-from-dump.ts",
		"db:prod:export-auth": "tsx scripts/db/db-guard.ts check --target production --operation export-auth --db-url \"${PROD_DB_URL}\" && tsx scripts/db/export-auth-users.ts",
		"db:prod:export-storage": "tsx scripts/db/db-guard.ts check --target production --operation export-storage --db-url \"${PROD_DB_URL}\" && tsx scripts/db/export-storage.ts",
		"db:prod:backup:critical": "tsx scripts/db/db-guard.ts check --target production --operation backup && tsx scripts/db/backup-critical-production.ts",
		"db:backup:create-disposable-fixture": "tsx scripts/db/create-disposable-recovery-backup.ts",
		"db:contract:verify": "tsx scripts/db/verify-mutation-schema-contract.ts"
	},
	"dependencies": {
		"@astrojs/vercel": "11.0.3",
		"@fontsource-variable/bodoni-moda": "^5.3.0",
		"@fontsource-variable/cinzel": "^5.3.0",
		"@fontsource-variable/cormorant-garamond": "^5.3.0",
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/pinyon-script": "^5.3.0",
		"@fontsource/special-elite": "^5.3.0",
		"@fontsource/the-nautigal": "^5.3.0",
		"@supabase/supabase-js": "^2.110.8",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"cloudinary": "^2.10.0",
		"date-fns-tz": "3.2.0",
		"framer-motion": "^12.42.2",
		"nodemailer": "^9.0.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sanitize-html": "^2.17.6",
		"sharp": "^0.35.3",
		"vercel": "^57.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/react": "6.0.1",
		"@astrojs/sitemap": "^3.7.3",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@inquirer/prompts": "^8.5.2",
		"@playwright/test": "^1.62.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.1",
		"@types/nodemailer": "8.0.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/sanitize-html": "^2.16.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"astro": "7.1.3",
		"astro-eslint-parser": "^3.0.0",
		"astro-robots-txt": "^1.0.0",
		"eslint": "^10.8.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-astro": "^3.0.1",
		"eslint-plugin-boundaries": "^7.1.0",
		"eslint-plugin-import-x": "^4.17.1",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"lint-staged": "17.2.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"sass-embedded": "^1.100.0",
		"stylelint": "17.14.1",
		"stylelint-config-standard-scss": "^17.0.0",
		"supabase": "2.109.1",
		"ts-jest": "^29.4.12",
		"tsx": "^4.23.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "^8.65.0"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs}": [
			"eslint --fix --cache",
			"prettier --write"
		],
		"*.astro": [
			"eslint --fix --cache",
			"prettier --write"
		],
		"*.{scss,css}": [
			"stylelint --fix --cache",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	}
}
