# Every text file is LF in the index and in every checkout, regardless of core.autocrlf: Prettier,
# lint-staged and the Linux visual-parity runtime all expect LF, and content hashes (CSS fingerprint,
# SQL digests) must not depend on the host.
* text=auto eol=lf
tests/e2e/visual-baselines/**/*.png filter=lfs diff=lfs merge=lfs -text
