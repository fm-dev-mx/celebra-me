{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "scripts/check-links.mjs",
        "scripts/validate-schema.mjs",
        "scripts/agent/worktree-status.ts",
        "scripts/agent/worktree-doctor.ts",
        "scripts/ops/vercel-ignore-build.mjs",
        "scripts/playwright/canonical-fixture-server.ts",
        "scripts/provision/print-canonical-status.ts",
        "scripts/db/_check-admin-login.mjs",
        "scripts/db/_check-asset-api.mjs",
        "scripts/db/run-command-sequences-worker.cjs",
        "scripts/db/test-asset-loader.mjs",
        "scripts/db/publication-application-flow.ts",
        "scripts/db/publication-concurrency-test.ts",
        "scripts/db/publication-stale-baseline-test.ts",
        "scripts/db/memories-concurrency-test.ts",
        "scripts/db/system-concurrency-test.ts",
        "src/assets/images/events/*/index.ts",
        "jest.*.config.cjs",
        ".cursor/hooks/*.{ts,mjs}",
        "playwright*.config.ts",
        "tests/e2e/**/*.{spec,test}.ts",
        "tests/e2e/harness/visual-record-teardown.ts",
        "tests/e2e/harness/visual-environment-preflight.ts"
    ],
    "project": [
        "src/**/*.{ts,tsx,astro,mjs,js}",
        "scripts/**/*.{ts,mjs,cjs,js}",
        "tests/**/*.{ts,tsx,mjs}",
        "workers/**/*.ts",
        ".cursor/hooks/*.{ts,mjs}",
        "*.{ts,mjs,cjs,js}"
    ],
    "ignoreExportsUsedInFile": true,
    "ignoreDependencies": [
        "@fontsource/*",
        "markdownlint-cli2",
        "playwright",
        "esbuild",
        "vite",
        "markdownlint",
        "@jest/globals",
        "jest-mock",
        "undici",
        "sass"
    ],
    "ignoreBinaries": ["psql", "pg_dump", "where.exe"],
    "rules": {
        "files": "error",
        "dependencies": "error",
        "devDependencies": "error",
        "unlisted": "error",
        "binaries": "error",
        "unresolved": "error",
        "exports": "warn",
        "types": "warn",
        "duplicates": "warn",
        "enumMembers": "warn"
    },
    "playwright": false
}
