{
    "version": 1,
    "authAppMetadataKeys": {
        "login_alias": {
            "prerequisite": "auth-login-alias-app-metadata"
        },
        "login_alias_operation_id": {
            "migration": "none",
            "reason": "Written together with a new alias by the admin alias update; an absent value only means no update is in flight."
        },
        "role": {
            "prerequisite": "auth-role-app-metadata"
        },
        "must_change_password": {
            "prerequisite": "auth-must-change-password"
        },
        "temp_password_expires_at": {
            "migration": "none",
            "reason": "An absent value reads as not expired; it is written together with each temporary password."
        }
    },
    "prerequisites": [
        {
            "id": "auth-role-app-metadata",
            "summary": "Every Auth account has a valid app_user_roles.role matching app_metadata.role, with no orphan application roles.",
            "introducedBy": "scripts/auth/check-role-app-metadata.mjs",
            "verify": "pnpm auth:check-role-app-metadata",
            "environments": {
                "production": {
                    "status": "pending"
                },
                "preview": {
                    "status": "pending"
                }
            }
        },
        {
            "id": "auth-login-alias-app-metadata",
            "summary": "Every account that logs in by alias has the alias in app_metadata.login_alias; login never reads user_metadata.",
            "introducedBy": "https://github.com/fm-dev-mx/celebra-me/pull/866",
            "verify": "pnpm auth:check-login-alias",
            "environments": {
                "production": {
